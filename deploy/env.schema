# deploy/env.schema — the ONE schema of deploy/.env (read by deploy/env-config.sh)
#
# Every key `synap config set` may write, with its type and flags. A key that is
# neither here nor referenced as ${KEY} by docker-compose.yml / its override is
# REFUSED (PATH, NODE_VERSION, typos), so a hand `sed` can no longer plant a
# runtime key in the pod's config.
#
# This file is cross-checked, never trusted on its own
# (deploy/__tests__/config-door.test.sh): every key in .env.example, every
# ${KEY} in docker-compose.yml, every key `synap install` generates and every
# key of @eve/dna POD_SECRET_FIELDS (when hestia-cli is checked out beside this
# repo) must be listed here — and every key listed here must still be used by
# one of those sources or by the synap CLI / deploy scripts.
#
# Columns: KEY  TYPE  FLAGS(comma-separated, "-" for none)
#   A KEY ending in * matches every key with that prefix.
# Types:
#   str      any single-line value
#   token    a secret-shaped value: no whitespace, quotes, $, `, \ or #
#   int      digits
#   bool     true | false | 1 | 0
#   host     a bare hostname (no scheme, port or path)
#   email    user@host.tld
#   origin   http(s)://host[:port] — no path, no trailing slash (validate warns
#            when PUBLIC_URL is http:// on a public host)
#   httpsurl canonical https://host[:port][/path] — no trailing slash, query,
#            fragment or credentials (the pod-agent trust anchors)
#   url      http(s)://… with a host
#   list     comma-separated, no whitespace
#   name     a compose project name: [a-z0-9][a-z0-9_-]*
#   size     digits + optional unit (100MB, 256mb)
#   image    an image reference (managed by `synap update`)
#   enum:a|b one of the listed values
# Flags:
#   secret    value is masked in every output
#   required  validate/doctor report it when missing or empty
#   immutable indexes data that already exists (volumes, encrypted rows);
#             changing a non-empty value needs --force (filling an empty one is fine)
#   managed   owned by `synap update` / `synap install`; `config set` refuses it
#   pin       may be set once when empty, never changed by `config set`

# ── identity & routing ───────────────────────────────────────────────────────
DOMAIN                        host      required
PUBLIC_URL                    origin    -
POD_ADMIN_DOMAIN              host      -
POD_ADMIN_URL                 origin    -
FRONTEND_URL                  origin    -
CORS_ORIGIN                   list      -
ALLOWED_ORIGINS               list      -
SYNAP_BASE_DOMAIN             host      -
SYNAP_POD_URL                 origin    -
LETSENCRYPT_EMAIL             email     -
SYNAP_EDGE                    enum:caddy|traefik  -
SYNAP_SHARED_CLIENT_IP        str       -
CADDYFILE_PATH                str       -
CLOUDFLARED_TUNNEL_TOKEN      token     secret

# ── compose project + release (owned by synap) ───────────────────────────────
COMPOSE_PROJECT_NAME          name      pin
SYNAP_RELEASE_ID              str       managed
BACKEND_VERSION               str       managed
SYNAP_IMAGE_*                 image     managed
POD_AGENT_VERSION             str       -
GIT_SHA                       str       -
GITHUB_REPOSITORY             str       -
SYNAP_UPDATE_CHANNEL          str       -
SYNAP_UPDATE_NOTIFY_CMD       str       -

# ── data-indexing secrets (regenerating one is one-way data loss) ────────────
POSTGRES_PASSWORD             token     secret,required,immutable
JWT_SECRET                    token     secret,required,immutable
KRATOS_SECRETS_COOKIE         token     secret,required,immutable
KRATOS_SECRETS_CIPHER         token     secret,immutable
KRATOS_WEBHOOK_SECRET         token     secret,immutable
ORY_HYDRA_SECRETS_SYSTEM      token     secret,immutable
MINIO_ACCESS_KEY              token     secret,immutable
MINIO_SECRET_KEY              token     secret,immutable
TYPESENSE_API_KEY             token     secret,immutable
TYPESENSE_ADMIN_API_KEY       token     secret,immutable
SYNAP_SERVICE_ENCRYPTION_KEY  token     secret,immutable
VAULT_SERVER_KEY              token     secret,immutable
PROVISIONING_TOKEN            token     secret,immutable

# ── other secrets ────────────────────────────────────────────────────────────
HUB_JWT_SECRET                token     secret
HUB_PROTOCOL_API_KEY          token     secret
HUB_PROTOCOL_API_KEYS         str       secret
HUB_PROTOCOL_SUB_TOKENS       bool      -
HUB_PROTOCOL_EXTERNAL_USER_WORKSPACE_STRATEGY  enum:first|all|none  -
BRIDGE_SECRET                 token     secret
CHANNEL_GATEWAY_KEY           token     secret
SYNAP_POD_INTERNAL_KEY        token     secret
INTELLIGENCE_API_KEY          token     secret
INTELLIGENCE_HUB_API_KEY      token     secret
INTELLIGENCE_HUB_INTERNAL_KEY token     secret
OPENCLAW_HUB_API_KEY          token     secret
INNGEST_EVENT_KEY             token     secret
INNGEST_SIGNING_KEY           token     secret
OPENAI_API_KEY                token     secret
ANTHROPIC_API_KEY             token     secret
GOOGLE_AI_API_KEY             token     secret
OPENROUTER_API_KEY            token     secret
NANGO_SECRET_KEY              token     secret
RSSHUB_ACCESS_KEY             token     secret
T3CODE_API_KEY                token     secret
GRAFANA_PASSWORD              token     secret
SMTP_CONNECTION_URI           str       secret
ADMIN_PASSWORD                str       secret
ADMIN_BOOTSTRAP_TOKEN         token     secret

# ── admin bootstrap ──────────────────────────────────────────────────────────
ADMIN_EMAIL                   email     -
ADMIN_BOOTSTRAP_MODE          enum:preseed|token  -

# ── pod-agent (CP command channel) ───────────────────────────────────────────
SYNAP_WITH_POD_AGENT          bool      -
POD_AGENT_ISSUER_URL          httpsurl  -
POD_AGENT_AUDIENCE            httpsurl  -

# ── federation / control plane / connectors ──────────────────────────────────
SYNAP_POD_FEDERATION_DISABLED bool      -
SYNAP_POD_OIDC_LABEL          str       -
CONTROL_PLANE_URL             url       -
SYNAP_CONNECTOR_BROKER        enum:local  -
NANGO_HOST                    url       -
NANGO_CONNECT_URL             url       -
INTELLIGENCE_HUB_URL          url       -
SYNAP_AGENT_USER_ID           str       -
SYNAP_WORKSPACE_ID            str       -
T3CODE_URL                    url       -

# ── AI ───────────────────────────────────────────────────────────────────────
AI_PROVIDER                   str       -
EMBEDDING_PROVIDER            str       -
DEFAULT_AI_PROVIDER           str       -
DEFAULT_AI_MODEL              str       -
OLLAMA_BASE_URL               url       -

# ── RSS ──────────────────────────────────────────────────────────────────────
RSS_PROVIDER_TYPE             enum:direct|rsshub|cpproxy|custom  -
RSSHUB_URL                    url       -
CP_RSSHUB_PROXY_URL           url       -
RSS_FETCH_TIMEOUT_MS          int       -
RSS_FETCH_RETRIES             int       -

# ── tuning ───────────────────────────────────────────────────────────────────
DEBUG                         bool      -
MAX_UPLOAD_SIZE               size      -
DB_POOL_SIZE                  int       -
REDIS_MAX_MEMORY              size      -

# ── storage paths (operator overrides) ───────────────────────────────────────
KRATOS_CONFIG_DIR             str       -
POSTGRES_INIT_SCRIPT          str       -
SYNAP_ALLOW_PG_REINIT         bool      -

# ── backups (deploy/pgdata-safety.sh) ────────────────────────────────────────
BACKUP_REPOSITORY             str       secret
BACKUP_RESTIC_REST_USERNAME   str       -
BACKUP_RESTIC_REST_PASSWORD   token     secret
BACKUP_AWS_ACCESS_KEY_ID      token     secret
BACKUP_AWS_SECRET_ACCESS_KEY  token     secret
BACKUP_AWS_DEFAULT_REGION     str       -
BACKUP_B2_ACCOUNT_ID          token     secret
BACKUP_B2_ACCOUNT_KEY         token     secret
BACKUP_HEARTBEAT_URL          url       secret
BACKUP_DRILL_INTERVAL_SECONDS int       -
PG_BACKUP_INTERVAL_SECONDS    int       -
PG_BACKUP_KEEP                int       -
PG_BACKUP_KEEP_DAILY          int       -

# Synap compose request (H3): pod-agent runs in a container and must never
# create a container itself — its compose resolves the relative binds against
# its own /deploy, which does not exist on the host. It writes
# state/requests/compose.json; this unit runs it with the real deploy dir.
# Started by synap-compose.path. Template: synap units install.
[Unit]
Description=Synap pod compose request (from pod-agent)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
Environment=SYNAP_DEPLOY_DIR=@DEPLOY_DIR@
Environment=SYNAP_ASSUME_YES=1
# Take the request BEFORE the engine runs (contract: _synap_take_request in
# `synap`): a run that dies before its own take would leave compose.json in
# place, and PathExists= would restart this unit until the start limit fails
# synap-compose.path for good. An older taken file is dropped first, so
# the engine only ever reads THIS run's request (none on a timer run).
Environment=SYNAP_REQUEST_PRETAKEN=1
ExecStartPre=/bin/sh -c 'r="$${SYNAP_DEPLOY_DIR}/state/requests"; rm -f "$$r/compose.taken.json"; [ ! -e "$$r/compose.json" ] || mv -f "$$r/compose.json" "$$r/compose.taken.json"'
ExecStart=@SYNAP@ compose-request
# A request taken here but never answered (the engine died before recording
# an outcome) still gets one, so pod-agent and the CP never wait on it.
# No StartLimit*= override: with the request always taken first, a start
# cannot repeat itself; if the take itself failed, systemd's default limit
# failing synap-compose.path is the loud outcome (synap doctor names a
# request waiting > 10 min), where StartLimitIntervalSec=0 would spin.
# The leading '-': a failing recorder must not turn this run's own result
# into a failure or hide the engine's exit status (the journal still shows it).
ExecStopPost=-/bin/sh -c 'exec /bin/sh "$${SYNAP_DEPLOY_DIR}/request-outcome.sh" compose'
TimeoutStartSec=20min

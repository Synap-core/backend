# Runs synap-update.service when an update request appears (contract: the
# REQUEST CONTRACT comment above _ue_unattended_plan in `synap`).
# synap-update.service takes the file (ExecStartPre) before the engine runs,
# so this cannot loop even when the engine dies early. Template: synap units install.
[Unit]
Description=Synap pod update requests

[Path]
PathExists=@DEPLOY_DIR@/state/requests/update.json
Unit=synap-update.service

[Install]
WantedBy=multi-user.target

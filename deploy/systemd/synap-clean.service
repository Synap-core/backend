# Synap clean request (plan P3): pod admin offers a few clean-ups when the host
# runs short; the backend writes state/clean/request.json and this unit runs it
# on the host. Only regenerable things: the build cache, old release images
# (the current and previous release are kept), or a restart of an allowlisted
# service (never postgres). Started by synap-clean.path. Template: synap units install.
[Unit]
Description=Synap pod clean request (from the backend)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
Environment=SYNAP_DEPLOY_DIR=@DEPLOY_DIR@
Environment=SYNAP_ASSUME_YES=1
# Take the request BEFORE the engine runs (contract: _synap_take_request in
# `synap`): a run that dies before its own take would leave request.json in
# place, and PathExists= would restart this unit until the start limit fails
# synap-clean.path for good. An older taken file is dropped first, so the
# engine only ever reads THIS run's request.
Environment=SYNAP_REQUEST_PRETAKEN=1
ExecStartPre=/bin/sh -c 'r="$${SYNAP_DEPLOY_DIR}/state/clean"; rm -f "$$r/request.taken.json"; [ ! -e "$$r/request.json" ] || mv -f "$$r/request.json" "$$r/request.taken.json"'
ExecStart=@SYNAP@ clean-request
# A request taken here but never answered (the engine died before recording
# a result) still gets one, so the backend never waits on it.
# The leading '-': a failing recorder must not turn this run's own result
# into a failure or hide the engine's exit status (the journal still shows it).
ExecStopPost=-/bin/sh -c 'exec /bin/sh "$${SYNAP_DEPLOY_DIR}/request-outcome.sh" clean'
TimeoutStartSec=20min
Nice=10

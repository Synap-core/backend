# Synap unattended update (D2): the ONE unit that runs the update engine
# without a person. Started by synap-update.path (a request in
# state/requests/update.json) or synap-update.timer (the owner's policy,
# state/update-policy.json). `--unattended` enforces the release signature
# (D3). A hung run is stopped after 90 min: SIGTERM makes the engine roll
# back, and the rollback (which may restore the database) gets 30 min.
# Template: synap units install.
[Unit]
Description=Synap pod update (unattended)
After=docker.service network-online.target
Wants=network-online.target
Wants=docker.service

[Service]
Type=oneshot
Environment=SYNAP_DEPLOY_DIR=@DEPLOY_DIR@
Environment=SYNAP_ASSUME_YES=1
# Take the request BEFORE the engine runs (contract: _synap_take_request in
# `synap`): a run that dies before its own take would leave update.json in
# place, and PathExists= would restart this unit until the start limit fails
# synap-update.path for good. An older taken file is dropped first, so
# the engine only ever reads THIS run's request (none on a timer run).
Environment=SYNAP_REQUEST_PRETAKEN=1
ExecStartPre=/bin/sh -c 'r="$${SYNAP_DEPLOY_DIR}/state/requests"; rm -f "$$r/update.taken.json"; [ ! -e "$$r/update.json" ] || mv -f "$$r/update.json" "$$r/update.taken.json"'
ExecStart=@SYNAP@ update --unattended
# A request taken here but never answered (the engine died before recording
# an outcome) still gets one, so pod-agent and the CP never wait on it.
# No StartLimit*= override: with the request always taken first, a start
# cannot repeat itself; if the take itself failed, systemd's default limit
# failing synap-update.path is the loud outcome (synap doctor names a
# request waiting > 10 min), where StartLimitIntervalSec=0 would spin.
ExecStopPost=/bin/sh -c 'exec /bin/sh "$${SYNAP_DEPLOY_DIR}/request-outcome.sh" update'
TimeoutStartSec=90min
TimeoutStopSec=30min
Nice=10

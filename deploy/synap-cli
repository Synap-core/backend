#!/bin/bash
# Synap CLI - Management tool for self-hosted Synap instances

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Get installation directory
INSTALL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$INSTALL_DIR"

# Check if docker-compose.yml exists
if [ ! -f "docker-compose.yml" ]; then
    echo -e "${RED}Error: docker-compose.yml not found${NC}"
    echo "Are you in the Synap installation directory?"
    exit 1
fi

# Commands
cmd_health() {
    echo -e "${BLUE}🏥 Synap Health Check${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""

    # Check if services are running
    if ! docker compose ps | grep -q "Up"; then
        echo -e "${RED}❌ No services running${NC}"
        echo ""
        echo "Start Synap with: docker compose up -d"
        exit 1
    fi

    # Check each service
    check_service() {
        local service=$1
        local name=$2
        
        if docker compose ps "$service" | grep -q "Up"; then
            echo -e "${GREEN}✅ ${name}${NC}"
        else
            echo -e "${RED}❌ ${name}${NC}"
        fi
    }

    check_service "backend" "Backend API"
    # Intelligence Service is external/separate, skipping local check
    check_service "postgres" "Database"
    check_service "redis" "Redis"
    check_service "minio" "Storage"
    check_service "typesense" "Search"
    check_service "kratos" "Authentication"
    check_service "hydra" "OAuth2"
    check_service "caddy" "Reverse Proxy"

    echo ""
    
    # Check backend health endpoint
    if docker compose exec -T backend node -e "require('http').get('http://localhost:4000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))" &>/dev/null; then
        echo -e "${GREEN}✅ Backend responding${NC}"
    else
        echo -e "${YELLOW}⚠️  Backend not responding${NC}"
    fi

    echo ""
    echo -e "${BLUE}Overall Status: ${GREEN}HEALTHY${NC}"
}

cmd_logs() {
    local service=${1:-}
    
    if [ -z "$service" ]; then
        echo -e "${BLUE}📊 Viewing all logs (Ctrl+C to exit)${NC}"
        docker compose logs -f
    else
        echo -e "${BLUE}📊 Viewing logs for: ${service}${NC}"
        docker compose logs -f "$service"
    fi
}

cmd_restart() {
    local service=${1:-}
    
    if [ -z "$service" ]; then
        echo -e "${BLUE}🔄 Restarting all services...${NC}"
        docker compose restart
        echo -e "${GREEN}✅ All services restarted${NC}"
    else
        echo -e "${BLUE}🔄 Restarting ${service}...${NC}"
        docker compose restart "$service"
        echo -e "${GREEN}✅ ${service} restarted${NC}"
    fi
}

cmd_stop() {
    echo -e "${YELLOW}⏸️  Stopping Synap...${NC}"
    docker compose stop
    echo -e "${GREEN}✅ Synap stopped${NC}"
}

cmd_start() {
    echo -e "${BLUE}▶️  Starting Synap...${NC}"
    docker compose up -d
    echo -e "${GREEN}✅ Synap started${NC}"
}

cmd_update() {
    local version="latest"
    local force_build="false"
    
    # Parse arguments: handle --build flag and version
    for arg in "$@"; do
        if [ "$arg" = "--build" ] || [ "$arg" = "-b" ]; then
            force_build="true"
        elif [[ "$arg" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]] || [ "$arg" = "latest" ]; then
            version="$arg"
        fi
    done
    
    echo -e "${BLUE}🔄 Checking for updates...${NC}"
    echo ""
    
    # Safely read .env file (without executing commands)
    # Only read KEY=VALUE pairs, ignore comments and empty lines
    GITHUB_REPOSITORY=""
    BACKEND_VERSION=""
    GITHUB_TOKEN=""
    GITHUB_USER=""
    
    if [ -f .env ]; then
        while IFS='=' read -r key value || [ -n "$key" ]; do
            # Skip empty lines, comments, and lines without =
            [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
            [[ ! "$key" =~ ^[A-Z_]+$ ]] && continue
            
            # Remove quotes from value if present and trim whitespace
            value=$(echo "$value" | sed "s/^['\"]//;s/['\"]$//" | xargs)
            
            # Store specific variables we need (safely, without export)
            case "$key" in
                GITHUB_REPOSITORY)
                    GITHUB_REPOSITORY="$value"
                    ;;
                BACKEND_VERSION)
                    BACKEND_VERSION="$value"
                    ;;
                GITHUB_TOKEN)
                    GITHUB_TOKEN="$value"
                    ;;
                GITHUB_USER)
                    GITHUB_USER="$value"
                    ;;
            esac
        done < <(grep -E "^[A-Z_]+=" .env 2>/dev/null || true)
    fi
    
    # Get current image version from .env (docker-compose.yml uses variables)
    if [ -n "$BACKEND_VERSION" ]; then
        CURRENT_IMAGE="$BACKEND_VERSION"
    else
        CURRENT_IMAGE="latest"
    fi
    
    echo -e "Current image: ${YELLOW}${CURRENT_IMAGE}${NC}"
    
    # Determine target image
    if [ "$version" = "latest" ]; then
        echo -e "Target: ${BLUE}latest${NC}"
    elif [[ "$version" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]]; then
        # Ensure version starts with v
        if [[ ! "$version" =~ ^v ]]; then
            version="v${version}"
        fi
        echo -e "Target: ${BLUE}${version}${NC}"
    else
        echo -e "${RED}❌ Invalid version format. Use 'latest' or semantic version (e.g., v1.2.3)${NC}"
        exit 1
    fi
    
    # Use GITHUB_REPOSITORY from .env or default
    # Note: GITHUB_REPOSITORY should be in format "owner/repo-name" (e.g., "synap-core/backend")
    # The image name is just the repo name, not repo-name/backend
    REPO="${GITHUB_REPOSITORY:-synap-core/backend}"
    TARGET_IMAGE="ghcr.io/${REPO}:${version}"
    
    # Backup before update
    echo ""
    echo -e "${BLUE}💾 Creating backup before update...${NC}"
    cmd_backup "pre-update-$(date +%Y%m%d-%H%M%S)"
    
    # Login to GHCR if needed
    echo ""
    echo -e "${BLUE}🔐 Authenticating with GitHub Container Registry...${NC}"
    if [ -n "$GITHUB_TOKEN" ]; then
        echo "$GITHUB_TOKEN" | docker login ghcr.io -u "$GITHUB_USER" --password-stdin 2>/dev/null || \
        echo -e "${YELLOW}⚠️  Could not login to GHCR. Public images may still be accessible.${NC}"
    else
        echo -e "${YELLOW}⚠️  GITHUB_TOKEN not set. Attempting to pull public image...${NC}"
    fi
    
    # Update .env file with new BACKEND_VERSION first
    # (Docker Compose reads this automatically)
    echo ""
    echo -e "${BLUE}📝 Updating configuration...${NC}"
    if [ -f .env ]; then
        # Backup .env
        cp .env .env.backup
        
        # Update or add BACKEND_VERSION in .env
        if grep -q "^BACKEND_VERSION=" .env 2>/dev/null; then
            # Update existing BACKEND_VERSION
            if [[ "$OSTYPE" == "darwin"* ]]; then
                # macOS sed requires -i '' for in-place editing
                sed -i '' "s|^BACKEND_VERSION=.*|BACKEND_VERSION=${version}|" .env
            else
                # Linux sed
                sed -i "s|^BACKEND_VERSION=.*|BACKEND_VERSION=${version}|" .env
            fi
        else
            # Add BACKEND_VERSION to .env
            echo "BACKEND_VERSION=${version}" >> .env
        fi
    else
        echo -e "${YELLOW}⚠️  .env file not found. Creating it...${NC}"
        echo "BACKEND_VERSION=${version}" > .env
        echo "GITHUB_REPOSITORY=${REPO}" >> .env
    fi
    
    # Use standard Docker Compose commands
    # Strategy: Try to pull image first (fast), fall back to building from source if needed
    echo ""
    
    if [ "$force_build" = "true" ]; then
        # Force build from source (development, testing, or when you want latest code)
        echo -e "${BLUE}🔨 Building from source (--build flag)...${NC}"
        echo -e "${YELLOW}ℹ️  This will build from the repository in the parent directory${NC}"
        echo ""
        
        # Check if source code exists
        if [ ! -d "../packages" ] && [ ! -d "../apps" ]; then
            echo -e "${RED}❌ Source code not found. Expected repository in parent directory.${NC}"
            echo -e "   For image-based deployment, remove --build flag"
            echo -e "   For source-based deployment, ensure repository is cloned"
            exit 1
        fi
        
        # Build from source
        if ! docker compose build backend; then
            echo -e "${RED}❌ Failed to build from source.${NC}"
            exit 1
        fi
    else
        # Try to pull image first (standard, fast, production-ready)
        echo -e "${BLUE}📥 Pulling new image (standard: docker compose pull)...${NC}"
        PULL_SUCCESS=true
        if ! docker compose pull backend 2>/dev/null; then
            PULL_SUCCESS=false
            echo -e "${YELLOW}⚠️  Failed to pull image. Falling back to building from source...${NC}"
            echo ""
            
            # Check if source code exists for fallback
            if [ ! -d "../packages" ] && [ ! -d "../apps" ]; then
                echo -e "${RED}❌ Cannot pull image and source code not available for fallback build.${NC}"
                echo -e ""
                echo -e "${YELLOW}Options:${NC}"
                echo -e "  1. Check image exists: https://github.com/${REPO}/pkgs/container/backend"
                echo -e "  2. Set GITHUB_TOKEN in .env (for private repos)"
                echo -e "  3. Clone repository for source-based build:"
                echo -e "     ${GREEN}cd .. && git clone https://github.com/${REPO}.git .${NC}"
                echo -e "  4. Force build from source: ${GREEN}./synap-cli update --build${NC}"
                exit 1
            fi
            
            # Fallback: Build from source
            echo -e "${BLUE}🔨 Building from source (fallback)...${NC}"
            if ! docker compose build backend; then
                echo -e "${RED}❌ Failed to build from source.${NC}"
                exit 1
            fi
            echo -e "${GREEN}✅ Built from source successfully${NC}"
        else
            echo -e "${GREEN}✅ Image pulled successfully${NC}"
        fi
    fi
    
    # Run migrations FIRST (before starting backend)
    echo ""
    echo -e "${BLUE}🔄 Running database migrations...${NC}"
    MIGRATE_OUTPUT=$(docker compose run --rm backend-migrate 2>&1)
    MIGRATE_EXIT=$?
    
    if [ $MIGRATE_EXIT -eq 0 ]; then
        echo -e "${GREEN}✅ Migrations completed successfully${NC}"
        echo "$MIGRATE_OUTPUT" | tail -5  # Show last 5 lines of output
    else
        # Check if it's just "already applied" (which is fine)
        if echo "$MIGRATE_OUTPUT" | grep -q "already applied\|Nothing to do"; then
            echo -e "${GREEN}✅ Migrations already applied (no changes needed)${NC}"
        else
            echo -e "${YELLOW}⚠️  Migration service exited with code $MIGRATE_EXIT${NC}"
            echo -e "${YELLOW}   This might be normal if migrations are already applied.${NC}"
            echo -e "${YELLOW}   Check logs: ${BLUE}docker compose logs backend-migrate${NC}"
        fi
    fi
    
    # Update services using standard Docker Compose command
    echo ""
    echo -e "${BLUE}🔄 Updating services (standard: docker compose up -d)...${NC}"
    docker compose up -d backend
    
    # Wait for backend to be healthy
    echo ""
    echo -e "${BLUE}⏳ Waiting for backend to be healthy...${NC}"
    sleep 10
    
    # Health check
    echo ""
    echo -e "${BLUE}🏥 Health check...${NC}"
    if docker compose exec -T backend node -e "require('http').get('http://localhost:4000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))" 2>/dev/null; then
        echo -e "${GREEN}✅ Backend is healthy${NC}"
    else
        echo -e "${YELLOW}⚠️  Backend health check failed. Check logs:${NC}"
        echo -e "  ${BLUE}./synap-cli logs backend${NC}"
    fi
    
    # Get new version info from .env
    NEW_VERSION=$(grep "^BACKEND_VERSION=" .env 2>/dev/null | cut -d'=' -f2- | xargs || echo "$version")
    
    echo ""
    echo -e "${GREEN}✅ Update complete!${NC}"
    echo -e "New version: ${GREEN}${NEW_VERSION}${NC}"
    echo -e "Image: ${GREEN}ghcr.io/${REPO}:${NEW_VERSION}${NC}"
    echo ""
    echo -e "${BLUE}📚 Standard Docker Compose commands (for reference):${NC}"
    echo -e "  ${YELLOW}# Update to latest (pull image):${NC}"
    echo -e "  ${GREEN}docker compose pull backend${NC}"
    echo -e "  ${GREEN}docker compose up -d backend${NC}"
    echo -e ""
    echo -e "  ${YELLOW}# Update to specific version (pull image):${NC}"
    echo -e "  ${GREEN}echo 'BACKEND_VERSION=v1.2.3' >> .env${NC}"
    echo -e "  ${GREEN}docker compose pull backend${NC}"
    echo -e "  ${GREEN}docker compose up -d backend${NC}"
    echo -e ""
    echo -e "  ${YELLOW}# Build from source (if pull fails or for development):${NC}"
    echo -e "  ${GREEN}docker compose build backend${NC}"
    echo -e "  ${GREEN}docker compose up -d backend${NC}"
    echo ""
    echo -e "${YELLOW}💡 To rollback:${NC}"
    echo -e "  ${BLUE}./synap-cli update <previous-version>${NC}"
    echo -e "  ${BLUE}Or restore from backup: ./synap-cli restore backups/pre-update-*.tar.gz${NC}"
}

cmd_backup() {
    local backup_name=${1:-"backup-$(date +%Y%m%d-%H%M%S)"}
    local backup_dir="./backups"
    
    mkdir -p "$backup_dir"
    
    echo -e "${BLUE}💾 Creating backup: ${backup_name}${NC}"
    echo ""
    
    # Backup database
    echo -e "${BLUE}Backing up database...${NC}"
    docker compose exec -T postgres pg_dump -U synap synap > "$backup_dir/${backup_name}-database.sql"
    echo -e "${GREEN}✓ Database backed up${NC}"
    
    # Backup .env
    echo -e "${BLUE}Backing up configuration...${NC}"
    cp .env "$backup_dir/${backup_name}.env"
    echo -e "${GREEN}✓ Configuration backed up${NC}"
    
    # Create tarball
    echo -e "${BLUE}Creating archive...${NC}"
    tar -czf "$backup_dir/${backup_name}.tar.gz" \
        -C "$backup_dir" \
        "${backup_name}-database.sql" \
        "${backup_name}.env"
    
    # Cleanup individual files
    rm "$backup_dir/${backup_name}-database.sql" "$backup_dir/${backup_name}.env"
    
    echo ""
    echo -e "${GREEN}✅ Backup created: ${backup_dir}/${backup_name}.tar.gz${NC}"
    echo -e "${YELLOW}⚠️  Store this backup securely!${NC}"
}

cmd_restore() {
    local backup_file=$1
    
    if [ -z "$backup_file" ]; then
        echo -e "${RED}Error: Backup file required${NC}"
        echo "Usage: $0 restore <backup-file.tar.gz>"
        exit 1
    fi
    
    if [ ! -f "$backup_file" ]; then
        echo -e "${RED}Error: Backup file not found: $backup_file${NC}"
        exit 1
    fi
    
    echo -e "${YELLOW}⚠️  WARNING: This will overwrite current data!${NC}"
    read -p "Continue? (yes/no): " CONFIRM
    if [ "$CONFIRM" != "yes" ]; then
        echo "Restore cancelled"
        exit 0
    fi
    
    echo -e "${BLUE}📦 Restoring from backup...${NC}"
    echo ""
    
    # Extract backup
    local temp_dir=$(mktemp -d)
    tar -xzf "$backup_file" -C "$temp_dir"
    
    # Stop services
    echo -e "${BLUE}Stopping services...${NC}"
    docker compose stop backend
    
    # Restore database
    echo -e "${BLUE}Restoring database...${NC}"
    cat "$temp_dir"/*-database.sql | docker compose exec -T postgres psql -U synap synap
    echo -e "${GREEN}✓ Database restored${NC}"
    
    # Restore .env
    if [ -f "$temp_dir"/*.env ]; then
        echo -e "${BLUE}Restoring configuration...${NC}"
        cp "$temp_dir"/*.env .env
        echo -e "${GREEN}✓ Configuration restored${NC}"
    fi
    
    # Cleanup
    rm -rf "$temp_dir"
    
    # Restart services
    echo -e "${BLUE}Restarting services...${NC}"
    docker compose up -d
    
    echo ""
    echo -e "${GREEN}✅ Restore complete!${NC}"
}

cmd_config() {
    local action=${1:-list}
    local key=${2:-}
    local value=${3:-}

    case "$action" in
        list)
            if [ -f .env ]; then
                echo -e "${BLUE}📝 Current Configuration:${NC}"
                # Show all but mask known secrets
                while IFS='=' read -r k v; do
                    # Skip empty lines or comments
                    [[ -z "$k" || "$k" =~ ^# ]] && continue
                    
                    if [[ "$k" == *"SECRET"* ]] || [[ "$k" == *"KEY"* ]] || [[ "$k" == *"PASSWORD"* ]] || [[ "$k" == *"CIPHER"* ]] || [[ "$k" == *"COOKIE"* ]]; then
                        echo "$k=********"
                    else
                        echo "$k=$v"
                    fi
                done < .env
            else
                echo -e "${RED}No .env file found.${NC}"
            fi
            ;;
        edit)
            # Create backup before edit
            cp .env .env.bak
            
            # Try nano, then vi
            if command -v nano >/dev/null; then
                nano .env
            else
                vi .env
            fi
            
            echo -e "${GREEN}✓ Configuration saved.${NC}"
            echo -e "${YELLOW}ℹ️  Restart services to apply changes: ./synap-cli restart${NC}"
            ;;
        set)
            if [ -z "$key" ] || [ -z "$value" ]; then
                echo "Usage: synap-cli config set KEY VALUE"
                exit 1
            fi
            
            # Create backup
            cp .env .env.bak
            
            if grep -q "^$key=" .env; then
                # Update existing
                # Use a temp file to safely handle sed on different platforms
                awk -v k="$key" -v v="$value" 'BEGIN{FS="=";OFS="="} $1==k {$2=v} 1' .env > .env.tmp && mv .env.tmp .env
            else
                # Append new
                echo "$key=$value" >> .env
            fi
            echo -e "${GREEN}✓ Updated $key=$value${NC}"
            echo -e "${YELLOW}ℹ️  Restart services to apply changes.${NC}"
            ;;
        get)
             if [ -z "$key" ]; then
                echo "Usage: synap-cli config get KEY"
                exit 1
            fi
            grep "^$key=" .env | cut -d'=' -f2-
            ;;
        *)
            echo "Usage: synap-cli config [list|edit|set|get]"
            ;;
    esac
}

cmd_domain() {
    echo -e "${BLUE}🌐 Domain Configuration Wizard${NC}"
    echo "This will update your Synap instance to use a different domain."
    echo ""
    
    local CURRENT_DOMAIN=$(grep '^DOMAIN=' .env | cut -d'=' -f2-)
    echo -e "Current Domain: ${YELLOW}${CURRENT_DOMAIN}${NC}"
    echo ""
    
    echo "Enter new domain (e.g., synap.example.com)"
    echo "For localhost, type 'localhost'"
    read -p "New Domain: " NEW_DOMAIN
    
    if [ -z "$NEW_DOMAIN" ]; then
        echo -e "${RED}Cancelled.${NC}"
        exit 1
    fi
    
    local NEW_EMAIL=""
    if [ "$NEW_DOMAIN" != "localhost" ]; then
        local CURRENT_EMAIL=$(grep '^LETSENCRYPT_EMAIL=' .env | cut -d'=' -f2-)
        read -p "Enter email for SSL [${CURRENT_EMAIL}]: " NEW_EMAIL
        NEW_EMAIL=${NEW_EMAIL:-$CURRENT_EMAIL}
        
        while [ -z "$NEW_EMAIL" ]; do
             echo -e "${RED}Email is required for SSL!${NC}"
             read -p "Enter email: " NEW_EMAIL
        done
    else
        NEW_EMAIL="noreply@localhost"
    fi
    
    # Backup
    cmd_backup "pre-domain-change-$(date +%Y%m%d)"
    
    # Update config
    echo -e "${BLUE}📝 Updating configuration...${NC}"
    cmd_config set DOMAIN "$NEW_DOMAIN"
    cmd_config set LETSENCRYPT_EMAIL "$NEW_EMAIL"
    
    echo ""
    echo -e "${GREEN}✓ Configuration updated${NC}"
    
    # Restart
    echo -e "${BLUE}🔄 Restarting services to apply changes...${NC}"
    cmd_restart
    
    echo ""
    echo -e "${GREEN}✅ Domain changed to: ${NEW_DOMAIN}${NC}"
    if [ "$NEW_DOMAIN" != "localhost" ]; then
        echo -e "Access at: https://${NEW_DOMAIN}"
    else
        echo -e "Access at: http://localhost:4000"
    fi
}

cmd_shell() {
    local service=${1:-backend}
    echo -e "${BLUE}🐚 Opening shell in ${service}...${NC}"
    docker compose exec "$service" sh
}

cmd_help() {
    cat << EOF
${BLUE}Synap CLI - Management Tool${NC}

${YELLOW}Usage:${NC}
  synap-cli <command> [options]

${YELLOW}Commands:${NC}
  ${GREEN}health${NC}              Check system health
  ${GREEN}config${NC} [action]     Manage configuration (list, edit, set, get)
  ${GREEN}domain${NC}              Change domain (wizard)
  ${GREEN}logs${NC} [service]      View logs (all or specific service)
  ${GREEN}restart${NC} [service]   Restart services (all or specific)
  ${GREEN}start${NC}               Start all services
  ${GREEN}stop${NC}                Stop all services
  ${GREEN}update${NC} [version]    Update to latest or specific version (e.g., v1.2.3)
  ${GREEN}update --build${NC}       Force build from source (skips image pull)
  ${GREEN}backup${NC} [name]       Create backup (DB + Config)
  ${GREEN}restore${NC} <file>      Restore from backup
  ${GREEN}shell${NC} [service]     Open shell in container
  ${GREEN}help${NC}                Show this help

${YELLOW}Examples:${NC}
  synap-cli config list         # View current config
  synap-cli config edit         # Edit .env file
  synap-cli domain              # Change domain wizard
  synap-cli logs backend
  synap-cli update              # Update to latest (pulls image, falls back to build)
  synap-cli update --build      # Force build from source (skips pull)
  synap-cli update v1.2.3       # Update to specific version (pulls image)
  synap-cli backup my-backup

${YELLOW}Documentation:${NC}
  https://docs.synap.live

EOF
}

# Main command router
case "${1:-help}" in
    health)
        cmd_health
        ;;
    config|env)
        shift
        cmd_config "$@"
        ;;
    domain)
        cmd_domain
        ;;
    logs)
        cmd_logs "${2:-}"
        ;;
    restart)
        cmd_restart "${2:-}"
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    backup)
        cmd_backup "${2:-}"
        ;;
    restore)
        cmd_restore "${2:-}"
        ;;
    shell)
        cmd_shell "${2:-backend}"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo ""
        cmd_help
        exit 1
        ;;
esac

{
    # Global options
    email {$EMAIL}
}

# ─── Cloudflare Tunnel Handler ────────────────────────────────────────────────
# Handles HTTP traffic from cloudflared (Cloudflare Tunnel connector).
# IMPORTANT: Place BEFORE {$DOMAIN} to prevent redirect loops.
# cloudflared sends HTTPS traffic through the tunnel as HTTP to port 80.
#
# Route Kratos directly (not through backend) - this is critical for auth
# flows to work properly with cookies and session handling.
# ────────────────────────────────────────────────────────────────────────────────────────────────
{$DOMAIN}:80 {
    # Ory Kratos public API - route direct to bypass backend CORS issues
    handle_path /.ory/kratos/public/* {
        reverse_proxy kratos:4433
    }

    # NO route to the Kratos ADMIN API (kratos:4434) on purpose: it is
    # unauthenticated by design, so a public route = account takeover. The
    # backend reaches it on the compose network; port-exposure.test.sh fails
    # if a reverse_proxy to an admin upstream comes back.

    # Realtime WebSocket (Socket.IO) — must be before the catch-all backend proxy
    # so that WebSocket upgrades from the gateway reach the realtime server, not backend:4000.
    handle /socket.io/* {
        reverse_proxy realtime:4001
    }

    handle /realtime/* {
        reverse_proxy realtime:4001
    }

    handle /realtime-health {
        rewrite /realtime-health /bridge/health
        reverse_proxy realtime:4001
    }

    # Defense-in-depth: `/internal/*` is never a public surface. The backend no
    # longer defines any such route (crons run in-process via IoC, not an HTTP
    # loopback), but this :80 listener is the Cloudflare-tunnel ingress, so keep
    # blocking the prefix before the catch-all proxy in case one is ever added.
    handle /internal/* {
        respond 404
    }
    # Unauthenticated Prometheus text; the scraper reads backend:4000 directly.
    handle /metrics {
        respond 404
    }

    # The routes below mirror the TLS block (a tunnelled pod is served ONLY by
    # this block). Every TLS `handle` path must reach the same upstream here —
    # explicitly, or through the backend catch-all; caddy-routes.test.sh fails
    # on drift.
    handle /storage/* {
        reverse_proxy minio:9001
    }

    # Presigned S3 path — same sandbox CSP as the TLS block (see there).
    handle /synap-storage/* {
        # MinIO CVE-2026-41145 / CVE-2026-40344 (high, never fixed in the free
        # builds): an upload declaring an UNSIGNED trailer is written without
        # checking its signature, so anyone holding a presigned URL (which
        # carries the access key) could write any object. Our clients never
        # send that mode; refuse it at the edge, as the advisories advise.
        @minio_unsigned_trailer header X-Amz-Content-Sha256 STREAMING-UNSIGNED-PAYLOAD-TRAILER
        @minio_snowball header X-Amz-Meta-Snowball-Auto-Extract *
        respond @minio_unsigned_trailer 403
        respond @minio_snowball 403
        header Content-Security-Policy "sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:"
        reverse_proxy minio:9000
    }

    handle /api/pod-agent/* {
        reverse_proxy pod-agent:4002
    }

    # Registration proof (PODPROV-CONTRACT §3/§6.2): while `synap install
    # --register-token` registers, deploy/state/registration-nonce/nonce.json
    # holds {"nonce":"…"} and the Control Plane may read it here to prove a
    # custom domain points at this server. Any other time: 404.
    handle /.well-known/synap-registration {
        root * /srv/synap-registration
        rewrite * /nonce.json
        file_server
    }

    # Everything else goes to backend
    reverse_proxy backend:4000
}

{$DOMAIN} {
    # Automatic HTTPS with Let's Encrypt

    # Backend API
    handle /trpc/* {
        reverse_proxy backend:4000
    }

    handle /api/* {
        reverse_proxy backend:4000
    }

    # MCP endpoint — JSON-RPC over HTTP for Claude Desktop, Cursor, and other
    # MCP-capable clients (typically reached via the `mcp-remote` stdio bridge).
    # Without an explicit route, Caddy's catch-all below serves plain text and
    # breaks the MCP handshake.
    handle /mcp {
        reverse_proxy backend:4000
    }
    handle /mcp/* {
        reverse_proxy backend:4000
    }

    # Realtime WebSocket (Socket.IO)
    # Caddy v2 automatically detects and upgrades WebSocket connections
    # No manual header manipulation needed - it breaks the upgrade
    handle /socket.io/* {
        reverse_proxy realtime:4001 {
            # Caddy automatically handles all headers
            # Just preserve X-Real-IP for logging/debugging
            header_up X-Real-IP {remote}
        }
    }
    
    # Realtime HTTP bridge endpoints (for Inngest workers)
    handle /realtime/* {
        reverse_proxy realtime:4001
    }
    
    # Realtime health check (for debugging)
    handle /realtime-health {
        rewrite /realtime-health /bridge/health
        reverse_proxy realtime:4001
    }

    # Ory Kratos (Authentication)
    # SERVE_PUBLIC_BASE_URL = https://${DOMAIN}/.ory/kratos/public/
    # handle_path strips the prefix → Kratos receives bare /self-service/... paths.
    handle_path /.ory/kratos/public/* {
        reverse_proxy kratos:4433
    }

    # NO route to the Kratos ADMIN API (kratos:4434) on purpose: it is
    # unauthenticated by design, so a public route = account takeover. The
    # backend reaches it on the compose network; port-exposure.test.sh fails
    # if a reverse_proxy to an admin upstream comes back.

    # MinIO (Object Storage) - Admin UI
    handle /storage/* {
        reverse_proxy minio:9001
    }

    # MinIO S3 API for PRESIGNED URLs (large uploads PUT straight to storage,
    # downloads GET). /storage/* above is the CONSOLE (9001) and can never serve
    # a signed URL: SigV4 signs host + path, so the bucket must sit at the root
    # path and the Host header must reach MinIO unchanged (Caddy's default).
    # Active once the backend has MINIO_PUBLIC_URL = this pod's origin; the
    # bucket name must match MINIO_BUCKET (compose: synap-storage).
    # A stored blob is served with its UPLOAD Content-Type on THIS origin, so an
    # SVG (or any script-capable type) opened directly would run as the pod.
    # `sandbox` gives the response an opaque origin and no script; <img>/<video>
    # embeds are unaffected (a CSP on a subresource response does not apply).
    handle /synap-storage/* {
        # MinIO CVE-2026-41145 / CVE-2026-40344 (high, never fixed in the free
        # builds): an upload declaring an UNSIGNED trailer is written without
        # checking its signature, so anyone holding a presigned URL (which
        # carries the access key) could write any object. Our clients never
        # send that mode; refuse it at the edge, as the advisories advise.
        @minio_unsigned_trailer header X-Amz-Content-Sha256 STREAMING-UNSIGNED-PAYLOAD-TRAILER
        @minio_snowball header X-Amz-Meta-Snowball-Auto-Extract *
        respond @minio_unsigned_trailer 403
        respond @minio_snowball 403
        header Content-Security-Policy "sandbox; default-src 'none'; style-src 'unsafe-inline'; img-src data:"
        reverse_proxy minio:9000
    }

    # Pod Agent (CP-initiated commands: update, suspend, restore, configure)
    handle /api/pod-agent/* {
        reverse_proxy pod-agent:4002
    }

    # Registration proof (PODPROV-CONTRACT §3/§6.2): while `synap install
    # --register-token` registers, deploy/state/registration-nonce/nonce.json
    # holds {"nonce":"…"} and the Control Plane may read it here to prove a
    # custom domain points at this server. Any other time: 404.
    handle /.well-known/synap-registration {
        root * /srv/synap-registration
        rewrite * /nonce.json
        file_server
    }

    # Health check
    handle /health {
        reverse_proxy backend:4000
    }

    # Public pod status (metadata only): the CP's backup-staleness monitor and
    # release check read these. Without them the catch-all answers 200 text and
    # every pod reads as "unknown". Exact paths, never /status/* — a future
    # /status route must opt in here deliberately.
    handle /status/backup {
        reverse_proxy backend:4000
    }
    handle /status/release {
        reverse_proxy backend:4000
    }

    # Portable object locator — Discord/email click-to-app bounce (and later
    # signed-in render). Without this, the HTTPS catch-all returns static API
    # text. The Cloudflare-tunnel :80 block already proxies /open via its
    # catch-all; keep both ingresses in lock-step.
    handle /open {
        reverse_proxy backend:4000
    }
    handle /open/* {
        reverse_proxy backend:4000
    }

    # Pod home (exact / only): lightweight landing.
    @site_root path /
    handle @site_root {
        header Content-Type "text/html; charset=utf-8"
        header X-Robots-Tag "noindex, nofollow"
        respond "<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'/><meta name='viewport' content='width=device-width,initial-scale=1'/><title>Synap Data Pod</title><style>body{font-family:ui-sans-serif,system-ui,sans-serif;max-width:42rem;margin:0 auto;padding:2.5rem 1.25rem;color:#18181b;background:#f4f4f5;line-height:1.5}h1{font-size:1.5rem;margin:0 0 .5rem}a{color:#b45309}code{font-size:.875em;background:#e4e4e7;padding:.1rem .35rem;border-radius:.25rem}.card{background:#fafafa;border:1px solid #e4e4e7;border-radius:.75rem;padding:1.25rem 1.5rem;margin-top:1.25rem}</style></head><body><h1>Synap Data Pod</h1><p>This hostname is serving your pod (API, auth, realtime). The <strong>operator console</strong> is at the pod-admin subdomain.</p><div class='card'><p style='margin:.75rem 0 0;font-size:.875rem;color:#52525b'>Health: <a href='/health'>/health</a> · API: <code>/trpc</code>, <code>/api/*</code></p></div></body></html>" 200
    }

    # Never public, on either ingress: `/internal/*` (see the :80 block) and the
    # backend's unauthenticated Prometheus text (scraped on the compose network).
    handle /internal/* {
        respond 404
    }
    handle /metrics {
        respond 404
    }

    # Everything else goes to backend, exactly like the :80 block. This was a
    # static "Synap Backend API" answer, so every path the backend mounts
    # outside /api, /trpc and /mcp was dead on a directly exposed pod while
    # working on a tunnelled one: /admin/connect (the Claude connect link),
    # the MCP OAuth endpoints, /setup, /v1 (2026-10-19, lab pod).
    # caddy-routes.test.sh pins this catch-all.
    handle {
        reverse_proxy backend:4000
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Logging
    log {
        output file /var/log/caddy/access.log
        format json
    }
}

# ─── Pod Admin Console ────────────────────────────────────────────────────────
# Operator-facing Next.js console served at the explicit Pod Admin hostname.
# It is not derived from {$DOMAIN}: a Pod API commonly lives at
# pod.<root>, while its console lives at pod-admin.<root>.
# Owns /login (Kratos sign-in) and /setup (first-admin bootstrap).
# The legacy admin-ui SPA (/admin/*) has been retired.
# ─────────────────────────────────────────────────────────────────────────────
{$POD_ADMIN_DOMAIN}:80 {
    # Cloudflare Tunnel HTTP path — same shape as the main host's :80 block.
    reverse_proxy pod-admin:3000
}

{$POD_ADMIN_DOMAIN} {
    reverse_proxy pod-admin:3000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /var/log/caddy/access.log
        format json
    }
}

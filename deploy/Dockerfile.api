FROM node:20-alpine AS base
RUN npm install -g pnpm@10.28.0
WORKDIR /app

# ============================================================================
# Builder: Install dependencies and build
# ============================================================================
FROM base AS builder

# Copy all files for build
COPY . .

# Install all dependencies (including dev deps for building)
RUN pnpm install --frozen-lockfile || (sleep 5 && pnpm install --frozen-lockfile) || (sleep 10 && pnpm install --frozen-lockfile)

# Build the API package (using directory filter to avoid ambiguity)
RUN pnpm turbo build --filter="{apps/api}"

# Deploy API package (pnpm deploy works perfectly for single package)
# Deploy API package (using directory filter to be explicit)
RUN rm -rf /app/deploy && \
  pnpm deploy --filter="{apps/api}" --prod --legacy /app/deploy

# Verify we deployed the correct package (API server, NOT realtime)
RUN echo "=== Verifying deployment ===" && \
  ls -la /app/deploy/dist/ && \
  test -f /app/deploy/dist/index.js || (echo "✗ ERROR: dist/index.js (API entry point) NOT found!" && exit 1) && \
  # Critical check: Ensure we didn't accidentally deploy realtime package (which has server.js)
  if [ -f /app/deploy/dist/server.js ]; then echo "✗ ERROR: dist/server.js found! This looks like the Realtime package, not API!" && exit 1; fi && \
  echo "✓ Deployment looks correct (index.js found, server.js absent)"

# Prepare custom migrations directory
RUN mkdir -p /app/migrations-custom-temp && \
  if [ -d "/app/packages/database/migrations-custom" ] && [ -n "$(ls -A /app/packages/database/migrations-custom/*.sql 2>/dev/null)" ]; then \
  cp /app/packages/database/migrations-custom/*.sql /app/migrations-custom-temp/; \
  fi

# ============================================================================
# Runner: Minimal production image
# ============================================================================
FROM node:20-alpine AS runner

# Install runtime dependencies
RUN apk add --no-cache postgresql-client dumb-init

# Create non-root user
RUN addgroup -g 10001 -S nodejs && \
  adduser -S nodejs -u 10001

WORKDIR /app
USER nodejs

# Copy self-contained deployment (includes hard-linked node_modules)
COPY --from=builder --chown=nodejs:nodejs /app/deploy .

# Copy configuration files needed at runtime (from build context, not builder stage)
COPY --chown=nodejs:nodejs kratos ./kratos
COPY --chown=nodejs:nodejs hydra ./hydra

# Copy migrations (SQL files not included in pnpm deploy)
COPY --from=builder --chown=nodejs:nodejs /app/packages/database/migrations-drizzle/*.sql ./migrations-drizzle/
COPY --from=builder --chown=nodejs:nodejs /app/migrations-custom-temp/ ./migrations-custom/

# Expose port
EXPOSE 4000

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]

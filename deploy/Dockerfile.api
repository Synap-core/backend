FROM node:20-alpine AS base
RUN npm install -g pnpm@10.28.0
WORKDIR /app

# ============================================================================
# Builder: Install dependencies and build
# ============================================================================
FROM base AS builder

# Build tools for native addons (e.g. node-pty via node-gyp)
RUN apk add --no-cache python3 make g++

# ── Layer 1: dependency manifests (cached unless lockfile or package.json changes) ──
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/admin-ui/package.json ./apps/admin-ui/
COPY apps/api/package.json      ./apps/api/
COPY packages/ai-embeddings/package.json ./packages/ai-embeddings/
COPY packages/ai/package.json            ./packages/ai/
COPY packages/api-types/package.json     ./packages/api-types/
COPY packages/api/package.json           ./packages/api/
COPY packages/auth/package.json          ./packages/auth/
COPY packages/core/package.json          ./packages/core/
COPY packages/database/package.json      ./packages/database/
COPY packages/events/package.json        ./packages/events/
COPY packages/feed-service/package.json  ./packages/feed-service/
COPY packages/hub-protocol/package.json  ./packages/hub-protocol/
COPY packages/intelligence-client/package.json ./packages/intelligence-client/
COPY packages/jobs/package.json          ./packages/jobs/
COPY packages/realtime/package.json      ./packages/realtime/
COPY packages/scripts/package.json       ./packages/scripts/
COPY packages/search/package.json        ./packages/search/
COPY packages/shared-utils/package.json  ./packages/shared-utils/
COPY packages/storage/package.json       ./packages/storage/
COPY packages/test-e2e/package.json      ./packages/test-e2e/
COPY packages/types/package.json         ./packages/types/

# Install all dependencies — pnpm store is cached across builds
RUN --mount=type=cache,id=pnpm-backend,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ── Layer 2: source + build (re-runs on every source change) ──
COPY . .

# Build the API package and its workspace deps (sequential to avoid worker OOM)
# @synap/database is listed explicitly so its dist/scripts/ (migrate.js, init-hub-keys.js)
# are always compiled fresh and included by pnpm deploy.
RUN --mount=type=cache,id=turbo-backend,target=/app/.turbo \
    NODE_OPTIONS=--max-old-space-size=4096 pnpm turbo build \
      --filter=api \
      --filter=@synap/database \
      --concurrency=1

# Build provision-agent script separately (standalone bundle, not affected by turbo cache)
RUN cd /app/packages/api && npx tsup --config tsup.provision.config.ts

# Build admin-ui SPA
RUN --mount=type=cache,id=vite-admin,target=/app/apps/admin-ui/.vite \
    cd apps/admin-ui && npx vite build

# Deploy API package (pnpm deploy works perfectly for single package)
RUN rm -rf /app/deploy && \
  pnpm deploy --filter=api --prod --legacy /app/deploy


# ============================================================================
# Runner: Minimal production image
# ============================================================================
FROM node:20-alpine AS runner

# Install runtime dependencies
RUN apk add --no-cache postgresql-client dumb-init

# Create non-root user
RUN addgroup -g 10001 -S nodejs && \
  adduser -S nodejs -u 10001

WORKDIR /app
USER nodejs

# Copy self-contained deployment (includes hard-linked node_modules)
COPY --from=builder --chown=nodejs:nodejs /app/deploy .

# Copy configuration files needed at runtime (from build context, not builder stage)
COPY --chown=nodejs:nodejs kratos ./kratos
COPY --chown=nodejs:nodejs hydra ./hydra

# Copy migrations (SQL files not included in pnpm deploy)
COPY --from=builder --chown=nodejs:nodejs /app/packages/database/migrations/*.sql ./migrations/

# pnpm deploy doesn't include apps/api/dist (gitignored, no "files" field)
# Copy the built server dist from the builder stage
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/dist ./dist/

# Copy missing routers from packages/api (openclaw-admin is in packages/api but not in apps/api)
COPY --from=builder --chown=nodejs:nodejs /app/packages/api/dist/routers/openclaw-admin.js ./dist/routers/

# Copy the provision-agent script (built from packages/api by the separate tsup step)
COPY --from=builder --chown=nodejs:nodejs /app/packages/api/dist/scripts ./dist/scripts/

# pnpm deploy --legacy doesn't create top-level symlinks for all packages.
# Shamefully hoist: for each .pnpm entry, link its main package to the top level if missing.
USER root
RUN pnpm_dir=/app/node_modules/.pnpm; \
    ls "$pnpm_dir" | while read entry; do \
      # Derive the package path from the .pnpm entry name
      # Scoped: @scope+name@version... → @scope/name
      # Unscoped: name@version... → name
      if echo "$entry" | grep -q "^@"; then \
        scope_part=$(echo "$entry" | sed 's/+[^@]*@.*//'); \
        name_part=$(echo "$entry" | sed 's/^[^+]*+//' | sed 's/@.*//'); \
        pkg_path="$scope_part/$name_part"; \
      else \
        pkg_path=$(echo "$entry" | sed 's/@.*//'); \
      fi; \
      target="/app/node_modules/$pkg_path"; \
      src="$pnpm_dir/$entry/node_modules/$pkg_path"; \
      if [ ! -e "$target" ] && [ -d "$src" ]; then \
        mkdir -p "$(dirname "$target")" && ln -snf "$src" "$target"; \
      fi; \
    done
USER nodejs

# Copy admin-ui static build
COPY --from=builder --chown=nodejs:nodejs /app/apps/admin-ui/dist ./admin-ui/

# Expose port
EXPOSE 4000

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]

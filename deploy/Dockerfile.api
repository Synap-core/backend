FROM node:20-alpine AS base
RUN npm install -g pnpm@10.28.0
WORKDIR /app

# ============================================================================
# Builder: Install dependencies and build
# ============================================================================
FROM base AS builder

# Copy all files for build
COPY . .

# Install all dependencies (including dev deps for building)
RUN pnpm install --no-frozen-lockfile

# Build the API package (sequential to avoid worker OOM on constrained hosts)
RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm turbo build --filter=api --concurrency=1

# Build provision-agent script separately (standalone bundle, not affected by turbo cache)
RUN cd /app/packages/api && npx tsup --config tsup.provision.config.ts

# Build admin-ui SPA
RUN cd apps/admin-ui && npx vite build

# Deploy API package (pnpm deploy works perfectly for single package)
RUN rm -rf /app/deploy && \
  pnpm deploy --filter=api --prod --legacy /app/deploy

# Prepare custom migrations directory
RUN mkdir -p /app/migrations-custom-temp && \
  if [ -d "/app/packages/database/migrations-custom" ] && [ -n "$(ls -A /app/packages/database/migrations-custom/*.sql 2>/dev/null)" ]; then \
  cp /app/packages/database/migrations-custom/*.sql /app/migrations-custom-temp/; \
  fi

# ============================================================================
# Runner: Minimal production image
# ============================================================================
FROM node:20-alpine AS runner

# Install runtime dependencies
RUN apk add --no-cache postgresql-client dumb-init

# Create non-root user
RUN addgroup -g 10001 -S nodejs && \
  adduser -S nodejs -u 10001

WORKDIR /app
USER nodejs

# Copy self-contained deployment (includes hard-linked node_modules)
COPY --from=builder --chown=nodejs:nodejs /app/deploy .

# Copy configuration files needed at runtime (from build context, not builder stage)
COPY --chown=nodejs:nodejs kratos ./kratos
COPY --chown=nodejs:nodejs hydra ./hydra

# Copy migrations (SQL files not included in pnpm deploy)
COPY --from=builder --chown=nodejs:nodejs /app/packages/database/migrations-drizzle/*.sql ./migrations-drizzle/
COPY --from=builder --chown=nodejs:nodejs /app/migrations-custom-temp/ ./migrations-custom/

# pnpm deploy doesn't include apps/api/dist (gitignored, no "files" field)
# Copy the built server dist from the builder stage
COPY --from=builder --chown=nodejs:nodejs /app/apps/api/dist ./dist/

# Copy the provision-agent script (built from packages/api by the separate tsup step)
COPY --from=builder --chown=nodejs:nodejs /app/packages/api/dist/scripts ./dist/scripts/

# pnpm deploy --legacy doesn't create top-level symlinks for all packages.
# Shamefully hoist: for each .pnpm entry, link its main package to the top level if missing.
USER root
RUN pnpm_dir=/app/node_modules/.pnpm; \
    ls "$pnpm_dir" | while read entry; do \
      # Derive the package path from the .pnpm entry name
      # Scoped: @scope+name@version... → @scope/name
      # Unscoped: name@version... → name
      if echo "$entry" | grep -q "^@"; then \
        scope_part=$(echo "$entry" | sed 's/+[^@]*@.*//'); \
        name_part=$(echo "$entry" | sed 's/^[^+]*+//' | sed 's/@.*//'); \
        pkg_path="$scope_part/$name_part"; \
      else \
        pkg_path=$(echo "$entry" | sed 's/@.*//'); \
      fi; \
      target="/app/node_modules/$pkg_path"; \
      src="$pnpm_dir/$entry/node_modules/$pkg_path"; \
      if [ ! -e "$target" ] && [ -d "$src" ]; then \
        mkdir -p "$(dirname "$target")" && ln -snf "$src" "$target"; \
      fi; \
    done
USER nodejs

# Copy admin-ui static build
COPY --from=builder --chown=nodejs:nodejs /app/apps/admin-ui/dist ./admin-ui/

# Expose port
EXPOSE 4000

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/index.js"]

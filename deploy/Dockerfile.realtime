FROM node:20-alpine AS base
RUN npm install -g pnpm@10.28.0
WORKDIR /app

# ============================================================================
# Builder: Install dependencies and build
# ============================================================================
FROM base AS builder

# Copy all files for build
COPY . .

# Install all dependencies (including dev deps for building)
RUN pnpm install --frozen-lockfile || (sleep 5 && pnpm install --frozen-lockfile) || (sleep 10 && pnpm install --frozen-lockfile)

# Build the realtime package
RUN pnpm turbo build --filter=@synap/realtime

# Verify build created server.js
RUN echo "=== Verifying build output ===" && \
    ls -la /app/packages/realtime/dist/ && \
    (test -f /app/packages/realtime/dist/server.js && echo "✓ server.js exists in build" || (echo "✗ server.js NOT found in build" && exit 1))

# Deploy realtime package dependencies (but copy dist ourselves to ensure server.js is included)
RUN rm -rf /app/deploy && \
    mkdir -p /app/deploy && \
    pnpm deploy --filter=@synap/realtime --prod --legacy /app/deploy

# CRITICAL: Copy dist directory directly from build output
# pnpm deploy might exclude server.js since it's not the main entry point
# We copy the entire dist/ to ensure all files are included
RUN echo "=== Copying dist directory ===" && \
    cp -r /app/packages/realtime/dist /app/deploy/dist && \
    echo "=== Verifying server.js after copy ===" && \
    (test -f /app/deploy/dist/server.js && echo "✓ server.js confirmed in /app/deploy/dist/" || (echo "✗ ERROR: server.js missing after copy!" && ls -la /app/deploy/dist/ && exit 1))

# ============================================================================
# Runner: Minimal production image
# ============================================================================
FROM node:20-alpine AS runner

# Install runtime dependencies
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 10001 -S nodejs && \
  adduser -S nodejs -u 10001

WORKDIR /app
USER nodejs

# Copy self-contained deployment (includes hard-linked node_modules)
COPY --from=builder --chown=nodejs:nodejs /app/deploy .

# Verify server.js exists in final image (fail build if missing)
RUN test -f /app/dist/server.js || (echo "ERROR: /app/dist/server.js not found in final image!" && ls -la /app/ && ls -la /app/dist/ 2>/dev/null || echo "dist/ does not exist" && exit 1)

# Expose port
EXPOSE 4001

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
# Same pattern as API - pnpm deploy places dist/ at root
# server.js is now guaranteed to exist after the copy step above
CMD ["node", "dist/server.js"]

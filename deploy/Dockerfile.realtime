FROM node:20-alpine AS base
RUN npm install -g pnpm@10.28.0
WORKDIR /app

# ============================================================================
# Builder: Install dependencies and build
# ============================================================================
FROM base AS builder

# Copy all files for build
COPY . .

# Install all dependencies (including dev deps for building)
RUN pnpm install --frozen-lockfile || (sleep 5 && pnpm install --frozen-lockfile) || (sleep 10 && pnpm install --frozen-lockfile)

# Build the realtime package
RUN pnpm turbo build --filter=@synap/realtime

# Verify build created server.js
RUN echo "=== Verifying build output ===" && \
    ls -la /app/packages/realtime/dist/ && \
    (test -f /app/packages/realtime/dist/server.js && echo "✓ server.js exists in build" || echo "✗ server.js NOT found in build")

# Deploy realtime package (pnpm deploy works perfectly for single package)
# Same pattern as API - pnpm deploy places package at root with dist/ folder
RUN rm -rf /app/deploy && \
    pnpm deploy --filter=@synap/realtime --prod --legacy /app/deploy

# Ensure dist directory exists and server.js is present
# pnpm deploy might not include server.js if it's not the main entry point
RUN mkdir -p /app/deploy/dist && \
    if [ -f /app/packages/realtime/dist/server.js ]; then \
      echo "Copying server.js from build output..." && \
      cp /app/packages/realtime/dist/server.js /app/deploy/dist/server.js && \
      cp /app/packages/realtime/dist/server.js.map /app/deploy/dist/server.js.map 2>/dev/null || true && \
      echo "✓ server.js copied"; \
    else \
      echo "✗ ERROR: server.js not found in build output!" && \
      ls -la /app/packages/realtime/dist/ && \
      exit 1; \
    fi

# Debug: Check what was actually created
RUN echo "=== Deploy structure ===" && \
    ls -la /app/deploy/ && \
    echo "=== dist contents ===" && \
    (ls -la /app/deploy/dist/ 2>/dev/null || echo "dist/ not found") && \
    echo "=== Finding server.js ===" && \
    find /app/deploy -name "server.js" -type f 2>/dev/null | head -10 || echo "server.js not found anywhere" && \
    (test -f /app/deploy/dist/server.js && echo "✓ server.js confirmed in deploy" || echo "✗ server.js STILL missing after copy attempt")

# ============================================================================
# Runner: Minimal production image
# ============================================================================
FROM node:20-alpine AS runner

# Install runtime dependencies
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 10001 -S nodejs && \
  adduser -S nodejs -u 10001

WORKDIR /app
USER nodejs

# Copy self-contained deployment (includes hard-linked node_modules)
COPY --from=builder --chown=nodejs:nodejs /app/deploy .

# Debug: Show what's actually in the container (for troubleshooting)
RUN echo "=== Container contents ===" && \
    ls -la /app/ && \
    echo "=== dist contents ===" && \
    (ls -la /app/dist/ 2>/dev/null || echo "dist/ not found") && \
    echo "=== Finding server.js ===" && \
    find /app -name "server.js" -type f 2>/dev/null | head -10 || echo "server.js not found"

# Expose port
EXPOSE 4001

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
# Same pattern as API - pnpm deploy places dist/ at root
# server.js is now guaranteed to exist after the copy step above
CMD ["node", "dist/server.js"]

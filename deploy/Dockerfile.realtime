FROM node:20-alpine AS base
RUN npm install -g pnpm@10.28.0
WORKDIR /app

# ============================================================================
# Builder: Install dependencies and build
# ============================================================================
FROM base AS builder

# Copy all files for build
COPY . .

# Install all dependencies (including dev deps for building)
RUN pnpm install --frozen-lockfile || (sleep 5 && pnpm install --frozen-lockfile) || (sleep 10 && pnpm install --frozen-lockfile)

# Build the realtime package with --force to bypass turbo cache
# This ensures a fresh build every time, preventing cache-related issues
RUN pnpm turbo build --filter=@synap/realtime --force

# Verify build created server.js BEFORE deploying
RUN echo "=== Verifying build output ===" && \
    ls -la /app/packages/realtime/dist/ && \
    test -f /app/packages/realtime/dist/server.js || (echo "✗ ERROR: server.js NOT found after build!" && exit 1) && \
    echo "✓ server.js exists in build output"

# Deploy realtime package (creates self-contained deployment with node_modules)
# The --legacy flag ensures dist/ is included even if not in git
RUN rm -rf /app/deploy && \
    pnpm deploy --filter=@synap/realtime --prod --legacy /app/deploy

# Verify dist/ was included in deployment
RUN echo "=== Verifying deployment ===" && \
    ls -la /app/deploy/ && \
    test -d /app/deploy/dist || (echo "✗ ERROR: dist/ not found in deployment!" && exit 1) && \
    test -f /app/deploy/dist/server.js || (echo "✗ ERROR: server.js not found in deployment!" && exit 1) && \
    echo "✓ Deployment successful with dist/server.js"

# ============================================================================
# Runner: Minimal production image
# ============================================================================
FROM node:20-alpine AS runner

# Install runtime dependencies
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 10001 -S nodejs && \
    adduser -S nodejs -u 10001

WORKDIR /app
USER nodejs

# Copy self-contained deployment (includes hard-linked node_modules and dist/)
COPY --from=builder --chown=nodejs:nodejs /app/deploy .

# Debug: Show what's actually in the container (for troubleshooting)
RUN echo "=== Container contents ===" && \
    ls -la /app/ && \
    echo "=== dist contents ===" && \
    (ls -la /app/dist/ 2>/dev/null || echo "dist/ not found") && \
    echo "=== Finding server.js ===" && \
    find /app -name "server.js" -type f 2>/dev/null | head -5 || echo "server.js not found anywhere"

# Verify server.js exists in final image (fail build if missing)
RUN test -f /app/dist/server.js || (echo "ERROR: /app/dist/server.js not found in final image!" && ls -la /app/ && ls -la /app/dist/ 2>/dev/null || echo "dist/ does not exist" && exit 1)

# Expose port
EXPOSE 4001

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
# Same pattern as API - pnpm deploy places dist/ at root
# server.js is now guaranteed to exist after the copy step above
CMD ["node", "dist/server.js"]

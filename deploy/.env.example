# Synap Backend Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# DOMAIN & SSL
# ============================================================================
# Your domain name (e.g., synap.example.com)
DOMAIN=synap.example.com

# Email for Let's Encrypt SSL certificates
LETSENCRYPT_EMAIL=admin@example.com

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL password (auto-generated by setup script)
# Use a strong random password: openssl rand -base64 32
POSTGRES_PASSWORD=

# ============================================================================
# AUTHENTICATION
# ============================================================================
# JWT secret for session tokens (auto-generated by setup script)
# Use a strong random password: openssl rand -base64 64
JWT_SECRET=

# Ory Kratos secrets (auto-generated by setup script)
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=
KRATOS_WEBHOOK_SECRET=

# ============================================================================
# STORAGE
# ============================================================================
# MinIO credentials (auto-generated by setup script)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=

# ============================================================================
# SEARCH
# ============================================================================
# Typesense API keys (auto-generated by setup script)
TYPESENSE_API_KEY=
TYPESENSE_ADMIN_API_KEY=

# ============================================================================
# JOBS
# ============================================================================
# Inngest keys (auto-generated by setup script)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ============================================================================
# AI PROVIDERS (Optional - can skip for basic deployment)
# ============================================================================
# Intelligence service API key (auto-generated by setup script)
INTELLIGENCE_API_KEY=

# AI Provider: "anthropic" | "openai" | "" (empty to disable)
AI_PROVIDER=anthropic

# Embeddings Provider: "openai" | "deterministic"
# Use "deterministic" if you don't have OpenAI API key
EMBEDDING_PROVIDER=deterministic

# Get keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Google AI: https://makersuite.google.com/app/apikey

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# Comma-separated list of allowed frontend origins.
# REQUIRED in production — without this all browser requests will be rejected.
# Example: ALLOWED_ORIGINS=https://app.synap.live,https://studio.synap.live
# The backend will refuse to start in production if this is not set.
ALLOWED_ORIGINS=https://app.${DOMAIN}

# ============================================================================
# OPTIONAL: Advanced Configuration
# ============================================================================
# Enable debug logging (true/false)
DEBUG=false

# Maximum file upload size (default: 100MB)
MAX_UPLOAD_SIZE=100MB

# Database connection pool size (default: 10)
DB_POOL_SIZE=10

# Redis max memory (default: 256mb)
REDIS_MAX_MEMORY=256mb

# ============================================================================
# SERVICE CREDENTIAL ENCRYPTION
# ============================================================================
# Required for the pod to encrypt Hub API keys and other IS credentials at rest.
# REQUIRED for Control Plane provisioning (POST /api/provision/register-intelligence).
# Without this, intelligence service registration will fail with a 500.
#
# Generate: openssl rand -hex 32
# Keep it secret — rotating this key will invalidate stored IS credentials
# (re-provision the intelligence service to recover).
SYNAP_SERVICE_ENCRYPTION_KEY=         # [REQUIRED for CP/Hub provisioning]

# ============================================================================
# VAULT (server-side add-on credential encryption)
# ============================================================================
# Required for storing OpenClaw / ZeroClaw bootstrap credentials so that
# services can self-configure on startup via intelligenceRegistry.getServiceConfig
# instead of requiring manual env-var copy-paste.
#
# Generate: openssl rand -hex 32
# Must be a 64-character hex string (32 bytes raw). Keep it secret — rotating
# this key will invalidate all stored service secrets (re-provision to recover).
VAULT_SERVER_KEY=                     # [REQUIRED for add-on provisioning]

# ============================================================================
# OPTIONAL: Control Plane Integration
# ============================================================================
# Required for Synap-managed pods (provisioned via app.synap.live).
# Leave empty for fully self-hosted deployments.
#
# CONTROL_PLANE_URL — only required for Synap-managed pods.
#   The pod fetches /.well-known/jwks.json from this URL to verify ES256 JWTs
#   issued by the Control Plane (handshake tokens, provision tokens).
#   Leave empty for fully self-hosted deployments.
CONTROL_PLANE_URL=https://api.synap.live

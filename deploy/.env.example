# Synap Backend Configuration Template
# Copy this file to .env and fill in your values

# ============================================================================
# DOMAIN & SSL
# ============================================================================
# Your domain name (e.g., synap.example.com)
DOMAIN=synap.example.com

# Email for Let's Encrypt SSL certificates
LETSENCRYPT_EMAIL=admin@example.com

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL password (auto-generated by setup script)
# Use a strong random password: openssl rand -base64 32
POSTGRES_PASSWORD=

# ============================================================================
# AUTHENTICATION
# ============================================================================
# JWT secret for session tokens (auto-generated by setup script)
# Use a strong random password: openssl rand -base64 64
JWT_SECRET=

# Ory Kratos secrets (auto-generated by setup script)
KRATOS_SECRETS_COOKIE=
KRATOS_SECRETS_CIPHER=
KRATOS_WEBHOOK_SECRET=

# ============================================================================
# STORAGE
# ============================================================================
# MinIO credentials (auto-generated by setup script)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=

# ============================================================================
# SEARCH
# ============================================================================
# Typesense API keys (auto-generated by setup script)
TYPESENSE_API_KEY=
TYPESENSE_ADMIN_API_KEY=

# ============================================================================
# JOBS
# ============================================================================
# Inngest keys (auto-generated by setup script)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ============================================================================
# AI PROVIDERS (Optional - can skip for basic deployment)
# ============================================================================
# Intelligence service API key (auto-generated by setup script)
INTELLIGENCE_API_KEY=

# Intelligence Service (IS) connection — for knowledge synthesis (synap_ask).
# INTELLIGENCE_HUB_URL: where the IS lives, e.g. http://10.10.0.20:3001
# INTELLIGENCE_HUB_INTERNAL_KEY: X-Internal-Key for the IS /internal/* +
#   /api/knowledge/answer routes. MUST equal the IS's INTELLIGENCE_HUB_INTERNAL_KEY,
#   else synthesis 401s (synap_ask returns sources but answer:null, synthesis_unavailable).
INTELLIGENCE_HUB_URL=
INTELLIGENCE_HUB_INTERNAL_KEY=

# Shared secret for the loopback /internal/* endpoints (mail-feed + event-sync
# run, signal route). REQUIRED to enable the mail-feed / event-sync features —
# the endpoints fail closed (503) without it. Generate: openssl rand -hex 32
BRIDGE_SECRET=

# AI Provider: "anthropic" | "openai" | "" (empty to disable)
AI_PROVIDER=anthropic

# Embeddings Provider: "openai" | "deterministic"
# Use "deterministic" if you don't have OpenAI API key
EMBEDDING_PROVIDER=deterministic

# Get keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Google AI: https://makersuite.google.com/app/apikey

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ============================================================================
# CORS — no origin whitelist.
# ============================================================================
# The backend is the pod's security boundary (Kratos sessions, Bearer tokens,
# SameSite cookies, in-handler authorization). CORS headers are emitted open —
# any origin, with credentials — and auth decides what gets returned.
# Nothing to configure here.

# ============================================================================
# OPTIONAL: Advanced Configuration
# ============================================================================
# Enable debug logging (true/false)
DEBUG=false

# Maximum file upload size (default: 100MB)
MAX_UPLOAD_SIZE=100MB

# Database connection pool size (default: 10)
DB_POOL_SIZE=10

# Redis max memory (default: 256mb)
REDIS_MAX_MEMORY=256mb

# ============================================================================
# SERVICE CREDENTIAL ENCRYPTION
# ============================================================================
# Required for the pod to encrypt Hub API keys and other IS credentials at rest.
# REQUIRED for Control Plane provisioning (POST /api/provision/register-intelligence).
# Without this, intelligence service registration will fail with a 500.
#
# Generate: openssl rand -hex 32
# Keep it secret — rotating this key will invalidate stored IS credentials
# (re-provision the intelligence service to recover).
SYNAP_SERVICE_ENCRYPTION_KEY=         # [REQUIRED for CP/Hub provisioning]

# ============================================================================
# VAULT (server-side add-on credential encryption)
# ============================================================================
# Required for storing OpenClaw / ZeroClaw bootstrap credentials so that
# services can self-configure on startup via intelligenceRegistry.getServiceConfig
# instead of requiring manual env-var copy-paste.
#
# Generate: openssl rand -hex 32
# Must be a 64-character hex string (32 bytes raw). Keep it secret — rotating
# this key will invalidate all stored service secrets (re-provision to recover).
VAULT_SERVER_KEY=                     # [REQUIRED for add-on provisioning]

# Service-to-service auth key for the external channel gateway REST API
# Generate: openssl rand -hex 32
# CHANNEL_GATEWAY_KEY=

# ============================================================================
# SELF-HOSTED AGENT SETUP
# ============================================================================
# Required for setup-openclaw.sh and other self-hosted agent provisioning.
#
# Used by:
#   - deploy/setup-openclaw.sh — bootstraps OpenClaw against this pod.
#   - The Eve CLI (hestia-cli) — `eve install` / `eve auth provision` reads
#     this value and calls POST /api/hub/setup/agent for each agent it
#     manages (eve, openclaw, hermes, openwebui-pipelines). Each call mints
#     a separate per-agent Hub key with its own audit trail.
#   - Any other co-located tool that needs to provision agent users on
#     this pod without going through the Control Plane.
#
# Treat this like a master admin password: anyone with PROVISIONING_TOKEN
# can mint Hub keys for arbitrary agentTypes. Keep it out of git, logs,
# and shared secrets stores.
#
# Generate: openssl rand -hex 32
PROVISIONING_TOKEN=

  # ============================================================================
  # OPTIONAL: Control Plane Integration
  # ============================================================================
  # Required for Synap-managed pods (provisioned via app.synap.live).
  # Leave empty for fully self-hosted deployments.
  #
  # CONTROL_PLANE_URL — only required for Synap-managed pods.
  #   The pod fetches /.well-known/jwks.json from this URL to verify ES256 JWTs
  #   issued by the Control Plane (handshake tokens, provision tokens).
  #   Leave empty for fully self-hosted deployments.
  CONTROL_PLANE_URL=https://api.synap.live

  # ============================================================================
  # OPTIONAL: RSS Feed Provider Configuration
  # ============================================================================
  # Choose your RSS feed provider:
  #   - direct:     Fetch RSS feeds directly (no aggregation service)
  #   - rsshub:     Self-hosted RSSHub instance (requires --profile rsshub)
  #   - cpproxy:    Control Plane RSSHub proxy (default, SaaS only)
  #   - custom:     Custom RSSHub instance (set RSSHUB_URL)
  #
  RSS_PROVIDER_TYPE=cpproxy

  # For RSSHub provider (when RSS_PROVIDER_TYPE=rsshub or custom)
  # URL of your RSSHub instance (default: http://rsshub:1200 for Docker network)
  RSSHUB_URL=http://rsshub:1200

  # Access key for RSSHub instance (optional but recommended for security)
  # Generate: openssl rand -hex 16
  RSSHUB_ACCESS_KEY=

  # For CP Proxy provider (when RSS_PROVIDER_TYPE=cpproxy)
  # URL of the Control Plane RSSHub proxy endpoint
  CP_RSSHUB_PROXY_URL=https://api.synap.live/api/rsshub-proxy

  # RSS fetch configuration
  RSS_FETCH_TIMEOUT_MS=30000
  RSS_FETCH_RETRIES=3

# ── Nango (OAuth proxy for third-party connections) ──────────────────────────
NANGO_HOST=
NANGO_SECRET_KEY=

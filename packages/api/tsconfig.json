{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "paths": {
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "__tests__"],
  "references": [
    {
      "path": "../search"
    },
    {
      "path": "../database"
    },
    {
      "path": "../events"
    },
    {
      "path": "../jobs"
    },
    {
      "path": "../ai"
    },
    {
      "path": "../storage"
    },
    {
      "path": "../auth"
    }
  ]
}

{
  "name": "@synap/api",
  "version": "1.0.5",
  "description": "Synap API Router - tRPC types and router for Data Pod",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types/feed-config": {
      "types": "./dist/types/feed-config.d.ts",
      "import": "./dist/types/feed-config.js",
      "default": "./dist/types/feed-config.js"
    },
    "./services/DeliveryService": {
      "types": "./dist/services/DeliveryService.d.ts",
      "import": "./dist/services/DeliveryService.js",
      "default": "./dist/services/DeliveryService.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "export $(grep -v '^#' ../../.env | xargs) && tsx watch src/index.ts",
    "start": "export $(grep -v '^#' ../../.env | xargs) && tsx src/index.ts",
    "build": "node ../../skills/build.mjs && rm -rf dist && tsc -p tsconfig.types.json && tsup && pnpm gen-types",
    "gen-types": "node scripts/gen-types.mjs",
    "gen-types:check": "node scripts/gen-types.mjs && git diff --exit-code -- ../api-types/src/generated.d.ts",
    "gen-docs": "node scripts/gen-sdk-docs.mjs",
    "gen-api-docs": "node scripts/gen-api-docs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "provision": "export $(grep -v '^#' ../../.env | xargs) && tsx src/scripts/provision.ts",
    "provision-agent": "export $(grep -v '^#' ../../.env | xargs) && tsx src/scripts/provision-agent.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.926.0",
    "@hono/node-server": "^1.19.12",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/trpc-server": "^0.3.2",
    "@hono/zod-openapi": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@synap-core/core": "workspace:*",
    "@synap-core/hub-protocol": "workspace:*",
    "@synap-core/types": "workspace:*",
    "@synap/ai": "workspace:*",
    "@synap/ai-embeddings": "workspace:*",
    "@synap/auth": "workspace:*",
    "@synap/capability-gate": "workspace:*",
    "@synap/database": "workspace:*",
    "@synap/events": "workspace:*",
    "@synap/feed-service": "workspace:*",
    "@synap/governance-policy": "workspace:*",
    "@synap/playbooks": "workspace:*",
    "@synap/intelligence-client": "workspace:*",
    "@synap/jobs": "workspace:*",
    "@synap/search": "workspace:*",
    "@synap/shared-utils": "workspace:*",
    "@synap/storage": "workspace:*",
    "@trpc/server": "^11.8.1",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "0.8.3",
    "esbuild": "^0.25.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.10",
    "jsonwebtoken": "^9.0.2",
    "postgres": "^3.4.8",
    "superjson": "^2.2.6",
    "ws": "^8.18.3",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@trpc/react-query": "^11.8.1",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.8",
    "@vitest/coverage-v8": "^4.0.15",
    "dts-bundle-generator": "^9.5.1",
    "react": "^19.2.3",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/synap/synap.git",
    "directory": "packages/api"
  },
  "keywords": [
    "synap",
    "api",
    "trpc",
    "router"
  ],
  "license": "MIT"
}

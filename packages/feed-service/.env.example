/**
 * Feed Service Environment Variables
 *
 * This file documents all environment variables required for the feed service.
 * Copy these to your .env file and configure as needed.
 *
 * @module feed-service-env
 */

// ============================================================================
// Required Variables
// ============================================================================

/**
 * RSS Provider Type
 * Determines the default provider for fetching RSS feeds.
 * Options: direct | rsshub | cpproxy | custom
 * Default: direct
 */
RSS_PROVIDER_TYPE=direct

/**
 * RSSHub URL
 * Required when RSS_PROVIDER_TYPE=rsshub
 * URL of the RSSHub instance
 */
RSSHUB_URL=https://rsshub.app

/**
 * RSSHub Access Key
 * Optional access key for restricted RSSHub routes
 */
RSSHUB_ACCESS_KEY=

/**
 * Control Plane RSSHub Proxy URL
 * Required when RSS_PROVIDER_TYPE=cpproxy
 * URL of the CP-managed RSSHub proxy
 */
CP_RSSHUB_PROXY_URL=https://feeds.synap.io

// ============================================================================
// Fetch Configuration
// ============================================================================

/**
 * RSS Fetch Timeout
 * Timeout for RSS feed fetch operations in milliseconds
 * Default: 30000 (30 seconds)
 */
RSS_FETCH_TIMEOUT_MS=30000

/**
 * RSS Fetch Retries
 * Number of retry attempts for failed fetches
 * Default: 3
 */
RSS_FETCH_RETRIES=3

/**
 * Max Items Per Fetch
 * Maximum number of items to fetch per feed request
 * Default: 100
 */
RSS_MAX_ITEMS_PER_FETCH=100

/**
 * Max Concurrent Fetches
 * Maximum number of concurrent feed fetches
 * Default: 10
 */
RSS_MAX_CONCURRENT_FETCHES=10

/**
 * User Agent String
 * User agent sent with HTTP requests
 * Default: SynapFeedService/1.0
 */
RSS_USER_AGENT=SynapFeedService/1.0

// ============================================================================
// Classification Configuration
// ============================================================================

/**
 * Default Classifier Type
 * Default classifier for feed items
 * Options: is | keyword | noop
 * Default: keyword
 */
DEFAULT_CLASSIFIER_TYPE=keyword

/**
 * IS Classification Service URL
 * Required when using IS classifier
 * URL of the Intelligence Hub service
 */
INTELLIGENCE_HUB_URL=https://is.synap.io

/**
 * IS Classification API Key
 * Required when using IS classifier
 * API key for IS authentication
 */
INTELLIGENCE_HUB_API_KEY=

/**
 * Classification Minimum Confidence
 * Minimum confidence threshold for classifications (0-1)
 * Default: 0.5
 */
CLASSIFICATION_MIN_CONFIDENCE=0.5

/**
 * Classification Minimum Relevance Score
 * Minimum relevance score for items to be published (0-1)
 * Default: 0.3
 */
CLASSIFICATION_MIN_RELEVANCE=0.3

// ============================================================================
// Publishing Configuration
// ============================================================================

/**
 * Publishing Batch Size
 * Number of items to publish in a batch
 * Default: 10
 */
PUBLISH_BATCH_SIZE=10

/**
 * Publishing Rate Limit
 * Maximum items to publish per minute
 * Default: 60
 */
PUBLISH_RATE_LIMIT_PER_MINUTE=60

/**
 * Deduplication Enabled
 * Whether to enable deduplication of feed items
 * Default: true
 */
DEDUPLICATION_ENABLED=true

/**
 * Deduplication Window Hours
 * How long to track seen URLs for deduplication
 * Default: 24
 */
DEDUPLICATION_WINDOW_HOURS=24

// ============================================================================
// Scheduling Configuration
// ============================================================================

/**
 * Default Poll Interval Minutes
 * Default interval between feed fetches
 * Default: 60
 */
DEFAULT_POLL_INTERVAL_MINUTES=60

/**
 * Scheduler Enabled
 * Whether the feed scheduler is enabled
 * Default: true
 */
SCHEDULER_ENABLED=true

/**
 * Scheduler Cron Expression
 * Cron expression for scheduler runs
 * Default: * * * * * (every minute)
 */
SCHEDULER_CRON=* * * * *

// ============================================================================
// Cache Configuration
// ============================================================================

/**
 * Classification Cache Size
 * Maximum number of items in classification cache
 * Default: 10000
 */
CLASSIFICATION_CACHE_SIZE=10000

/**
 * Classification Cache TTL Minutes
 * Time-to-live for classification cache entries
 * Default: 60
 */
CLASSIFICATION_CACHE_TTL_MINUTES=60

/**
 * Topic Cache Size
 * Maximum number of items in topic cache
 * Default: 5000
 */
TOPIC_CACHE_SIZE=5000

/**
 * Topic Cache TTL Minutes
 * Time-to-live for topic cache entries
 * Default: 30
 */
TOPIC_CACHE_TTL_MINUTES=30

// ============================================================================
// Feature Flags
// ============================================================================

/**
 * Enable Full Content Extraction
 * Whether to fetch full article content
 * Default: false
 */
ENABLE_FULL_CONTENT_EXTRACTION=false

/**
 * Enable Media Attachments
 * Whether to include media attachments
 * Default: false
 */
ENABLE_MEDIA_ATTACHMENTS=false

/**
 * Enable Engagement Tracking
 * Whether to track user engagement
 * Default: true
 */
ENABLE_ENGAGEMENT_TRACKING=true

/**
 * Enable Fallback Classification
 * Whether to use fallback classification when IS fails
 * Default: true
 */
ENABLE_FALLBACK_CLASSIFICATION=true

// ============================================================================
// Development/Debugging
// ============================================================================

/**
 * Feed Service Log Level
 * Logging level for feed service
 * Options: debug | info | warn | error
 * Default: info
 */
FEED_LOG_LEVEL=info

/**
 * Feed Service Debug Mode
 * Enable debug logging and additional diagnostics
 * Default: false
 */
FEED_DEBUG_MODE=false

/**
 * Mock RSS Responses
 * Use mock RSS responses for testing (development only)
 * Default: false
 */
MOCK_RSS_RESPONSES=false

// ============================================================================
// Integration Testing
// ============================================================================

/**
 * Test RSS Feed URL
 * URL for integration testing
 * Default: https://rss.cnn.com/rss/edition.rss
 */
TEST_RSS_URL=https://rss.cnn.com/rss/edition.rss

/**
 * Test RSSHub Route
 * Route for RSSHub integration testing
 * Default: /youtube/user/@example
 */
TEST_RSSHUB_ROUTE=/youtube/user/@example

/**
 * Integration Test Timeout
 * Timeout for integration tests in milliseconds
 * Default: 60000
 */
INTEGRATION_TEST_TIMEOUT_MS=60000

// ============================================================================
// Migration
// ============================================================================

/**
 * Migration Batch Size
 * Number of channels to process per batch during migration
 * Default: 100
 */
MIGRATION_BATCH_SIZE=100

/**
 * Migration Dry Run
 * Run migration without making changes (for testing)
 * Default: false
 */
MIGRATION_DRY_RUN=false

// ============================================================================
// Security
// ============================================================================

/**
 * Allowed Feed Domains
 * Comma-separated list of allowed feed domains (empty = allow all)
 * Example: example.com,news.site.org
 */
ALLOWED_FEED_DOMAINS=

/**
 * Blocked Feed Domains
 * Comma-separated list of blocked feed domains
 * Example: spam.com,malicious.net
 */
BLOCKED_FEED_DOMAINS=

/**
 * Feed Webhook Secret
 * Secret for verifying feed webhook signatures
 */
FEED_WEBHOOK_SECRET=

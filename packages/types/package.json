{
  "name": "@synap-core/types",
  "version": "1.12.0",
  "description": "Shared TypeScript types and Zod schemas for the Synap platform",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/synap/synap.git",
    "directory": "packages/types"
  },
  "keywords": [
    "synap",
    "types",
    "typescript",
    "zod",
    "drizzle"

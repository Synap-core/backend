    "./projection": {
      "types": "./dist/projection/index.d.ts",
      "import": "./dist/projection/index.js"
    },
    "./capture-routing": {
      "types": "./dist/capture-routing-types.d.ts",
      "import": "./dist/capture-routing-types.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/verify-exports.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "0.8.3",
    "yjs": "^13.6.11",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@synap-core/core": "workspace:*",
    "@synap/database": "workspace:*",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0"
  }

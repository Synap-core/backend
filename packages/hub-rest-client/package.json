{
  "name": "@synap-core/hub-rest-client",
  "version": "1.1.1",
  "description": "Zero-dependency TypeScript client for the Synap Hub Protocol REST API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@synap-core/types": "workspace:*"
  },
  "keywords": [
    "synap",
    "hub-protocol",
    "rest",
    "client"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/synaptik-ai/synap.git",
    "directory": "packages/hub-rest-client"
  },
  "publishConfig": {
    "access": "public"
  }
}

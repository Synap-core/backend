{
  "name": "@synap/database",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./agent-governance": {
      "types": "./dist/utils/resolve-agent-governance-decision.d.ts",
      "import": "./dist/utils/resolve-agent-governance-decision.js",
      "default": "./dist/utils/resolve-agent-governance-decision.js"
    },
    "./governance-rule-provenance": {
      "types": "./dist/utils/governance-rule-provenance.d.ts",
      "import": "./dist/utils/governance-rule-provenance.js",
      "default": "./dist/utils/governance-rule-provenance.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:studio": "tsx ./node_modules/drizzle-kit/bin.cjs studio",
    "migrate": "tsx src/scripts/migrate.ts",
    "schema:check": "tsx src/scripts/check-schema-coherence.ts",
    "conversions": "tsx src/scripts/run-conversions.ts",
    "rebuild-property-index": "tsx src/scripts/rebuild-property-index.ts",
    "backfill:default-sources-edges": "tsx src/scripts/backfill-default-sources-edges.ts"
  },
  "dependencies": {
    "@synap-core/core": "workspace:*",
    "@synap/governance-policy": "workspace:*",
    "@synap/storage": "workspace:*",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "0.8.3",
    "pgvector": "^0.2.1",
    "postgres": "^3.4.7",
    "tsx": "^4.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.8",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.15"
  },
  "publishConfig": {
    "access": "public"
  }
}

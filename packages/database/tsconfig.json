{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    // DOM supplies a complete `Response`. Without it, `fetch` is typed by
    // @types/node, whose `Response` collapses to `{}` whenever any other
    // type in the compile declares a global `onmessage` — which happened in
    // the Docker install (ok/status "do not exist"). Same choice as packages/api.
    "lib": ["ES2022", "DOM"],
    "rootDir": "./src",
    "skipLibCheck": true,
    "declaration": true,
    // No `preserveSymlinks`: with it, a project that references this one
    // (api, capability-gate) resolves `@synap-core/types` from database's files
    // to a SECOND copy (database/node_modules/@synap-core/types), and api's
    // declaration emit cannot name a column type that comes from types
    // (TS2742 on coreRouter, "@synap/database/node_modules/@synap-core/types").
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**"
  ]
}

{
  "name": "@synap-core/field-crypto",
  "version": "0.1.0",
  "description": "One field-encryption envelope for Synap (AES-256-GCM, versioned keyring, AAD-bound)",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/synap/synap.git",
    "directory": "packages/field-crypto"
  },
  "keywords": [
    "synap",
    "encryption",
    "aes-gcm",
    "keyring"
  ],
  "author": "Synap Team",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "test-vectors.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-vectors.json": "./test-vectors.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:vectors": "node scripts/gen-test-vectors.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}

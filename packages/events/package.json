{
  "name": "@synap/events",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./realtime-schemas": {
      "types": "./dist/realtime-schemas.d.ts",
      "import": "./dist/realtime-schemas.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "generate": "tsx src/generator.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@synap-core/core": "workspace:*",
    "@synap-core/types": "workspace:*",
    "@synap/database": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "0.8.3",
    "pg-boss": "^10.1.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.7"
  }
}

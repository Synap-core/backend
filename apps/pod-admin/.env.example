# ─────────────────────────────────────────────────────────────────────────────
# Pod Admin — environment variables
# Copy this file to `.env.local` (or set in your deploy environment).
# ─────────────────────────────────────────────────────────────────────────────

# URL of the pod this admin console manages. Required.
#
# - `NEXT_PUBLIC_POD_URL` is browser-visible — used by tRPC client + Kratos
#   self-service redirects.
# - `POD_URL` (server-only) is read by middleware for `/sessions/whoami` +
#   `/trpc/sync.getStatus` server-side calls. If unset it falls back to
#   `NEXT_PUBLIC_POD_URL`.
#
# Dev: pod runs on :4000, this app runs on :4040.
NEXT_PUBLIC_POD_URL=http://localhost:4000
# POD_URL=http://localhost:4000

# Studio URL — used by deep links from the Workspaces tab. Optional;
# defaults to https://studio.synap.live.
# NEXT_PUBLIC_STUDIO_URL=http://localhost:3002

# Synap Backend API - Environment Configuration
# These variables are typically set via docker-compose, but can be overridden here for local development.

# ============================================================================
# RSS Feed Provider Configuration
# ============================================================================
# Choose your RSS feed provider:
#   - direct:     Fetch RSS feeds directly (no aggregation service)
#   - rsshub:     Self-hosted RSSHub instance (requires Docker profile)
#   - cpproxy:    Control Plane RSSHub proxy (default for managed pods)
#   - custom:     Custom RSSHub instance (set RSSHUB_URL)
#
RSS_PROVIDER_TYPE=cpproxy

# For RSSHub provider (when RSS_PROVIDER_TYPE=rsshub or custom)
# URL of your RSSHub instance
RSSHUB_URL=http://localhost:1200

# Access key for RSSHub instance (optional but recommended)
RSSHUB_ACCESS_KEY=

# For CP Proxy provider (when RSS_PROVIDER_TYPE=cpproxy)
# URL of the Control Plane RSSHub proxy endpoint
CP_RSSHUB_PROXY_URL=https://api.synap.live/api/rsshub-proxy

# RSS fetch configuration
RSS_FETCH_TIMEOUT_MS=30000
RSS_FETCH_RETRIES=3

# ============================================================================
# Core Backend Configuration (usually from root .env)
# ============================================================================
# NODE_ENV=development
# PORT=4000
# DATABASE_URL=postgresql://synap:password@localhost:5432/synap
# JWT_SECRET=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

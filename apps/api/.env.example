# Synap Backend API - Environment Configuration
# These variables are typically set via docker-compose, but can be overridden here for local development.

# ============================================================================
# RSS Feed Provider Configuration
# ============================================================================
# Choose your RSS feed provider:
#   - direct:     Fetch RSS feeds directly (no aggregation service)
#   - custom:     Custom provider (add via SourceProviderRegistry)
#
RSS_PROVIDER_TYPE=direct

# RSS fetch configuration
RSS_FETCH_TIMEOUT_MS=30000
RSS_FETCH_RETRIES=3

# RSS fetch configuration
RSS_FETCH_TIMEOUT_MS=30000
RSS_FETCH_RETRIES=3

# ============================================================================
# Core Backend Configuration (usually from root .env)
# ============================================================================
# NODE_ENV=development
# PORT=4000
# DATABASE_URL=postgresql://synap:password@localhost:5432/synap
# JWT_SECRET=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

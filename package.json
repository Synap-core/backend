{
  "name": "synap-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Synap - Event-Sourced Knowledge Backend",
  "scripts": {
    "dev": "pnpm --filter api dev",
    "dev:all": "pnpm --filter api --filter @synap/realtime dev",
    "dev:realtime": "pnpm --filter @synap/realtime dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:floor": "node scripts/test-floor.mjs",
    "test:floor:record": "node scripts/test-floor.mjs --record",
    "tripwires": "node scripts/tripwires.mjs",
    "test:e2e": "pnpm --filter @synap/test-e2e test",
    "test:e2e:watch": "pnpm --filter @synap/test-e2e test:watch",
    "test:system": "pnpm build && tsx scripts/test-system.ts",
    "db:migrate": "tsx --env-file=.env.development.local packages/database/scripts/migrate.ts",
    "db:migrate:remote": "tsx --env-file=.env.development.remote packages/database/scripts/migrate.ts",
    "db:studio": "cd packages/database && pnpm drizzle-kit studio",
    "create:hub-client": "tsx scripts/create-hub-client.ts",
    "typecheck": "turbo run typecheck",
    "publish:packages": "./scripts/publish-packages.sh",
    "publish:packages:dry-run": "./scripts/publish-packages.sh --dry-run",
    "contracts:publish": "node scripts/contracts-publish.mjs",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "run-ci": "run-s lint typecheck test build",
    "prepare": "husky",
    "postinstall": "husky || true",
    "lint:staged": "lint-staged",
    "smoke:firewall": "node smoke/verify-firewall.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "@ory/hydra-client": "^2.2.1",
    "@synap-core/core": "workspace:*",
    "@vitest/ui": "^4.1.10",
    "dotenv-cli": "^7.4.4",
    "dts-bundle-generator": "9.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@trpc/server": "^11.16.0",
      "drizzle-orm": "^0.45.2",
      "drizzle-zod": "0.8.3",
      "zod": "4.3.6",
      "zod-to-json-schema": "3.23.2",
      "axios": ">=1.15.2",
      "fast-xml-parser": ">=5.5.6",
      "socket.io-parser": ">=4.2.6",
      "path-to-regexp": ">=8.4.0",
      "protobufjs": ">=8.4.1",
      "picomatch@<3": ">=2.3.2",
      "picomatch@>=4 <4.0.4": ">=4.0.4",
      "fast-uri": ">=3.1.2",
      "langsmith": ">=0.6.0",
      "@grpc/grpc-js": ">=1.14.4",
      "form-data": ">=4.0.6",
      "ws": ">=8.21.0",
      "minimatch": ">=9.0.7",
      "fast-xml-builder": ">=1.1.7",
      "hono": ">=4.12.25"
    },
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild",
      "leveldown",
      "node-pty",
      "protobufjs",
      "sharp",
      "workerd"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-7h2j-956f-4vf2",
        "GHSA-3ppc-4f35-3m26",
        "GHSA-7r86-cg39-jmmj",
        "GHSA-23c5-xmqv-rm74",
        "GHSA-c2c7-rcm5-vvqj"
      ]
    }
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "dependencies": {
    "prettier": "^3.9.6"
  }
}

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Emitted JS/declarations in src (build must output to dist only; prevent accidental commit)
**/src/**/*.js
**/src/**/*.d.ts
**/src/**/*.js.map
**/src/**/*.d.ts.map

# Local dev secrets — never commit
.env
.env.local
.env.*.local
.env.test
.env.development

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Database
*.db
*.db-shm
*.db-wal

# Testing
coverage/
.nyc_output/

.turbo/

# Self-hosting deployment
deploy/.env
deploy/.secrets-backup.txt
deploy/backups/
# Local Caddyfile overrides (e.g. Cloudflare Tunnel, custom routing)
deploy/Caddyfile.local

# Kratos config - always generated by CLI, never committed
kratos/kratos.yml
kratos/kratos.yml.template
kratos/kratos.yml.backup
kratos/kratos.yml.*

# MinIO runtime data (never source-controlled)
data/
**/.minio.sys/

# Cloudflare Wrangler build artifacts
.wrangler/

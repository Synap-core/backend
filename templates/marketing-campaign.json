      "icon": "user-plus",
      "color": "#06B6D4",
      "properties": [
        {
          "slug": "lead-stage",
          "valueType": "string",
          "label": "Stage",
          "enumValues": [
            "new",
            "contacted",
            "interested",
            "qualified",
            "demo",
            "proposal",
            "converted",
            "lost"
          ],
          "inputType": "select",
          "constraints": {
            "defaultValue": "new"
          }
        },
        {
          "slug": "lead-source",
          "valueType": "string",
          "label": "Source",
          "enumValues": [
            "organic",
            "referral",
            "social",
            "email",
            "event",
            "paid",
            "content",
            "partnership",
            "other"
          ],
          "inputType": "select"
        },
        {
          "slug": "lead-email",
          "valueType": "string",
          "label": "Email"
        },
        {
          "slug": "lead-company",
          "valueType": "string",
          "label": "Company"
        },
        {
          "slug": "lead-title",
          "valueType": "string",
          "label": "Title"
        },
        {
          "slug": "lead-linkedin",
          "valueType": "string",
          "label": "LinkedIn"
        },
        {
          "slug": "lead-score",
          "valueType": "number",
          "label": "Lead Score"
        },
        {
          "slug": "lead-campaign",
          "valueType": "entity_id",
          "targetProfileSlug": "campaign",
          "label": "Campaign"
        },
        {
          "slug": "lead-last-contacted",
          "valueType": "date",
          "label": "Last Contacted"
        },
        {
          "slug": "lead-notes",
          "valueType": "string",
          "label": "Notes"
        },
        {
          "slug": "lead-ai-summary",
          "valueType": "string",
          "label": "AI Summary"
        }
      ]
    },
    {
      "slug": "campaign-activity",
      "description": "An activity or touchpoint in a campaign — email sent, event attended, post published",
      "icon": "activity",
      "color": "#8B5CF6",
      "properties": [
        {
          "slug": "activity-type",
          "valueType": "string",
          "label": "Type",
          "enumValues": [
            "email",
            "social-post",
            "event",
            "call",
            "meeting",
            "demo",
            "proposal-sent",
            "follow-up",
            "other"
          ],
          "inputType": "select"
        },
        {
          "slug": "activity-campaign",
          "valueType": "entity_id",
          "targetProfileSlug": "campaign",
          "label": "Campaign"
        },
        {
          "slug": "activity-lead",
          "valueType": "entity_id",
          "targetProfileSlug": "lead",
          "label": "Lead"
        },
        {
          "slug": "activity-date",
          "valueType": "date",
          "label": "Date"
        },
        {
          "slug": "activity-outcome",
          "valueType": "string",
          "label": "Outcome",
          "enumValues": ["positive", "neutral", "negative", "no-response"],
          "inputType": "select"
        },
        {
          "slug": "activity-notes",
          "valueType": "string",
          "label": "Notes"
        }
      ]
    }
  ],
  "views": [
    {
      "slug": "campaign-pipeline",
      "name": "Campaign Pipeline",
      "type": "kanban",
      "scopeProfileSlug": "campaign",
      "groupBy": "campaign-status",
      "sortBy": "createdAt",
      "sortDirection": "desc"
    },
    {
      "slug": "lead-pipeline",
      "name": "Lead Pipeline",
      "type": "kanban",
      "scopeProfileSlug": "lead",
      "groupBy": "lead-stage",
      "sortBy": "createdAt",
      "sortDirection": "desc"

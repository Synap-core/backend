{
  "_meta": {
    "slug": "marketing-campaign",
    "icon": "megaphone",
    "color": "#E91E8C",
    "tags": ["marketing", "crm", "outreach", "leads", "campaigns"],
    "requiredTier": null,
    "isPublic": true
  },
  "workspaceName": "Marketing Campaign OS",
  "description": "Track leads, manage campaigns, and let AI help run your outreach. Contacts, pipeline, tasks, and AI briefings — all connected.",
  "icon": "megaphone",
  "color": "#E91E8C",
  "profiles": [
    {
      "slug": "campaign",
      "description": "A marketing campaign — email, social, event, content, or partnership",
      "icon": "megaphone",
      "color": "#E91E8C",
      "properties": [
        {
          "slug": "campaign-status",
          "valueType": "string",
          "label": "Status",
          "enumValues": [
            "planning",
            "active",
            "paused",
            "completed",
            "cancelled"
          ],
          "inputType": "select",
          "constraints": {
            "defaultValue": "planning"
          }
        },
        {
          "slug": "campaign-channel",
          "valueType": "string",
          "label": "Channel",
          "enumValues": [
            "email",
            "social",
            "event",
            "content",
            "partnership",
            "paid",
            "organic",
            "other"
          ],
          "inputType": "select"
        },
        {
          "slug": "campaign-goal",
          "valueType": "string",
          "label": "Goal"
        },
        {
          "slug": "campaign-target-audience",
          "valueType": "string",
          "label": "Target Audience"
        },
        {
          "slug": "campaign-start-date",
          "valueType": "date",
          "label": "Start Date"
        },
        {
          "slug": "campaign-end-date",
          "valueType": "date",
          "label": "End Date"
        },
        {
          "slug": "campaign-budget",
          "valueType": "number",
          "label": "Budget (€)"
        },
        {
          "slug": "campaign-lead-count",
          "valueType": "number",
          "label": "Lead Count"
        },
        {
          "slug": "campaign-conversion-rate",
          "valueType": "number",
          "label": "Conversion Rate (%)"
        },
        {
          "slug": "campaign-notes",
          "valueType": "string",
          "label": "Notes"
        }
      ]
    },
    {
      "slug": "lead",

  "sidebarItems": ["dashboard", "chat", "library"],
  "bentoLayout": {
    "blocks": [
      {
        "kind": "widget",
        "widgetKind": "stat-card",
        "config": {
          "title": "Active Campaigns",
          "profileSlug": "campaign",
          "filter": { "campaign-status": "active" }
        },
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 2
      },
      {
        "kind": "widget",
        "widgetKind": "stat-card",
        "config": { "title": "Total Leads", "profileSlug": "lead" },
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 2
      },
      {
        "kind": "widget",
        "widgetKind": "stat-card",
        "config": {
          "title": "Converted",
          "profileSlug": "lead",
          "filter": { "lead-stage": "converted" }
        },
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 2
      },
      {
        "kind": "view",
        "viewSlug": "lead-pipeline",
        "x": 0,
        "y": 2,
        "w": 12,
        "h": 6
      },
      {
        "kind": "view",
        "viewSlug": "campaign-pipeline",
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 5
      },
      {
        "kind": "view",
        "viewSlug": "campaign-activity-log",
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 5
      }
    ]

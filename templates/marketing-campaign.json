      "scopeProfileSlug": "lead",
      "sortBy": "createdAt",
      "sortDirection": "desc"
    },
    {
      "slug": "leads-by-source",
      "name": "Leads by Source",
      "type": "table",
      "scopeProfileSlug": "lead",
      "groupBy": "lead-source",
      "sortBy": "createdAt",
      "sortDirection": "desc"
    },
    {
      "slug": "campaign-activity-log",
      "name": "Activity Log",
      "type": "table",
      "scopeProfileSlug": "campaign-activity",
      "sortBy": "activity-date",
      "sortDirection": "desc"
    },
    {
      "slug": "campaign-grid",
      "name": "Campaigns",
      "type": "grid",
      "scopeProfileSlug": "campaign",
      "sortBy": "createdAt",
      "sortDirection": "desc"
    }

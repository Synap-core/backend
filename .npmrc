# Hoist zod and tRPC to root node_modules so all workspace packages share
# the same instance — prevents TypeScript "cannot name type" TS2742 errors
# caused by duplicate zod instances across packages.
public-hoist-pattern[]=*zod*
public-hoist-pattern[]=@trpc/*
# Husky / lint-staged: ensure real package path exists at node_modules/lint-staged
# (otherwise .bin shim can point at a missing folder and pre-commit crashes).
public-hoist-pattern[]=lint-staged
public-hoist-pattern[]=eslint
public-hoist-pattern[]=prettier

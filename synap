        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-}
    local no_cache=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --no-cache)
                no_cache=true
                shift
                ;;
            *)
                if [ -z "$service" ]; then
                    service="$1"
                fi
                shift
                ;;
        esac
    done
    
    # If no service specified, show interactive menu
    if [ -z "$service" ]; then
        local services=($(docker compose ps --services 2>/dev/null))
        if [ ${#services[@]} -eq 0 ]; then
            echo -e "${RED}❌ No services found${NC}"
            exit 1
        fi
        
        echo -e "${BLUE}🔨 Rebuild Service${NC}"
        echo ""
        local i=1
        for svc in "${services[@]}"; do
            echo -e "  ${GREEN}[$i]${NC} $svc"
            ((i++))
        done
        echo ""
        echo -e "  ${BLUE}[a]${NC} All services"
        echo -e "  ${BLUE}[q]${NC} Quit"
        echo ""
        read -p "Select service (number/a/q): " choice
        
        case "$choice" in
            [0-9]*)
                local idx=$((choice - 1))
                if [ $idx -ge 0 ] && [ $idx -lt ${#services[@]} ]; then
                    service="${services[$idx]}"
                else
                    echo -e "${RED}Invalid selection${NC}"
                    exit 1
                fi
                ;;
            a|A)
                service=""
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    fi
    
    # First-party images (backend + realtime + migrate share one image; pod-admin)
    # are rebuilt through the update engine: the build is tagged synap-local/*
    # (never the registry name) and goes through backup / canary / rollback (U6).
    case "$service" in
        ""|backend|realtime|backend-migrate|backend-canary|pod-admin)
            echo -e "${BLUE}🔨 Rebuilding first-party images via: synap update --from-source${NC}"

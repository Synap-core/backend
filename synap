cmd_backup() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local backup_name=${1:-"backup-$(date +%Y%m%d-%H%M%S)"}
    local backup_dir="./backups"
    
    mkdir -p "$backup_dir"
    
    echo -e "${BLUE}💾 Creating backup: ${backup_name}${NC}"
    
    # Backup database
    docker compose exec -T postgres pg_dump -U synap synap > "$backup_dir/${backup_name}-database.sql"
    
    # Backup .env
    cp .env "$backup_dir/${backup_name}.env"
    
    # Create tarball
    tar -czf "$backup_dir/${backup_name}.tar.gz" \
        -C "$backup_dir" \
        "${backup_name}-database.sql" \
        "${backup_name}.env"
    
    rm "$backup_dir/${backup_name}-database.sql" "$backup_dir/${backup_name}.env"
    
    echo -e "${GREEN}✅ Backup created: ${backup_dir}/${backup_name}.tar.gz${NC}"
}

cmd_restore() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local backup_file=$1
    if [ -z "$backup_file" ]; then
        echo -e "${RED}Error: Backup file required${NC}"
        echo "Usage: synap restore <backup-file.tar.gz>"
        exit 1
    fi
    
    if [ ! -f "$backup_file" ]; then
        echo -e "${RED}Error: Backup file not found: $backup_file${NC}"
        exit 1
    fi
    
    echo -e "${YELLOW}⚠️  WARNING: This will overwrite current data!${NC}"
    read -p "Continue? (yes/no): " CONFIRM
    if [ "$CONFIRM" != "yes" ]; then
        echo "Restore cancelled"
        exit 0
    fi
    
    local temp_dir=$(mktemp -d)
    tar -xzf "$backup_file" -C "$temp_dir"
    
    docker compose stop backend
    cat "$temp_dir"/*-database.sql | docker compose exec -T postgres psql -U synap synap
    cp "$temp_dir"/*.env .env
    rm -rf "$temp_dir"
    
    docker compose up -d --remove-orphans
    
    echo -e "${GREEN}✅ Restore complete!${NC}"
}

cmd_config() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local action=${1:-list}
    
    case "$action" in
        list)
            if [ -f .env ]; then
                echo -e "${BLUE}📝 Current Configuration:${NC}"
                grep -v "^#" .env | grep -v "^$" | while IFS='=' read -r k v; do
                    if [[ "$k" == *"SECRET"* ]] || [[ "$k" == *"KEY"* ]] || [[ "$k" == *"PASSWORD"* ]]; then
                        echo "$k=********"
                    else
                        echo "$k=$v"
                    fi
                done
            fi
            ;;
        edit)
            ${EDITOR:-nano} .env
            ;;
        get)
            local key=$2
            if [ -z "$key" ]; then
                echo "Usage: synap config get <key>"
                exit 1
            fi
            grep "^${key}=" .env | cut -d'=' -f2-
            ;;
        set)
            local key=$2
            local value=$3
            if [ -z "$key" ] || [ -z "$value" ]; then
                echo "Usage: synap config set <key> <value>"
                exit 1
            fi
            if grep -q "^${key}=" .env; then
                sed -i.bak "s|^${key}=.*|${key}=${value}|" .env
            else
                echo "${key}=${value}" >> .env
            fi
            echo -e "${GREEN}✓ Updated ${key}${NC}"
            ;;
        *)
            echo "Usage: synap config [list|edit|get|set]"
            ;;
    esac
}

cmd_rebuild() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-}
    local no_cache=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --no-cache)
                no_cache=true
                shift
                ;;
            *)
                if [ -z "$service" ]; then
                    service="$1"
                fi
                shift
                ;;
        esac
    done
    
    # If no service specified, show interactive menu
    if [ -z "$service" ]; then
        local services=($(docker compose ps --services 2>/dev/null))
        if [ ${#services[@]} -eq 0 ]; then
            echo -e "${RED}❌ No services found${NC}"
            exit 1
        fi
        
        echo -e "${BLUE}🔨 Rebuild Service${NC}"
        echo ""
        local i=1
        for svc in "${services[@]}"; do
            echo -e "  ${GREEN}[$i]${NC} $svc"
            ((i++))
        done
        echo ""
        echo -e "  ${BLUE}[a]${NC} All services"
        echo -e "  ${BLUE}[q]${NC} Quit"
        echo ""
        read -p "Select service (number/a/q): " choice
        
        case "$choice" in
            [0-9]*)
                local idx=$((choice - 1))
                if [ $idx -ge 0 ] && [ $idx -lt ${#services[@]} ]; then
                    service="${services[$idx]}"
                else
                    echo -e "${RED}Invalid selection${NC}"
                    exit 1
                fi
                ;;
            a|A)
                service=""
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    fi
    
    local build_cmd="docker compose build"
    if [ "$no_cache" = true ]; then
        build_cmd="$build_cmd --no-cache"
    fi
    
    if [ -z "$service" ]; then
        echo -e "${BLUE}🔨 Rebuilding all services...${NC}"
        eval "$build_cmd"
        echo -e "${BLUE}🔄 Restarting services...${NC}"
        docker compose up -d --remove-orphans
    else
        echo -e "${BLUE}🔨 Rebuilding $service...${NC}"
        eval "$build_cmd $service"
        echo -e "${BLUE}🔄 Restarting $service...${NC}"
        docker compose up -d --remove-orphans "$service"
    fi
    
    echo -e "${GREEN}✅ Rebuild complete!${NC}"
}

cmd_errors() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-}
    local tail_lines=${2:-100}
    
    echo -e "${BLUE}🔍 Searching for errors in logs...${NC}"
    echo ""
    
    if [ -z "$service" ]; then
        # Search all services
        local services=($(docker compose ps --services 2>/dev/null))
        for svc in "${services[@]}"; do
            local status=$(docker compose ps "$svc" --format json 2>/dev/null | grep -o '"State":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
            if [ "$status" = "running" ]; then
                echo -e "${YELLOW}━━━ $svc ━━━${NC}"
                docker compose logs --tail="$tail_lines" "$svc" 2>&1 | grep -i "error\|fatal\|panic\|exception\|failed" | head -20 || echo "  No errors found"
                echo ""
            fi
        done
    else
        echo -e "${YELLOW}━━━ $service ━━━${NC}"
        docker compose logs --tail="$tail_lines" "$service" 2>&1 | grep -i "error\|fatal\|panic\|exception\|failed" | head -50 || echo "  No errors found"
    fi
}


cmd_health() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    echo -e "${BLUE}🏥 Synap Health Check${NC}"
    echo ""
    
    if ! docker compose ps | grep -q "Up"; then
        echo -e "${RED}❌ No services running${NC}"
        exit 1
    fi
    
    check_service() {
        local service=$1
        local name=$2
        if docker compose ps "$service" | grep -q "Up"; then
            echo -e "${GREEN}✅ ${name}${NC}"
        else
            echo -e "${RED}❌ ${name}${NC}"
        fi
    }
    
    check_service "backend" "Backend API"
    check_service "postgres" "Database"
    check_service "redis" "Redis"
    check_service "minio" "Storage"
    check_service "typesense" "Search"
    check_service "kratos" "Authentication"
    check_service "hydra" "OAuth2"
    check_service "caddy" "Reverse Proxy"
    
    echo ""
    echo -e "${GREEN}✅ System healthy${NC}"
}

# Quick checks for "why doesn't my domain work?" (DNS, TLS, /health through the edge)
cmd_connectivity() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    cd "$deploy_dir"

    local domain=""
    local public_url=""
    if [ -f ".env" ]; then
        domain=$(grep "^DOMAIN=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" || true)
        public_url=$(grep "^PUBLIC_URL=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" || true)
    fi

    echo -e "${BLUE}🌐 Connectivity / domain checks${NC}"
    echo ""
    echo "  DOMAIN:      ${domain:-<not set in .env>}"
    echo "  PUBLIC_URL:  ${public_url:-<not set — will assume https://\$DOMAIN>}"
    echo ""

    if [ -z "$domain" ]; then
        echo -e "${YELLOW}⚠️  No DOMAIN in deploy/.env — cannot run external checks.${NC}"
        exit 1
    fi

    local probe_url="${public_url}"
    if [ -z "$probe_url" ]; then
        if [ "$domain" = "localhost" ]; then
            probe_url="http://localhost:4000"
        else
            probe_url="https://${domain}"
        fi
    fi

    echo -e "${BLUE}1) DNS resolution${NC}"
    if command -v getent >/dev/null 2>&1; then
        getent hosts "$domain" || echo -e "  ${YELLOW}getent hosts failed (no libc hosts entry?)${NC}"
    elif command -v dig >/dev/null 2>&1; then
        dig +short "$domain" || true
    else
        echo -e "  ${YELLOW}Install 'bind9-host' or 'bind9-dnsutils' for dig, or use getent.${NC}"
    fi
    echo ""

    echo -e "${BLUE}2) HTTP /health (via PUBLIC_URL or inferred URL)${NC}"
    echo "  GET ${probe_url}/health"
    if curl -fsS -m 20 -o /tmp/synap-health.body -w "  HTTP %{http_code}  time_total=%{time_total}s\n" "${probe_url}/health"; then
        head -c 200 /tmp/synap-health.body 2>/dev/null | tr -d '\r' | sed 's/^/  body: /' || true
        echo ""
    else
        echo -e "  ${RED}curl failed${NC} — check Caddy logs: ./synap logs caddy --no-follow --tail 80"
        echo "  If you use a tunnel (Pangolin / Cloudflare), verify the tunnel points to this host:80 or :443."
    fi
    rm -f /tmp/synap-health.body 2>/dev/null || true
    echo ""

    echo -e "${BLUE}3) Docker edge (Caddy)${NC}"
    if docker compose ps caddy 2>/dev/null | grep -q "Up"; then
        echo -e "  ${GREEN}✅ Caddy container is Up${NC}"
    else
        echo -e "  ${RED}❌ Caddy not Up${NC} — run: ./synap start"
    fi
}

cmd_logs() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local follow=true
    local tail_lines=""
    local service=""
    local filter=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --no-follow|-n)
                follow=false
                shift
                ;;
            --tail|-t)
                tail_lines="$2"
                shift 2
                ;;
            --filter|-f)
                filter="$2"
                shift 2
                ;;
            --help|-h)
                cat << EOF
${BLUE}Synap Logs${NC}

${YELLOW}Usage:${NC}
  synap logs [service] [options]

${YELLOW}Options:${NC}
  ${GREEN}--no-follow${NC}, ${GREEN}-n${NC}     Don't follow logs (show and exit)
  ${GREEN}--tail <n>${NC}, ${GREEN}-t <n>${NC}  Show last N lines (default: all)
  ${GREEN}--filter <text>${NC}, ${GREEN}-f <text>${NC}  Filter logs by text (grep)
  ${GREEN}--help${NC}, ${GREEN}-h${NC}          Show this help

${YELLOW}Examples:${NC}
  synap logs                    # Interactive service selection
  synap logs backend            # View backend logs
  synap logs backend --tail 100 # Last 100 lines
  synap logs backend --no-follow # Show and exit
  synap logs backend --filter error # Filter by "error"

EOF
                exit 0
                ;;
            *)
                if [ -z "$service" ]; then
                    service="$1"
                fi
                shift
                ;;
        esac
    done
    
    # Get list of running services
    local services=($(docker compose ps --services --status running 2>/dev/null || docker compose ps --services 2>/dev/null))
    
    if [ ${#services[@]} -eq 0 ]; then
        echo -e "${RED}❌ No services found${NC}"
        exit 1
    fi
    
    # If no service specified, show interactive menu
    if [ -z "$service" ]; then
        echo -e "${BLUE}📋 Available Services:${NC}"
        echo ""
        local i=1
        for svc in "${services[@]}"; do
            local status=$(docker compose ps "$svc" --format json 2>/dev/null | grep -o '"State":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
            if [ "$status" = "running" ]; then
                echo -e "  ${GREEN}[$i]${NC} $svc"
            else
                echo -e "  ${YELLOW}[$i]${NC} $svc (not running)"
            fi
            ((i++))
        done
        echo ""
        echo -e "  ${BLUE}[a]${NC} All services"
        echo -e "  ${BLUE}[q]${NC} Quit"
        echo ""
        read -p "Select service (number/a/q): " choice
        
        case "$choice" in
            [0-9]*)
                local idx=$((choice - 1))
                if [ $idx -ge 0 ] && [ $idx -lt ${#services[@]} ]; then
                    service="${services[$idx]}"
                else
                    echo -e "${RED}Invalid selection${NC}"
                    exit 1
                fi
                ;;
            a|A)
                service=""
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    fi
    
    # Build docker compose logs command
    local cmd="docker compose logs"
    
    if [ "$follow" = true ]; then
        cmd="$cmd -f"
    fi
    
    if [ -n "$tail_lines" ]; then
        cmd="$cmd --tail=$tail_lines"
    fi
    
    if [ -n "$service" ]; then
        cmd="$cmd $service"
    fi
    
    # Execute command with optional filter
    if [ -n "$filter" ]; then
        eval "$cmd" | grep --color=always "$filter"
    else
        eval "$cmd"
    fi
}

cmd_update() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    # Fail fast on a stub .env that's missing the critical infrastructure
    # secrets — running compose against it would launch postgres with a blank
    # password and lock everyone out of the existing volume data. The
    # `cmd_update` flow ASSUMES `.env` was already populated by `cmd_install`.
    if [ -f .env ]; then
        local missing_critical=""
        for key in POSTGRES_PASSWORD JWT_SECRET KRATOS_SECRETS_COOKIE; do
            local val=$(grep "^${key}=" .env 2>/dev/null | cut -d'=' -f2-)
            if [ -z "$val" ]; then
                missing_critical="${missing_critical} ${key}"
            fi
        done
        if [ -n "$missing_critical" ]; then
            echo -e "${RED}❌ .env is missing critical secrets:${missing_critical}${NC}"
            echo -e "${YELLOW}This .env looks like a fresh template (.env.example shape) — running update against it"
            echo -e "would launch postgres with a blank password and break authentication against existing data."
            echo ""
            echo -e "Recovery options:${NC}"
            echo -e "  1. Restore .env from a backup if you have one (your secrets must match the existing volumes)."
            echo -e "  2. If your postgres/typesense/minio volumes are empty (no data to preserve), run:"
            echo -e "       docker volume prune -f && synap install --domain <your-domain>"
            echo -e "     This generates a fresh .env and reinitializes all storage."
            echo -e "  3. If you only want the synap CLI to populate the missing secrets WITHOUT touching"
            echo -e "     your DOMAIN/ADMIN_* values, run \`synap install\` — non-interactive mode preserves"
            echo -e "     existing values and only regenerates secrets when .env is missing entirely."
            exit 1
        fi
    fi

    cleanup_stale_synap_state "$deploy_dir"
    
    # Auto-detect if we're in a git repo (for smart defaults)
    local IN_GIT_REPO=false
    local repo_root=$(get_repo_root)
    if [ -n "$repo_root" ] && [ "$(cd "$deploy_dir" && pwd)" = "$(cd "$repo_root/deploy" 2>/dev/null && pwd)" ]; then
        IN_GIT_REPO=true
    fi
    
    local version="latest"
    local force_build=false
    local force_image=false
    local local_build=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --build|-b|--from-source)
                force_build=true
                shift
                ;;
            --from-image)
                force_image=true
                shift
                ;;
            --local|-l)
                local_build=true
                force_build=true
                shift
                ;;
            --version|-v)
                version="$2"
                shift 2
                ;;
            *)
                if [[ "$1" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]] || [ "$1" = "latest" ]; then
                    version="$1"
                fi
                shift
                ;;
        esac
    done
    
    echo -e "${BLUE}🔄 Updating Synap...${NC}"

    # Smart defaults when neither --from-image nor --from-source was passed:
    #   1. If .env has BACKEND_VERSION=local, the operator built locally
    #      previously. The `:local` tag is a sentinel that never existed
    #      upstream, so `docker compose pull` would always fail before
    #      falling through to a rebuild — pure waste. Go straight to build.
    #   2. Otherwise if we're in a git repo, default to --from-source
    #      (the operator has source on disk and can rebuild).
    #   3. Otherwise pull from the registry.
    if [ "$force_build" = false ] && [ "$force_image" = false ]; then
        if [ -f .env ] && grep -q "^BACKEND_VERSION=local" .env 2>/dev/null; then
            force_build=true
            echo -e "${BLUE}ℹ️  .env has BACKEND_VERSION=local — building from source (skipping wasted pull of :local sentinel)${NC}"
        elif [ "$IN_GIT_REPO" = true ]; then
            force_build=true
            echo -e "${BLUE}ℹ️  In git repository, defaulting to --from-source${NC}"
        fi
    fi
    
    if [ "$force_build" = true ]; then
        echo -e "${BLUE}🔨 Building from source...${NC}"
        echo -e "${BLUE}  Building backend...${NC}"
        docker compose build backend
        echo -e "${BLUE}  Building realtime...${NC}"
        docker compose build realtime
        echo -e "${BLUE}  Building pod-admin...${NC}"
        docker compose build pod-admin
        version="local"
    else
        echo -e "${BLUE}📥 Pulling images...${NC}"
        echo -e "${BLUE}  Pulling backend...${NC}"
        docker compose pull backend || {
            echo -e "${YELLOW}⚠️  Pull failed, building from source...${NC}"
            docker compose build backend
            version="local"
        }
        echo -e "${BLUE}  Pulling realtime...${NC}"
        docker compose pull realtime || {
            echo -e "${YELLOW}⚠️  Pull failed, building from source...${NC}"
            docker compose build realtime
        }
        # Pod-admin is a separate image (Next.js standalone). Pull failure
        # falls back to local build so the operator console always lands.
        echo -e "${BLUE}  Pulling pod-admin...${NC}"
        docker compose pull pod-admin || {
            echo -e "${YELLOW}⚠️  Pull failed, building from source...${NC}"
            docker compose build pod-admin
        }
        # Refresh Kratos images so the migrate one-shot and the running
        # kratos service line up with the new schema. Best-effort: a
        # registry hiccup shouldn't block a backend security update, the
        # existing local image keeps working.
        echo -e "${BLUE}  Pulling kratos + kratos-migrate...${NC}"
        docker compose pull kratos kratos-migrate || \
            echo -e "${YELLOW}⚠️  Kratos image pull failed — continuing with the local image.${NC}"
    fi
    
    # Update .env
    if [ -f .env ]; then
        if grep -q "^BACKEND_VERSION=" .env; then
            sed -i.bak "s|^BACKEND_VERSION=.*|BACKEND_VERSION=${version}|" .env
            rm -f .env.bak
        else
            echo "BACKEND_VERSION=${version}" >> .env
        fi
        
        # Ensure required encryption key exists for service credential crypto
        if ! grep -q "^SYNAP_SERVICE_ENCRYPTION_KEY=" .env; then
            echo "SYNAP_SERVICE_ENCRYPTION_KEY=$(openssl rand -hex 32)" >> .env
            echo -e "${YELLOW}⚠️  Added missing SYNAP_SERVICE_ENCRYPTION_KEY to .env${NC}"
        fi

        # Ensure agent-provisioning token exists. Backend reads it to auth
        # POST /v1/agents/provision; missing or empty == agent provisioning
        # is broken. Backfill with a fresh secret on update if absent.
        if ! grep -q "^PROVISIONING_TOKEN=." .env; then
            # Strip any empty placeholder line first (e.g. `PROVISIONING_TOKEN=`).
            sed -i.bak '/^PROVISIONING_TOKEN=\s*$/d' .env && rm -f .env.bak
            echo "PROVISIONING_TOKEN=$(openssl rand -hex 32)" >> .env
            echo -e "${YELLOW}⚠️  Added missing PROVISIONING_TOKEN to .env${NC}"
        fi

        # Read DOMAIN from .env for kratos config regeneration
        local domain=$(grep "^DOMAIN=" .env 2>/dev/null | cut -d'=' -f2- || echo "localhost")
    else
        local domain="localhost"
    fi
    
    # Regenerate kratos.yml (ensures it exists and has correct webhook secret)
    echo -e "${BLUE}📝 Regenerating Kratos configuration...${NC}"
    generate_kratos_config "$domain"

    # Ensure the kratos and hydra databases exist before kratos-migrate runs.
    # postgres's init-databases.sh only fires on a fresh data volume, so an
    # existing volume from before kratos/hydra were added has neither db
    # — kratos-migrate then fails with "database does not exist".
    # Idempotent: \gexec only runs CREATE DATABASE when the row is absent.
    echo -e "${BLUE}📝 Ensuring kratos and hydra databases exist...${NC}"
    docker compose exec -T postgres psql -U synap -c \
        "SELECT 'CREATE DATABASE kratos' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'kratos')\gexec" \
        2>/dev/null || true
    docker compose exec -T postgres psql -U synap -c \
        "SELECT 'CREATE DATABASE hydra' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'hydra')\gexec" \
        2>/dev/null || true

    # Run migrations (critical - must succeed).
    # Kratos and backend evolve their schemas independently. Both run before
    # any service is recreated so an upgrade with both schema changes lands
    # in one go. Failures abort: continuing with mismatched schema yields
    # 500s on /self-service/* (Kratos) and broken queries (backend).
    echo -e "${BLUE}🔄 Running backend migrations...${NC}"
    if ! docker compose run --rm backend-migrate; then
        echo -e "${RED}❌ Backend migrations failed!${NC}"
        echo -e "${YELLOW}⚠️  Backend will not start correctly without migrations${NC}"
        if synap_assume_yes; then
            echo -e "${RED}Aborting in non-interactive mode — investigate and re-run \`synap update\` once migrations succeed.${NC}"
            exit 1
        fi
        read -p "Continue anyway? (y/N): " CONTINUE
        if [ "$CONTINUE" != "y" ] && [ "$CONTINUE" != "Y" ]; then
            echo "Update cancelled"
            exit 1
        fi
    fi

    # Kratos + Hydra schema migrations. `compose run --rm` forces a fresh
    # migrate container every time — bypasses docker compose's
    # `service_completed_successfully` short-circuit which silently skips
    # migrate services on subsequent `up`s after they've exited 0 once. If
    # the kratos/hydra database is empty for ANY reason (volume drift, an
    # `init-databases.sh` re-create, manual ops), this is the only thing
    # that brings the schema back. Failure is interactive-blocking; CI /
    # eve always exits non-zero so the broken state never silently ships.
    echo -e "${BLUE}🔄 Running Kratos migrations...${NC}"
    if ! docker compose run --rm kratos-migrate; then
        echo -e "${YELLOW}⚠️  Kratos migrations failed — login/registration flows will 500 against the new image.${NC}"
        if synap_assume_yes; then
            echo -e "${RED}Aborting in non-interactive mode — investigate and re-run.${NC}"
            exit 1
        fi
        read -p "Continue anyway? (y/N): " CONTINUE
        if [ "$CONTINUE" != "y" ] && [ "$CONTINUE" != "Y" ]; then
            echo "Update cancelled"
            exit 1
        fi
    fi

    echo -e "${BLUE}🔄 Running Hydra migrations...${NC}"
    if ! docker compose run --rm hydra-migrate; then
        echo -e "${YELLOW}⚠️  Hydra migrations failed — OAuth2 flows will 500 against the new image.${NC}"
        if synap_assume_yes; then
            echo -e "${RED}Aborting in non-interactive mode — investigate and re-run.${NC}"
            exit 1
        fi
        read -p "Continue anyway? (y/N): " CONTINUE
        if [ "$CONTINUE" != "y" ] && [ "$CONTINUE" != "Y" ]; then
            echo "Update cancelled"
            exit 1
        fi
    fi

    # Restart services. Kratos is force-recreated so it picks up:
    #   1. The new image just pulled
    #   2. The freshly-regenerated kratos.yml (kratos reads this at startup)
    # Without --force-recreate, kratos keeps the old image + old config and
    # the operator hits 500s on /self-service/* until they restart by hand.
    #
    # Caddy is the synap stack's built-in edge proxy. When the operator runs
    # behind their own edge (eve's Traefik on port 80, an external nginx,
    # cloudflared, etc.) Caddy can't bind 80/443 and aborts the update.
    # Set SYNAP_SKIP_EDGE=1 to keep Caddy stopped — backend, realtime, kratos,
    # pod-agent and pod-admin come up regardless.

    # Pod-agent is profile-gated (compose profile: pod-agent) and only restarted
    # when SYNAP_WITH_POD_AGENT=1 is set. See cmd_install for full rationale.
    local pod_agent_args=()
    local profile_args=()
    if [ "${SYNAP_WITH_POD_AGENT:-}" = "1" ]; then
        pod_agent_args=(pod-agent)
        profile_args=(--profile pod-agent)
    fi

    echo -e "${BLUE}🔄 Restarting services...${NC}"
    if [ "${SYNAP_SKIP_EDGE:-}" = "1" ]; then
        echo -e "${BLUE}  (SYNAP_SKIP_EDGE=1: skipping Caddy — external edge proxy assumed)${NC}"
        docker compose "${profile_args[@]}" up -d --remove-orphans backend realtime "${pod_agent_args[@]}" pod-admin
    else
        docker compose "${profile_args[@]}" up -d --remove-orphans backend realtime caddy "${pod_agent_args[@]}" pod-admin
    fi
    docker compose up -d --force-recreate kratos

    # Idempotent admin seed — ensures the users/workspace rows exist after
    # every update. create-admin-cli.js is a no-op when the admin already
    # exists, so this is safe to run unconditionally. Without it, a fresh
    # install followed by `synap update` would leave the pod with a Kratos
    # identity but no users/workspace_members rows, causing 401/403 on all
    # tRPC calls even for authenticated sessions.
    local update_admin_email=""
    local update_admin_password=""
    local update_bootstrap_mode=""
    if [ -f .env ]; then
        update_admin_email=$(grep "^ADMIN_EMAIL=" .env 2>/dev/null | cut -d'=' -f2-)
        update_admin_password=$(grep "^ADMIN_PASSWORD=" .env 2>/dev/null | cut -d'=' -f2-)
        update_bootstrap_mode=$(grep "^ADMIN_BOOTSTRAP_MODE=" .env 2>/dev/null | cut -d'=' -f2-)
    fi

    if [ -n "$update_admin_email" ] && [ -n "$update_admin_password" ]; then
        echo -e "${BLUE}👤 Ensuring admin provisioning is complete...${NC}"
        if run_preseed_admin_in_container "$update_admin_email" "$update_admin_password"; then
            echo -e "${GREEN}✅ Admin provisioning confirmed.${NC}"
        else
            echo -e "${YELLOW}⚠️  Admin provisioning failed (pod may still be starting). Run manually if needed:${NC}"
            echo "  ./synap setup admin --email ${update_admin_email} --password <password>"
        fi
        unset update_admin_password
    elif [ "$update_bootstrap_mode" = "token" ]; then
        # Token-bootstrap: admin was set up via the browser UI — no password in
        # .env is correct. The users/workspace rows were created during that flow.
        echo -e "${BLUE}ℹ️  Token bootstrap mode — skipping auto-provision (admin set up via browser).${NC}"
    else
        # Preseed mode but credentials missing — something is off. Warn the operator.
        echo -e "${YELLOW}⚠️  ADMIN_EMAIL/ADMIN_PASSWORD not found in .env — skipping auto-provisioning.${NC}"
        echo "  If this is a fresh pod, run: ./synap setup admin --email <email> --password <password>"
    fi

    echo -e "${GREEN}✅ Update complete!${NC}"
}

cmd_restart() {
    local deploy_dir=$(get_deploy_dir)

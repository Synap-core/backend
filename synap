cmd_backup() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    # ONE backup door: deploy/pgdata-safety.sh. init/status run here on the
    # host; push/drill run inside a throwaway copy of the postgres-backup
    # service — the exact context the hourly loop runs in (same script, same
    # mounts, network access to postgres and minio).
    case "${1:-}" in
        init)
            SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" backup_init "${2:-}"
            return $?
            ;;
        kit-saved)
            # The owner confirms they saved the recovery kit: clears the "not yet saved" mark.
            SYNAP_DEPLOY_DIR="$deploy_dir" _bk_kit_mark saved
            return $?
            ;;
        status)
            SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" backup_status
            return $?
            ;;
        push|drill)
            docker compose run --rm --no-deps -T --entrypoint sh postgres-backup \
                /synap-deploy/pgdata-safety.sh "$@"
            return $?
            ;;
        -h|--help|help)
            cat <<'USAGE'
Usage:
  synap backup [label]          local dump of every database (backups/postgres/<ts>-<label>)
  synap backup init             create the off-host repository (BACKUP_REPOSITORY in .env), print
                                the recovery kit and ask you to type back the password's last 6
  synap backup init --non-interactive
                                no TTY: the kit goes to state/kit/recovery-kit.txt (0600). It is "not
                                yet saved" until the owner confirms it in the app (Settings → Pod →
                                Backups) or runs: synap backup kit-saved
  synap backup push             dump + push an encrypted snapshot now (the service does it hourly)
  synap backup drill [snap]     restore a snapshot into a throwaway postgres, compare fingerprints
  synap backup status           repository, last runs, alarms
USAGE
            return 0
            ;;
    esac

    # A local dump: EVERY database — synap AND the kratos identity
    # stores — each read back before it is kept. Secrets are not copied next
    # to it any more (the plaintext env.backup is retired): they travel inside
    # the encrypted off-host snapshot (`synap backup init` / `push`).
    local label=${1:-manual}
    local dir
    dir="$(SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" pgdata_backup "$label")" || {
        echo -e "${RED}❌ Backup failed${NC}"
        exit 1
    }
    echo -e "${GREEN}✅ Backup created: ${dir}${NC}"
    echo -e "${YELLOW}   Local only, databases only. Off-host + files + secrets: synap backup init && synap backup push${NC}"
}

cmd_restore() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    local target=${1:-}
    if [ -z "$target" ]; then
        echo -e "${RED}Error: what to restore is required${NC}"
        echo "Usage: synap restore --from-snapshot <id|latest> [--password-file <file>]"
        echo "       synap restore <backups/postgres/<dir>>"
        exit 1
    fi

    # Off-host snapshot (fresh host or rollback): secrets → databases → MinIO
    # → fingerprint compare. The stack is only started when the fingerprint
    # recorded at backup time matches.
    if [ "$target" = "--from-snapshot" ]; then
        local snap=${2:-} pwfile="" tmp_pw=""
        [ -n "$snap" ] || { echo -e "${RED}Usage: synap restore --from-snapshot <id|latest> [--password-file <file>]${NC}"; exit 1; }
        if [ "${3:-}" = "--password-file" ]; then
            pwfile=${4:-}
            [ -s "$pwfile" ] || { echo -e "${RED}Password file not found or empty: ${pwfile}${NC}"; exit 1; }
        elif [ ! -s "$deploy_dir/state/backup/restic-password" ]; then
            read -r -s -p "Repository password (from your recovery kit): " _kit_pw; echo
            [ -n "$_kit_pw" ] || { echo -e "${RED}No password given${NC}"; exit 1; }
            tmp_pw="$(umask 077 && mktemp)"
            printf '%s' "$_kit_pw" > "$tmp_pw"; unset _kit_pw
            pwfile="$tmp_pw"
        fi
        echo -e "${YELLOW}⚠️  WARNING: This replaces .env, every database and the stored files with snapshot ${snap}${NC}"
        read -p "Continue? (yes/no): " CONFIRM
        [ "$CONFIRM" = "yes" ] || { [ -n "$tmp_pw" ] && rm -f "$tmp_pw"; echo "Restore cancelled"; exit 0; }
        local rc=0
        [ -n "$pwfile" ] && export BACKUP_PASSWORD_FILE="$pwfile"
        SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="docker compose" backup_restore_snapshot "$snap" || rc=$?
        [ -n "$tmp_pw" ] && rm -f "$tmp_pw"
        [ "$rc" = 0 ] || exit "$rc"
        # backup_restore_snapshot exported the restored COMPOSE_PROJECT_NAME pin.
        if docker compose up -d --remove-orphans; then
            echo -e "${GREEN}✅ Restore complete — check: synap health${NC}"
        else
            echo -e "${YELLOW}Data restored and verified, but the stack did not start (a fresh host has no images yet): run synap update — it keeps the restored .env.${NC}"
            exit 1
        fi
        return 0
    fi

    # A directory is a `synap backup` / postgres-backup dump set (<db>.dump each).
    if [ -d "$target" ]; then
        echo -e "${YELLOW}⚠️  WARNING: This replaces every database with the contents of ${target}${NC}"
        read -p "Continue? (yes/no): " CONFIRM
        [ "$CONFIRM" = "yes" ] || { echo "Restore cancelled"; exit 0; }
        SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" pgdata_restore "$target" || exit 1
        # The fingerprint recorded with the dump is the second, independent
        # proof (as for a snapshot): the stack starts only when it matches.
        local want got
        want="$(cat "$target/fingerprint" 2>/dev/null)"
        if [ -n "$want" ]; then
            got="$(SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" _pgs_fingerprint "$(SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" _pgs_container)")"
            if [ "$got" != "$want" ]; then
                echo -e "${RED}❌ Restoring ${target} did not bring the data back: the dump recorded users|entities|api_keys=${want}, the database now has ${got:-<unreadable>}. The stack was NOT restarted — inspect before starting it.${NC}"
                exit 1
            fi
            echo -e "${GREEN}  fingerprint matches the dump (users|entities|api_keys=${got})${NC}"
        else
            echo -e "${YELLOW}⚠️  ${target} has no recorded fingerprint: the restore could not be checked against it${NC}"
        fi
        docker compose up -d --remove-orphans
        echo -e "${GREEN}✅ Restore complete!${NC}"
        return 0
    fi

    # The legacy tar.gz format (synap-db-only SQL + an .env overwrite) is
    # retired: it was a second restore format nothing produces any more.
    echo -e "${RED}Error: not a backup directory: ${target}${NC}"
    echo "Usage: synap restore --from-snapshot <id|latest> [--password-file <file>]"
    echo "       synap restore <backups/postgres/<dir>>"
    exit 1
}

cmd_config() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    # The ONE writer of deploy/.env: deploy/env-config.sh against
    # deploy/env.schema (types, unknown-key refusal, managed/pin/immutable
    # keys, atomic write + .env.bak.<ts>, masked output). Eve, configure-pod.sh
    # and the synap npm CLI all write through this door.
    local action=${1:-list}
    [ $# -gt 0 ] && shift
    case "$action" in
        list)
            [ -f .env ] || { echo -e "${RED}No .env in ${deploy_dir}${NC}"; exit 1; }
            local k
            for k in $(envcfg_file_keys | awk '!seen[$0]++'); do
                echo "${k}=$(envcfg_mask "$k" "$(envcfg_value "$k")")"
            done
            ;;
        get)
            envcfg_get "$@"
            ;;
        set)
            envcfg_set "$@"
            ;;
        unset)
            envcfg_unset "$@"
            ;;
        validate)
            local findings rc=0
            findings="$(envcfg_validate)" || rc=1
            if [ -n "$findings" ]; then
                printf '%s\n' "$findings" | awk -F'|' '{ printf "%-5s %-30s %s\n", $1, $2, $3 }'
            fi
            [ "$rc" = 0 ] && echo -e "${GREEN}✓ .env matches deploy/env.schema${NC}"
            return "$rc"
            ;;
        diff)
            envcfg_diff "$@"
            ;;
        edit)
            # Edit a COPY, validate it, then replace .env atomically with a
            # backup — never an unvalidated in-place edit.
            local draft
            draft="$(umask 077 && mktemp "${deploy_dir}/.env.edit.XXXXXX")" || exit 1
            cat .env > "$draft" 2>/dev/null || true
            ${EDITOR:-nano} "$draft"
            if cmp -s "$draft" .env; then rm -f "$draft"; echo "config: unchanged"; return 0; fi
            local findings
            if ! findings="$(envcfg_validate "$draft")"; then
                printf '%s\n' "$findings" | grep '^error|' | awk -F'|' '{ printf "refused: %s — %s\n", $2, $3 }' >&2
                echo -e "${RED}config: your edit is kept in ${draft}; .env was not changed.${NC}" >&2
                return 1
            fi
            envcfg_backup || return 1
            chmod "$(stat -c %a .env 2>/dev/null || stat -f %Lp .env 2>/dev/null || echo 600)" "$draft"
            mv -f "$draft" .env
            echo "config: .env replaced (previous kept as ${ENVCFG_LAST_BACKUP}). Recreate what reads it: synap apply"
            ;;
        apply)
            cmd_apply "$@"
            ;;
        -h|--help|help)
            cat <<'USAGE'
synap config <action> — the one validated writer of deploy/.env (schema: deploy/env.schema)

  list                         every key, secrets masked
  get <KEY> [--reveal]         one value (masked unless --reveal)
  set KEY=VALUE... | KEY VALUE validate every pair, then write atomically; .env.bak.<ts> kept
      [--force]                allow changing an immutable secret / POD_AGENT_AUDIENCE ≠ PUBLIC_URL
      [--stdin | --from-file F] read KEY=VALUE lines (keeps secret values out of argv)
  unset [--force] KEY...       remove keys (same rules)
  validate                     the whole .env against the schema; non-zero on errors
  diff [from] [to]             masked diff (default: newest .env.bak.* → .env)
  edit                         $EDITOR on a copy; replaced only when it validates
  apply                        same as `synap apply`

Refused: unknown keys (PATH, NODE_VERSION…), the release block (synap update owns it),
COMPOSE_PROJECT_NAME once pinned, invalid values for the key's type.
USAGE
            ;;
        *)
            echo "Usage: synap config [list|get|set|unset|validate|diff|edit|apply] (synap config help)"
            return 2
            ;;
    esac
}

# `synap apply` — make running containers see the current deploy/.env.
# Guarded recreate: the update lock (router), the pgdata guard (the docker()
# interceptor fires on `compose up`), kratos.yml regenerated from .env, then
# `up -d --no-deps` of the services that are RUNNING — compose itself
# recreates only the ones whose resolved config changed. Never prunes, never
# touches a volume, never starts a stopped service, never removes orphans.
cmd_apply() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    cd "$deploy_dir"
    [ -f .env ] || { echo -e "${RED}No .env in ${deploy_dir}${NC}"; exit 1; }

    local findings
    if ! findings="$(envcfg_validate)"; then
        printf '%s\n' "$findings" | grep '^error|' | awk -F'|' '{ printf "  %s — %s\n", $2, $3 }' >&2
        echo -e "${RED}❌ .env does not validate (synap config validate) — not recreating anything.${NC}" >&2
        exit 1
    fi

    local running=() svc
    while IFS= read -r svc; do
        [ -n "$svc" ] && running+=("$svc")
    done < <(docker compose ps --status running --services 2>/dev/null | grep -vxE 'backend-canary|.*-migrate' || true)
    if [ "${#running[@]}" -eq 0 ]; then
        echo "apply: no running services — the next start/update reads the new .env."
        return 0
    fi

    local domain kratos_before="" kratos_after=""
    domain="$(envcfg_value DOMAIN)"; domain="${domain:-localhost}"
    [ -f ../kratos/kratos.yml ] && kratos_before="$(cksum < ../kratos/kratos.yml)"
    generate_kratos_config "$domain"
    [ -f ../kratos/kratos.yml ] && kratos_after="$(cksum < ../kratos/kratos.yml)"

    local profile_args=()
    if should_start_pod_agent; then profile_args=(--profile pod-agent); fi
    echo -e "${BLUE}🔄 apply: recreating what changed among: ${running[*]}${NC}"
    docker compose "${profile_args[@]}" up -d --no-deps "${running[@]}" || {
        echo -e "${RED}❌ apply: compose up failed — see: docker compose ps; the previous .env is the newest .env.bak.*${NC}" >&2
        exit 1
    }
    # kratos.yml is a bind-mounted FILE: compose cannot see its content change.
    if [ "$kratos_before" != "$kratos_after" ] && printf '%s\n' "${running[@]}" | grep -qx kratos; then
        docker compose up -d --no-deps --force-recreate kratos || exit 1
    fi
    echo -e "${GREEN}✓ apply: running services match deploy/.env${NC}"
}

# `synap doctor` — READ-ONLY health of the pod's deployment, one finding per
# problem, non-zero exit when there is any. It never starts, stops, writes or
# pulls: only `docker ps/inspect/exec <read>`, `docker compose ls/ps`, file
# reads, `git status`, one psql SELECT (backup runs) and one HTTP GET (PUBLIC_URL
# /health, SYNAP_DOCTOR_PROBE=0 skips it). Checks:
#   env       deploy/.env against deploy/env.schema (unknown keys, types,
#             required, duplicates, PUBLIC_URL/POD_AGENT_AUDIENCE coherence)
#   project   COMPOSE_PROJECT_NAME pinned; no second compose project on this dir
#   checkout  no locally modified tracked files in the deploy checkout
#   release   running backend = state/current-release.json (image + buildStamp)
#   override  docker-compose.override.yml is Eve-managed (marker) and edge-pinned
#   backup    off-host repository configured + initialised, no alarms, fresh dump
#   pgdata    postgres cluster lives on its volume (pgdata guard layout)
#   disk      ≥ 15% free where the pod writes
#   lock      update-lock holder + age (> SYNAP_DOCTOR_LOCK_MAX_HOURS=2 h), stale mkdir lock
#   containers  Docker health (unhealthy / crash-looping) + restart counts
#   kratos    ../kratos/kratos.yml well-formed, OIDC providers = strings + https issuer
#   url       PUBLIC_URL/health answers
cmd_doctor() {
    local json=0
    case "${1:-}" in --json) json=1 ;; -h|--help) echo "Usage: synap doctor [--json]   (read-only; exit 1 when anything is found)"; return 0 ;; esac
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    cd "$deploy_dir"
    command -v jq >/dev/null 2>&1 || { echo -e "${RED}synap doctor needs jq${NC}" >&2; exit 2; }

    local out; out="$(umask 077 && mktemp)"
    # check|severity|message — severity: error | warn | ok | info
    _dr() { printf '%s|%s|%s\n' "$1" "$2" "$3" >> "$out"; }

    # ── env ──
    local findings line
    if [ ! -f .env ]; then
        _dr env error "${deploy_dir}/.env does not exist"
    else
        findings="$(envcfg_validate || true)"
        if [ -z "$findings" ]; then _dr env ok "deploy/.env matches deploy/env.schema"; fi
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            _dr env "${line%%|*}" "$(echo "$line" | cut -d'|' -f2): $(echo "$line" | cut -d'|' -f3-)"
        done <<< "$findings"
        case "$(stat -c %a .env 2>/dev/null || stat -f %Lp .env 2>/dev/null)" in
            *[1-7]) _dr env warn ".env is readable by every local user (mode $(stat -c %a .env 2>/dev/null || stat -f %Lp .env)) — it holds the pod's secrets: chmod 600 .env" ;;
        esac
    fi

    # ── project ──
    local pinned owners extra
    pinned="$(envcfg_value COMPOSE_PROJECT_NAME)"
    if [ -n "$_SYNAP_PROJECT_CONFLICT" ]; then
        _dr project error "projects ${_SYNAP_PROJECT_CONFLICT} each own a postgres container for this deploy dir and none is pinned — inspect both before pinning COMPOSE_PROJECT_NAME"
    elif [ -z "$pinned" ]; then
        _dr project error "COMPOSE_PROJECT_NAME is not pinned in .env (resolved: ${COMPOSE_PROJECT_NAME:-?}) — the next synap update pins it"
    fi
    owners="$(_compose_projects_owning_postgres "$deploy_dir" | tr '\n' ' ' | sed 's/ $//')"
    local phys; phys="$(pwd -P)"
    extra="$(command docker compose ls -a --format json 2>/dev/null \
        | jq -r --arg d "$deploy_dir" --arg p "$phys" '.[] | select((.ConfigFiles // "") | split(",") | any(startswith($d + "/") or startswith($p + "/"))) | .Name' 2>/dev/null \
        | grep -vx "${COMPOSE_PROJECT_NAME:-}" | tr '\n' ' ' | sed 's/ $//')" || true
    for line in $owners; do
        [ "$line" = "${COMPOSE_PROJECT_NAME:-}" ] && continue
        case " $extra " in *" $line "*) ;; *) extra="${extra:+$extra }$line" ;; esac
    done
    if [ -n "$extra" ]; then
        _dr project error "other compose project(s) use this deploy dir: ${extra} (this pod: ${COMPOSE_PROJECT_NAME:-?}). Inspect before removing anything: docker compose -p <name> ps"
    elif [ -z "$_SYNAP_PROJECT_CONFLICT" ] && [ -n "$pinned" ]; then
        _dr project ok "one compose project: ${pinned}"
    fi

    # ── checkout ──
    local repo_root modified untracked
    repo_root="$(git -C "$deploy_dir" rev-parse --show-toplevel 2>/dev/null || true)"
    if [ -z "$repo_root" ]; then
        _dr checkout info "not a git checkout (release-bundle layout)"
    else
        modified="$(git -C "$repo_root" status --porcelain --untracked-files=no 2>/dev/null | awk '{print $NF}' | tr '\n' ' ' | sed 's/ $//')"
        untracked="$(git -C "$repo_root" status --porcelain 2>/dev/null | grep -c '^??' || true)"
        if [ -n "$modified" ]; then
            _dr checkout error "locally modified tracked files in ${repo_root}: ${modified} — a release bundle install would replace them; save them first"
        else
            _dr checkout ok "no locally modified tracked files (HEAD $(git -C "$repo_root" rev-parse --short=12 HEAD 2>/dev/null))"
        fi
        [ "${untracked:-0}" -gt 0 ] && _dr checkout info "${untracked} untracked, not-ignored path(s) in the checkout"
    fi

    # ── release ──
    local rel_id rel_sha rel_img cid run_img want_img stamp
    if [ ! -s state/current-release.json ]; then
        _dr release error "no state/current-release.json — this pod has never been updated by the release engine (the first synap update adopts the running images)"
    else
        rel_id="$(jq -r '.id // empty' state/current-release.json)"
        rel_sha="$(jq -r '.gitSha // empty' state/current-release.json)"
        rel_img="$(jq -r '.images.SYNAP_IMAGE_BACKEND // empty' state/current-release.json)"
        cid="$(command docker compose ps -q --status running backend 2>/dev/null | head -1)"
        if [ -z "$cid" ]; then
            _dr release error "release ${rel_id:-?} is recorded but no backend container is running"
        else
            run_img="$(command docker inspect -f '{{.Image}}' "$cid" 2>/dev/null || true)"
            want_img="$([ -n "$rel_img" ] && command docker image inspect -f '{{.Id}}' "$rel_img" 2>/dev/null || true)"
            stamp="$(command docker exec "$cid" node -e "$_UE_STATUS_PROBE" 2>/dev/null | jq -r '.buildStamp // empty' 2>/dev/null)"
            if [ -n "$rel_img" ] && [ "$run_img" != "$want_img" ]; then
                _dr release error "running backend image ${run_img:0:19} is not release ${rel_id}'s ${rel_img}"
            elif [ -n "$rel_sha" ] && [ -n "$stamp" ] && [ "$stamp" != "$rel_sha" ]; then
                _dr release error "running buildStamp ${stamp:0:12} ≠ release ${rel_id} gitSha ${rel_sha:0:12}"
            elif [ -n "$rel_sha" ] && [ -z "$stamp" ]; then
                _dr release warn "release ${rel_id}: the running backend reports no buildStamp (could not verify ${rel_sha:0:12})"
            else
                _dr release ok "running release ${rel_id}${stamp:+ (buildStamp ${stamp:0:12})}"
            fi
        fi
    fi

    # ── override ──
    if [ -f docker-compose.override.yml ]; then
        if grep -qs 'eve-managed:' docker-compose.override.yml; then
            if [ -z "$(envcfg_value SYNAP_EDGE)" ]; then
                _dr override error "Eve-managed override present but SYNAP_EDGE is not pinned — synap update refuses until: synap config set SYNAP_EDGE=traefik"
            else
                _dr override ok "Eve-managed override (edge: $(envcfg_value SYNAP_EDGE))"
            fi
        else
            _dr override error "docker-compose.override.yml has no eve-managed marker — an unmanaged override silently changes every compose command (services: $(awk '/^services:/{s=1;next} s&&/^  [A-Za-z0-9_.-]+:/{gsub(/[ :]/,"");printf "%s ",$0} /^[^ #]/&&!/^services:/{s=0}' docker-compose.override.yml))"
        fi
    else
        _dr override ok "no docker-compose.override.yml"
    fi

    # ── backup ── (the backup door's own helpers: deploy/pgdata-safety.sh)
    local bdir newest age m
    bdir="$(SYNAP_DEPLOY_DIR="$deploy_dir" _bk_backups_dir)"
    if [ -z "$(SYNAP_DEPLOY_DIR="$deploy_dir" _bk_cfg BACKUP_REPOSITORY)" ]; then
        _dr backup warn "no off-host backup repository (BACKUP_REPOSITORY) — dumps exist on this host only: synap backup init"
    elif [ ! -s "$(SYNAP_DEPLOY_DIR="$deploy_dir" _bk_password_file)" ]; then
        _dr backup error "BACKUP_REPOSITORY is set but the repository is not initialised: synap backup init"
    else
        _dr backup ok "off-host repository $(SYNAP_DEPLOY_DIR="$deploy_dir" _bk_repo_display)"
    fi
    for m in alarm push-failed drill-failed; do
        [ -e "$bdir/.$m" ] && _dr backup error "ALERT ${m}: $(head -c 200 "$bdir/.$m")"
    done
    newest="$(SYNAP_DEPLOY_DIR="$deploy_dir" _bk_good_dumps | tail -n 1)"
    if [ -z "$newest" ]; then
        _dr backup error "no hourly database dump in ${bdir} (is the postgres-backup service running?)"
    else
        age=$(( ( $(date +%s) - $(stat -c %Y "$newest" 2>/dev/null || stat -f %m "$newest") ) / 3600 ))
        if [ "$age" -gt 26 ]; then _dr backup error "newest dump $(basename "$newest") is ${age}h old (the backup service runs hourly)"
        else _dr backup ok "newest dump $(basename "$newest") (${age}h old)"; fi
    fi

    # ── pgdata ──
    local layout
    layout="$(SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" pgdata_layout 2>/dev/null || echo unknown)"
    case "$layout" in
        ok) _dr pgdata ok "postgres cluster is on its volume" ;;
        legacy) _dr pgdata error "postgres cluster lives in the container's writable layer — one recreate loses it; the next synap update/start moves it (pgdata guard)" ;;
        absent)
            if [ -e state/postgres-initialized ]; then _dr pgdata error "this pod is marked initialised but has no postgres container"
            else _dr pgdata info "no postgres container (fresh pod)"; fi ;;
        *) _dr pgdata warn "could not read the postgres layout" ;;
    esac

    # ── timescaledb ── (the update engine's own reader, _ue_tsdb_behind)
    if [ "$layout" = ok ] && [ -n "$(command docker compose ps -q --status running postgres 2>/dev/null)" ]; then
        local tsdb tdb tv tnew
        if tsdb="$(_ue_tsdb_behind)"; then
            [ -n "$tsdb" ] || _dr timescaledb ok "no database lags the TimescaleDB its postgres image ships"
            while IFS='|' read -r tdb tv tnew; do
                [ -n "$tdb" ] || continue
                _dr timescaledb info "database '${tdb}' runs TimescaleDB ${tv}; the postgres image ships up to ${tnew}. It keeps working; update it in a maintenance window: deploy/runbooks/timescaledb-update.md"
            done <<<"$tsdb"
        else
            _dr timescaledb warn "could not read the TimescaleDB extension versions or the postgres image's libraries"
        fi
    fi

    # ── disk ──
    local pct
    pct="$(df -Pk "$deploy_dir" 2>/dev/null | awk 'NR==2 { gsub(/%/, "", $5); print 100 - $5 }')"
    if [ -n "$pct" ] && [ "$pct" -lt "${SYNAP_DOCTOR_MIN_FREE_PCT:-15}" ]; then _dr disk warn "only ${pct}% free on ${deploy_dir} (updates keep 2 releases of images + dumps)"
    elif [ -n "$pct" ]; then _dr disk ok "${pct}% free"; fi
    # Headroom against the update's own floor (a from-source pod builds: 12 GB).
    local floor dshort
    floor="${SYNAP_UPDATE_MIN_FREE_MB:-2048}"
    [ "$(jq -r '.source // false' state/current-release.json 2>/dev/null || true)" = true ] && floor="${SYNAP_UPDATE_MIN_FREE_SOURCE_MB:-12288}"
    dshort="$(_ue_disk_short "$floor")"
    if [ -n "$dshort" ]; then _dr disk error "only ${dshort%% *} MB free on ${dshort#* } — the next update needs ${floor} MB (it first removes this pod's old release images; the rest is yours to free)"
    else _dr disk ok "update headroom: at least ${floor} MB free where updates write"; fi

    # ── lock ── who holds the update lock, for how long (a hung `synap update`
    # once held it 33 days: every later update failed fast against it).
    # flock: /proc/locks names the kernel's real holder — the owner text in the
    # file is only the LAST holder's, kept after it exits. mkdir fallback: the
    # owner pid's liveness. Reading only; the lock is never taken here.
    local lk ltext lpid lsince lheld="" lage="" lmax="${SYNAP_DOCTOR_LOCK_MAX_HOURS:-2}" lino
    if [ -d state/update.lock.d ]; then lk=state/update.lock.d/owner
    elif [ -f state/update.lock ]; then lk=state/update.lock
    else lk=""; fi
    if [ -z "$lk" ]; then
        _dr lock ok "no update lock (no operation has run)"
    else
        ltext="$(head -1 "$lk" 2>/dev/null)"
        lpid="$(sed -n 's/.* pid=\([0-9][0-9]*\).*/\1/p' <<<"$ltext")"
        lsince="$(sed -n 's/.* since=\([0-9TZ:-]*\).*/\1/p' <<<"$ltext")"
        if [ -n "$lsince" ]; then
            lage="$(date -u -d "$lsince" +%s 2>/dev/null || date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$lsince" +%s 2>/dev/null)"
            [ -n "$lage" ] && lage=$(( ( $(date +%s) - lage ) / 60 ))
        fi
        if [ "$lk" = state/update.lock ] && [ -r "${SYNAP_PROC_LOCKS:-/proc/locks}" ]; then
            lino="$(stat -c %i "$lk" 2>/dev/null || stat -f %i "$lk" 2>/dev/null)"
            lheld="$(awk -v ino="$lino" '$2 == "FLOCK" { n = split($6, a, ":"); if (a[n] == ino) { print $5; exit } }' "${SYNAP_PROC_LOCKS:-/proc/locks}")"
        elif [ -n "$lpid" ] && { kill -0 "$lpid" 2>/dev/null || ps -p "$lpid" >/dev/null 2>&1; }; then
            lheld="$lpid"
        fi
        if [ -n "$lheld" ]; then
            if [ -n "$lage" ] && [ "$lage" -ge $(( lmax * 60 )) ]; then
                _dr lock warn "update lock held for $(( lage / 60 ))h$(( lage % 60 ))m by pid ${lheld} (${ltext:-no owner text}) — a hung operation? Check: ps -p ${lheld} -o pid,etime,args. An update rolls back on SIGTERM: kill ${lheld}"
            else
                _dr lock info "an operation is running: ${ltext:-pid ${lheld}}${lage:+ (${lage}m)}"
            fi
            [ -n "$lpid" ] && [ "$lpid" != "$lheld" ] && _dr lock warn "the lock is held by pid ${lheld} but its owner text names pid ${lpid} (written from another PID namespace, e.g. a container?)"
        elif [ "$lk" = state/update.lock.d/owner ]; then
            _dr lock warn "stale mkdir update lock: holder ${ltext:-<no owner>} is gone (the next operation removes it; or: rm -rf ${deploy_dir}/state/update.lock.d)"
        else
            _dr lock ok "free (last holder: ${ltext:-unknown})"
        fi
    fi

    # ── containers ── Docker's own health verdict + restart counts. Docker acts
    # only on EXIT: an `unhealthy` container keeps running, so this is the one
    # place a crash-looping or unhealthy service shows up.
    local cids crow csvc cstate chealth crest cn=0 cbad=0 crestarts=""
    cids="$(command docker compose ps -a -q 2>/dev/null | tr '\n' ' ')"
    if [ -z "${cids// /}" ]; then
        _dr containers info "no containers for project ${COMPOSE_PROJECT_NAME:-?}"
    else
        while IFS='|' read -r csvc cstate chealth crest; do
            [ -n "$csvc" ] || continue
            cn=$((cn + 1))
            [ "${crest:-0}" -gt 0 ] 2>/dev/null && crestarts="${crestarts:+$crestarts, }${csvc}=${crest}"
            if [ "$cstate" = restarting ]; then
                _dr containers error "${csvc} is crash-looping (restarting, ${crest} restarts) — docker compose logs --tail 50 ${csvc}"; cbad=1
            elif [ "$cstate" = running ] && [ "$chealth" = unhealthy ]; then
                _dr containers error "${csvc} is unhealthy (${crest} restarts) — docker inspect --format '{{json .State.Health}}' \$(docker compose ps -q ${csvc})"; cbad=1
            elif [ "$cstate" = running ] && [ "${crest:-0}" -ge "${SYNAP_DOCTOR_MAX_RESTARTS:-5}" ] 2>/dev/null; then
                _dr containers warn "${csvc} has restarted ${crest} times — docker compose logs --tail 50 ${csvc}"; cbad=1
            fi
        done < <(command docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}|{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}|{{.RestartCount}}' $cids 2>/dev/null)
        [ "$cbad" = 0 ] && _dr containers ok "${cn} container(s), none unhealthy or crash-looping"
        [ -n "$crestarts" ] && _dr containers info "restart counts: ${crestarts}"
    fi

    # ── kratos ── the config Kratos boots from (generated, not in the release
    # bundle); kratos.yml.good = the last one an update verified.
    local kerrs
    kerrs="$(kratos_config_errors ../kratos/kratos.yml)"
    if [ -z "$kerrs" ]; then
        _dr kratos ok "kratos.yml is well-formed$([ -s ../kratos/kratos.yml.good ] && echo '; last verified copy: kratos.yml.good')"
    else
        while IFS= read -r line; do [ -n "$line" ] && _dr kratos error "kratos.yml: ${line}"; done <<< "$kerrs"
    fi

    # ── heal ── what synap heal gave up on, or only alerts about (never restarts)
    local hf hsvc hat hn=0
    for hf in state/heal/exhausted-* state/heal/alert-*; do
        [ -e "$hf" ] || continue
        hn=$((hn + 1)); hsvc="${hf##*/}"
        hat="$(head -1 "$hf" 2>/dev/null)"; hat="$(date -u -d "@${hat}" +%Y-%m-%dT%H:%MZ 2>/dev/null || date -u -r "${hat:-0}" +%Y-%m-%dT%H:%MZ 2>/dev/null || echo '?')"
        case "$hsvc" in
            exhausted-*) _dr heal error "heal stopped restarting ${hsvc#exhausted-} (restart budget used up, ${hat}) — it re-arms once the service is healthy: docker compose logs --tail 100 ${hsvc#exhausted-}" ;;
            alert-*)     _dr heal error "${hsvc#alert-} has been unhealthy since ${hat} — heal never restarts it: docker compose logs --tail 100 ${hsvc#alert-}" ;;
        esac
    done
    if [ "$hn" = 0 ]; then
        hn="$(grep -c . state/heal/restarts.log 2>/dev/null || true)"
        _dr heal ok "no service over its restart budget$([ "${hn:-0}" -gt 0 ] 2>/dev/null && echo "; ${hn} restart(s) by heal in the last ${SYNAP_HEAL_WINDOW_MIN:-30} min")"
    fi

    # ── units ── the timers that make this pod heal and take pushed updates
    local un ust ubad=""
    if _units_have_systemd; then
        for un in synap-heal.timer synap-update.path synap-compose.path; do
            ust="$(_units_state "$un" "$deploy_dir")"
            [ "$ust" = current ] && [ "$(systemctl is-active "$un" 2>/dev/null || true)" = active ] && continue
            [ "$ust" = current ] && ust=inactive
            ubad="${ubad:+$ubad, }${un} ${ust}"
        done
        if [ -n "$ubad" ]; then
            _dr units warn "${ubad} — this pod does not heal itself: sudo synap units install"
        else
            _dr units ok "heal and update-request units active; automatic updates $([ "$(systemctl is-enabled synap-update.timer 2>/dev/null || true)" = enabled ] && echo on || echo 'off (opt in: synap units install --enable-auto-update)')"
        fi
    else
        _dr units info "no systemd: heal runs only from cron (synap units install prints the line)"
    fi
    if [ -f state/requests/update.json ] && [ -n "$(find state/requests/update.json -mmin +10 2>/dev/null)" ]; then
        _dr units warn "an update request has waited over 10 min in state/requests/update.json — is synap-update.path active? (synap units status)"
    fi
    if [ -f state/requests/compose.json ] && [ -n "$(find state/requests/compose.json -mmin +10 2>/dev/null)" ]; then
        _dr units warn "a pod-agent compose request has waited over 10 min in state/requests/compose.json — is synap-compose.path active? (synap units status)"
    fi

    # ── url ──
    local pu
    pu="$(envcfg_value PUBLIC_URL)"
    if [ "${SYNAP_DOCTOR_PROBE:-1}" != 0 ] && [ -n "$pu" ] && command -v curl >/dev/null 2>&1; then
        if curl -fsS -o /dev/null --max-time 8 "${pu%/}/health" 2>/dev/null; then _dr url ok "${pu}/health answers"
        else _dr url warn "${pu}/health does not answer from this host (dead domain, DNS, or no hairpin route)"; fi
    fi

    local nfind
    nfind="$(grep -cE '^[^|]+\|(error|warn)\|' "$out" || true)"
    if [ "$json" = 1 ]; then
        jq -Rn --arg dir "$deploy_dir" --arg project "${COMPOSE_PROJECT_NAME:-}" '
            [inputs | capture("^(?<check>[^|]+)\\|(?<severity>[^|]+)\\|(?<message>.*)$")] as $all
            | { ok: ([$all[] | select(.severity == "error" or .severity == "warn")] | length == 0),
                deployDir: $dir, project: $project,
                findings: [$all[] | select(.severity == "error" or .severity == "warn")],
                checks: $all }' < "$out"
    else
        echo -e "${BLUE}🩺 synap doctor — ${deploy_dir} (project ${COMPOSE_PROJECT_NAME:-?})${NC}"
        local c sev msg
        while IFS='|' read -r c sev msg; do
            case "$sev" in
                ok)    echo -e "  ${GREEN}✓${NC} ${c}: ${msg}" ;;
                info)  echo -e "  · ${c}: ${msg}" ;;
                warn)  echo -e "  ${YELLOW}!${NC} ${c}: ${msg}" ;;
                *)     echo -e "  ${RED}✗${NC} ${c}: ${msg}" ;;
            esac
        done < "$out"
        [ "$nfind" = 0 ] && echo -e "${GREEN}No findings.${NC}" || echo -e "${YELLOW}${nfind} finding(s).${NC}"
    fi
    rm -f "$out"
    [ "$nfind" = 0 ]
}

cmd_rebuild() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-}
    local no_cache=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --no-cache)
                no_cache=true
                shift
                ;;
            *)
                if [ -z "$service" ]; then
                    service="$1"
                fi
                shift
                ;;
        esac
    done
    
    # If no service specified, show interactive menu
    if [ -z "$service" ]; then
        local services=($(docker compose ps --services 2>/dev/null))
        if [ ${#services[@]} -eq 0 ]; then
            echo -e "${RED}❌ No services found${NC}"
            exit 1
        fi
        
        echo -e "${BLUE}🔨 Rebuild Service${NC}"
        echo ""
        local i=1
        for svc in "${services[@]}"; do
            echo -e "  ${GREEN}[$i]${NC} $svc"
            ((i++))
        done
        echo ""
        echo -e "  ${BLUE}[a]${NC} All services"
        echo -e "  ${BLUE}[q]${NC} Quit"
        echo ""
        read -p "Select service (number/a/q): " choice
        
        case "$choice" in
            [0-9]*)
                local idx=$((choice - 1))
                if [ $idx -ge 0 ] && [ $idx -lt ${#services[@]} ]; then
                    service="${services[$idx]}"
                else
                    echo -e "${RED}Invalid selection${NC}"
                    exit 1
                fi
                ;;
            a|A)
                service=""
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    fi
    
    # First-party images (backend + realtime + migrate share one image; pod-admin)
    # are rebuilt through the update engine: the build is tagged synap-dev/*
    # (never the registry name) and goes through backup / canary / rollback (U6).
    case "$service" in
        ""|backend|realtime|backend-migrate|backend-canary|pod-admin)
            echo -e "${BLUE}🔨 Rebuilding first-party images via: synap update --from-source${NC}"
            cmd_update --from-source --force
            return $?
            ;;
    esac

    local build_cmd="docker compose build"
    if [ "$no_cache" = true ]; then
        build_cmd="$build_cmd --no-cache"
    fi
    
    if [ -z "$service" ]; then
        echo -e "${BLUE}🔨 Rebuilding all services...${NC}"
        eval "$build_cmd"
        echo -e "${BLUE}🔄 Restarting services...${NC}"
        docker compose up -d --remove-orphans
    else
        echo -e "${BLUE}🔨 Rebuilding $service...${NC}"
        eval "$build_cmd $service"
        echo -e "${BLUE}🔄 Restarting $service...${NC}"
        docker compose up -d --remove-orphans "$service"
    fi
    
    echo -e "${GREEN}✅ Rebuild complete!${NC}"
}

cmd_errors() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-}
    local tail_lines=${2:-100}
    
    echo -e "${BLUE}🔍 Searching for errors in logs...${NC}"
    echo ""
    
    if [ -z "$service" ]; then
        # Search all services
        local services=($(docker compose ps --services 2>/dev/null))
        for svc in "${services[@]}"; do
            local status=$(docker compose ps "$svc" --format json 2>/dev/null | grep -o '"State":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
            if [ "$status" = "running" ]; then
                echo -e "${YELLOW}━━━ $svc ━━━${NC}"
                docker compose logs --tail="$tail_lines" "$svc" 2>&1 | grep -i "error\|fatal\|panic\|exception\|failed" | head -20 || echo "  No errors found"
                echo ""
            fi
        done
    else
        echo -e "${YELLOW}━━━ $service ━━━${NC}"
        docker compose logs --tail="$tail_lines" "$service" 2>&1 | grep -i "error\|fatal\|panic\|exception\|failed" | head -50 || echo "  No errors found"
    fi
}

cmd_diagnose() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    echo -e "${BLUE}🔍 Synap Diagnostics${NC}"
    echo ""
    
    # Check Docker
    echo -e "${BLUE}1. Docker Status${NC}"
    if command -v docker &> /dev/null; then
        echo -e "${GREEN}✓ Docker installed${NC}"
        docker --version
    else
        echo -e "${RED}❌ Docker not found${NC}"
    fi
    echo ""
    
    # Check services
    echo -e "${BLUE}2. Services Status${NC}"
    docker compose ps
    echo ""
    
    # Check for errors
    echo -e "${BLUE}3. Recent Errors${NC}"
    cmd_errors "" 50
    echo ""
    
    # Check disk space
    echo -e "${BLUE}4. Disk Space${NC}"
    df -h . | tail -1
    echo ""
    
    # Check Docker resources
    echo -e "${BLUE}5. Docker Resources${NC}"
    docker system df
    echo ""
    
    # Check health endpoints
    echo -e "${BLUE}6. Health Checks${NC}"
    if docker compose ps backend | grep -q "Up"; then
        if curl -sf http://localhost:4000/health > /dev/null 2>&1; then
            echo -e "${GREEN}✓ Backend health endpoint responding${NC}"
        else
            echo -e "${RED}❌ Backend health endpoint not responding${NC}"
        fi
    fi
    echo ""
}

cmd_clean() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local what=${1:-}

    # `clean` NEVER touches volumes. The 2026-10-02 pod wipe was an update
    # episode followed by a volume-pruning `system prune`; a stopped stack's
    # postgres/minio/kratos volumes count as "unused" to Docker. The one
    # explicit wipe door is `synap reset --full --delete-data` (backup first,
    # typed domain, this project's volumes only).
    _clean_refuse_volumes() {
        echo -e "${RED}synap clean never removes Docker volumes — they hold the pod's database and files.${NC}"
        echo "To deliberately wipe THIS pod's data: synap reset --full --delete-data (takes a verified backup first)."
        exit 1
    }
    # Only THIS pod's leftovers: the host may run other stacks (the owner's own
    # images, stopped containers, networks) that a global prune would delete.
    _clean_images() { synap_update_lock "$deploy_dir" "synap clean" || exit 1; _ue_prune_images; }
    _clean_networks() {
        local n
        for n in $(docker network ls -q --filter "label=com.docker.compose.project=${COMPOSE_PROJECT_NAME:-}" 2>/dev/null); do
            docker network rm "$n" >/dev/null 2>&1 || true   # in use ⇒ refused by docker
        done
    }
    
    if [ -z "$what" ]; then
        echo -e "${BLUE}🧹 Clean Docker Resources${NC} (volumes are never removed)"
        echo ""
        echo "  ${GREEN}[1]${NC} Remove this pod's stopped containers"
        echo "  ${GREEN}[2]${NC} Remove this pod's old release images (first-party only)"
        echo "  ${GREEN}[3]${NC} Remove this pod's unused networks"
        echo "  ${GREEN}[4]${NC} All three (volumes and other stacks are never touched)"
        echo "  ${GREEN}[5]${NC} Remove build cache"
        echo "  ${GREEN}[q]${NC} Quit"
        echo ""
        read -p "Select option (number/q): " choice
        
        case "$choice" in
            1)
                docker compose rm -f
                ;;
            2)
                _clean_images
                ;;
            3)
                _clean_networks
                ;;
            4)
                echo -e "${YELLOW}⚠️  This removes this pod's stopped containers, old release images and unused networks (volumes are kept)${NC}"
                read -p "Continue? (y/N): " CONFIRM
                if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
                    docker compose rm -f; _clean_images; _clean_networks
                fi
                ;;
            5)
                docker builder prune -f
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    else
        case "$what" in
            containers)
                docker compose rm -f
                ;;
            images)
                _clean_images
                ;;
            volumes)
                _clean_refuse_volumes
                ;;
            networks)
                _clean_networks
                ;;
            all)
                echo -e "${YELLOW}⚠️  This removes this pod's stopped containers, old release images and unused networks (volumes are kept)${NC}"
                read -p "Continue? (y/N): " CONFIRM
                if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
                    docker compose rm -f; _clean_images; _clean_networks
                fi
                ;;
            cache)
                docker builder prune -f
                ;;
            *)
                echo "Usage: synap clean [containers|images|networks|all|cache]"
                exit 1
                ;;
        esac
    fi
    
    echo -e "${GREEN}✅ Cleanup complete!${NC}"
}

# ── heal (self-heal D1: synap-heal.timer, every 2 min) ────────────────────────
# Docker restarts a container only when it EXITS; `unhealthy` is reported and
# never acted on outside Swarm. heal restarts this project's containers that
# Docker marks unhealthy, within a budget of SYNAP_HEAL_MAX_RESTARTS (3) per
# SYNAP_HEAL_WINDOW_MIN (30) per service. A service that uses it up is no longer
# restarted (marker state/heal/exhausted-<svc>, a doctor finding, a notify
# event) until heal sees it healthy again. SYNAP_HEAL_NEVER (postgres — a
# restart mid-write risks the data; postgres-backup — its health is backup
# freshness, which a restart cannot fix) are alerted on, never restarted.
# Kratos unhealthy or crash-looping on a kratos.yml that differs from the last
# verified one (kratos.yml.good, kept by every verified update): when the file
# is malformed, Kratos crash-loops, or a restart already did not help, the .good
# copy is restored (the replaced file kept as kratos.yml.broken-<ts>) and Kratos
# recreated. Reads first, lock-free; takes the update lock only to act, and
# skips while an update, apply or install holds it.
_heal_rows() { # "<service>|<status>|<health>" per container of this project
    local ids
    ids="$(docker compose ps -a -q 2>/dev/null | tr '\n' ' ')"
    [ -n "${ids// /}" ] || return 0
    # shellcheck disable=SC2086 # one id per word
    docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}|{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' $ids 2>/dev/null || true
}

_heal_count() { # <service> — heal's restarts of it inside the window
    local since=$(( $(date +%s) - ${SYNAP_HEAL_WINDOW_MIN:-30} * 60 ))
    awk -v s="$1" -v t="$since" '$2 == s && $1 >= t' state/heal/restarts.log 2>/dev/null | grep -c . || true
}

_heal_event() { # <status> <service> <reason> [notify 0|1]
    _synap_event "$(jq -cn --arg st "$1" --arg svc "$2" --arg r "$3" --argjson n "$(_heal_count "$2")" \
        '{kind:"pod.heal", status:$st, service:$svc, reason:$r, restartsInWindow:$n}')" "${4:-0}"
}

# <state> <restarts-in-window> — 0 when the last verified kratos.yml was restored.
_heal_kratos_restore() {
    local cur=../kratos/kratos.yml good=../kratos/kratos.yml.good keep
    [ -s "$good" ] && [ -z "$(kratos_config_errors "$good")" ] || return 1
    [ -f "$cur" ] && cmp -s "$cur" "$good" && return 1
    [ -n "$(kratos_config_errors "$cur")" ] || [ "$1" = restarting ] || [ "$2" -ge 1 ] || return 1
    keep="../kratos/kratos.yml.broken-$(date -u +%Y%m%dT%H%M%SZ)"
    [ -f "$cur" ] && cp -p "$cur" "$keep"
    cp -p "$good" "$cur" || return 1   # in place: the bind mount keeps its inode
    docker compose up -d --no-deps --force-recreate kratos >/dev/null 2>&1 </dev/null || true
    echo "$(date +%s) kratos" >> state/heal/restarts.log
    _heal_event kratos_config_restored kratos "Kratos was ${1} on a kratos.yml that differs from the last verified one: restored kratos.yml.good (the replaced file: ${keep#../kratos/})" 1
}

# The systemd units belong to the release, and synap-heal.timer runs the
# INSTALLED `synap` — the file every update replaces. So a release whose units
# changed reaches the host within one heal tick, whichever engine ran the
# update: an engine without _ue_units_refresh (≤ v1.1.4, before H1) installs
# the new templates and the new `synap`, never the units, and its pods would
# otherwise never get synap-compose.path (every pod-agent compose request then
# fails "the host did not take it"). Only where the owner installed the units
# (synap-heal.timer present) and only for this deploy dir; under the update
# lock, so never half-way through an update (busy ⇒ next tick).
_heal_units_converge() {
    local dst="${SYNAP_SYSTEMD_DIR:-/etc/systemd/system}" dir u stale="" out
    _units_have_systemd || return 0
    [ "$(id -u)" = 0 ] || [ -n "${SYNAP_SYSTEMD_DIR:-}" ] || return 0
    [ -f "$dst/synap-heal.timer" ] || return 0
    dir="$(pwd -P)"
    grep -qxF "Environment=SYNAP_DEPLOY_DIR=${dir}" "$dst/synap-heal.service" 2>/dev/null || return 0
    for u in $(_units_names systemd); do
        [ "$(_units_state "$u" "$dir")" = current ] || stale="${stale} ${u}"
    done
    [ -n "$stale" ] || return 0
    if out="$( { synap_update_lock "$dir" "synap heal (units)" 2>/dev/null || exit 3; cmd_units install; } 2>&1 </dev/null )"; then
        echo "synap heal: systemd units re-rendered from this release (were not current:${stale})"
    elif [ $? = 3 ]; then
        echo "synap heal: units not current (${stale# }) — another pod operation holds the update lock; next tick"
    else
        echo "synap heal: could not re-render the systemd units ($(printf '%s' "$out" | tail -1)) — run: sudo $(_units_self) units install" >&2
    fi
    return 0
}

cmd_heal() {
    case "${1:-}" in -h|--help) echo "Usage: synap heal   (restart this pod's unhealthy containers within a budget; run by synap-heal.timer)"; return 0 ;; esac
    local deploy_dir=$(get_deploy_dir)
    [ -n "$deploy_dir" ] || { echo -e "${RED}Error: Not in Synap installation directory${NC}"; exit 1; }
    cd "$deploy_dir"
    command -v jq >/dev/null 2>&1 || { echo -e "${RED}synap heal needs jq${NC}" >&2; exit 2; }
    mkdir -p state/heal
    _heal_units_converge
    local max="${SYNAP_HEAL_MAX_RESTARTS:-3}" never=" ${SYNAP_HEAL_NEVER:-postgres postgres-backup} " rows svc st h m n todo=""
    rows="$(_heal_rows)"
    while IFS='|' read -r svc st h; do
        [ -n "$svc" ] || continue
        if [ "$st" = running ] && { [ "$h" = healthy ] || [ "$h" = none ]; }; then
            for m in exhausted alert; do
                [ -e "state/heal/${m}-${svc}" ] || continue
                rm -f "state/heal/${m}-${svc}"
                _heal_event recovered "$svc" "${svc} is healthy again — heal re-armed" 1
            done
        elif { [ "$st" = running ] && [ "$h" = unhealthy ]; } || { [ "$svc" = kratos ] && [ "$st" = restarting ]; }; then
            grep -qx "${svc}|.*" <<<"$todo" || todo="${todo}${svc}|${st}|${h}"$'\n'
        fi
    done <<<"$rows"
    # Forget restarts older than the window.
    if [ -s state/heal/restarts.log ]; then
        awk -v t="$(( $(date +%s) - ${SYNAP_HEAL_WINDOW_MIN:-30} * 60 ))" '$1 >= t' state/heal/restarts.log > state/heal/restarts.log.tmp \
            && mv -f state/heal/restarts.log.tmp state/heal/restarts.log
    fi
    [ -n "$todo" ] || return 0
    if ! synap_update_lock "$deploy_dir" "synap heal" 2>/dev/null; then
        echo "synap heal: another pod operation holds the update lock — not acting now"
        return 0
    fi
    while IFS='|' read -r svc st h; do
        [ -n "$svc" ] || continue
        case "$never" in
            *" ${svc} "*)
                if [ ! -e "state/heal/alert-${svc}" ]; then
                    date +%s > "state/heal/alert-${svc}"
                    _heal_event alert "$svc" "${svc} is ${h/none/$st} — heal never restarts it: docker compose logs --tail 100 ${svc}; synap doctor" 1
                fi
                continue ;;
        esac
        [ -e "state/heal/exhausted-${svc}" ] && continue
        n="$(_heal_count "$svc")"
        if [ "$svc" = kratos ] && _heal_kratos_restore "$st" "$n"; then continue; fi
        # A crash loop is Docker's to back off; heal acts on `unhealthy` only.
        [ "$st" = running ] || continue
        if [ "$n" -ge "$max" ]; then
            date +%s > "state/heal/exhausted-${svc}"
            _heal_event budget_exhausted "$svc" "${svc} was restarted ${n} times in ${SYNAP_HEAL_WINDOW_MIN:-30} min and is still unhealthy — heal stopped restarting it: docker compose logs --tail 100 ${svc}; synap doctor" 1
            continue
        fi
        echo "$(date +%s) ${svc}" >> state/heal/restarts.log
        if docker compose restart "$svc" >/dev/null 2>&1 </dev/null; then
            _heal_event restarted "$svc" "${svc} was unhealthy" 0
        else
            _heal_event restart_failed "$svc" "docker compose restart ${svc} failed" 1
        fi
    done <<<"$todo"
    return 0
}

# ── compose requests from pod-agent (H3) ──────────────────────────────────────
# pod-agent runs in a container with the deploy dir mounted at /deploy. A
# `docker compose up` it runs resolves the compose file's RELATIVE binds
# (./Caddyfile, ../kratos, ./state, …) against /deploy, and the host's docker
# daemon then mounts the HOST's /deploy — which does not exist. The CP's
# email-relay delivery (configure → recreate kratos + backend) brought kratos up
# with no config, and sign-in died. So pod-agent never creates a container: it
# writes a REQUEST and this host door runs it, with the real deploy dir, the
# pgdata guard, the update lock and the kratos render — one door, like updates.
#
# COMPOSE REQUEST CONTRACT (schema 1), written atomically (tmp + rename) to
# <deploy dir>/state/requests/compose.json (writer: deploy/host-request.sh):
#   {"schema":1, "id":"<opaque>", "services":["kratos",…] (empty = every service),
#    "recreate":true|false, "noDeps":true|false, "profiles":["pod-agent",…]}
# Names are compose services / profiles of THIS compose file (checked). Taken
# (renamed to compose.taken.json) before anything else, then run under the
# update lock, which it waits for up to SYNAP_COMPOSE_LOCK_WAIT seconds (300);
# the outcome is state/last-compose-request.json {kind:"pod.compose-request",
# status: succeeded|failed|aborted, request:<id>, reason}. Started by synap-compose.path.
_CR_NAME_RE='^[a-z0-9][a-z0-9_-]{0,63}$'
_CR_ID_RE='^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$'

_cr_take() { _synap_take_request compose; }

_cr_record() { # <status> <request-id> <reason> [services]
    _synap_event "$(jq -cn --arg s "$1" --arg r "$2" --arg why "$3" --arg svc "${4:-}" \
        '{kind:"pod.compose-request", status:$s, request:$r, reason:$why, services:$svc}')" 0 state/last-compose-request.json >/dev/null
}

cmd_compose_request() {
    local deploy_dir req id wait known profiles=() services=() pargs=() args=(up -d --no-build) n bad="" dropped="" domain rc=0 out
    deploy_dir="$(get_deploy_dir)"
    [ -n "$deploy_dir" ] || { echo -e "${RED}Error: Not in Synap installation directory${NC}"; exit 1; }
    cd "$deploy_dir"
    command -v jq >/dev/null 2>&1 || { echo -e "${RED}jq is required${NC}"; exit 1; }
    req="$(_cr_take)"
    [ -n "$req" ] || { echo "no compose request waiting"; return 0; }
    id="$(jq -r '.id // empty' "$req" 2>/dev/null || true)"
    # Taken first (so the agent sees it picked up and the .path unit cannot
    # loop on it), THEN the update lock — waited for, bounded: an update
    # mid-way is minutes, and the agent waits HOST_REQUEST_TIMEOUT_SECONDS (540)
    # for the outcome. Every read below runs under the lock, so a request never
    # meets a compose file or .env that an update is swapping.
    wait="${SYNAP_COMPOSE_LOCK_WAIT:-300}"
    [[ "$wait" =~ ^[0-9]+$ ]] || wait=300
    if ! synap_update_lock "$deploy_dir" "synap compose-request" "$wait"; then
        _cr_record aborted "$id" "another pod operation held the update lock for ${wait}s — the request was not run; send it again"
        exit 1
    fi
    if ! [[ "$id" =~ $_CR_ID_RE ]] || [ "$(jq -r '.schema // empty' "$req" 2>/dev/null)" != 1 ] \
        || ! jq -e '(.services // []) | type == "array"' "$req" >/dev/null 2>&1 \
        || ! jq -e '(.profiles // []) | type == "array"' "$req" >/dev/null 2>&1; then
        _cr_record aborted "$id" "invalid compose request: it must be {\"schema\":1, \"id\":…, \"services\":[…], \"profiles\":[…]}"
        echo -e "${RED}❌ invalid compose request ${id:-<no id>} — nothing was run${NC}" >&2
        exit 1
    fi
    while IFS= read -r n; do [ -n "$n" ] && profiles+=("$n"); done < <(jq -r '(.profiles // [])[] | tostring' "$req")
    while IFS= read -r n; do [ -n "$n" ] && services+=("$n"); done < <(jq -r '(.services // [])[] | tostring' "$req")
    # A profile this compose file no longer has (an older CP's retired add-on)
    # activates nothing: it is dropped, and said so — never passed through.
    # A failed read is not "no such profile": refuse rather than run the request
    # without the profiles it asked for and record it as a success.
    known="$(docker compose config --profiles 2>/dev/null)" || {
        _cr_record failed "$id" "could not read this pod's compose profiles (docker compose config failed)"
        echo -e "${RED}❌ compose request ${id}: could not read the compose file — nothing was run${NC}" >&2
        exit 1
    }
    for n in "${profiles[@]}"; do
        if [[ "$n" =~ $_CR_NAME_RE ]] && grep -qx "$n" <<<"$known"; then pargs+=(--profile "$n"); else dropped="${dropped} ${n}"; fi
    done
    [ -z "$dropped" ] || echo -e "${YELLOW}compose request ${id}: no such profile here, ignored:${dropped}${NC}"
    known="$(docker compose "${pargs[@]}" config --services 2>/dev/null)" || {
        _cr_record failed "$id" "could not read this pod's compose services (docker compose config failed)"
        echo -e "${RED}❌ compose request ${id}: could not read the compose file — nothing was run${NC}" >&2
        exit 1
    }
    for n in "${services[@]}"; do
        [[ "$n" =~ $_CR_NAME_RE ]] && grep -qx "$n" <<<"$known" || bad="${bad} service:${n}"
    done
    if [ -n "$bad" ]; then
        _cr_record aborted "$id" "unknown names in the compose request:${bad}" "${services[*]}"
        echo -e "${RED}❌ compose request ${id} names what this compose file does not have:${bad} — nothing was run${NC}" >&2
        exit 1
    fi
    # --no-build: a pod never builds; a request only ever runs pinned images.
    # What is derived from the pod's names follows the current .env first (a
    # Control Plane `configure` that moved the pod to new names): the
    # first-party base SYNAP_BASE_DOMAIN the backend and realtime read, the old
    # origins in ALLOWED_ORIGINS, and Kratos's GENERATED kratos.yml (what
    # configure-pod.sh used to reach through `synap start kratos`).
    domain="$(_ue_env_get DOMAIN)"
    if [ -n "$domain" ] && { [ "${#services[@]}" = 0 ] || printf '%s\n' "${services[@]}" | grep -qxE 'kratos|backend|realtime'; }; then
        backfill_federation_public_urls "$domain"
        reconcile_moved_origins
    fi
    if [ "${#services[@]}" = 0 ] || printf '%s\n' "${services[@]}" | grep -qx kratos; then
        if [ -n "$domain" ] && ! generate_kratos_config "$domain"; then
            _cr_record failed "$id" "kratos config generation failed" "${services[*]}"
            exit 1
        fi
    fi
    [ "$(jq -r '.recreate // false' "$req")" = true ] && args+=(--force-recreate)
    [ "$(jq -r '.noDeps // false' "$req")" = true ] && args+=(--no-deps)
    [ "${#services[@]}" = 0 ] && args+=(--remove-orphans)
    echo -e "${BLUE}🔁 compose request ${id}: docker compose ${pargs[*]} ${args[*]} ${services[*]}${NC}"
    out="$(docker compose "${pargs[@]}" "${args[@]}" "${services[@]}" 2>&1 </dev/null)" || rc=$?
    printf '%s\n' "$out" | tail -20
    if [ "$rc" = 0 ]; then
        _cr_record succeeded "$id" "${dropped:+ignored unknown profiles:${dropped}}" "${services[*]}"
    else
        _cr_record failed "$id" "docker compose up failed: $(printf '%s' "$out" | tail -1 | cut -c1-300)" "${services[*]}"
        exit 1
    fi
}

# ── units (systemd) ───────────────────────────────────────────────────────────
# deploy/systemd/ holds the unit TEMPLATES (@SYNAP@ = this CLI, @DEPLOY_DIR@ =
# this deploy dir); the set is whatever is in that directory. Installed:
# synap-heal.timer, synap-update.path and synap-compose.path enabled;
# synap-update.timer written but left as the owner set it (off on a fresh
# install; --enable-auto-update turns it on). Hosts without systemd get the
# cron lines to add by hand.
_units_have_systemd() { [ -d "${SYNAP_SYSTEMD_RUN_DIR:-/run/systemd/system}" ] && command -v systemctl >/dev/null 2>&1; }
_units_names() { (cd "$1" 2>/dev/null && ls -1 synap-*.service synap-*.timer synap-*.path 2>/dev/null) || true; }
_units_self() { readlink -f "$SYNAP_SELF" 2>/dev/null || echo "$SYNAP_SELF"; }
_units_render() { # <template> <deploy-dir>
    sed -e "s#@SYNAP@#$(_units_self)#g" -e "s#@DEPLOY_DIR@#$2#g" "$1"
}
# <unit> <deploy-dir> → missing | outdated | current (installed vs this template)
_units_state() {
    local dst="${SYNAP_SYSTEMD_DIR:-/etc/systemd/system}"
    [ -f "$dst/$1" ] || { echo missing; return 0; }
    _units_render "$2/systemd/$1" "$(cd "$2" && pwd -P)" | cmp -s - "$dst/$1" && echo current || echo outdated
}

cmd_units() {
    local sub="${1:-status}" auto=0 force=0 u
    [ $# -gt 0 ] && shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --enable-auto-update) auto=1 ;;
            --force) force=1 ;;
            *) echo -e "${RED}Unknown option: $1${NC}"; exit 1 ;;
        esac
        shift
    done
    local deploy_dir=$(get_deploy_dir)
    [ -n "$deploy_dir" ] || { echo -e "${RED}Error: Not in Synap installation directory${NC}"; exit 1; }
    deploy_dir="$(cd "$deploy_dir" && pwd -P)"
    cd "$deploy_dir"
    local src="$deploy_dir/systemd" dst="${SYNAP_SYSTEMD_DIR:-/etc/systemd/system}" names
    names="$(_units_names "$src")"
    case "$sub" in
        install)
            [ -n "$names" ] || { echo -e "${RED}No unit templates in ${src}${NC}"; exit 1; }
            mkdir -p state/requests state/heal
            if ! _units_have_systemd; then
                echo -e "${YELLOW}No systemd on this host — add this line to /etc/cron.d/synap (as root) instead:${NC}"
                echo "*/2 * * * * root SYNAP_DEPLOY_DIR=${deploy_dir} $(_units_self) heal >/dev/null 2>&1"
                echo "(Pushed update requests and automatic updates need systemd; run \`synap update\` by hand.)"
                return 0
            fi
            if [ "$(id -u)" != 0 ] && [ -z "${SYNAP_SYSTEMD_DIR:-}" ]; then
                echo -e "${RED}Installing systemd units needs root: sudo $(_units_self) units install${NC}"; exit 1
            fi
            for u in $names; do
                # The .service units carry the deploy dir (timers/path name only their unit).
                if [ -f "$dst/$u" ] && grep -q "SYNAP_DEPLOY_DIR=" "$dst/$u" && ! grep -qxF "Environment=SYNAP_DEPLOY_DIR=${deploy_dir}" "$dst/$u" && [ "$force" = 0 ]; then
                    echo -e "${RED}${dst}/${u} is installed for another deploy dir ($(sed -n 's/.*SYNAP_DEPLOY_DIR=\([^ "]*\).*/\1/p' "$dst/$u" | head -1)). One pod per host: re-run with --force to repoint it here.${NC}"
                    exit 1
                fi
            done
            for u in $names; do
                _units_render "$src/$u" "$deploy_dir" > "$dst/$u.synap-new" && mv -f "$dst/$u.synap-new" "$dst/$u" \
                    || { echo -e "${RED}could not write ${dst}/${u}${NC}"; exit 1; }
            done
            systemctl daemon-reload
            systemctl enable --now synap-heal.timer synap-update.path synap-compose.path
            [ "$auto" = 1 ] && systemctl enable --now synap-update.timer
            echo -e "${GREEN}✓ units installed in ${dst}: heal every 2 min, update requests watched$([ "$auto" = 1 ] && echo ', automatic updates ON (03:00–05:00, state/update-policy.json)' || echo '; automatic updates: see synap units status')${NC}"
            _synap_event "$(jq -cn --arg d "$dst" --argjson auto "$auto" '{kind:"pod.units", status:"installed", dir:$d, autoUpdateEnabledNow:($auto == 1)}')" 0 >/dev/null
            ;;
        status)
            [ -n "$names" ] || { echo "no unit templates in ${src}"; return 0; }
            if ! _units_have_systemd; then echo "no systemd on this host — see: synap units install (prints the cron lines)"; return 0; fi
            for u in $names; do
                local inst
                case "$(_units_state "$u" "$deploy_dir")" in
                    missing)  inst="not installed" ;;
                    outdated) inst="installed (OUTDATED: re-run synap units install)" ;;
                    *)        inst="installed" ;;
                esac
                printf '  %-22s %-44s %s/%s\n' "$u" "$inst" "$(systemctl is-enabled "$u" 2>/dev/null || true)" "$(systemctl is-active "$u" 2>/dev/null || true)"
            done
            ;;
        remove)
            if _units_have_systemd; then
                for u in $names; do
                    case "$u" in *.timer|*.path) systemctl disable --now "$u" >/dev/null 2>&1 || true ;; esac
                done
            fi
            for u in $names; do rm -f "$dst/$u"; done
            _units_have_systemd && systemctl daemon-reload
            echo "units removed from ${dst}"
            ;;
        *) echo "Usage: synap units install [--enable-auto-update] [--force] | status | remove"; exit 1 ;;
    esac
}

# The installer's last step: units when this host can take them, else the hint.
_units_install_best_effort() {
    if _units_have_systemd && [ "$(id -u)" = 0 ]; then
        ( cmd_units install ) || echo -e "${YELLOW}⚠️  Self-heal + update units not installed — run: sudo $(_units_self) units install${NC}"
    else
        echo -e "${YELLOW}ℹ️  Self-heal + pushed updates: run 'sudo $(_units_self) units install' (prints the cron line on hosts without systemd)${NC}"
    fi
}

cmd_shell() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-backend}
    local shell=${2:-sh}
    
    echo -e "${BLUE}🐚 Opening shell in $service (using $shell)...${NC}"
    docker compose exec "$service" "$shell"
}

cmd_exec() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    local service=$1
    shift

    if [ -z "$service" ] || [ $# -eq 0 ]; then
        echo "Usage: synap exec <service> <command> [args...]"
        echo "Example: synap exec backend node --version"
        exit 1
    fi

    docker compose exec "$service" "$@"
}

# ============================================================================
# PROFILES — Optional docker-compose profiles (RSSHub, monitoring)
# ============================================================================

cmd_profiles() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory (set SYNAP_DEPLOY_DIR or run from repo/deploy)${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    local action="${1:-help}"
    shift || true

    case "$action" in
        enable)
            local name="${1:-}"
            if [ -z "$name" ]; then
                echo -e "${RED}Usage: synap profiles enable <rsshub|monitoring>${NC}"
                exit 1
            fi
            case "$name" in
                rsshub)
                    echo -e "${BLUE}📡 Enabling RSSHub (browserless + rsshub)...${NC}"
                    docker compose --profile rsshub up -d browserless rsshub
                    ;;
                monitoring)
                    echo -e "${BLUE}📊 Enabling Dozzle (logs UI)...${NC}"
                    docker compose --profile monitoring up -d dozzle
                    ;;
                *)
                    echo -e "${RED}Unknown profile: ${name}${NC}"
                    echo "Known: rsshub, monitoring"
                    exit 1
                    ;;
            esac
            echo -e "${GREEN}✅ Profile ${name} enabled${NC}"
            ;;

        disable)
            local name="${1:-}"
            if [ -z "$name" ]; then
                echo -e "${RED}Usage: synap profiles disable <rsshub|monitoring>${NC}"
                exit 1
            fi
            case "$name" in
                rsshub)
                    echo -e "${BLUE}📡 Stopping RSSHub stack...${NC}"
                    docker compose stop rsshub browserless 2>/dev/null || true
                    ;;
                monitoring)
                    echo -e "${BLUE}📊 Stopping Dozzle...${NC}"
                    docker compose stop dozzle 2>/dev/null || true
                    ;;
                *)
                    echo -e "${RED}Unknown profile: ${name}${NC}"
                    echo "Known: rsshub, monitoring"
                    exit 1
                    ;;
            esac
            echo -e "${GREEN}✅ Profile ${name} stopped (containers may still exist; use docker compose rm if needed)${NC}"
            ;;

        status)
            echo -e "${BLUE}Optional profile services:${NC}"
            docker compose ps rsshub browserless dozzle 2>/dev/null || true
            ;;

        help|--help|-h|"")
            cat << EOF
${BLUE}Synap Profiles${NC} — Optional Docker Compose stacks

${YELLOW}Usage:${NC}
  synap profiles enable <name>    Start profile services
  synap profiles disable <name>   Stop profile services
  synap profiles status             Show rsshub / dozzle status

${YELLOW}Names:${NC}
  rsshub       RSSHub + browserless (RSS aggregation)
  monitoring   Dozzle log viewer (port 8888)

${YELLOW}Install-time:${NC}
  synap install --domain localhost --with-rsshub

${YELLOW}Environment:${NC}
  SYNAP_DEPLOY_DIR=/path/to/deploy  # Run from any cwd
EOF
            ;;

        *)
            echo -e "${RED}Unknown profiles action: ${action}${NC}"
            echo "Run 'synap profiles help'"
            exit 1
            ;;
    esac
}

# ============================================================================
# TUNNEL COMMAND
# Self-hosted operators expose their pod via Cloudflare Tunnel or Pangolin.
# This is the "bring your own token" path — the operator pastes a token and
# we wire it into .env + activate the matching compose profile.
# CP-managed tunnels follow a different flow (pod-agent /configure).
# ============================================================================

# Resolve a tunnel provider's env var name. Keep this the single source of truth.
_tunnel_env_var_for() {
    case "$1" in
        cloudflare) echo "CLOUDFLARED_TUNNEL_TOKEN" ;;
        pangolin)   echo "PANGOLIN_NEWT_TOKEN" ;;
        *)          echo "" ;;
    esac
}

_tunnel_profile_for() {
    case "$1" in
        cloudflare) echo "cloudflare-tunnel" ;;
        pangolin)   echo "pangolin-tunnel" ;;
        *)          echo "" ;;
    esac
}

_tunnel_service_for() {
    case "$1" in
        cloudflare) echo "cloudflared" ;;
        pangolin)   echo "pangolin-tunnel" ;;
        *)          echo "" ;;
    esac
}

# Read a token from --token or --token-file, with basic sanity checks.
# Sets the global TUNNEL_TOKEN_VALUE on success, empties it on failure.
_tunnel_read_token() {
    local token_arg="$1"
    local token_file="$2"
    TUNNEL_TOKEN_VALUE=""

    if [ -n "$token_arg" ] && [ -n "$token_file" ]; then
        echo -e "${RED}Error: pass either --token or --token-file, not both${NC}"
        return 1
    fi
    if [ -n "$token_file" ]; then
        if [ ! -f "$token_file" ]; then
            echo -e "${RED}Error: token file not found: ${token_file}${NC}"
            return 1
        fi
        # Strip leading/trailing whitespace + any stray newline
        TUNNEL_TOKEN_VALUE=$(tr -d '\r\n' < "$token_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    else
        TUNNEL_TOKEN_VALUE="$token_arg"
    fi
    if [ -z "$TUNNEL_TOKEN_VALUE" ]; then
        echo -e "${RED}Error: tunnel token is empty${NC}"
        return 1
    fi
    return 0
}

# Comment out a key in .env (preserve for easy re-enable); idempotent.
_comment_env_value() {
    local key="$1"
    local reason="${2:-disabled}"
    if [ ! -f ".env" ]; then
        return 0
    fi
    SYNAP_ENV_FILE=.env envcfg_write_raw C "$key" "$reason"
}

# Remove a key entirely from .env; idempotent.
_remove_env_value() {
    local key="$1"
    if [ ! -f ".env" ]; then
        return 0
    fi
    # Remove both active and already-commented variants, and our disabled marker.
    SYNAP_ENV_FILE=.env envcfg_write_raw R "$key"
}

# Internal helper: wire up a tunnel provider (write token, start compose profile,
# tail logs, print handoff). Shared by `tunnel enable` and install --tunnel.
_tunnel_enable_provider() {
    local provider="$1"
    local token="$2"

    local env_var
    env_var=$(_tunnel_env_var_for "$provider")
    local profile
    profile=$(_tunnel_profile_for "$provider")
    local service
    service=$(_tunnel_service_for "$provider")

    if [ -z "$env_var" ] || [ -z "$profile" ] || [ -z "$service" ]; then
        echo -e "${RED}Error: unknown tunnel provider: ${provider}${NC}"
        echo "Known providers: cloudflare, pangolin"
        return 1
    fi

    # .env must exist (install writes it); if missing, the pod isn't set up.
    if [ ! -f ".env" ]; then
        echo -e "${RED}Error: .env not found in ${PWD}. Run 'synap install' first.${NC}"
        return 1
    fi

    # Compose file must exist.
    if [ ! -f "docker-compose.yml" ]; then
        echo -e "${RED}Error: docker-compose.yml not found in ${PWD}${NC}"
        return 1
    fi

    # Pod must be running — tunnel alone without a backend is pointless.
    if ! docker compose ps --services --filter "status=running" 2>/dev/null | grep -q '^backend$'; then
        echo -e "${RED}Error: backend service is not running.${NC}"
        echo "  Start it first: ${GREEN}./synap start${NC}"
        return 1
    fi

    echo -e "${BLUE}🔐 Writing ${env_var} to .env...${NC}"
    update_env_value "$env_var" "$token"

    echo -e "${BLUE}🚀 Starting ${provider} tunnel (compose profile: ${profile})...${NC}"
    if ! docker compose --profile "$profile" up -d "$service"; then
        echo -e "${RED}Error: failed to start ${service}${NC}"
        return 1
    fi

    # Give cloudflared/newt a few seconds to register before tailing logs.
    echo -e "${BLUE}⏳ Waiting for tunnel to connect (5s)...${NC}"
    sleep 5
    echo ""
    echo -e "${YELLOW}Recent ${service} logs:${NC}"
    docker compose logs --tail 20 "$service" 2>/dev/null || true
    echo ""

    case "$provider" in
        cloudflare)
            echo -e "${GREEN}✅ Cloudflare tunnel active.${NC}"
            echo ""
            echo "Next: in your Cloudflare dashboard, configure the tunnel's public hostname"
            echo "to route traffic to http://backend:4000 (or the service you want to expose)."
            echo ""
            echo "Check status anytime: ./synap tunnel status"
            ;;
        pangolin)
            echo -e "${GREEN}✅ Pangolin tunnel container started.${NC}"
            echo ""
            echo -e "${YELLOW}Note:${NC} the pangolin-tunnel compose profile is a placeholder in this"
            echo "repo. Replace the image/command in docker-compose.yml with your actual"
            echo "newt runtime before relying on it for exposure. Env var: ${env_var}."
            echo ""
            echo "Check status anytime: ./synap tunnel status"
            ;;
    esac
    return 0
}

cmd_tunnel() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory (set SYNAP_DEPLOY_DIR or run from repo/deploy)${NC}"
        exit 1
    fi
    cd "$deploy_dir"

    local action="${1:-help}"
    shift || true

    case "$action" in
        enable)
            # Allow `synap tunnel enable --help` without forcing a provider.
            case "${1:-}" in
                --help|-h|"")
                    if [ -z "${1:-}" ]; then
                        echo -e "${RED}Usage: synap tunnel enable <cloudflare|pangolin> --token <TOKEN>${NC}"
                        echo "   or: synap tunnel enable <cloudflare|pangolin> --token-file <PATH>"
                        echo "Run 'synap tunnel enable --help' for details"
                        exit 1
                    fi
                    cat << EOF
${BLUE}synap tunnel enable${NC} — wire a tunnel provider into this pod

${YELLOW}Usage:${NC}
  synap tunnel enable cloudflare --token <TOKEN>
  synap tunnel enable cloudflare --token-file <PATH>
  synap tunnel enable pangolin   --token <TOKEN>
  synap tunnel enable pangolin   --token-file <PATH>

${YELLOW}What it does:${NC}
  1. Writes the provider's token to deploy/.env
  2. Starts the matching docker compose profile
  3. Tails the tunnel container logs so you can see the handshake
  4. Prints next-step guidance (dashboard config)

${YELLOW}Env vars written:${NC}
  cloudflare → CLOUDFLARED_TUNNEL_TOKEN
  pangolin   → PANGOLIN_NEWT_TOKEN

${YELLOW}Tip:${NC} prefer --token-file for long tokens — avoids shell history leaks.
EOF
                    exit 0
                    ;;
            esac

            local provider="$1"
            shift

            local token_arg=""
            local token_file=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --token)      token_arg="$2"; shift 2 ;;
                    --token-file) token_file="$2"; shift 2 ;;
                    --help|-h)
                        cat << EOF
${BLUE}synap tunnel enable${NC} — wire a tunnel provider into this pod

${YELLOW}Usage:${NC}
  synap tunnel enable cloudflare --token <TOKEN>
  synap tunnel enable cloudflare --token-file <PATH>
  synap tunnel enable pangolin   --token <TOKEN>
  synap tunnel enable pangolin   --token-file <PATH>

${YELLOW}What it does:${NC}
  1. Writes the provider's token to deploy/.env
  2. Starts the matching docker compose profile
  3. Tails the tunnel container logs so you can see the handshake
  4. Prints next-step guidance (dashboard config)

${YELLOW}Env vars written:${NC}
  cloudflare → CLOUDFLARED_TUNNEL_TOKEN
  pangolin   → PANGOLIN_NEWT_TOKEN

${YELLOW}Tip:${NC} prefer --token-file for long tokens — avoids shell history leaks.
EOF
                        exit 0
                        ;;
                    *)
                        echo -e "${RED}Unknown option: $1${NC}"
                        echo "Run 'synap tunnel enable --help'"
                        exit 1
                        ;;
                esac
            done

            if ! _tunnel_read_token "$token_arg" "$token_file"; then
                exit 1
            fi

            case "$provider" in
                cloudflare|pangolin) ;;
                *)
                    echo -e "${RED}Unknown tunnel provider: ${provider}${NC}"
                    echo "Known providers: cloudflare, pangolin"
                    exit 1
                    ;;
            esac

            _tunnel_enable_provider "$provider" "$TUNNEL_TOKEN_VALUE" || exit 1
            ;;

        disable)
            local provider=""
            local clear_token=false
            while [ $# -gt 0 ]; do
                case "$1" in
                    --provider)    provider="$2"; shift 2 ;;
                    --clear-token) clear_token=true; shift ;;
                    --help|-h)
                        cat << EOF
${BLUE}synap tunnel disable${NC} — stop tunnel containers

${YELLOW}Usage:${NC}
  synap tunnel disable                       Disable all tunnels
  synap tunnel disable --provider cloudflare Disable just Cloudflare
  synap tunnel disable --provider pangolin   Disable just Pangolin

${YELLOW}Options:${NC}
  --clear-token    Remove the token from .env (default: comment it out so re-enable
                   is one command)
EOF
                        exit 0
                        ;;
                    *)
                        echo -e "${RED}Unknown option: $1${NC}"
                        echo "Run 'synap tunnel disable --help'"
                        exit 1
                        ;;
                esac
            done

            if [ ! -f "docker-compose.yml" ]; then
                echo -e "${RED}Error: docker-compose.yml not found in ${PWD}${NC}"
                exit 1
            fi

            local providers_to_disable=""
            if [ -z "$provider" ]; then
                providers_to_disable="cloudflare pangolin"
            else
                case "$provider" in
                    cloudflare|pangolin) providers_to_disable="$provider" ;;
                    *)
                        echo -e "${RED}Unknown provider: ${provider}${NC}"
                        echo "Known: cloudflare, pangolin"
                        exit 1
                        ;;
                esac
            fi

            for p in $providers_to_disable; do
                local svc env_var
                svc=$(_tunnel_service_for "$p")
                env_var=$(_tunnel_env_var_for "$p")
                echo -e "${BLUE}🛑 Stopping ${p} tunnel (${svc})...${NC}"
                docker compose stop "$svc" 2>/dev/null || true
                docker compose rm -f "$svc" 2>/dev/null || true
                if [ "$clear_token" = "true" ]; then
                    _remove_env_value "$env_var"
                    echo -e "${YELLOW}  Removed ${env_var} from .env${NC}"
                else
                    _comment_env_value "$env_var" "disabled"
                fi
            done

            echo ""
            echo -e "${GREEN}✅ Tunnel disabled.${NC}"
            echo "Re-enable anytime: ${GREEN}./synap tunnel enable <cloudflare|pangolin> --token <TOKEN>${NC}"
            ;;

        status)
            if [ ! -f "docker-compose.yml" ]; then
                echo -e "${RED}Error: docker-compose.yml not found in ${PWD}${NC}"
                exit 1
            fi

            local running
            running=$(docker compose ps --services --filter "status=running" 2>/dev/null || true)

            local any_active=false
            for p in cloudflare pangolin; do
                local svc
                svc=$(_tunnel_service_for "$p")
                if echo "$running" | grep -q "^${svc}$"; then
                    any_active=true
                    echo -e "${GREEN}✅ ${p} tunnel active (${svc})${NC}"
                    echo -e "${YELLOW}  Recent logs:${NC}"
                    docker compose logs --tail 5 "$svc" 2>/dev/null || true
                    echo ""
                fi
            done

            if [ "$any_active" = "false" ]; then
                echo "No tunnel active. Your pod is exposed via direct DNS (or not exposed — check \`./synap health\`)."
            fi
            ;;

        help|--help|-h|"")
            cat << EOF
${BLUE}Synap Tunnel${NC} — Expose your pod via Cloudflare or Pangolin

${YELLOW}Usage:${NC}
  synap tunnel enable <provider> --token <TOKEN>         Enable a tunnel
  synap tunnel enable <provider> --token-file <PATH>     Enable from a file
  synap tunnel disable [--provider <p>] [--clear-token]  Stop tunnel(s)
  synap tunnel status                                    Show active tunnel(s)

${YELLOW}Providers:${NC}
  cloudflare   Cloudflare Tunnel (uses CLOUDFLARED_TUNNEL_TOKEN)
  pangolin     Pangolin/newt tunnel (uses PANGOLIN_NEWT_TOKEN)

${YELLOW}Examples:${NC}
  synap tunnel enable cloudflare --token eyJhIjoiX...
  synap tunnel enable cloudflare --token-file ~/secrets/cf-tunnel.token
  synap tunnel status
  synap tunnel disable --provider cloudflare
  synap tunnel disable --clear-token

${YELLOW}Note:${NC} this is the ${GREEN}self-hosted${NC} path — you bring your own token from the
provider's dashboard. CP-managed tunnels follow a different flow.

${YELLOW}At install time:${NC}
  synap install --domain example.com --tunnel cloudflare --tunnel-token <TOKEN>
  synap install --domain example.com --tunnel cloudflare --tunnel-token-file <PATH>
EOF
            ;;

        *)
            echo -e "${RED}Unknown tunnel action: ${action}${NC}"
            echo "Run 'synap tunnel help'"
            exit 1
            ;;
    esac
}

# Resolve a password WITHOUT putting it on argv: --password-stdin, a hidden
# prompt (twice, mismatch aborts), or a legacy positional (warned: it already
# leaked into shell history/ps by the time we run). Prints the secret on stdout;
# prompts/warnings go to stderr. Single trailing newlines are not preserved.
synap_users_secret() {
    local from_stdin="$1" positional="$2" p1="" p2=""
    if [ "$from_stdin" = "true" ]; then
        IFS= read -r p1 || [ -n "$p1" ] || { echo -e "${RED}No password received on stdin${NC}" >&2; return 1; }
    elif [ -n "$positional" ]; then
        echo -e "${YELLOW}⚠️  Password given as an argument: it is now in your shell history and the process list. Prefer the hidden prompt or --password-stdin.${NC}" >&2
        p1="$positional"
    else
        if [ ! -r /dev/tty ]; then
            echo -e "${RED}No terminal for a hidden prompt; use --password-stdin${NC}" >&2
            return 1
        fi
        printf 'New password: ' >&2
        IFS= read -rs p1 </dev/tty; echo >&2
        printf 'Repeat password: ' >&2
        IFS= read -rs p2 </dev/tty; echo >&2
        if [ "$p1" != "$p2" ]; then
            echo -e "${RED}Passwords do not match. Nothing changed.${NC}" >&2
            return 1
        fi
    fi
    if [ -z "$p1" ]; then
        echo -e "${RED}Empty password. Nothing changed.${NC}" >&2
        return 1
    fi
    printf '%s' "$p1"
}

cmd_users() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    cd "$deploy_dir"

    local subcommand="${1:-help}"
    shift || true

    case "$subcommand" in
        list)
            local limit="${1:-200}"
            echo -e "${BLUE}👥 Listing users (limit=${limit})...${NC}"
            docker compose exec -T backend \
                sh -c "ACTION=list LIMIT='${limit}' node dist/scripts/user-admin-cli.js"
            ;;

        add-admin)
            # Password: --password-stdin, or hidden prompt, or (legacy) positional.
            local email="" password="" name="" create_workspace="true" from_stdin="false" positional=0
            local arg
            for arg in "$@"; do [ "$arg" = "--password-stdin" ] && from_stdin="true"; done
            for arg in "$@"; do
                case "$arg" in
                    --no-workspace) create_workspace="false" ;;
                    --password-stdin) ;;
                    *)
                        positional=$((positional + 1))
                        case "$positional" in
                            1) email="$arg" ;;
                            2) if [ "$from_stdin" = "true" ]; then name="$arg"; else password="$arg"; fi ;;
                            3) name="$arg" ;;
                        esac
                        ;;
                esac
            done
            # With --password-stdin the 2nd positional is the name, not a password.
            # Legacy positional form `<email> <password> [name]` still works (warned).
            if [ -z "$email" ]; then
                echo -e "${RED}Usage: synap users add-admin <email> [name] [--password-stdin] [--no-workspace]${NC}"
                exit 1
            fi
            password="$(synap_users_secret "$from_stdin" "$password")" || exit 1
            echo -e "${BLUE}👤 Creating admin user ${email}...${NC}"
            printf '%s\n' "$password" | docker compose exec -T \
                -e ACTION=add-admin -e "CREATE_WORKSPACE=${create_workspace}" \
                -e "ADMIN_EMAIL=${email}" -e "ADMIN_NAME=${name}" \
                backend node dist/scripts/user-admin-cli.js
            ;;

        reset-password|passwd)
            # The secret never touches argv or a shell string: it is piped on
            # STDIN into the container; `exec` gets each value as its own argv
            # element (no `sh -c` interpolation). Success is only reported once
            # user-admin-cli has proven the new password with a real Kratos login.
            local email="" password="" from_stdin="false" arg
            for arg in "$@"; do
                case "$arg" in
                    --password-stdin) from_stdin="true" ;;
                    *)
                        if [ -z "$email" ]; then email="$arg"; else password="$arg"; fi
                        ;;
                esac
            done
            if [ -z "$email" ]; then
                echo -e "${RED}Usage: synap users reset-password <email> [--password-stdin]${NC}"
                exit 1
            fi
            password="$(synap_users_secret "$from_stdin" "$password")" || exit 1
            echo -e "${BLUE}🔐 Resetting password for ${email}...${NC}"
            printf '%s\n' "$password" | docker compose exec -T \
                -e ACTION=reset-password -e "USER_EMAIL=${email}" \
                backend node dist/scripts/user-admin-cli.js
            ;;

        delete)
            local email="${1:-}"
            local assume_yes="false"
            if [ "$email" = "--yes" ] || [ "$email" = "-y" ]; then
                assume_yes="true"
                email="${2:-}"
            fi
            if [ -z "$email" ]; then
                echo -e "${RED}Usage: synap users delete [--yes|-y] <email>${NC}"
                exit 1
            fi
            if [ "$assume_yes" != "true" ] && ! synap_assume_yes; then
                echo -e "${YELLOW}⚠️  This deletes the user identity for ${email}.${NC}"
                read -p "Continue? (y/N): " confirm
                if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
                    echo "Cancelled."
                    exit 0
                fi
            fi
            echo -e "${BLUE}🗑️  Deleting user ${email}...${NC}"
            docker compose exec -T backend \
                sh -c "ACTION=delete USER_EMAIL='${email}' node dist/scripts/user-admin-cli.js"
            ;;

        help|--help|-h|"")
            cat << EOF
${BLUE}Synap Users${NC} — Manage pod users and passwords

${YELLOW}Usage:${NC}
  synap users list [limit]
  synap users add-admin <email> [name] [--password-stdin] [--no-workspace]
  synap users reset-password <email> [--password-stdin]
  synap users delete [--yes|-y] <email>

${YELLOW}Examples:${NC}
  synap users list
  synap users add-admin admin@example.com --no-workspace          # prompts (hidden)
  synap users reset-password relay@example.com                    # prompts twice (hidden)
  printf '%s' "\$PW" | synap users reset-password relay@example.com --password-stdin
  synap users delete --yes relay@example.com
EOF
            ;;

        *)
            echo -e "${RED}Unknown users subcommand: $subcommand${NC}"
            echo "Run 'synap users help' for usage"
            exit 1
            ;;
    esac
}

cmd_reset() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    # `synap reset` is the ONE explicit wipe door (update-door plan P0,
    # 2026-10-04). Whatever the mode, it (a) requires the operator to TYPE the
    # pod's DOMAIN — no --yes / SYNAP_ASSUME_YES bypass, an automation cannot
    # wipe a pod — and (b) takes a verified `pgdata_backup pre-reset` of every
    # database first, aborting if that fails. `--full` recreates the stack and
    # keeps its volumes; only `--full --delete-data` removes THIS project's
    # volumes (`down --volumes`, compose-scoped) — never `system prune`.
    local mode="data"
    local assume_yes="false"
    local delete_data="false"
    local usage="Usage: synap reset [--full|-f] [--delete-data] [--yes|-y]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full|-f)
                mode="full"
                ;;
            --delete-data)
                delete_data="true"
                ;;
            --yes|-y)
                # Only skips the "re-run install?" prompt. Never the confirmation.
                assume_yes="true"
                ;;
            --help|-h)
                echo "$usage"
                echo "  default       : wipe workspace/application data (TRUNCATE; keeps logins + infra)"
                echo "  --full        : stop and remove this pod's containers + networks (volumes KEPT), optionally reinstall"
                echo "  --delete-data : with --full, ALSO remove this compose project's volumes (database, files)"
                echo "  Every mode takes a verified database backup first and asks you to type the pod domain."
                return 0
                ;;
            *)
                echo -e "${RED}Unknown option for reset: $1${NC}"
                echo "$usage"
                return 1
                ;;
        esac
        shift
    done
    if [ "$delete_data" = "true" ] && [ "$mode" != "full" ]; then
        echo -e "${RED}--delete-data only applies to --full.${NC}"
        echo "$usage"
        return 1
    fi

    local pod_domain
    pod_domain=$(grep "^DOMAIN=" .env 2>/dev/null | head -1 | cut -d'=' -f2- | tr -d '"' | tr -d "'")
    if [ -z "$pod_domain" ]; then
        echo -e "${RED}❌ DOMAIN is not set in ${deploy_dir}/.env — cannot confirm which pod this is. Nothing was changed.${NC}"
        exit 1
    fi

    if [ "$mode" = "full" ]; then
        echo -e "${RED}⚠️  WARNING: FULL RESET of pod ${pod_domain} (compose project ${COMPOSE_PROJECT_NAME}).${NC}"
        echo ""
        echo "What will be removed:"
        echo "  - All of this project's containers and networks"
        if [ "$delete_data" = "true" ]; then
            echo "  - All of this project's VOLUMES: the database (Postgres) and stored files (MinIO)"
        else
            echo "  - (volumes are KEPT — add --delete-data to remove the database and files)"
        fi
        echo ""
        echo "What will be kept:"
        echo "  - A verified database backup taken now, in ${deploy_dir}/backups/postgres"
        echo "  - deploy/.env and repository files"
        echo ""
    else
        echo -e "${RED}⚠️  WARNING: This will permanently delete all workspace data on ${pod_domain}!${NC}"
        echo ""
        echo "What will be deleted:"
        echo "  - All workspaces, users, and workspace members"
        echo "  - All documents, channels, messages, entities, relations"
        echo "  - All API keys, agent users, intelligence services"
        echo "  - All MinIO stored files (documents, attachments)"
        echo ""
        echo "What will be KEPT:"
        echo "  - A verified database backup taken now, in ${deploy_dir}/backups/postgres"
        echo "  - Kratos identities (login accounts remain intact)"
        echo "  - Database schema and migrations"
        echo "  - Configuration (.env)"
        echo ""
    fi

    local confirm=""
    read -r -p "Type the pod domain (${pod_domain}) to confirm: " confirm || true
    if [ "$confirm" != "$pod_domain" ]; then
        echo "Cancelled — the domain did not match. Nothing was changed."
        exit 1
    fi

    echo -e "${BLUE}💾 Taking a verified backup before reset...${NC}"
    local backup_dir
    backup_dir="$(SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" pgdata_backup pre-reset)" || {
        echo -e "${RED}❌ Pre-reset backup failed — aborting. Nothing was changed.${NC}"
        echo -e "${YELLOW}   Postgres must be running for the backup (synap start postgres), then re-run.${NC}"
        exit 1
    }
    echo -e "${GREEN}✓ Backup: ${backup_dir}${NC}"

    # The secrets (.env) are not copied in plaintext beside the dump any more
    # (backup plan §7). With an off-host repository they travel inside the
    # encrypted snapshot `synap backup push` takes; without one, a 0600 copy in
    # state/reset/ (owner-only dir) is the fallback — and we say so.
    local env_saved=""
    if [ -n "$(envcfg_value BACKUP_REPOSITORY)" ] && [ -s state/backup/restic-password ]; then
        echo -e "${BLUE}🔐 Pushing an encrypted off-host snapshot (.env + databases + files)...${NC}"
        if docker compose run --rm --no-deps -T --entrypoint sh postgres-backup /synap-deploy/pgdata-safety.sh push; then
            env_saved="the encrypted off-host snapshot just pushed"
        else
            echo -e "${YELLOW}⚠️  The off-host push failed — keeping a local copy of .env instead.${NC}"
        fi
    fi
    if [ -z "$env_saved" ]; then
        local env_copy="state/reset/env.$(basename "$backup_dir")"
        (umask 077 && mkdir -p state/reset && chmod 700 state/reset && cat .env > "$env_copy" && chmod 600 "$env_copy") || {
            echo -e "${RED}❌ Could not save a copy of .env — aborting. Nothing was changed.${NC}"
            exit 1
        }
        env_saved="${deploy_dir}/${env_copy}"
        echo -e "${YELLOW}⚠️  .env saved UNENCRYPTED (0600) at ${env_saved} — no off-host repository is configured. Set one up: synap backup init${NC}"
    fi
    echo -e "${GREEN}✓ Secrets (.env): ${env_saved}${NC}"

    if [ "$mode" = "full" ]; then
        echo ""
        echo -e "${BLUE}🧨 Full reset in progress...${NC}"
        if [ "$delete_data" = "true" ]; then
            echo "  Removing this project's containers, networks and volumes..."
            docker compose down --volumes --remove-orphans # volume-destroy-allowlisted: synap reset --full --delete-data
        else
            echo "  Removing this project's containers and networks (volumes kept)..."
            docker compose down --remove-orphans
        fi

        echo ""
        echo -e "${GREEN}✅ Full reset complete. Backup: ${backup_dir}${NC}"
        echo ""
        if [ "$assume_yes" = "true" ] || synap_assume_yes; then
            echo -e "${BLUE}🚀 Re-running install in non-interactive mode...${NC}"
            cmd_install --non-interactive
            return $?
        fi

        local rerun=""
        read -p "Run fresh install now? (y/N): " rerun || true
        if [ "$rerun" = "y" ] || [ "$rerun" = "Y" ]; then
            cmd_install
            return $?
        fi
        echo "Run 'synap install' when ready."
        return 0
    fi

    echo ""
    echo -e "${BLUE}🗑️  Resetting workspace data...${NC}"

    # 1. Truncate all workspace data from PostgreSQL
    echo "  Clearing PostgreSQL workspace data..."
    docker compose exec -T postgres psql -U synap -d synap -c "
        TRUNCATE TABLE
            workspace_members, users, workspaces,
            api_keys, events,
            documents, document_versions, document_sessions,
            channels, channel_context_items, messages, message_links,
            entities, entity_relationships, entity_tags, entity_enrichments,
            entity_property_index, entity_templates, entity_vectors,
            knowledge_facts,
            profiles, profile_properties, profile_relations, profile_workspace_access,
            proposals, reasoning_traces,
            relations, relation_defs, property_defs,
            resource_shares, roles, skills, tags, views,
            inbox_items, user_resource_state, user_preferences,
            agents, ai_suggestions, command_runs,
            intelligence_commands, intelligence_services,
            background_tasks, admin_invitations,
            webhook_deliveries, webhook_subscriptions, workspace_invites,
            provisioning_tokens,
            secrets, secret_tags, secret_shares, secret_vault_keys, secret_audit_log
        CASCADE;
        DELETE FROM system_settings WHERE key = 'event_processor_watermark';
        SELECT 'PostgreSQL cleared' as status;
    " 2>&1 | grep -v "^$" | sed 's/^/    /'

    # 2. Clear MinIO bucket
    echo "  Clearing MinIO storage..."
    local minio_key=$(grep "^MINIO_ACCESS_KEY=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "minioadmin")
    local minio_secret=$(grep "^MINIO_SECRET_KEY=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "minioadmin")
    docker compose exec -T minio sh -c "
        mc alias set local http://localhost:9000 ${minio_key} ${minio_secret} 2>/dev/null
        mc rm --recursive --force local/synap-storage/ 2>/dev/null || true
        echo 'MinIO cleared'
    " 2>&1 | grep -v "^$" | sed 's/^/    /'

    # 3. Restart backend to re-initialize
    echo "  Restarting backend..."
    docker start synap-backend-backend-1 2>/dev/null || docker compose restart backend 2>/dev/null || true
    sleep 3

    echo ""
    echo -e "${GREEN}✅ Data reset complete!${NC}"
    echo ""
    echo "Next steps:"
    echo "  1. Log in via the UI — a new workspace will be created automatically"
    echo "  2. Run 'synap services add <type>' to reprovision agent services"
}


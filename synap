cmd_health() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    echo -e "${BLUE}🏥 Synap Health Check${NC}"
    echo ""
    
    if ! docker compose ps | grep -q "Up"; then
        echo -e "${RED}❌ No services running${NC}"
        exit 1
    fi
    
    check_service() {
        local service=$1
        local name=$2
        if docker compose ps "$service" | grep -q "Up"; then
            echo -e "${GREEN}✅ ${name}${NC}"
        else
            echo -e "${RED}❌ ${name}${NC}"
        fi
    }
    
    check_service "backend" "Backend API"
    check_service "postgres" "Database"
    check_service "redis" "Redis"
    check_service "minio" "Storage"
    check_service "typesense" "Search"
    check_service "kratos" "Authentication"
    check_service "caddy" "Reverse Proxy"
    
    echo ""
    echo -e "${GREEN}✅ System healthy${NC}"
}

# Quick checks for "why doesn't my domain work?" (DNS, TLS, /health through the edge)
cmd_connectivity() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    cd "$deploy_dir"

    local domain=""
    local public_url=""
    if [ -f ".env" ]; then
        domain=$(grep "^DOMAIN=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" || true)
        public_url=$(grep "^PUBLIC_URL=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' | tr -d "'" || true)
    fi

    echo -e "${BLUE}🌐 Connectivity / domain checks${NC}"
    echo ""
    echo "  DOMAIN:      ${domain:-<not set in .env>}"
    echo "  PUBLIC_URL:  ${public_url:-<not set — will assume https://\$DOMAIN>}"
    echo ""

    if [ -z "$domain" ]; then
        echo -e "${YELLOW}⚠️  No DOMAIN in deploy/.env — cannot run external checks.${NC}"
        exit 1
    fi

    local probe_url="${public_url}"
    if [ -z "$probe_url" ]; then
        if [ "$domain" = "localhost" ]; then
            probe_url="http://localhost:4000"
        else
            probe_url="https://${domain}"
        fi
    fi

    echo -e "${BLUE}1) DNS resolution${NC}"
    if command -v getent >/dev/null 2>&1; then
        getent hosts "$domain" || echo -e "  ${YELLOW}getent hosts failed (no libc hosts entry?)${NC}"
    elif command -v dig >/dev/null 2>&1; then
        dig +short "$domain" || true
    else
        echo -e "  ${YELLOW}Install 'bind9-host' or 'bind9-dnsutils' for dig, or use getent.${NC}"
    fi
    echo ""

    echo -e "${BLUE}2) HTTP /health (via PUBLIC_URL or inferred URL)${NC}"
    echo "  GET ${probe_url}/health"
    if curl -fsS -m 20 -o /tmp/synap-health.body -w "  HTTP %{http_code}  time_total=%{time_total}s\n" "${probe_url}/health"; then
        head -c 200 /tmp/synap-health.body 2>/dev/null | tr -d '\r' | sed 's/^/  body: /' || true
        echo ""
    else
        echo -e "  ${RED}curl failed${NC} — check Caddy logs: ./synap logs caddy --no-follow --tail 80"
        echo "  If you use a tunnel (Pangolin / Cloudflare), verify the tunnel points to this host:80 or :443."
    fi
    rm -f /tmp/synap-health.body 2>/dev/null || true
    echo ""

    echo -e "${BLUE}3) Docker edge (Caddy)${NC}"
    if docker compose ps caddy 2>/dev/null | grep -q "Up"; then
        echo -e "  ${GREEN}✅ Caddy container is Up${NC}"
    else
        echo -e "  ${RED}❌ Caddy not Up${NC} — run: ./synap start"
    fi
}

cmd_logs() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local follow=true
    local tail_lines=""
    local service=""
    local filter=""
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --no-follow|-n)
                follow=false
                shift
                ;;
            --tail|-t)
                tail_lines="$2"
                shift 2
                ;;
            --filter|-f)
                filter="$2"
                shift 2
                ;;
            --help|-h)
                cat << EOF
${BLUE}Synap Logs${NC}

${YELLOW}Usage:${NC}
  synap logs [service] [options]

${YELLOW}Options:${NC}
  ${GREEN}--no-follow${NC}, ${GREEN}-n${NC}     Don't follow logs (show and exit)
  ${GREEN}--tail <n>${NC}, ${GREEN}-t <n>${NC}  Show last N lines (default: all)
  ${GREEN}--filter <text>${NC}, ${GREEN}-f <text>${NC}  Filter logs by text (grep)
  ${GREEN}--help${NC}, ${GREEN}-h${NC}          Show this help

${YELLOW}Examples:${NC}
  synap logs                    # Interactive service selection
  synap logs backend            # View backend logs
  synap logs backend --tail 100 # Last 100 lines
  synap logs backend --no-follow # Show and exit
  synap logs backend --filter error # Filter by "error"

EOF
                exit 0
                ;;
            *)
                if [ -z "$service" ]; then
                    service="$1"
                fi
                shift
                ;;
        esac
    done
    
    # Get list of running services
    local services=($(docker compose ps --services --status running 2>/dev/null || docker compose ps --services 2>/dev/null))
    
    if [ ${#services[@]} -eq 0 ]; then
        echo -e "${RED}❌ No services found${NC}"
        exit 1
    fi
    
    # If no service specified, show interactive menu
    if [ -z "$service" ]; then
        echo -e "${BLUE}📋 Available Services:${NC}"
        echo ""
        local i=1
        for svc in "${services[@]}"; do
            local status=$(docker compose ps "$svc" --format json 2>/dev/null | grep -o '"State":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
            if [ "$status" = "running" ]; then
                echo -e "  ${GREEN}[$i]${NC} $svc"
            else
                echo -e "  ${YELLOW}[$i]${NC} $svc (not running)"
            fi
            ((i++))
        done
        echo ""
        echo -e "  ${BLUE}[a]${NC} All services"
        echo -e "  ${BLUE}[q]${NC} Quit"
        echo ""
        read -p "Select service (number/a/q): " choice
        
        case "$choice" in
            [0-9]*)
                local idx=$((choice - 1))
                if [ $idx -ge 0 ] && [ $idx -lt ${#services[@]} ]; then
                    service="${services[$idx]}"
                else
                    echo -e "${RED}Invalid selection${NC}"
                    exit 1
                fi
                ;;
            a|A)
                service=""
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    fi
    
    # Build docker compose logs command
    local cmd="docker compose logs"
    
    if [ "$follow" = true ]; then
        cmd="$cmd -f"
    fi
    
    if [ -n "$tail_lines" ]; then
        cmd="$cmd --tail=$tail_lines"
    fi
    
    if [ -n "$service" ]; then
        cmd="$cmd $service"
    fi
    
    # Execute command with optional filter
    if [ -n "$filter" ]; then
        eval "$cmd" | grep --color=always "$filter"
    else
        eval "$cmd"
    fi
}

# ============================================================================
# RELEASE ENGINE — `synap update` (update-door plan P2, Option A)
# ============================================================================
# ONE engine for every pod update. Its input is an immutable RELEASE MANIFEST
# (release.json, published by .github/workflows/docker-publish.yml; format in
# deploy/release/make-manifest.py, validated by _ue_manifest_errors below),
# never a git checkout or a mutable tag. Flow (each step's failure is handled where it happens):
#
#   lock (router) → fetch + validate manifest → preflight (project pin, edge,
#   disk, minFrom, compose) → PULL BY DIGEST (nothing changed yet) → snapshot
#   .env → pgdata guard + VERIFIED pre-update dump → install the release's
#   deploy bundle → pin images in .env → migrate → canary → swap → every other
#   service → verify (buildStamp == gitSha, migration level == manifest) →
#   state/{current,previous}-release.json
#
# Any failure after the snapshot ROLLS BACK: the previous images (still cached
# locally — Kamal-style, the last two releases are kept), the previous .env and
# deploy files. It never restores data: the schema stays migrated and the
# pre-update dump is offered to the operator (_ue_rollback). Every outcome is RECORDED
# (state/last-update.json + state/events.jsonl + a `SYNAP_EVENT {json}` line)
# and handed to an optional notify hook (SYNAP_UPDATE_NOTIFY_CMD) — U4.
#
# UPDATE THE UPDATER FIRST (H1). A release update used to run entirely in the
# host's PREVIOUS `synap`: a fix to the kratos render, the recreate list, verify
# or the rollback reached a pod one update late. Now, once the manifest's
# signature and the bundle's sha256 are verified (and the pod is not already on
# it), this engine EXECS the staged bundle's own `synap` — the file the signed
# manifest covers — with SYNAP_UE_HANDOFF=<release id>. That engine skips the
# fetch (the manifest and the staged bundle are reused, the bundle's sha256
# re-checked) and runs everything else: preflight, pull, backup, install,
# kratos render, migrations, swap, verify, record — and the ROLLBACK. Same pid,
# so the update lock carries over. SYNAP_UE_HANDOFF set ⇒ never hand off again.
# The rollback stays with the engine that made the change rather than going
# back to the previous one: the previous release's engine has no entry point
# to finish a half-done update (it predates this one), while the release's
# engine knows exactly what it changed; the rollback acts only on restored,
# byte-identical previous files, and units are refreshed only after verify, so
# nothing of the new release is left for an older engine to undo.
# A verified update then re-renders the systemd units from the INSTALLED
# `synap` (`synap units install`), so unit changes ship with the release.
# The first update FROM a release without this code still runs that release's
# engine end to end; every later one hands off. That old engine installs the
# new `synap` and unit templates but never the units: the next heal tick does
# (_heal_units_converge — synap-heal.timer runs the installed `synap`).
#
# `--from-source` (U6, open to anyone) goes through the SAME backup / canary /
# rollback. It builds `synap-dev/*:<sha>` with `docker build -t` — the tag
# is named here and nowhere else, so a host build can never carry the ghcr name
# — and records the release as `local-<sha>`.
#
# Channels: `fast` (every green main push) and `stable` (v* tags). The per-pod
# auto-update SETTING (U3, wave 2) only has to decide WHEN to call
# `synap update` and which channel: it sets SYNAP_UPDATE_CHANNEL in deploy/.env
# (default: stable). The engine never decides that itself.
SYNAP_RELEASE_BASE_URL_DEFAULT="https://github.com/synap-core/backend/releases/download"
_UE_STATUS_PROBE="fetch('http://localhost:4000/status/release').then(r=>r.text()).then(t=>process.stdout.write(t)).catch(()=>process.exit(1))"

_ue_log()  { echo -e "${BLUE}[update] $*${NC}"; }
_ue_ok()   { echo -e "${GREEN}[update] ✓ $*${NC}"; }
_ue_warn() { echo -e "${YELLOW}[update] ⚠️  $*${NC}" >&2; }
_ue_err()  { echo -e "${RED}[update] ❌ $*${NC}" >&2; }

# <key> [file] — last value of KEY in an env file (quotes stripped), empty when absent.
_ue_env_get() {
    grep "^$1=" "${2:-.env}" 2>/dev/null | tail -1 | cut -d'=' -f2- | tr -d '"' | tr -d "'"
}

# The image variables a compose file consumes — DERIVED from the file, so a new
# pinned service joins the manifest contract by existing (no hand list).
_ue_compose_image_keys() {
    grep -oE '\$\{SYNAP_IMAGE_[A-Z0-9_]+' "${1:-docker-compose.yml}" 2>/dev/null | sed 's/^\${//' | sort -u
}

_ue_sha256() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
    else shasum -a 256 "$1" | cut -d' ' -f1; fi
}

_ue_manifest_url() { # <fast|stable|release-id> [asset]
    local base="${SYNAP_RELEASE_BASE_URL:-$SYNAP_RELEASE_BASE_URL_DEFAULT}" asset="${2:-release.json}"
    case "$1" in
        fast|stable) echo "${base}/channel-$1/${asset}" ;;
        *)           echo "${base}/$1/${asset}" ;;
    esac
}

_ue_fetch() { # <url> <out>
    local auth=()
    [ -n "${SYNAP_RELEASE_TOKEN:-}" ] && auth=(-H "Authorization: Bearer ${SYNAP_RELEASE_TOKEN}")
    curl -fsSL --retry 2 --max-time 300 "${auth[@]}" -o "$2" "$1"
}

# D12 — CI signs every release.json keyless (docker-publish.yml publish-release:
# `cosign sign-blob --bundle release.json.sigstore.json`), next to it on the
# release AND on the channel pointer. Verified against the signing workflow
# (main via workflow_run, which always runs the default-branch file, or a v* tag)
# and GitHub's OIDC issuer, so a release written by a token or a fork build fails.
# SYNAP_RELEASE_VERIFY (env or deploy/.env): warn (default) — a missing cosign,
# missing bundle or failed check WARNS and the update goes on; enforce — any of
# them refuses the manifest; off — skip (a private mirror with no signatures).
SYNAP_RELEASE_SIGNER_RE='^https://github\.com/(?i:synap-core/backend)/\.github/workflows/docker-publish\.yml@refs/(heads/main|tags/v[0-9][0-9A-Za-z.+-]*)$'
SYNAP_RELEASE_OIDC_ISSUER="https://token.actions.githubusercontent.com"
# Nothing installs cosign on a pod host, and the unattended path ENFORCES the
# check, so every Control-Plane-ordered update refused a valid release
# (lab pod, v1.1.2 → v1.1.3, 2026-10-19). Without a host cosign, run sigstore's
# own image — the release CI signs with — pinned by its index digest. Docker is
# on every pod. Its tag must equal docker-publish.yml's `cosign-release`
# (release-signature.test.sh pins the two together).
SYNAP_COSIGN_IMAGE="ghcr.io/sigstore/cosign/cosign:v2.5.3@sha256:f1946d0f30fc8e3777b02f2201e02efdba9fe38f4918162f937052fac98e083f"

# The ONE place that decides how cosign runs: cosign | docker | none.
_ue_cosign_via() {
    if command -v cosign >/dev/null 2>&1; then echo cosign
    elif command -v docker >/dev/null 2>&1; then echo docker
    else echo none; fi
}

# <cosign|docker> <manifest> <bundle in the same directory> — cosign's verdict.
# Through docker: the manifest's directory is bind-mounted read-only with
# --mount (a ':' in the path breaks -v's syntax), the container runs read-only
# with no capabilities. cosign writes its sigstore TUF metadata under $HOME, so
# that is a tmpfs owned by the image's nonroot user. Not persisted on purpose:
# measured on the CP host (2026-10-19), a warm cache does not let cosign verify
# offline (it refreshes from the TUF mirror every run), and a named volume is
# root-owned, so keeping one would mean running cosign as root for no gain.
# A docker exit of 125/126/127 means docker could not run cosign at all
# (daemon down, pull failed) — the caller reports that, never "does not verify".
_ue_cosign_verify() {
    local args=(verify-blob --certificate-identity-regexp "$SYNAP_RELEASE_SIGNER_RE"
                --certificate-oidc-issuer "$SYNAP_RELEASE_OIDC_ISSUER")
    case "$1" in
        cosign) cosign "${args[@]}" --bundle "$3" "$2" ;;
        docker)
            local dir; dir="$(cd "$(dirname "$2")" && pwd)" || return 1
            docker run --rm --read-only --cap-drop ALL --security-opt no-new-privileges \
                --tmpfs /home/nonroot:uid=65532,gid=65532 \
                --mount "type=bind,src=${dir},dst=/release,readonly" "$SYNAP_COSIGN_IMAGE" \
                "${args[@]}" --bundle "/release/$(basename "$3")" "/release/$(basename "$2")" ;;
        *) return 1 ;;
    esac
}

_ue_verify_manifest_sig() { # <fast|stable|release-id> <manifest> — non-zero only under enforce
    local mode="${SYNAP_RELEASE_VERIFY:-$(_ue_env_get SYNAP_RELEASE_VERIFY)}" bundle="$2.sigstore.json" why="" out via rc=0
    case "${mode:=warn}" in
        warn|enforce) ;;
        off) return 0 ;;
        *) _ue_warn "SYNAP_RELEASE_VERIFY=${mode} is not warn|enforce|off — using warn"; mode=warn ;;
    esac
    rm -f "$bundle"
    via="$(_ue_cosign_via)"
    if [ "$via" = none ]; then
        why="cosign is not installed (and no docker to run it)"
    elif ! _ue_fetch "$(_ue_manifest_url "$1" release.json.sigstore.json)" "$bundle" 2>/dev/null; then
        why="no signature (release.json.sigstore.json) is published for '$1'"
    else
        out="$(_ue_cosign_verify "$via" "$2" "$bundle" 2>&1)" || rc=$?
        if [ "$rc" = 0 ]; then
            _ue_ok "release manifest signature verified (Synap CI, keyless)"
            return 0
        elif [ "$via" = docker ] && [ "$rc" -ge 125 ] && [ "$rc" -le 127 ]; then
            why="could not run the signature check (docker exited ${rc}: $(printf '%s' "$out" | tail -1))"
        else
            why="the signature does not verify as Synap CI ($(printf '%s' "$out" | tail -1))"
        fi
    fi
    if [ "$mode" = enforce ]; then
        _ue_err "release manifest for '$1' refused: ${why} (SYNAP_RELEASE_VERIFY=enforce)"
        return 1
    fi
    _ue_warn "release manifest for '$1' is NOT signature-verified: ${why} — continuing (SYNAP_RELEASE_VERIFY=warn)"
    return 0
}

# <manifest> <compose-file> — prints one line per violation; empty = valid.
# A registry release must pin EVERY image by digest and cover every
# SYNAP_IMAGE_* the compose file uses. A from-source release (source:true,
# id local-*) may carry synap-dev/* tags for its two built images only.
_ue_manifest_errors() {
    local keys
    keys="$(_ue_compose_image_keys "$2" | jq -R . | jq -sc .)"
    jq -r --argjson keys "$keys" '
      def digest: test("^[a-z0-9][a-z0-9._/:-]*@sha256:[0-9a-f]{64}$");
      def localref: test("^synap-dev/[a-z0-9._/-]+:[A-Za-z0-9._-]+$");
      (.source == true) as $src
      | (.images // {}) as $img
      | [ (if .schema != 1 then "schema must be 1 (got \(.schema))" else empty end),
          (if ((.id|type) != "string") or ((.id|tostring)|test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")|not) then "id is missing or malformed" else empty end),
          (if $src and ((.id|tostring)|startswith("local-")|not) then "a from-source release id must start with local-" else empty end),
          (if ($src|not) and ((.id|tostring)|startswith("local-")) then "local-* ids are reserved for --from-source builds" else empty end),
          (if ((.gitSha|type) != "string") or ((.gitSha|tostring)|test("^[0-9a-f]{40}$")|not) then "gitSha must be a full 40-hex commit" else empty end),
          (if ($img|type) != "object" or ($img|length) == 0 then "images must be a non-empty object" else empty end),
          ($img | to_entries[] | select((.value|type) != "string") | "image \(.key) is not a string"),
          ($img | to_entries[] | select((.value|type) == "string") | select((.value|digest|not) and (($src and (.value|localref))|not))
                | "image \(.key) is not pinned by digest: \(.value)"),
          ($img | to_entries[] | select((.value|type) == "string") | select((.value|localref) and ([.key]|inside(["SYNAP_IMAGE_BACKEND","SYNAP_IMAGE_POD_ADMIN"])|not))
                | "image \(.key) may not be a synap-dev build"),
          ((if $src then ["SYNAP_IMAGE_BACKEND","SYNAP_IMAGE_POD_ADMIN"] else ($keys + ["SYNAP_IMAGE_BACKEND","SYNAP_IMAGE_POD_ADMIN"] | unique) end)[]
                | select($img[.] == null) | "image \(.) (used by docker-compose.yml) is missing from the manifest"),
          (if ((.migrations.last|type) != "string") or ((.migrations.last|tostring)|endswith(".sql")|not) then "migrations.last must name a .sql file" else empty end),
          (if ((.migrations.count|type) != "number") or (.migrations.count < 1) then "migrations.count must be a positive number" else empty end),
          (if ((.composeSha|type) != "string") or ((.composeSha|tostring)|test("^sha256:[0-9a-f]{64}$")|not) then "composeSha must be sha256:<64 hex>" else empty end),
          (if .minFrom != null and (((.minFrom|type) != "string") or ((.minFrom|tostring)|test("^[A-Za-z0-9][A-Za-z0-9._-]*[.]sql$")|not)) then "minFrom must be null or a migration filename" else empty end),
          (if .minFromRelease != null and (((.minFromRelease|type) != "string") or ((.minFromRelease|tostring)|test("^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$")|not)) then "minFromRelease must be null or a release id" else empty end),
          (if .minFromRelease != null and .minFrom == null then "minFromRelease is set without minFrom" else empty end)
        ] | .[]' "$1" 2>&1
}

# ── edge proxy ────────────────────────────────────────────────────────────────
# SYNAP_EDGE=caddy|traefik in deploy/.env (default caddy). On an Eve-managed pod
# Traefik IS the edge (founder decision 2026-10-04), and Caddy cannot bind :80
# there — the 2026-10-04 perso update died exactly on that bind. Eve's delegate
# already exports SYNAP_SKIP_EDGE=1; the first such run pins SYNAP_EDGE=traefik
# so every later door (an operator in a shell included) agrees. An Eve pod with
# nothing pinned is REFUSED before anything changes, never failed mid-update.
_ue_edge() {
    local edge="${SYNAP_EDGE:-$(_ue_env_get SYNAP_EDGE)}"
    if [ -z "$edge" ] && [ "${SYNAP_SKIP_EDGE:-}" = "1" ]; then
        edge=traefik
        if [ -f .env ]; then
            SYNAP_ENV_FILE=.env envcfg_write_raw S SYNAP_EDGE traefik
            echo -e "${BLUE}[update] ℹ️  SYNAP_SKIP_EDGE=1 — pinned SYNAP_EDGE=traefik in deploy/.env${NC}" >&2
        fi
    fi
    if [ -z "$edge" ] && grep -qs 'eve-managed:' docker-compose.override.yml; then
        _ue_err "This pod is Eve-managed (docker-compose.override.yml carries an eve-managed marker): Traefik is its edge, and Caddy cannot bind :80 next to it."
        _ue_err "Set SYNAP_EDGE=traefik in $(pwd)/.env (or SYNAP_EDGE=caddy if Caddy really is this pod's edge), then re-run. Nothing was changed."
        return 1
    fi
    edge="${edge:-caddy}"
    case "$edge" in
        caddy|traefik) echo "$edge" ;;
        *) _ue_err "SYNAP_EDGE=${edge} — expected caddy or traefik. Nothing was changed."; return 1 ;;
    esac
}

# With edge=caddy, :80/:443 must be free or held by THIS project's caddy.
_ue_edge_preflight() {
    [ "$1" = caddy ] || return 0
    local holders
    holders="$(docker ps --filter publish=80 --filter publish=443 \
        --format '{{.Names}}|{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.service"}}' 2>/dev/null \
        | awk -F'|' -v p="${COMPOSE_PROJECT_NAME:-}" '!($2 == p && $3 == "caddy") {print $1}' | sort -u | tr '\n' ' ')"
    if [ -n "${holders// /}" ]; then
        _ue_err "SYNAP_EDGE=caddy but :80/:443 is held by: ${holders}— Caddy could not start."
        _ue_err "If that container is this pod's edge proxy (e.g. Traefik), set SYNAP_EDGE=traefik in $(pwd)/.env and re-run. Nothing was changed."
        return 1
    fi
}

# Long-running services the update (re)creates AFTER the backend swap — derived
# from the compose file's active services, never a hand list. One-shots
# (*-migrate), the canary, the swapped backend/realtime, and Caddy
# when another proxy is the edge are excluded.
_ue_services() { # <edge> [profile args...]
    local edge="$1"; shift
    docker compose "$@" config --services 2>/dev/null \
        | grep -vxE 'backend|realtime|backend-canary|.*-migrate' \
        | { if [ "$edge" = traefik ]; then grep -vx caddy; else cat; fi; } || true
}

# "count|newest" of the synap _migrations ledger. newest is the newest BY
# FILENAME (byte order, as apps/api/src/status/migration-ledger.ts compares),
# never the latest applied: a migration merged late is applied last without
# being the newest (0331 after 0336, 2026-10-20). "0|" = no ledger table yet.
# Returns 1 when the ledger cannot be read: a caller must never read that as
# "no migrations" nor as "the level moved".
_ue_migration_level() {
    local c has out
    c="$(_pgs_container)"
    [ -n "$c" ] || return 1
    has="$(_pgs_psql "$c" synap "select to_regclass('public._migrations') is not null" 2>/dev/null)" || return 1
    case "$has" in
        f) echo "0|"; return 0 ;;
        t) ;;
        *) return 1 ;;
    esac
    out="$(_pgs_psql "$c" synap "select count(*)||'|'||coalesce(max(filename collate \"C\"),'') from _migrations" 2>/dev/null)" || return 1
    case "$out" in [0-9]*'|'*) echo "$out" ;; *) return 1 ;; esac
}

# a < b in byte order (filenames, as _migrations' collate "C" and the release
# builder sort them) — never the locale's collation, which `[[ < ]]` uses.
_ue_name_lt() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | LC_ALL=C sort | head -n 1)" = "$1" ]; }

# minFrom (release.json, derived by deploy/release/make-manifest.py): a release
# carrying a CONTRACT migration is safe to roll back from only if the pod
# already ran the release that shipped its EXPAND step (rollback swaps images
# only). Two levels must reach it: the database's newest migration, and the
# RUNNING release's own (state/current-release.json) — after an images-only
# rollback the database is ahead of the code it runs, and the code is what a
# failed update would roll back to. Refuses (records + returns 1) naming
# minFromRelease, the release to take first. <manifest> <db newest migration>
_ue_min_from_check() {
    local m="$1" db_last="$2" min_from min_rel run_last why
    min_from="$(jq -r '.minFrom // empty' "$m")"
    [ -n "$min_from" ] || return 0
    min_rel="$(jq -r '.minFromRelease // empty' "$m")"
    run_last="$(jq -r 'if (.migrations.last|type) == "string" then .migrations.last else empty end' state/current-release.json 2>/dev/null || true)"
    if _ue_name_lt "$db_last" "$min_from"; then
        why="this pod's database is at ${db_last:-no migration}"
    elif [ -n "$run_last" ] && _ue_name_lt "$run_last" "$min_from"; then
        why="this pod runs ${UE_FROM:-a release} (migrations up to ${run_last}); its database is further only because an update was rolled back"
    else
        return 0
    fi
    _ue_err "release ${UE_TO} requires a pod that already ran migration ${min_from}: ${why}."
    if [ -n "$min_rel" ]; then
        _ue_err "Update to ${min_rel} first (synap update --release ${min_rel}), then to ${UE_TO}. Nothing was changed."
    else
        _ue_err "Update to an intermediate release first. Nothing was changed."
    fi
    _ue_record aborted "$UE_FROM" "$UE_TO" "below minFrom ${min_from}${min_rel:+: update to ${min_rel} first}" false
    return 1
}

# ── TimescaleDB: the extension a database runs vs the postgres image ─────────
# A timescaledb-ha image ships the library of every OLDER TimescaleDB too
# (measured: the 2.28.3 image carries timescaledb-2.13.0 … 2.28.3.so), and a
# database keeps the extension version it was created or last updated at
# (pg_extension.extversion), loading that version's library. So a NEWER image
# is safe: the database runs on, unchanged. An OLDER image that lacks the
# database's version cannot start it, and a rollback swaps images only — so an
# update to such an image is refused before anything changes.
# The extension is never updated automatically: `ALTER EXTENSION timescaledb
# UPDATE` mid-update would make that update's rollback fatal, and after it the
# live backend sessions still hold the old library. Behind the image = a notice
# (here and in `synap doctor`); the procedure is deploy/runbooks/timescaledb-update.md.

# "<db>|<extversion>" per database that has the extension; non-zero on a failed read.
_ue_tsdb_versions() {
    local c dbs db v out=""
    c="$(_pgs_container)"
    [ -n "$c" ] || return 1
    dbs="$(_pgs_psql "$c" synap "select datname from pg_database where datallowconn and not datistemplate order by 1" 2>/dev/null)" || return 1
    [ -n "$dbs" ] || return 1
    for db in $dbs; do
        v="$(_pgs_psql "$c" "$db" "select extversion from pg_extension where extname = 'timescaledb'" 2>/dev/null)" || return 1
        [ -z "$v" ] || out="${out}${db}|${v}"$'\n'
    done
    printf '%s' "$out"
}

# The TimescaleDB versions a postgres image ships a library for, oldest first;
# non-zero when it could not be read (never "ships none"). Of an image not
# running yet (a release's), or of the running postgres container (read-only).
_ue_tsdb_libs_of() { # <command...> that runs `sh` in the image (gets -c '<script>')
    local out
    out="$("$@" -c 'ls /usr/lib/postgresql/*/lib/' 2>/dev/null)" || return 1
    out="$(printf '%s\n' "$out" | sed -n 's/^timescaledb-\([0-9][0-9.]*\)\.so$/\1/p' | sort -V)"
    [ -n "$out" ] || return 1
    printf '%s\n' "$out"
}
_ue_image_tsdb_libs() { _ue_tsdb_libs_of docker run --rm --entrypoint sh "$1"; }

# Refuses (records + returns 1) a release whose postgres image cannot load a
# database's TimescaleDB version. Postgres must be running. <manifest>
_ue_tsdb_check() {
    local m="$1" img cur rows libs row db v
    img="$(jq -r '.images.SYNAP_IMAGE_POSTGRES // empty' "$m")"
    [ -n "$img" ] || return 0                              # no pin: compose keeps the image it has
    cur="$(_ue_env_get SYNAP_IMAGE_POSTGRES)"
    [ "$img" != "$cur" ] || return 0                       # the pin this pod already runs
    _ue_log "postgres image: ${cur:-the compose default tag (whatever this host pulled)} → ${img}"
    _ue_log "  postgres RESTARTS during this update: the release pins a new postgres image. Its databases keep their TimescaleDB version (checked next); the data stays on its volume."
    rows="$(_ue_tsdb_versions)" || {
        _ue_err "cannot read which TimescaleDB version each database runs — refusing to change the postgres image. Nothing was changed."
        _ue_record aborted "$UE_FROM" "$UE_TO" "TimescaleDB extension versions unreadable" false
        return 1
    }
    [ -n "$rows" ] || return 0
    libs="$(_ue_image_tsdb_libs "$img")" || {
        _ue_err "cannot read the TimescaleDB libraries of release ${UE_TO}'s postgres image (${img}). Nothing was changed."
        _ue_record aborted "$UE_FROM" "$UE_TO" "postgres image unreadable" false
        return 1
    }
    while IFS= read -r row; do
        [ -n "$row" ] || continue
        db="${row%%|*}"; v="${row#*|}"
        grep -qxF "$v" <<<"$libs" && continue
        _ue_err "release ${UE_TO}'s postgres image ships TimescaleDB up to $(tail -n 1 <<<"$libs"), but database '${db}' runs ${v}: postgres could not start it. Nothing was changed."
        _ue_err "Take a release whose postgres image carries TimescaleDB ${v} or newer."
        _ue_record aborted "$UE_FROM" "$UE_TO" "postgres image cannot load TimescaleDB ${v} (database ${db})" false
        return 1
    done <<<"$rows"
    return 0
}

# One line per database whose extension is older than the newest library of
# the running postgres container ("<db>|<extversion>|<newest>"); non-zero on a failed read.
_ue_tsdb_behind() {
    local c rows libs newest row v
    c="$(_pgs_container)"
    [ -n "$c" ] && [ "$c" != direct ] || return 1
    rows="$(_ue_tsdb_versions)" || return 1
    [ -n "$rows" ] || return 0
    libs="$(_ue_tsdb_libs_of docker exec "$c" sh)" || return 1
    newest="$(tail -n 1 <<<"$libs")"
    while IFS= read -r row; do
        [ -n "$row" ] || continue
        v="${row#*|}"
        [ "$v" = "$newest" ] || [ "$(printf '%s\n%s\n' "$v" "$newest" | sort -V | tail -n 1)" = "$v" ] || echo "${row}|${newest}"
    done <<<"$rows"
}

_ue_tsdb_notice() { # after a verified update: say so when a database's extension lags the image
    local rows db v newest
    rows="$(_ue_tsdb_behind)" || { _ue_warn "could not compare the TimescaleDB extension with the postgres image (synap doctor re-checks)"; return 0; }
    while IFS='|' read -r db v newest; do
        [ -n "$db" ] || continue
        _ue_warn "TimescaleDB: database '${db}' runs ${v}; this postgres image ships up to ${newest}. It keeps working; update it in a maintenance window: deploy/runbooks/timescaledb-update.md"
    done <<<"$rows"
    return 0
}

# The synap schema now, against UE_LEVEL_BEFORE: migrated | unchanged | unknown.
# Only the synap ledger is measured; Kratos keeps its own (kratos-migrate).
_ue_schema_state() {
    local now
    now="$(_ue_migration_level)" || { echo unknown; return 0; }
    if [ "$now" = "${UE_LEVEL_BEFORE:-}" ]; then echo unchanged; else echo migrated; fi
}

_ue_backend_healthy() { # waits up to SYNAP_UPDATE_HEALTH_TRIES × SYNAP_HEALTH_INTERVAL
    local i cid probe="const r=require('http').get('http://localhost:4000/health',(s)=>{process.exit(s.statusCode===200?0:1)});r.setTimeout(4000,()=>{r.destroy();process.exit(1)});r.on('error',()=>process.exit(1))"
    for i in $(seq 1 "${SYNAP_UPDATE_HEALTH_TRIES:-12}"); do
        sleep "${SYNAP_HEALTH_INTERVAL:-10}"
        cid="$(docker compose ps -q backend 2>/dev/null | head -1)"
        [ -n "$cid" ] && docker exec "$cid" node -e "$probe" >/dev/null 2>&1 && return 0
    done
    return 1
}

# ── outcome record + notify (U4) ──────────────────────────────────────────────
# state/last-update.json (latest outcome) + state/events.jsonl (append-only)
# + a `SYNAP_EVENT {json}` stdout line for callers that capture output (eve,
# pod-agent). The pod can surface it without a new door: the backend container
# already mounts this deploy dir read-only at /opt/synap/deploy (compose
# `backend.volumes`), so state/last-update.json is readable in-pod — wiring it
# into /status/release + notif-center is the wave-2 seam. SYNAP_UPDATE_NOTIFY_CMD
# (env or .env) receives the JSON on stdin, best-effort.
# An unattended run started by a request carries the request's `id` as
# `request` (UE_REQUEST_ID, set by _ue_unattended_plan / _ue_unattended_busy):
# pod-agent matches it to report the outcome of the order it queued.
# `dbRestored` is false for every record this engine writes (a rollback swaps
# images only, see _ue_rollback); records from older engines may carry true.
# [schema] (rollbacks): migrated | unchanged | unknown — where the synap schema
# was left; `backup` is then the dump an operator may restore by hand.
_ue_record() { # <status> <from> <to> <reason> <dbRestored true|false> [backup] [schema]
    local ev
    ev="$(jq -cn --arg status "$1" --arg from "$2" --arg to "$3" \
        --arg reason "$4" --argjson db "${5:-false}" --arg backup "${6:-}" --arg schema "${7:-}" --arg req "${UE_REQUEST_ID:-}" \
        '{kind:"pod.update", status:$status, from:$from, to:$to, reason:$reason, dbRestored:$db, backup:$backup}
         + (if $schema == "" then {} else {schema:$schema} end)
         + (if $req == "" then {} else {request:$req} end)')"
    _synap_event "$ev" 1 state/last-update.json
}

# The ONE host event recorder (update, heal, units): stamps ts + pod onto
# <json-object>, appends it to state/events.jsonl, prints the `SYNAP_EVENT` line,
# and with notify=1 pipes it to SYNAP_UPDATE_NOTIFY_CMD. [latest-file] keeps the
# newest of that kind (last-update.json is the update outcome only — a heal
# never overwrites it). cwd = deploy dir.
_synap_event() { # <json-object> <notify 0|1> [latest-file]
    local ev hook
    ev="$(jq -c --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg pod "$(_ue_env_get DOMAIN)" '{ts:$ts} + . + {pod:$pod}' <<<"$1")"
    mkdir -p state
    if [ -n "${3:-}" ]; then
        printf '%s\n' "$ev" > "$3.tmp" && mv -f "$3.tmp" "$3"
    fi
    printf '%s\n' "$ev" >> state/events.jsonl
    echo "SYNAP_EVENT $ev"
    [ "${2:-0}" = 1 ] || return 0
    hook="${SYNAP_UPDATE_NOTIFY_CMD:-$(_ue_env_get SYNAP_UPDATE_NOTIFY_CMD)}"
    if [ -n "$hook" ]; then
        printf '%s\n' "$ev" | sh -c "$hook" || _ue_warn "notify hook failed (the event is still in state/events.jsonl)"
    fi
}

# ── requests (state/requests/<name>.json, watched by synap-<name>.path) ──────
# A request is TAKEN (renamed to <name>.taken.json) before anything acts on it,
# so the PathExists= unit cannot start the run again. Under systemd the
# service's ExecStartPre has already taken it before this script starts
# (SYNAP_REQUEST_PRETAKEN=1): a run that died before reaching its own take (a
# broken bundle, no jq, the compose-project refusal, `set -e`) left the file in
# place, and PathExists= restarted the service until systemd's start limit
# failed the .path unit for good. Measured on systemd 252 (2026-10-21): 4 runs
# in one second, 'unit-start-limit-hit', and no later request picked up.
_synap_take_request() { # <update|compose> → the taken file's path; empty when there is none
    local f="state/requests/$1.json" t="state/requests/$1.taken.json"
    if [ "${SYNAP_REQUEST_PRETAKEN:-}" = 1 ]; then
        # The unit took THIS run's request (and removed an older taken file);
        # a <name>.json present now arrived after it and starts the next run.
        if [ -f "$t" ]; then echo "$t"; fi
        return 0
    fi
    [ -f "$f" ] || return 0
    mv -f "$f" "$t" && echo "$t"
}

# ── current release / adoption ────────────────────────────────────────────────
# A pod with no release record (every pod before this engine) is ADOPTED: its
# running backend/pod-admin images are tagged synap-adopted/* so the image
# pruner and a later rollback can never lose them, and the record names them.
_ue_current_release_id() { jq -r '.id // empty' state/current-release.json 2>/dev/null || true; }

_ue_adopt_running() {
    [ -s state/current-release.json ] && return 0
    local cid img short id images="{}" svc key
    for svc in backend pod-admin; do
        cid="$(docker compose ps -q "$svc" 2>/dev/null | head -1)"
        [ -n "$cid" ] || continue
        img="$(docker inspect -f '{{.Image}}' "$cid" 2>/dev/null)" || continue
        short="${img#sha256:}"; short="${short:0:12}"
        [ -n "$short" ] || continue
        docker tag "$img" "synap-adopted/${svc}:${short}" >/dev/null 2>&1 || continue
        key=SYNAP_IMAGE_BACKEND; [ "$svc" = pod-admin ] && key=SYNAP_IMAGE_POD_ADMIN
        images="$(jq -c --arg k "$key" --arg v "synap-adopted/${svc}:${short}" '. + {($k): $v}' <<<"$images")"
        [ "$svc" = backend ] && id="adopted-${short}"
    done
    [ -n "${id:-}" ] || return 0
    mkdir -p state
    jq -n --arg id "$id" --argjson images "$images" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg bv "$(_ue_env_get BACKEND_VERSION)" \
        '{schema:1, id:$id, adopted:true, adoptedAt:$at, backendVersion:$bv, images:$images}' > state/current-release.json
    _ue_log "No release record — adopted the running pod as ${id} (images kept as synap-adopted/*)"
}

# ── from-source build (U6) ────────────────────────────────────────────────────
# A build that dies partway (ENOSPC, a killed docker) leaves BuildKit cache
# records whose containerd snapshots no longer exist. Every later build then
# fails at its FIRST RUN with "failed to stat active key during commit:
# snapshot ... does not exist" — and only a full cache clear removes them. The
# post-update cap (_ue_prune_images) can never do it: it runs only after a
# SUCCESSFUL applied update, so the very failure that poisons the cache also
# makes the cure unreachable, and the pod self-locks (perso, 2026-10-06: five
# retries, identical failure, until an operator ran `docker builder prune -af`).
# Drop the cache after a FAILED build only — it holds no data, just rebuild
# time, so the warm-cache cost is paid only once a build has already failed.
_ue_build_cache_reset() { docker builder prune -af >/dev/null 2>&1 || true; }

_ue_build_from_source() { # <out-manifest>
    local out="$1" repo_root sha tag be pa mig_dir last count carry pins k v
    repo_root="$(get_repo_root)"
    if [ -z "$repo_root" ] || [ ! -f "$repo_root/deploy/Dockerfile" ]; then
        _ue_err "--from-source needs a git checkout of synap-backend around this deploy dir. Nothing was changed."
        return 1
    fi
    sync_git_before_build
    sha="${GIT_SHA:-}"
    if ! [[ "$sha" =~ ^[0-9a-f]{40}$ ]]; then _ue_err "could not resolve the checkout's commit"; return 1; fi
    tag="${sha:0:12}"
    [ -n "$(git -C "$repo_root" status --porcelain --untracked-files=no 2>/dev/null)" ] && tag="${tag}-dirty"
    # The ONE place a host build is named. Never the registry name: a local
    # build must never be mistakable for a published artifact (U6).
    be="synap-dev/backend:${tag}"
    pa="synap-dev/pod-admin:${tag}"
    # Bound the cache BEFORE building and BEFORE the disk check. The cap in
    # _ue_prune_images runs only after an APPLIED update, so it is skipped when
    # the update is a no-op "already on release" — leaving up to ~11 GB of cache
    # on a disk that then has only a few GB free. That is the state that makes
    # the next from-source build ENOSPC, which is in turn what poisons the
    # BuildKit cache (see _ue_build_cache_reset). Cap first so the check below
    # measures the space the build will actually have.
    docker builder prune -f --max-used-space 2gb >/dev/null 2>&1 \
        || docker builder prune -f --keep-storage 2gb >/dev/null 2>&1 || true
    # A from-source build is the single largest disk consumer this pod runs
    # (~11 GB peak, perso 2026-10-05). Refuse below the floor rather than ENOSPC
    # mid-layer.
    _ue_disk_ok "${SYNAP_UPDATE_MIN_FREE_SOURCE_MB:-12288}" || return 1
    # Third-party images are pinned by digest by THE release rule — the same
    # resolver make-manifest.py uses (deploy/release/resolve-images.sh: the
    # compose default tag, resolved in its registry). Carrying them from .env
    # left a pod that never took a published release on the compose default
    # TAG, i.e. whatever this host pulled first (perso ran TimescaleDB 2.26.4
    # while releases pinned 2.28.3). Other first-party pins (pod-agent) still
    # carry over from .env (the manifest rules refuse one not pinned by digest).
    # Resolved BEFORE the build: a registry that cannot answer costs no build.
    if ! pins="$(bash "$repo_root/deploy/release/resolve-images.sh" docker-compose.yml)"; then
        _ue_err "could not pin this release's third-party images by digest (deploy/release/resolve-images.sh). Nothing was changed."
        return 1
    fi
    carry="{}"
    while IFS='=' read -r k v; do
        case "$k" in SYNAP_IMAGE_BACKEND|SYNAP_IMAGE_POD_ADMIN|"") continue ;; esac
        [ -n "$v" ] || v="$(_ue_env_get "$k")"      # first-party: the pin this pod has (manifest rules check it)
        if [ -n "$v" ]; then carry="$(jq -c --arg k "$k" --arg v "$v" '. + {($k): $v}' <<<"$carry")"; fi
    done <<<"$pins"
    _ue_log "Building ${be} and ${pa} from ${repo_root} (commit ${sha:0:12})..."
    if ! docker build -f "$repo_root/deploy/Dockerfile" --build-arg "GIT_SHA=${sha}" -t "$be" "$repo_root"; then
        _ue_build_cache_reset
        _ue_err "backend build failed. Nothing was changed."
        return 1
    fi
    if ! docker build -f "$repo_root/apps/pod-admin/Dockerfile" -t "$pa" "$repo_root"; then
        _ue_build_cache_reset
        _ue_err "pod-admin build failed. Nothing was changed."
        return 1
    fi
    mig_dir="$repo_root/packages/database/migrations"
    last="$(ls "$mig_dir"/*.sql 2>/dev/null | sort | tail -1 | xargs -r basename)"
    count="$(ls "$mig_dir"/*.sql 2>/dev/null | wc -l | tr -d ' ')"
    jq -n --arg id "local-${tag}" --arg sha "$sha" --arg be "$be" --arg pa "$pa" --argjson carry "$carry" \
        --arg last "$last" --argjson count "${count:-0}" --arg compose "sha256:$(_ue_sha256 docker-compose.yml)" \
        --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{schema:1, id:$id, channel:"local", source:true, gitSha:$sha, createdAt:$at,
          images: ($carry + {SYNAP_IMAGE_BACKEND:$be, SYNAP_IMAGE_POD_ADMIN:$pa}),
          migrations:{last:$last, count:$count}, composeSha:$compose, envSchemaVersion:null, minFrom:null, bundle:null}' > "$out"
}

# ── release bundle (U5: the deploy dir is a release bundle, not a checkout) ──
# The bundle holds the release's `synap`, deploy/, kratos/ and
# docker/postgres/ files. It is STAGED (downloaded, sha-verified, extracted)
# before anything changes, INSTALLED after the backup (each file swapped in
# with an atomic rename, so the running `synap` keeps reading its old inode),
# and the files it replaced are kept in state/update/pre-bundle.tar for rollback.
UE_BUNDLE_DIR=""
UE_BUNDLE_INSTALLED=0
_ue_stage_bundle() { # <manifest>
    UE_BUNDLE_DIR=""
    local m="$1" asset want got id
    asset="$(jq -r '.bundle.asset // empty' "$m")"
    want="$(jq -r '.bundle.sha256 // empty' "$m")"
    id="$(jq -r .id "$m")"
    if [ -z "$asset" ]; then
        [ "sha256:$(_ue_sha256 docker-compose.yml)" = "$(jq -r .composeSha "$m")" ] \
            || _ue_warn "release ${id} ships no deploy bundle and this docker-compose.yml differs from the release's — using the local one"
        return 0
    fi
    if [ "$(basename "$(pwd)")" != deploy ] || [ ! -f ../synap ]; then
        _ue_warn "deploy dir is not laid out as <root>/{synap,deploy} — not installing the release bundle"
        return 0
    fi
    rm -rf state/update/bundle state/update/bundle.tgz && mkdir -p state/update/bundle
    _ue_fetch "$(_ue_manifest_url "$id" "$asset")" state/update/bundle.tgz || { _ue_err "could not download the deploy bundle ${asset}"; return 1; }
    got="$(_ue_sha256 state/update/bundle.tgz)"
    [ "$got" = "$want" ] || { _ue_err "deploy bundle sha256 mismatch (manifest ${want}, got ${got})"; return 1; }
    tar -xzf state/update/bundle.tgz -C state/update/bundle || { _ue_err "deploy bundle is not a valid tar.gz"; return 1; }
    [ -f state/update/bundle/deploy/docker-compose.yml ] && [ -f state/update/bundle/synap ] \
        || { _ue_err "deploy bundle lacks synap + deploy/docker-compose.yml"; return 1; }
    UE_BUNDLE_DIR="$(pwd)/state/update/bundle"
}

# The handed-off engine (H1) reuses what the previous engine staged and
# verified: the bundle's sha256 is checked again against the manifest, the
# extracted tree is the one this engine is running from.
_ue_adopt_staged_bundle() { # <manifest>
    UE_BUNDLE_DIR=""
    local m="$1" want got
    want="$(jq -r '.bundle.sha256 // empty' "$m")"
    [ -n "$want" ] && [ -s state/update/bundle.tgz ] && [ -f state/update/bundle/synap ] \
        || { _ue_err "handoff: no staged deploy bundle for ${SYNAP_UE_HANDOFF}"; return 1; }
    got="$(_ue_sha256 state/update/bundle.tgz)"
    [ "$got" = "$want" ] || { _ue_err "handoff: staged bundle sha256 mismatch (manifest ${want}, got ${got})"; return 1; }
    UE_BUNDLE_DIR="$(pwd)/state/update/bundle"
}

# exec the staged release's own `synap` for the rest of this update — never returns.
_ue_handoff() {
    local next="$UE_BUNDLE_DIR/synap"
    _ue_log "Handing the rest of the update to release ${UE_TO}'s own engine (signed manifest, sha256-verified bundle)..."
    exec env SYNAP_UE_HANDOFF="$UE_TO" SYNAP_LOCK_HELD_BY="$$" SYNAP_DEPLOY_DIR="$(pwd)" \
        bash "$next" update "${UE_ARGV[@]}"
}

# The backup container's MinIO client (H2): only the host can copy it out of the
# minio container (pgdata-safety.sh _bk_ensure_mc). Best-effort — backups are
# never a reason to roll an update back; `synap backup status` shows "mc missing".
_ue_provide_backup_mc() {
    [ -n "$(_ue_env_get MINIO_ACCESS_KEY)" ] || return 0
    local out
    out="$(SYNAP_DEPLOY_DIR="$(pwd)" COMPOSE_CMD="command docker compose" _bk_ensure_mc 2>&1)" \
        || _ue_warn "the backup service has no MinIO client yet ($(printf '%s' "$out" | tail -1)) — off-host snapshots fail until: synap backup init"
}

# Re-render + reinstall the systemd units from the INSTALLED `synap` (not the
# staged copy this engine may run from: the units name the CLI's path), as the
# installer does. Best-effort: a host without systemd/root keeps its cron line.
_ue_units_refresh() {
    local self out
    self="$(cd .. && pwd)/synap"
    [ -f "$self" ] || self="$(_units_self)"
    _units_have_systemd || return 0
    [ "$(id -u)" = 0 ] || [ -n "${SYNAP_SYSTEMD_DIR:-}" ] || return 0
    if out="$(SYNAP_DEPLOY_DIR="$(pwd)" bash "$self" units install 2>&1 </dev/null)"; then
        _ue_log "systemd units re-rendered from this release"
    else
        _ue_warn "could not reinstall the systemd units ($(printf '%s' "$out" | tail -1)) — run: sudo ${self} units install"
    fi
}

_ue_install_bundle() {
    [ -n "$UE_BUNDLE_DIR" ] || return 0
    local root rel existing=()
    root="$(cd .. && pwd)"
    ( cd "$UE_BUNDLE_DIR" && find . -type f | sed 's|^\./||' | sort ) > state/update/bundle.files
    while IFS= read -r rel; do [ -e "$root/$rel" ] && existing+=("$rel"); done < state/update/bundle.files
    : > state/update/bundle.new
    while IFS= read -r rel; do [ -e "$root/$rel" ] || echo "$rel" >> state/update/bundle.new; done < state/update/bundle.files
    if [ "${#existing[@]}" -gt 0 ]; then
        tar -cf state/update/pre-bundle.tar -C "$root" "${existing[@]}" || return 1
    else
        tar -cf state/update/pre-bundle.tar -T /dev/null || return 1
    fi
    _ue_caddyfile_edit_warn
    UE_BUNDLE_INSTALLED=1
    while IFS= read -r rel; do
        mkdir -p "$(dirname "$root/$rel")" || return 1
        cp -p "$UE_BUNDLE_DIR/$rel" "$root/$rel.synap-new" && mv -f "$root/$rel.synap-new" "$root/$rel" || return 1
    done < state/update/bundle.files
    _ue_log "Installed the release's deploy files ($(wc -l < state/update/bundle.files | tr -d ' ') files; replaced ones kept in state/update/pre-bundle.tar)"
}

_ue_restore_bundle() {
    [ "$UE_BUNDLE_INSTALLED" = 1 ] || return 0
    local root tmp rel
    root="$(cd .. && pwd)"
    tmp="$(mktemp -d)"
    tar -xf state/update/pre-bundle.tar -C "$tmp" || { rm -rf "$tmp"; return 1; }
    ( cd "$tmp" && find . -type f | sed 's|^\./||' ) | while IFS= read -r rel; do
        cp -p "$tmp/$rel" "$root/$rel.synap-new" && mv -f "$root/$rel.synap-new" "$root/$rel"
    done
    while IFS= read -r rel; do [ -n "$rel" ] && rm -f "$root/$rel"; done < state/update/bundle.new
    rm -rf "$tmp"
}

# ── .env image pins ───────────────────────────────────────────────────────────
# The release block is the ONLY part of .env the engine owns; everything else is
# operator config (one validated writer = P3 `synap config`).
_ue_write_release_env() { # <manifest> <env-file>
    local m="$1" env="$2" tmp keys mode
    keys="$( (jq -r '.images | keys[]' "$m"; echo BACKEND_VERSION; echo SYNAP_RELEASE_ID) | paste -sd'|' -)"
    tmp="$(mktemp "${env}.XXXXXX")" || return 1
    grep -vE "^(${keys})=|^# (>>>|<<<) synap release" "$env" > "$tmp" || true
    {
        echo "# >>> synap release — managed by \`synap update\`; do not edit by hand >>>"
        echo "SYNAP_RELEASE_ID=$(jq -r .id "$m")"
        echo "BACKEND_VERSION=$(jq -r .id "$m")"
        jq -r '.images | to_entries[] | "\(.key)=\(.value)"' "$m"
        echo "# <<< synap release <<<"
    } >> "$tmp"
    mode="$(stat -c %a "$env" 2>/dev/null || stat -f %Lp "$env" 2>/dev/null || echo 600)"
    chmod "$mode" "$tmp" && mv -f "$tmp" "$env"
}

_ue_pull_images() { # <manifest> — before anything changes; a failure aborts the update
    local ref
    for ref in $(jq -r '.images[]' "$1" | sort -u); do
        if docker image inspect "$ref" >/dev/null 2>&1; then
            _ue_log "  cached  ${ref}"
            continue
        fi
        case "$ref" in
            synap-dev/*) _ue_err "local image ${ref} is missing"; return 1 ;;
        esac
        _ue_log "  pulling ${ref}"
        docker pull -q "$ref" >/dev/null || { _ue_err "pull failed: ${ref}"; return 1; }
    done
}

# "<free-MB> <dir>" of the first filesystem the update writes to (deploy dir,
# Docker root) that has less than <min> MB free; empty when every one has enough.
_ue_disk_short() { # <min-MB>
    local dir free root
    root="$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)"
    for dir in "$(pwd)" "$root"; do
        [ -n "$dir" ] && [ -d "$dir" ] || continue
        free="$(df -Pk "$dir" 2>/dev/null | awk 'NR==2 {print int($4/1024)}')"
        [ -n "$free" ] || continue
        if [ "$free" -lt "$1" ]; then echo "$free $dir"; return 0; fi
    done
}

_ue_disk_ok() { # every filesystem the update writes to keeps $1 / SYNAP_UPDATE_MIN_FREE_MB MB free
    local min="${1:-${SYNAP_UPDATE_MIN_FREE_MB:-2048}}" short
    short="$(_ue_disk_short "$min")"
    [ -z "$short" ] && return 0
    _ue_err "only ${short%% *} MB free on ${short#* } (need ${min} MB for images + the pre-update dump), after removing this pod's old release images. Free space, or set SYNAP_UPDATE_MIN_FREE_MB. Nothing was changed."
    _ue_disk_consumers >&2
    return 1
}

# The 3 biggest images and volumes that are NOT this pod's — named so the owner
# knows what to remove; Synap never removes them. Read-only.
_ue_disk_consumers() {
    local v mp
    echo "  Biggest consumers that are not this pod's (Synap never removes them):"
    { docker images --format '{{.Size}}|image {{.Repository}}:{{.Tag}}' 2>/dev/null | grep -vE "\|image (${_SYNAP_FIRST_PARTY_IMAGE_RE#^}|<none>)" \
        | awk -F'|' '{ n = $1 + 0; u = $1; sub(/^[0-9.]+/, "", u); m["kB"] = 1e3; m["MB"] = 1e6; m["GB"] = 1e9; m["TB"] = 1e12; printf "%.0f|%s\n", n * ((u in m) ? m[u] : 1), $2 }'
      for v in $(docker volume ls -q 2>/dev/null); do
          [ "$(docker volume inspect -f '{{index .Labels "com.docker.compose.project"}}' "$v" 2>/dev/null || true)" = "${COMPOSE_PROJECT_NAME:-}" ] && continue
          mp="$(docker volume inspect -f '{{.Mountpoint}}' "$v" 2>/dev/null || true)"
          [ -n "$mp" ] && echo "$(( $(du -sk "$mp" 2>/dev/null | cut -f1 || echo 0) * 1024 ))|volume ${v}"
      done; } | sort -t'|' -k1,1nr | head -3 | awk -F'|' '{ printf "    %.1f GB  %s\n", $1 / 1e9, $2 }'
}

_ue_verify() { # <manifest> <services...>
    local m="$1" cid svc running; shift
    cid="$(docker compose ps -q backend 2>/dev/null | head -1)"
    [ -n "$cid" ] || { _ue_err "verify: no backend container"; return 1; }
    docker exec "$cid" node -e "$_UE_STATUS_PROBE" > state/update/status-release.json 2>/dev/null \
        || { _ue_err "verify: /status/release unreachable"; return 1; }
    RELEASE_JSON_FILE="$(pwd)/state/update/status-release.json" \
    SYNAP_EXPECT_MIGRATION="$(jq -r .migrations.last "$m")" \
    SYNAP_EXPECT_GIT_SHA="$(jq -r .gitSha "$m")" \
        sh ./verify-deploy.sh || return 1
    running="$(docker compose ps --status running --services 2>/dev/null)"
    for svc in "$@"; do
        grep -qx "$svc" <<<"$running" || { _ue_err "verify: service ${svc} is not running"; return 1; }
    done
    _ue_services_healthy || return 1
    if printf '%s\n' "$@" | grep -qx caddy; then _ue_edge_verify || return 1; fi
}

# "<service> <health> <startPeriodNs>" per running/restarting container of this
# project (an exited one keeps its last health, so it is not judged here — the
# "is running" check covers it); health is Docker's own verdict
# (.State.Health.Status), `none` without a healthcheck.
_ue_health_states() {
    local ids
    ids="$(docker compose ps -q 2>/dev/null)"
    [ -n "$ids" ] || return 0
    # shellcheck disable=SC2086 # one id per word
    docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}} {{if .Config.Healthcheck}}{{.Config.Healthcheck.StartPeriod}}{{else}}0{{end}}' $ids 2>/dev/null || true
}

# Every service with a healthcheck must reach `healthy` (Docker restarts only on
# exit: a crash-looping or unhealthy Kratos still counts as "running"). Waits up
# to SYNAP_UPDATE_HEALTHY_WAIT s while a service is `starting`. Not a failure:
# a service that was already unhealthy before the update (UE_UNHEALTHY_BEFORE —
# rolling back cannot fix it; `synap doctor` reports it) and one whose own
# start_period is longer than the wait (postgres-backup: 30m) while it is still
# `starting`. Both are warned about.
_ue_services_healthy() {
    local wait="${SYNAP_UPDATE_HEALTHY_WAIT:-180}" deadline svc st sp bad pending slow
    deadline=$(( $(date +%s) + wait ))
    while :; do
        bad=""; pending=""; slow=""
        while read -r svc st sp; do
            [ -n "$svc" ] || continue
            case "$st" in
                healthy|none) ;;
                unhealthy)
                    if grep -qx "$svc" <<<"${UE_UNHEALTHY_BEFORE:-}"; then slow="${slow} ${svc}(unhealthy before the update)"
                    else bad="${bad} ${svc}"; fi ;;
                *)
                    if [ "${sp:-0}" -gt $(( wait * 1000000000 )) ] 2>/dev/null; then slow="${slow} ${svc}(${st})"
                    else pending="${pending} ${svc}"; fi ;;
            esac
        done < <(_ue_health_states)
        [ -z "$bad" ] && [ -z "$pending" ] && break
        if [ "$(date +%s)" -ge "$deadline" ]; then
            _ue_err "verify: not healthy after ${wait}s:${bad:+ unhealthy:${bad}}${pending:+ still starting:${pending}} — inspect: docker compose ps; docker compose logs <service>"
            return 1
        fi
        sleep "${SYNAP_UPDATE_HEALTHY_INTERVAL:-5}"
    done
    [ -z "$slow" ] || _ue_warn "verify: not judged healthy, not blocking the update:${slow}"
    return 0
}

# Keep the images of the current and previous release (Kamal-style local
# rollback cache); remove older first-party images — by REFERENCE without -f, so
# a tag another stack put on the same image keeps it — and dangling ones built
# from our Dockerfiles (LABEL io.synap.first-party). Images any container uses
# are skipped. No release record yet ⇒ no image is touched. Also keeps the newest
# 2 pre-update dumps (+ every dump a record names: _bk_pinned_dumps). Runs at the START
# of every update (before the disk check) and after every applied one. Never
# another stack's image, never a volume.
_SYNAP_FIRST_PARTY_IMAGE_RE='^(ghcr\.io/synap-core/(backend|pod-admin|pod-agent)|synap-dev/|synap-local/|synap-adopted/)'
_ue_prune_images() {
    local keep used ids id repo tag dg ref
    if [ -s state/current-release.json ]; then
        keep="$(jq -r '.images[]?' state/current-release.json state/previous-release.json 2>/dev/null \
            | while read -r ref; do docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null; done | sort -u)"
        ids="$(docker ps -aq 2>/dev/null | tr '\n' ' ')"
        # shellcheck disable=SC2086 # one id per word
        used="$( { [ -n "${ids// /}" ] && docker inspect -f '{{.Image}}' $ids 2>/dev/null; } || true)"
        docker images --digests --no-trunc --format '{{.ID}}|{{.Repository}}|{{.Tag}}|{{.Digest}}' 2>/dev/null \
            | while IFS='|' read -r id repo tag dg; do
                [[ "$repo" =~ $_SYNAP_FIRST_PARTY_IMAGE_RE ]] || continue
                grep -qxF "$id" <<<"${keep}"$'\n'"${used}" && continue
                if [ "$tag" != "<none>" ]; then ref="${repo}:${tag}"; elif [ "$dg" != "<none>" ]; then ref="${repo}@${dg}"; else continue; fi
                docker rmi "$ref" >/dev/null 2>&1 </dev/null || true
            done
        for id in $(docker images -q --no-trunc -f dangling=true -f label=io.synap.first-party=true 2>/dev/null); do
            grep -qxF "$id" <<<"$used" || docker rmi "$id" >/dev/null 2>&1 </dev/null || true
        done
    fi
    # A --from-source build leaves its BuildKit cache behind (10.8 GB on perso,
    # 2026-10-04: free space 16 GB → 4.6 GB after one update). Cap it; the
    # cache holds no data. --max-used-space is Docker 28+, --keep-storage older.
    docker builder prune -f --max-used-space 2gb >/dev/null 2>&1 \
        || docker builder prune -f --keep-storage 2gb >/dev/null 2>&1 || true
    SYNAP_DEPLOY_DIR="$(pwd)" _bk_prune_label pre-update 2
    return 0
}

# ── the edge's Caddyfile ──────────────────────────────────────────────────────
# deploy/Caddyfile belongs to the RELEASE: every update installs the release's
# copy over it (that is how edge fixes reach pods). A pod that needs its own
# edge rules points CADDYFILE_PATH (deploy/.env) at a file outside the bundle;
# the engine then never touches it — and warns that release edge rules no
# longer reach it. state/caddyfile.release.sha256 is the release copy's hash,
# kept by every verified update and every install, so a hand edit of
# deploy/Caddyfile is named before the next release replaces it.
_ue_caddyfile() { # → the absolute path of the Caddyfile caddy mounts
    local p="${CADDYFILE_PATH:-$(_ue_env_get CADDYFILE_PATH)}"
    p="${p:-./Caddyfile}"
    case "$p" in /*) echo "$p" ;; *) echo "$(pwd)/${p#./}" ;; esac
}

_ue_caddyfile_mark_release() { # after a verified update / an install: deploy/Caddyfile is the release's copy
    [ -f Caddyfile ] || return 0
    mkdir -p state && _ue_sha256 Caddyfile > state/caddyfile.release.sha256
}

_ue_caddyfile_edit_warn() {
    local custom="${CADDYFILE_PATH:-$(_ue_env_get CADDYFILE_PATH)}" want
    if [ -n "$custom" ] && [ "$(_ue_caddyfile)" != "$(pwd)/Caddyfile" ]; then
        _ue_warn "caddy serves CADDYFILE_PATH=${custom}, not the release's Caddyfile: edge rules this release ships (deploy/Caddyfile) do not reach it — merge them into your file by hand"
    fi
    [ -f Caddyfile ] && [ -s state/caddyfile.release.sha256 ] || return 0
    want="$(cat state/caddyfile.release.sha256)"
    [ "$(_ue_sha256 Caddyfile)" = "$want" ] && return 0
    _ue_warn "deploy/Caddyfile was edited by hand; this release replaces it with its own copy (yours is kept in state/update/pre-bundle.tar until the next update). To keep custom edge rules, put them in a file outside deploy/ and set CADDYFILE_PATH=<that file> in deploy/.env"
}

# The sha256 of the Caddyfile the RUNNING caddy has mounted. A bind-mounted file
# is pinned to the inode it was created with, and every write the engine makes
# is an atomic rename, so this is the file caddy loaded — not the one on disk.
# Empty when caddy is not running.
_ue_caddy_loaded_sha() {
    local cid
    cid="$(docker compose ps -q caddy 2>/dev/null | head -1)"
    [ -n "$cid" ] || return 0
    docker exec "$cid" sha256sum /etc/caddy/Caddyfile 2>/dev/null | cut -d' ' -f1
}

# The release's Caddyfile, checked by caddy itself before anything depends on it.
_ue_caddy_validate() {
    local out
    out="$(docker compose run --rm --no-deps caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile 2>&1 </dev/null)" && return 0
    _ue_err "the Caddyfile caddy would load ($(_ue_caddyfile)) does not validate:"
    printf '%s\n' "$out" | tail -5 | sed 's/^/      /' >&2
    return 1
}

# Recreate caddy only when the Caddyfile it loaded is not the one on disk. A
# changed caddy image or compose definition is recreated by the `up` before
# this (Compose sees it), and that new container already mounts the new file,
# so this never recreates it a second time.
_ue_caddy_converge() {
    local want have
    want="$(_ue_sha256 "$(_ue_caddyfile)" 2>/dev/null)"
    have="$(_ue_caddy_loaded_sha)"
    if [ -n "$want" ] && [ "$want" = "$have" ]; then
        _ue_log "caddy already serves this Caddyfile — not recreated"
        return 0
    fi
    docker compose up -d --force-recreate caddy
}

# Through the edge, as a client reaches it: https on 127.0.0.1:443 for DOMAIN,
# else http :80 with Host: DOMAIN (a tunnelled pod is served only there, and a
# direct pod whose certificate is not issued yet still proves its routing).
_ue_edge_verify() {
    local domain i code
    domain="$(_ue_env_get DOMAIN)"
    [ -n "$domain" ] || return 0
    for i in $(seq 1 "${SYNAP_UPDATE_EDGE_TRIES:-15}"); do
        code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 --resolve "${domain}:443:127.0.0.1" "https://${domain}/health" 2>/dev/null)"
        [ "$code" = 200 ] && return 0
        code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 -H "Host: ${domain}" "http://127.0.0.1/health" 2>/dev/null)"
        if [ "$code" = 200 ]; then
            _ue_log "edge: ${domain} answers over :80 (tunnel ingress); https on :443 did not — normal on a tunnelled pod or before its certificate is issued"
            return 0
        fi
        sleep "${SYNAP_UPDATE_EDGE_INTERVAL:-2}"
    done
    _ue_err "verify: the edge (caddy) does not serve ${domain}/health — neither https via 127.0.0.1:443 nor http :80 (last answer: ${code:-none}). Inspect: docker compose logs caddy"
    return 1
}

# ── the engine ────────────────────────────────────────────────────────────────
UE_FROM=""; UE_TO=""; UE_BACKUP=""; UE_LEVEL_BEFORE=""; UE_EDGE=""; UE_PROFILE_ARGS=(); UE_SERVICES=()

_ue_bring_up_rest() { # every non-backend service; never stops half-way
    local failed=0
    if [ "${#UE_SERVICES[@]}" -gt 0 ]; then
        docker compose "${UE_PROFILE_ARGS[@]}" up -d --remove-orphans "${UE_SERVICES[@]}" || failed=1
    fi
    # kratos.yml and the Caddyfile are bind-mounted files and pod-admin takes
    # PUBLIC_URL at creation: none of these changes is seen by a plain `up`.
    # Without caddy here, an edge rule a release ships (the MinIO upload refusal,
    # the backend catch-all) reached only freshly installed pods (2026-10-19).
    # Caddy is recreated only when its loaded Caddyfile differs (_ue_caddy_converge).
    local svc
    for svc in kratos pod-admin; do
        printf '%s\n' "${UE_SERVICES[@]}" | grep -qx "$svc" || continue
        docker compose up -d --force-recreate "$svc" || failed=1
    done
    if printf '%s\n' "${UE_SERVICES[@]}" | grep -qx caddy; then
        _ue_caddy_converge || failed=1
    fi
    return "$failed"
}

# A rollback swaps IMAGES ONLY; it never restores data (founder, 2026-10-20).
# Migrations are forward-only (expand/contract): a release only adds to the
# schema, and what it removes or reshapes (a contract step) stopped being used
# by an EARLIER release — the CI guard
# deploy/__tests__/migration-forward-only.test.sh refuses any other destructive
# migration. So the previous release's images run on the newer schema, and the
# data written since the update started is kept. Restoring the pre-update dump
# is the operator's deliberate choice (`synap restore <dump>`), never automatic:
# the automatic pg_restore of 2026-10-20 lost the events primary key on
# pod.antoinesrvt while its checks passed.
_ue_rollback() { # <reason>  — never returns
    set +e
    local reason="$1" status=rolled_back schema
    _ue_err "update ${UE_FROM:-?} → ${UE_TO} failed: ${reason}"
    _ue_log "↩ Rolling back to ${UE_FROM:-the previous release} (images and deploy files; the data is kept)..."
    docker rm -f synap-backend-canary >/dev/null 2>&1
    schema="$(_ue_schema_state)"
    case "$schema" in
        migrated) reason="${reason}; the database schema stays migrated (forward-only), its data kept" ;;
        unknown)  reason="${reason}; the migration ledger could not be read, so whether the schema moved is unknown" ;;
    esac
    cp -p state/update/env.before .env || status=rollback_failed
    _ue_restore_bundle || { _ue_err "could not restore the previous deploy files from state/update/pre-bundle.tar"; status=rollback_failed; }
    if [ -f state/update/kratos.yml.before ]; then
        local kcfg=state/update/kratos.yml.before kerr
        kerr="$(kratos_config_errors "$kcfg")"
        if [ -n "$kerr" ] && [ -s ../kratos/kratos.yml.good ] && [ -z "$(kratos_config_errors ../kratos/kratos.yml.good)" ]; then
            _ue_warn "the pre-update kratos.yml is itself broken ($(head -1 <<<"$kerr")) — restoring the last verified one, ../kratos/kratos.yml.good"
            kcfg=../kratos/kratos.yml.good
        fi
        cp -p "$kcfg" ../kratos/kratos.yml || status=rollback_failed
        docker compose up -d --force-recreate kratos >/dev/null 2>&1 || true
    fi
    docker compose up -d --force-recreate --remove-orphans backend realtime || status=rollback_failed
    _ue_bring_up_rest || status=rollback_failed
    if ! _ue_backend_healthy; then
        _ue_err "the previous release is not healthy either — inspect: docker compose logs backend"
        status=rollback_failed
    fi
    # Sign-in is part of "serving again": a backend answering /health while
    # Kratos crash-loops is a pod nobody can log into.
    if ! wait_for_kratos_ready; then
        _ue_err "Kratos (sign-in) is not ready after the rollback — inspect: docker compose logs kratos; synap doctor"
        status=rollback_failed
        reason="${reason}; after the rollback Kratos (sign-in) is not ready"
    fi
    _ue_record "$status" "$UE_FROM" "$UE_TO" "$reason" false "$UE_BACKUP" "$schema"
    if [ "$status" = rolled_back ]; then
        _ue_warn "Rolled back: the pod is serving ${UE_FROM:-its previous release} again. Its data was not touched."
    else
        _ue_err "ROLLBACK INCOMPLETE — the pod needs attention (synap doctor). Its data was not touched."
    fi
    if [ "$schema" != unchanged ]; then
        if [ "$schema" = migrated ]; then _ue_warn "The database keeps the schema ${UE_TO}'s migrations left it in, with all its data."
        else _ue_warn "Whether ${UE_TO}'s migrations changed the database is unknown (the migration ledger could not be read)."; fi
        if [ -n "$UE_BACKUP" ]; then
            _ue_warn "Only to put the database back exactly as it was before the update — this DISCARDS everything written since — run, while the pod still runs ${UE_FROM:-this release}:"
            _ue_warn "    synap restore ${UE_BACKUP}"
            _ue_warn "That dump is kept until another failed update offers a newer one (the dump pruning skips it); copy it off the pod to keep it longer."
        else
            _ue_warn "There is no pre-update dump: the pod had no database before this update."
        fi
    fi
    exit 1
}

# <release|source> <ref> <force 0|1>  — cwd = deploy dir, update lock held
synap_update_engine() {
    local mode="$1" ref="$2" force="${3:-0}" m errors level_before level_after rc
    mkdir -p state/update
    m="$(pwd)/state/update/manifest.json"
    # Every exit records an outcome (B3): pod-agent waits for the record of the
    # request it queued, and without one it reports UPDATE_NO_OUTCOME 3 h later.
    # jq is the one exception: it writes the record (and reads the request).
    command -v jq >/dev/null 2>&1 || { _ue_err "jq is required by synap update (it also writes the outcome record, so none is written). Nothing was changed."; exit 1; }
    command -v curl >/dev/null 2>&1 || { _ue_err "curl is required by synap update. Nothing was changed."; _ue_record aborted "$(_ue_current_release_id)" "${ref:-local}" "curl is not installed" false; exit 1; }

    UE_EDGE="$(_ue_edge)" || { _ue_record aborted "$(_ue_current_release_id)" "${ref:-local}" "edge proxy not settled (SYNAP_EDGE)" false; exit 1; }
    _ue_edge_preflight "$UE_EDGE" || { _ue_record aborted "$(_ue_current_release_id)" "${ref:-local}" "ports 80/443 are held by another container (SYNAP_EDGE=caddy)" false; exit 1; }
    _ue_adopt_running
    _ue_prune_images   # room first: this pod's old release images, before any disk check
    UE_FROM="$(_ue_current_release_id)"

    # 1. the target release
    if [ "$mode" = source ]; then
        _ue_build_from_source "$m" || { _ue_record aborted "$UE_FROM" "local" "from-source build failed" false; exit 1; }
    elif [ -n "${SYNAP_UE_HANDOFF:-}" ]; then
        if [ "$(jq -r '.id // empty' "$m" 2>/dev/null)" != "$SYNAP_UE_HANDOFF" ]; then
            _ue_err "handoff: state/update/manifest.json is not release ${SYNAP_UE_HANDOFF}. Nothing was changed."
            _ue_record aborted "$UE_FROM" "$SYNAP_UE_HANDOFF" "handoff manifest missing or not ${SYNAP_UE_HANDOFF}" false
            exit 1
        fi
        _ue_log "Release ${SYNAP_UE_HANDOFF}'s own engine is running this update"
    else
        _ue_log "Fetching release manifest: ${ref}"
        if ! _ue_fetch "$(_ue_manifest_url "$ref")" "$m"; then
            _ue_err "could not fetch the release manifest for '${ref}' ($(_ue_manifest_url "$ref")). Nothing was changed."
            _ue_err "To build this checkout instead: synap update --from-source"
            _ue_record aborted "$UE_FROM" "$ref" "manifest fetch failed" false
            exit 1
        fi
        if ! _ue_verify_manifest_sig "$ref" "$m"; then
            _ue_record aborted "$UE_FROM" "$ref" "manifest signature refused" false
            exit 1
        fi
    fi
    UE_TO="$(jq -r '.id // empty' "$m" 2>/dev/null)"
    [ -n "$UE_TO" ] || UE_TO="$ref"
    if [ -n "${SYNAP_UE_HANDOFF:-}" ]; then
        _ue_adopt_staged_bundle "$m" || { _ue_record aborted "$UE_FROM" "$UE_TO" "deploy bundle invalid" false; exit 1; }
    else
        _ue_stage_bundle "$m" || { _ue_record aborted "$UE_FROM" "$UE_TO" "deploy bundle invalid" false; exit 1; }
    fi
    errors="$(_ue_manifest_errors "$m" "${UE_BUNDLE_DIR:+$UE_BUNDLE_DIR/deploy/}docker-compose.yml")"
    if [ -n "$errors" ]; then
        _ue_err "release manifest ${UE_TO} is invalid — refusing it. Nothing was changed:"
        printf '      %s\n' "$errors" >&2
        _ue_record aborted "$UE_FROM" "$UE_TO" "invalid manifest" false
        exit 1
    fi
    if [ "$UE_TO" = "$UE_FROM" ] && [ "$force" != 1 ]; then
        _ue_ok "Already on release ${UE_TO} — nothing to do (--force re-applies it)."
        _ue_record noop "$UE_FROM" "$UE_TO" "already on release ${UE_TO}" false
        return 0
    fi
    # 1b. update the updater first (H1): the release's own engine runs the rest.
    if [ -n "$UE_BUNDLE_DIR" ] && [ -z "${SYNAP_UE_HANDOFF:-}" ]; then
        _ue_handoff
    fi
    _ue_log "Updating ${UE_FROM:-unrecorded} → ${UE_TO} (git $(jq -r '.gitSha[0:12]' "$m"), migrations → $(jq -r .migrations.last "$m"))"

    # 2. preflight — nothing changes before every check passed (the migration
    #    ledger and minFrom: in 4, once postgres is surely running)
    _ue_disk_ok || { _ue_record aborted "$UE_FROM" "$UE_TO" "not enough disk" false; exit 1; }
    _preflight_compose_check "$(pwd)" || { _ue_record aborted "$UE_FROM" "$UE_TO" "compose preflight failed" false; exit 1; }

    # 3. pull by digest — a failure here leaves the pod exactly as it was
    _ue_log "Pulling release images by digest (nothing changed yet)..."
    if ! _ue_pull_images "$m"; then
        _ue_err "image pull failed — nothing was changed; the pod keeps serving ${UE_FROM:-its current release}."
        _ue_record aborted "$UE_FROM" "$UE_TO" "image pull failed" false
        exit 1
    fi

    # 4. snapshot + verified pre-update dump (Cloudron rule: no backup, no update)
    (umask 077 && cp -p .env state/update/env.before) || { _ue_err "cannot snapshot .env"; _ue_record aborted "$UE_FROM" "$UE_TO" "could not snapshot .env" false; exit 1; }
    rm -f state/update/kratos.yml.before   # a previous run's snapshot is never restored
    _run_pgdata_guard
    if [ "$(SYNAP_DEPLOY_DIR="$(pwd)" COMPOSE_CMD="command docker compose" pgdata_layout)" = "ok" ]; then
        if [ -z "$(command docker compose ps -q --status running postgres 2>/dev/null)" ]; then
            docker compose up -d postgres || { _ue_err "postgres did not start — cannot take the pre-update backup. Nothing was changed."; _ue_record aborted "$UE_FROM" "$UE_TO" "postgres did not start for the pre-update backup" false; exit 1; }
            _pgs_wait_ready "$(_pgs_container)" || { _ue_err "postgres not ready — no backup, no update. Nothing was changed."; _ue_record aborted "$UE_FROM" "$UE_TO" "postgres not ready for the pre-update backup" false; exit 1; }
        fi
        # The level before anything changes. Unreadable refuses the update: a
        # failed read is neither "no migrations" (minFrom would pass) nor
        # "moved" (the rollback would report a schema change that never ran).
        level_before="$(_ue_migration_level)" || {
            _ue_err "cannot read the migration ledger (_migrations) — refusing to update a pod whose schema level is unknown. Nothing was changed."
            _ue_record aborted "$UE_FROM" "$UE_TO" "migration ledger unreadable" false
            exit 1
        }
        _ue_min_from_check "$m" "${level_before#*|}" || exit 1
        _ue_tsdb_check "$m" || exit 1
        UE_BACKUP="$(SYNAP_DEPLOY_DIR="$(pwd)" COMPOSE_CMD="command docker compose" pgdata_backup pre-update)" || {
            _ue_err "Pre-update database backup failed — aborting update before migrations. Nothing was changed."
            _ue_record aborted "$UE_FROM" "$UE_TO" "pre-update backup failed" false
            exit 1
        }
    else
        _ue_warn "no postgres data yet (fresh pod) — no pre-update dump to take"
        level_before="0|"
    fi
    UE_LEVEL_BEFORE="$level_before"
    # Services already unhealthy now are not the release's doing (verify warns, never rolls back for them).
    UE_UNHEALTHY_BEFORE="$(_ue_health_states | awk '$2 == "unhealthy" {print $1}')"

    # 5. from here on every failure rolls back
    trap '_ue_rollback "interrupted"' INT TERM HUP
    set +e
    _ue_install_bundle || _ue_rollback "installing the release's deploy files failed"
    _ue_write_release_env "$m" .env || _ue_rollback "writing the release image pins failed"
    UE_PROFILE_ARGS=()
    if should_start_pod_agent; then UE_PROFILE_ARGS=(--profile pod-agent)
    elif [ $? -eq 2 ]; then _ue_rollback "pod-agent misconfigured"; fi
    UE_SERVICES=()
    local _svc
    while IFS= read -r _svc; do [ -n "$_svc" ] && UE_SERVICES+=("$_svc"); done < <(_ue_services "$UE_EDGE" "${UE_PROFILE_ARGS[@]}")

    local domain
    domain="$(_ue_env_get DOMAIN)"; domain="${domain:-localhost}"
    backfill_federation_public_urls "$domain"
    # kratos.yml is generated, not part of the release bundle: keep the running
    # one so a rollback restores it (a bad render once outlived the rollback and
    # left Kratos crash-looping on the previous release).
    [ -f ../kratos/kratos.yml ] && cp -p ../kratos/kratos.yml state/update/kratos.yml.before
    generate_kratos_config "$domain" || _ue_rollback "kratos config generation failed"
    if printf '%s\n' "${UE_SERVICES[@]}" | grep -qx caddy; then
        _ue_caddy_validate || _ue_rollback "the Caddyfile does not validate"
    fi
    COMPOSE_CMD="docker compose" ensure_ory_databases || _ue_rollback "Ory database bootstrap failed"

    # 6. migrations (backend, kratos) — a throw rolls the images back; the
    #    schema stays where the migration left it (see _ue_rollback)
    _ue_log "Running migrations..."
    docker compose run --rm backend-migrate || _ue_rollback "backend migration failed"
    docker compose run --rm kratos-migrate  || _ue_rollback "kratos migration failed"
    level_after="$(_ue_migration_level)" || level_after="<unreadable>"
    _ue_log "Migration level: ${level_before} → ${level_after}"

    # 7. canary-gated swap, then EVERY other service — never stop in between
    _UE_MIGRATED=1 _swap_backend_canary; rc=$?
    case "$rc" in
        0) ;;
        2) _ue_rollback "production backend unhealthy after the swap (the canary had passed)" ;;
        *) _ue_rollback "the new backend image failed its canary health check" ;;
    esac
    _ue_log "Bringing up the other services (edge: ${UE_EDGE})..."
    _ue_bring_up_rest || _ue_rollback "some services failed to start"

    # 8. verify the release actually landed
    _ue_verify "$m" "${UE_SERVICES[@]}" || _ue_rollback "post-update verification failed"

    # 9. record
    trap - INT TERM HUP
    [ -s state/current-release.json ] && cp -p state/current-release.json state/previous-release.json
    jq --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg backup "$UE_BACKUP" --arg edge "$UE_EDGE" \
        '. + {appliedAt:$at, preUpdateBackup:$backup, edge:$edge}' "$m" > state/current-release.json.tmp \
        && mv -f state/current-release.json.tmp state/current-release.json
    _ue_prune_images
    # Last known-good kratos.yml (Kratos was just verified healthy on it): the
    # rollback falls back to it when the pre-update snapshot is itself broken.
    # Never removed by a later run.
    if [ -s ../kratos/kratos.yml ] && [ -z "$(kratos_config_errors ../kratos/kratos.yml)" ]; then
        cp -p ../kratos/kratos.yml ../kratos/kratos.yml.good.tmp && mv -f ../kratos/kratos.yml.good.tmp ../kratos/kratos.yml.good \
            || _ue_warn "could not keep ../kratos/kratos.yml.good (the last verified Kratos config)"
    fi
    _ue_caddyfile_mark_release
    _ue_provide_backup_mc
    _ue_units_refresh
    _ue_tsdb_notice
    _ue_record succeeded "$UE_FROM" "$UE_TO" "" false "$UE_BACKUP"
    _ue_ok "Release ${UE_TO} is live (verified: buildStamp + migration level)."
    set -e
}

# ── unattended updates (self-heal D2/D3: synap-update.service) ────────────────
# Two systemd triggers run `synap update --unattended` (units: deploy/systemd/):
#  • synap-update.path — a REQUEST, state/requests/update.json, from whoever was
#    authorised to order an update. Honoured at any hour and whatever `auto`
#    says: the order already passed its own policy (pod-agent policy.js).
#  • synap-update.timer (installed DISABLED — `synap units install
#    --enable-auto-update` opts in) — the owner's policy, state/update-policy.json.
# The unattended path always verifies the release signature (D3:
# SYNAP_RELEASE_VERIFY=enforce); a manual `synap update` keeps the .env setting.
#
# REQUEST CONTRACT (schema 1). Write it atomically (tmp file + rename) to
# <deploy dir>/state/requests/update.json:
#   {"schema": 1, "release": "<release id | fast | stable>",
#    "requestedBy": "<free text>", "requestedAt": "<ISO-8601>", "id": "<opaque, e.g. the order's jti>"}
# `release` follows pod-agent's validateUpdateTargetVersion: ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$,
# never "latest". The file is TAKEN (renamed to update.taken.json) before
# anything acts on it — by synap-update.service's ExecStartPre, or by the
# engine on a manual run (_synap_take_request) — so the .path unit can never
# loop on it, and the outcome
# lands in state/last-update.json like every update's, with `request: <id>` —
# an invalid request, or one that met a busy lock, is recorded `aborted` and is
# not retried. pod-agent (update-request.js) is the writer and reads that record
# back to report the order's outcome to the CP.
#
# POLICY, state/update-policy.json (every key optional):
#   {"auto": true, "channel": "stable" | "fast" | "source", "window": "03:00-05:00", "pinned": false}
# channel defaults to SYNAP_UPDATE_CHANNEL (.env), else stable; "source" means
# --from-source (a dev host with no published releases). The window is the
# host's local time and may wrap midnight ("23:00-02:00").
_UE_RELEASE_RE='^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$'

_ue_take_request() { _synap_take_request update; }

_ue_in_window() { # <HH:MM-HH:MM> [now HH:MM]
    local w="$1" now="${2:-$(date +%H:%M)}" a b
    a="${w%-*}"; b="${w#*-}"
    if [[ "$a" < "$b" ]]; then [[ ! "$now" < "$a" ]] && [[ "$now" < "$b" ]]
    elif [ "$a" = "$b" ]; then return 0
    else [[ ! "$now" < "$a" ]] || [[ "$now" < "$b" ]]; fi
}

# Sets the caller's mode/ref. 0 = run · 1 = nothing to do now · 2 = refused.
_ue_unattended_plan() {
    export SYNAP_RELEASE_VERIFY=enforce
    if [ -n "${SYNAP_UNATTENDED_PLAN:-}" ]; then   # the --from-source re-exec: already planned
        mode="${SYNAP_UNATTENDED_PLAN%%|*}"; ref="${SYNAP_UNATTENDED_PLAN#*|}"; return 0
    fi
    local req rel rid pol=state/update-policy.json channel window
    req="$(_ue_take_request)"
    if [ -n "$req" ]; then
        rel="$(jq -r '.release // empty' "$req" 2>/dev/null || true)"
        rid="$(jq -r '.id // empty' "$req" 2>/dev/null || true)"
        export UE_REQUEST_ID="$rid"
        if [ "$(jq -r '.schema // empty' "$req" 2>/dev/null || true)" != 1 ] || ! [[ "$rel" =~ $_UE_RELEASE_RE ]] || [ "$rel" = latest ]; then
            _ue_err "update request ${rid:-<no id>} refused: it must be {\"schema\":1, \"release\":\"<release id|fast|stable>\"} (got release '${rel}'). Nothing was changed."
            _ue_record aborted "$(_ue_current_release_id)" "${rel:-?}" "invalid update request ${rid:-<no id>}" false
            return 2
        fi
        _ue_log "update requested (${rid:-no id}, by $(jq -r '.requestedBy // "?"' "$req" 2>/dev/null || echo '?')): ${rel}"
        mode=release; ref="$rel"
    else
        if [ -f "$pol" ] && ! jq -e 'type == "object"' "$pol" >/dev/null 2>&1; then
            _ue_err "${pol} is not a JSON object — no automatic update until it is fixed"
            _ue_record aborted "$(_ue_current_release_id)" "?" "update policy ${pol} is not a JSON object" false
            return 2
        fi
        if [ "$(jq -r '.auto' "$pol" 2>/dev/null || true)" = false ]; then _ue_log "automatic updates are off (${pol}: auto false)"; return 1; fi
        if [ "$(jq -r '.pinned' "$pol" 2>/dev/null || true)" = true ]; then _ue_log "this pod is pinned (${pol}: pinned true) — no automatic update"; return 1; fi
        window="$(jq -r '.window // empty' "$pol" 2>/dev/null || true)"; window="${window:-03:00-05:00}"
        if ! [[ "$window" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
            _ue_err "${pol}: window '${window}' is not HH:MM-HH:MM — no automatic update until it is fixed"
            _ue_record aborted "$(_ue_current_release_id)" "?" "update policy window '${window}' is not HH:MM-HH:MM" false
            return 2
        fi
        if ! _ue_in_window "$window"; then _ue_log "outside the update window ${window} (now $(date +%H:%M)) — nothing to do"; return 1; fi
        channel="$(jq -r '.channel // empty' "$pol" 2>/dev/null || true)"
        channel="${channel:-$(_ue_env_get SYNAP_UPDATE_CHANNEL)}"; channel="${channel:-stable}"
        case "$channel" in
            source)      mode=source; ref="" ;;
            fast|stable) mode=release; ref="$channel" ;;
            *) _ue_err "update channel '${channel}' is not stable|fast|source"
               _ue_record aborted "$(_ue_current_release_id)" "?" "update channel '${channel}' is not stable|fast|source" false
               return 2 ;;
        esac
    fi
    export SYNAP_UNATTENDED_PLAN="${mode}|${ref}"
    return 0
}

# The update lock was busy (router): a pending request is taken and recorded as
# not run, so the .path unit cannot loop on it; a timer tick simply retries tomorrow.
_ue_unattended_busy() { # cwd = deploy dir
    local req
    req="$(_ue_take_request)"
    [ -n "$req" ] || return 0
    UE_REQUEST_ID="$(jq -r '.id // empty' "$req" 2>/dev/null || true)"
    _ue_record aborted "$(_ue_current_release_id)" "$(jq -r '.release // "?"' "$req" 2>/dev/null || echo '?')" \
        "another pod operation held the update lock — request $(jq -r '.id // "?"' "$req" 2>/dev/null || echo '?') was not run; send it again" false
}

cmd_update() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    local mode="release" ref="" force=0 unattended=0
    local -a _update_argv=("$@")
    UE_ARGV=("$@")   # the handoff (H1) re-runs this same command line
    while [[ $# -gt 0 ]]; do
        case $1 in
            --release|-r)
                ref="${2:-}"; shift 2 || { echo -e "${RED}--release needs an id or a channel (fast|stable)${NC}"; exit 1; } ;;
            --from-source|--build|-b|--local|-l)
                mode="source"; shift ;;
            --from-image)
                # Legacy flag (eve passes it): "use a published artifact" = a release.
                shift ;;
            --version|-v)
                ref="${2:-}"; shift 2 || exit 1 ;;
            --force)
                force=1; shift ;;
            --unattended)
                unattended=1; shift ;;
            -h|--help)
                cat <<'USAGE'
synap update [--release <id|fast|stable>] [--from-source] [--force] [--unattended]

  --release <ref>   apply a published release: a release id (main-<sha7>, vX.Y.Z)
                    or a channel — fast (every green main push) | stable (v* tags).
                    Default: SYNAP_UPDATE_CHANNEL from deploy/.env, else stable.
  --from-source     build THIS checkout as synap-dev/*:<sha> (release local-<sha>);
                    same backup / canary / rollback as a release.
  --force           re-apply the release the pod is already on.
  --unattended      what synap-update.service runs: a pending request
                    (state/requests/update.json) or the owner's policy
                    (state/update-policy.json: auto, channel, window); always
                    SYNAP_RELEASE_VERIFY=enforce. Nothing to do = exit 0.

Every update: lock → manifest → preflight → pull by digest → verified backup →
migrate → canary → swap → all services → verify → record. Any failure rolls
back the images and deploy files (never the data: the pre-update dump is kept
and `synap restore <dump>` is printed) and is recorded in deploy/state/last-update.json.
USAGE
                return 0 ;;
            *)
                # positional: a release id / version, or the legacy "latest"
                ref="$1"; shift ;;
        esac
    done
    if [ "$unattended" = 1 ]; then
        local plan_rc=0
        _ue_unattended_plan || plan_rc=$?
        [ "$plan_rc" = 1 ] && return 0
        [ "$plan_rc" = 0 ] || exit 1
    else
        unset UE_REQUEST_ID   # a person's run answers no request
    fi
    [ "$ref" = latest ] && ref=""
    # --from-source: sync the checkout FIRST, then run the synced installer. A
    # running bash keeps the functions it parsed, so without this re-exec every
    # fix to the update path (e.g. the Kratos render) only took effect one
    # update later — the failed run still used the old code (2026-10-14).
    if [ "$mode" = source ] && [ "${SYNAP_SKIP_GIT_SYNC:-}" != 1 ] && [ -z "${SYNAP_UPDATE_SYNCED:-}" ]; then
        sync_git_before_build || { _ue_record aborted "$(_ue_current_release_id)" local "could not sync the checkout to origin" false; exit 1; }
        if [ "$(cksum < "$SYNAP_SELF" 2>/dev/null)" != "$SYNAP_SELF_CKSUM" ]; then
            echo -e "${BLUE}🔁 The installer changed with this checkout — continuing with the new one.${NC}"
            # Same pid, so the update lock this process holds carries over.
            exec env SYNAP_UPDATE_SYNCED=1 SYNAP_LOCK_HELD_BY="$$" "$SYNAP_SELF" update "${_update_argv[@]}"
        fi
        export SYNAP_UPDATE_SYNCED=1
    fi
    if [ "$mode" = release ] && [ -z "$ref" ]; then
        ref="${SYNAP_UPDATE_CHANNEL:-$(_ue_env_get SYNAP_UPDATE_CHANNEL)}"
        ref="${ref:-stable}"
    fi

    # Fail fast on a stub .env that's missing the critical infrastructure
    # secrets — running compose against it would launch postgres with a blank
    # password and lock everyone out of the existing volume data.
    if [ ! -f .env ]; then
        echo -e "${RED}❌ ${deploy_dir}/.env not found — run \`synap install\` first.${NC}"
        _ue_record aborted "$(_ue_current_release_id)" "${ref:-local}" "deploy/.env not found" false
        exit 1
    fi
    local missing_critical="" key val
    for key in POSTGRES_PASSWORD JWT_SECRET KRATOS_SECRETS_COOKIE; do
        val=$(grep "^${key}=" .env 2>/dev/null | cut -d'=' -f2-)
        [ -z "$val" ] && missing_critical="${missing_critical} ${key}"
    done
    if [ -n "$missing_critical" ]; then
        echo -e "${RED}❌ .env is missing critical secrets:${missing_critical}${NC}"
        echo -e "${YELLOW}This .env looks like a fresh template (.env.example shape) — running update against it"
        echo -e "would launch postgres with a blank password and break authentication against existing data."
        echo ""
        echo -e "Recovery options:${NC}"
        echo -e "  1. Restore .env from a backup if you have one (your secrets must match the existing volumes)."
        echo -e "  2. If you only want the synap CLI to populate the missing secrets WITHOUT touching"
        echo -e "     your DOMAIN/ADMIN_* values, run \`synap install\` — non-interactive mode preserves"
        echo -e "     existing values and only regenerates secrets when .env is missing entirely."
        _ue_record aborted "$(_ue_current_release_id)" "${ref:-local}" ".env is missing critical secrets:${missing_critical}" false
        exit 1
    fi

    # Pin the compose project in .env (no-op when already pinned) so no later
    # door — eve, an operator in deploy/ — has to guess it.
    _pin_compose_project_name .env

    cleanup_stale_synap_state "$deploy_dir"

    # Secrets added after early installs (backfilled once, never rotated).
    if ! grep -q "^SYNAP_SERVICE_ENCRYPTION_KEY=" .env; then
        SYNAP_ENV_FILE=.env envcfg_write_raw S SYNAP_SERVICE_ENCRYPTION_KEY "$(openssl rand -hex 32)"
        echo -e "${YELLOW}⚠️  Added missing SYNAP_SERVICE_ENCRYPTION_KEY to .env${NC}"
    fi
    _bootstrap_token_backfill

    echo -e "${BLUE}🔄 Updating Synap (${mode}${ref:+: $ref})...${NC}"
    synap_update_engine "$mode" "$ref" "$force"

    # Keys a removed feature left in .env (env.schema `retired`) go now, through
    # the one writer and against the schema this update just installed —
    # re-sourced, since a release installs a new env-config.sh under this process.
    if ! ( source ./env-config.sh && SYNAP_ENV_FILE=.env envcfg_drop_retired ); then
        echo -e "${YELLOW}⚠️  Could not remove retired keys from .env (nothing reads them; run \`synap config validate\`).${NC}"
    fi

    # Idempotent admin seed — ensures the users/workspace rows exist after
    # every update. create-admin-cli.js is a no-op when the admin already
    # exists. Without it, a fresh install followed by `synap update` would
    # leave the pod with a Kratos identity but no users rows (401/403).
    local update_admin_email="" update_admin_password="" update_bootstrap_mode=""
    update_admin_email=$(grep "^ADMIN_EMAIL=" .env 2>/dev/null | cut -d'=' -f2-)
    update_admin_password=$(grep "^ADMIN_PASSWORD=" .env 2>/dev/null | cut -d'=' -f2-)
    update_bootstrap_mode=$(grep "^ADMIN_BOOTSTRAP_MODE=" .env 2>/dev/null | cut -d'=' -f2-)
    if [ -n "$update_admin_email" ] && [ -n "$update_admin_password" ]; then
        echo -e "${BLUE}👤 Ensuring admin provisioning is complete...${NC}"
        if run_preseed_admin_in_container "$update_admin_email" "$update_admin_password"; then
            echo -e "${GREEN}✅ Admin provisioning confirmed.${NC}"
            _bootstrap_token_retire || true
        else
            echo -e "${YELLOW}⚠️  Admin provisioning failed (pod may still be starting). Run manually if needed:${NC}"
            echo "  ./synap setup admin --email ${update_admin_email} --password <password>"
        fi
        unset update_admin_password
    elif [ "$update_bootstrap_mode" = "token" ]; then
        echo -e "${BLUE}ℹ️  Token bootstrap mode — skipping auto-provision (admin set up via browser).${NC}"
    else
        echo -e "${YELLOW}⚠️  ADMIN_EMAIL/ADMIN_PASSWORD not found in .env — skipping auto-provisioning.${NC}"
        echo "  If this is a fresh pod, run: ./synap setup admin --email <email> --password <password>"
    fi

    echo -e "${GREEN}✅ Update complete!${NC}"
}

cmd_restart() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-}
    
    # If no service specified, show interactive menu
    if [ -z "$service" ]; then
        local services=($(docker compose ps --services 2>/dev/null))
        if [ ${#services[@]} -eq 0 ]; then
            echo -e "${RED}❌ No services found${NC}"
            exit 1
        fi
        
        echo -e "${BLUE}🔄 Restart Service${NC}"
        echo ""
        local i=1
        for svc in "${services[@]}"; do
            echo -e "  ${GREEN}[$i]${NC} $svc"
            ((i++))
        done
        echo ""
        echo -e "  ${BLUE}[a]${NC} All services"
        echo -e "  ${BLUE}[q]${NC} Quit"
        echo ""
        read -p "Select service (number/a/q): " choice
        
        case "$choice" in
            [0-9]*)
                local idx=$((choice - 1))
                if [ $idx -ge 0 ] && [ $idx -lt ${#services[@]} ]; then
                    service="${services[$idx]}"
                else
                    echo -e "${RED}Invalid selection${NC}"
                    exit 1
                fi
                ;;
            a|A)
                service=""
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    fi
    
    if [ -z "$service" ]; then
        echo -e "${BLUE}🔄 Restarting all services...${NC}"
        docker compose restart
    else
        echo -e "${BLUE}🔄 Restarting $service...${NC}"
        docker compose restart "$service"
    fi
    
    echo -e "${GREEN}✅ Restart complete!${NC}"
}


CORS_ORIGIN=https://${domain}

# Allowed CORS origins (comma-separated frontend URLs)
# Add your Electron app origin or web client URL here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
EOF
    
    chmod 600 .env
}

# Generate kratos.yml with actual domain values
# IMPORTANT: This function ALWAYS overwrites kratos.yml - never use a static file
# The file is generated fresh on every install/update to ensure webhook secret and domain are correct
generate_kratos_config() {
    local domain=$1
    # $2 = "pod": the per-pod OIDC client is ALREADY in pod_settings (stored by
    # `synap install --register-token` through the signed oidc-config door), so
    # read it without asking the CP to push it again (PODPROV-CONTRACT §6.3).
    local oidc_source="${2:-cp}"
    local kratos_dir="../kratos"
    local deploy_dir="deploy"
    
    if [ ! -d "$kratos_dir" ]; then
        echo -e "${YELLOW}⚠️  Kratos directory not found, skipping config generation${NC}"
        return
    fi
    
    # Read webhook secret from .env file (if it exists)
    # This function is called from deploy/ directory, so .env is in current directory
    local webhook_secret=""
    local env_file=""
    
    # Find .env file - check current directory first (deploy/), then parent (repo root)
    if [ -f ".env" ] && [ -r ".env" ]; then
        # Called from deploy/ directory
        env_file=".env"
    elif [ -f "../deploy/.env" ] && [ -r "../deploy/.env" ]; then
        # Called from repo root
        env_file="../deploy/.env"
    elif [ -f "deploy/.env" ] && [ -r "deploy/.env" ]; then
        # Alternative path
        env_file="deploy/.env"
    fi
    
    if [ -n "$env_file" ]; then
        # Use cat and grep to avoid permission issues with direct grep
        webhook_secret=$(cat "$env_file" 2>/dev/null | grep "^KRATOS_WEBHOOK_SECRET=" | cut -d'=' -f2- | tr -d ' ' | tr -d '"' || echo "")
    fi

    # CP OIDC federation — per-pod, auto-provisioned via CP→pod PUSH. When this pod
    # is connected to a Control Plane (CONTROL_PLANE_URL set), we ask the CP to
    # (re)provision this pod's OWN OIDC client: the CP mints it and PUSHES it to the
    # pod over the authenticated Hub channel (the pod persists it in pod_settings).
    # We then read the pushed client from the pod's OWN database — there is no
    # pod→CP secret and no manual env var (a pod holds no credential it can present
    # to the CP; the authenticated direction is CP→pod). When NOT CP-connected
    # (self-hosted / agnostic), disabled via `synap federation disable`, or on ANY
    # failure, the oidc method stays disabled — byte-identical to the prior config,
    # so this can never break Kratos boot. provider_id is fixed at "cp": Kratos
    # builds its callback as .../oidc/callback/<provider_id>, which must match the
    # redirect the CP registered (see ensurePodOidcClient / derivePodOidcRedirectUri).
    local oidc_client_secret=""
    local oidc_issuer=""
    local oidc_client_id=""
    local oidc_label="Synap Cloud"
    local oidc_provider_id="cp"
    if [ -n "$env_file" ]; then
        local _cp_url _pub_url _v _disabled
        _cp_url=$(grep "^CONTROL_PLANE_URL=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || echo "")
        _pub_url=$(grep "^PUBLIC_URL=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || echo "")
        [ -z "$_pub_url" ] && _pub_url="https://${domain}"
        _v=$(grep "^SYNAP_POD_OIDC_LABEL=" "$env_file" 2>/dev/null | cut -d'=' -f2- | sed 's/^ *//; s/ *$//' | tr -d '"' || echo ""); [ -n "$_v" ] && oidc_label="$_v"
        # Explicit off-switch (`synap federation disable`) — keeps CP trust intact
        # while forcing password-only sign-in.
        _disabled=$(grep "^SYNAP_POD_FEDERATION_DISABLED=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || echo "")
        if [ -n "$_cp_url" ] && [ "$_disabled" != "1" ]; then
            # 1. Trigger the CP to mint + push this pod's OIDC client over the Hub
            #    channel. Returns { delivered: true } once the pod has persisted it.
            #    No secret is returned here — it travels CP→pod (authenticated) only.
            local _resp="" _delivered=""
            if [ "$oidc_source" = pod ]; then
                _delivered=pod
            else
                _resp=$(curl -fsS --max-time 20 -X POST \
                    -H "Content-Type: application/json" \
                    -d "{\"podUrl\":\"${_pub_url}\"}" \
                    "${_cp_url%/}/pods/oidc/provision" 2>/dev/null || echo "")
                _delivered=$(printf '%s' "$_resp" | grep -oE '"delivered"[[:space:]]*:[[:space:]]*true' | head -1)
            fi
            if [ -n "$_delivered" ]; then
                # 2. Read the pushed client through the backend's field-crypto CLI
                #    (decrypts the secret once SYNAP_FIELD_KEYS is set; same
                #    `clientId|clientSecret|issuer` line, same trust as kratos.yml).
                #    Keep ONLY a line shaped `id|secret|https://issuer`: the backend's
                #    config logger prints JSON lines to stdout before the answer, and
                #    taking the first line once rendered a log line into kratos.yml
                #    (Kratos crash-looped, perso pod 2026-10-14). No such line = disabled.
                local _row _oidc_line='^[^{|[:space:]][^|]*\|[^|[:space:]]+\|https?://[^|[:space:]]+$'
                _row=$(docker compose exec -T backend node dist/scripts/field-crypto.js federation-oidc-client 2>/dev/null | grep -E "$_oidc_line" | tail -1 || echo "")
                # Older backend image (no field-crypto CLI): the secret is still plaintext in pod_settings.
                [ -n "$_row" ] || _row=$(docker compose exec -T postgres psql -U synap -d synap -tAF '|' -c \
                    "SELECT settings->'federationOidcClient'->>'clientId', settings->'federationOidcClient'->>'clientSecret', settings->'federationOidcClient'->>'issuer' FROM pod_settings WHERE settings ? 'federationOidcClient' LIMIT 1" 2>/dev/null | grep -E "$_oidc_line" | tail -1 || echo "")
                case "$_row" in *'|senc:'*) _row="" ;; esac   # never render a ciphertext into Kratos
                oidc_client_id=$(printf '%s' "$_row" | cut -d'|' -f1)
                oidc_client_secret=$(printf '%s' "$_row" | cut -d'|' -f2)
                oidc_issuer=$(printf '%s' "$_row" | cut -d'|' -f3)
                if [ -n "$oidc_client_secret" ] && [ -n "$oidc_client_id" ] && [ -n "$oidc_issuer" ]; then
                    echo -e "${BLUE}ℹ️  Per-pod OIDC client provisioned by Control Plane (${oidc_client_id})${NC}"
                else
                    oidc_client_secret=""
                    echo -e "${YELLOW}⚠️  OIDC client delivered but not readable from pod_settings — federated sign-in stays disabled${NC}"
                fi
            elif [ -n "$_resp" ]; then
                echo -e "${YELLOW}⚠️  CP could not deliver the OIDC client (${_resp}) — federated sign-in stays disabled${NC}"
            else
                echo -e "${YELLOW}⚠️  Could not reach CP /pods/oidc/provision — federated sign-in stays disabled this deploy${NC}"
            fi
        fi
    fi

    if [ -z "$webhook_secret" ] || [ "$webhook_secret" = "" ]; then
        echo -e "${YELLOW}⚠️  KRATOS_WEBHOOK_SECRET not found in .env, generating new secret...${NC}"
        # Generate a random secret if not found
        webhook_secret=$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | base64 | tr -d '\n' || echo "CHANGE_ME")
        echo -e "${BLUE}ℹ️  Generated webhook secret: ${webhook_secret:0:10}...${NC}"
        # Try to write it back to .env if we found the file
        if [ -n "$env_file" ] && [ -w "$env_file" ]; then
            SYNAP_ENV_FILE="$env_file" envcfg_write_raw S KRATOS_WEBHOOK_SECRET "${webhook_secret}" 2>/dev/null || true
        fi
    fi
    
    # Backup existing kratos.yml if it exists (for recovery)
    if [ -f "$kratos_dir/kratos.yml" ]; then
        cp "$kratos_dir/kratos.yml" "$kratos_dir/kratos.yml.backup" 2>/dev/null || true
    fi
    
    # Determine if domain is localhost (dev) or production
    local is_localhost=false
    if [ "$domain" = "localhost" ]; then
        is_localhost=true
    fi

    # Browser-visible UI for Kratos flows. The legacy admin-ui SPA was retired
    # 2026-05; Pod Admin now hosts
    # all flow renderers natively at /login. Kratos still hits ui_url for
    # browser-initiated flows (error pages, /self-service/*/browser
    # redirects) — pointing it at pod-admin/login lets pod-admin re-init the
    # flow via Kratos public API and render the form locally.
    local pod_admin_ui=""
    local kratos_ui=""
    local bare_root="$domain"
    local pod_admin_domain=""
    local configured_pod_admin_domain=""
    local configured_pod_admin_url=""
    local pod_admin_origin=""
    if [ "$is_localhost" = true ]; then
        pod_admin_ui="http://localhost:4040"
        pod_admin_origin="$pod_admin_ui"
    else
        if [ -n "$env_file" ]; then
            configured_pod_admin_domain=$(grep "^POD_ADMIN_DOMAIN=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || true)
            configured_pod_admin_url=$(grep "^POD_ADMIN_URL=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || true)
        fi
        pod_admin_domain="${configured_pod_admin_domain:-$(pod_admin_domain_for_domain "$domain")}"
        pod_admin_ui="${configured_pod_admin_url:-https://${pod_admin_domain}}"
        pod_admin_ui="${pod_admin_ui%/}"
        local admin_remainder="${pod_admin_ui#*://}"
        local admin_host="${admin_remainder%%/*}"
        local admin_scheme="${pod_admin_ui%%://*}"
        if [ "$pod_admin_ui" != "https://${pod_admin_domain}" ] || ! [[ "$pod_admin_domain" =~ ^[A-Za-z0-9.-]+$ ]] || [ "$admin_host" != "$pod_admin_domain" ]; then
            echo -e "${RED}❌ POD_ADMIN_URL must be the HTTPS origin for POD_ADMIN_DOMAIN, without a path.${NC}" >&2
            return 1
        fi
        pod_admin_origin="${admin_scheme}://${admin_host}"
        bare_root="$(shared_cookie_domain "$domain" "$pod_admin_domain")"
        if [ -z "$bare_root" ]; then
            local shared_parent
            shared_parent="$(common_parent_domain "$domain" "$pod_admin_domain")"
            if [[ "$shared_parent" != *.* ]]; then
                echo -e "${RED}❌ POD_ADMIN_DOMAIN must share a parent domain with DOMAIN so Kratos can keep the owner session.${NC}" >&2
                return 1
            fi
            # A flat legacy pod: <name>.synap.live with its console at
            # <name>-admin.synap.live. They share only a tenant zone, so the
            # session cookie stays on the pod's own host, and the console,
            # which checks the session on its own host, cannot keep anyone
            # signed in. The pod keeps serving its apps and agents.
            echo -e "${YELLOW}⚠️  ${domain} and its console ${pod_admin_domain} share only ${shared_parent}, where other people's pods live.${NC}" >&2
            echo -e "${YELLOW}   Your sign-in now stays on ${domain} and is no longer sent to every ${shared_parent} site.${NC}" >&2
            echo -e "${YELLOW}   The console at https://${pod_admin_domain} cannot keep you signed in until this pod moves to its own name: <name>.pod.${shared_parent}, console admin.<name>.pod.${shared_parent} (Control Plane: pnpm ops:move-pod-names).${NC}" >&2
        fi
    fi
    kratos_ui="${pod_admin_ui}/login"
    # Recovery and settings have their own pod-admin renderers (account
    # recovery P0/P1): /recovery renders the Kratos recovery flow plus the
    # "use a recovery code" door; /settings/security is where a recovered
    # (privileged) session lands to set a new password.
    local kratos_recovery_ui="${pod_admin_ui}/recovery"
    local kratos_settings_ui="${pod_admin_ui}/settings/security"

    # Kratos public API base URL — localhost in dev, domain URL in production
    local kratos_public_base_url=""
    if [ "$is_localhost" = true ]; then
        kratos_public_base_url="http://localhost:4433"
    else
        kratos_public_base_url="https://${domain}/.ory/kratos/public/"
    fi

    # Generate CORS origins
    local cors_origins="        - http://localhost:3000
        - http://localhost:5173
        - http://localhost:3001
        - http://localhost:4000
        - http://localhost:4040"

    # The pod, its console and the Synap-hosted apps — never a whole zone:
    # *.synap.live let every other tenant's pod page make credentialed calls to
    # this pod's sign-in API.
    local first_party_origins="" origin
    if [ "$is_localhost" = false ]; then
        first_party_origins="$(synap_first_party_web_origins "$domain")"
        cors_origins="$cors_origins
        - https://${domain}
        - ${pod_admin_origin}"
        while read -r origin; do
            cors_origins="$cors_origins
        - ${origin}"
        done <<< "$first_party_origins"
    fi

    # Generate allowed return URLs. The relay-app (Expo/React Native) completes
    # federated "Continue with Synap Cloud" sign-in via WebBrowser.openAuthSession
    # → the ephemeral browser returns to a DEEP LINK, so its custom scheme must be
    # an allowed Kratos return_to (app-level, present in every env — relay's
    # app.json declares both the `synap` and `relay` schemes).
    local return_urls="    - http://localhost:3000
    - http://localhost:3000/*
    - http://localhost:4000
    - http://localhost:4000/*
    - http://localhost:4040
    - http://localhost:4040/*
    - synap://auth/callback
    - relay://auth/callback"

    if [ "$is_localhost" = false ]; then
        return_urls="$return_urls
    - https://${domain}
    - https://${domain}/*
    - ${pod_admin_origin}
    - ${pod_admin_origin}/*"
        while read -r origin; do
            return_urls="$return_urls
    - ${origin}
    - ${origin}/*"
        done <<< "$first_party_origins"
    fi

    # OIDC method block — federate to the Control Plane ONLY when a per-pod client
    # was fetched above; otherwise `enabled: false` (unchanged, cannot break
    # boot). The mapper (oidc.cp.jsonnet) maps email+name onto the pod identity.
    local oidc_block="      enabled: false"
    if [ -n "$oidc_client_secret" ]; then
        oidc_block="      enabled: true
      config:
        providers:
          - id: ${oidc_provider_id}
            provider: generic
            label: ${oidc_label}
            issuer_url: ${oidc_issuer}
            client_id: ${oidc_client_id}
            client_secret: ${oidc_client_secret}
            scope:
              - openid
              - email
              - profile
            mapper_url: file:///etc/config/kratos/oidc.cp.jsonnet"
    fi

    # Cookie domain and secure settings — scoped to the pod's own site so the
    # session cookie set on the pod is also valid on its console:
    # <name>.pod.synap.live for <name>.pod.synap.live + admin.<name>.pod.synap.live,
    # <root> for a self-hosted pod.<root> + pod-admin.<root>. The passkey rp id
    # is the same domain, so a pod that moves names asks for its passkeys again.
    # With no shareable root (a flat legacy <name>.synap.live pod) there is no
    # domain line: Kratos then sets a host-only cookie on the pod's own host.
    local cookie_domain_line="    domain: localhost"
    local cookie_secure="false"
    local passkey_rp_id="$bare_root"
    if [ "$is_localhost" = false ]; then
        cookie_secure="true"
        if [ -n "$bare_root" ]; then
            cookie_domain_line="    domain: ${bare_root}"
        else
            cookie_domain_line="    # No domain: host-only on ${domain} (no parent it may share)."
            passkey_rp_id="$domain"
        fi
    fi
    
    # Always overwrite kratos.yml (never use a static file - always generate fresh)
    # This ensures webhook secret and domain are always correct
    cat > "$kratos_dir/kratos.yml" << EOF
version: v1.3.1
# DSN should match docker-compose environment variable
# Uses postgres service name, kratos database
dsn: postgres://synap:\${POSTGRES_PASSWORD}@postgres:5432/kratos?sslmode=disable
serve:
  public:
    base_url: ${kratos_public_base_url}
    cors:
      enabled: true
      # CORS origins - automatically generated from domain
      allowed_origins:
$cors_origins
      allowed_methods:
        - POST
        - GET
        - PUT
        - PATCH
        - DELETE
        - OPTIONS
      allowed_headers:
        - Authorization
        - Cookie
        - Content-Type
        - X-Requested-With
      exposed_headers:
        - Content-Type
        - Set-Cookie
      allow_credentials: true
  admin:
    base_url: http://localhost:4434
selfservice:
  default_browser_return_url: ${pod_admin_ui}/
  allowed_return_urls:
$return_urls
  methods:
    password:
      enabled: true
      config: {}
    passkey:
      # Pod Admin does NOT run the WebAuthn ceremony yet: its login hides the
      # passkey trigger (no navigator.credentials code there). The ceremony
      # exists in synap-app/packages/core/auth-ui/src/webauthn.ts but is mounted
      # only in synap-app/apps/studio. Kept enabled so passkeys already
      # registered stay valid. Requires the passkey credentials block in
      # identity.schema.json — without it the strategy silently does nothing.
      enabled: true
      config:
        rp:
          display_name: "Synap"
          id: ${passkey_rp_id}
          origins:
$(if [ "$is_localhost" = true ]; then
echo "            - http://localhost:3000"
echo "            - http://localhost:4040"
else
echo "            - https://${domain}"
if [ -n "$bare_root" ]; then echo "            - ${pod_admin_origin}"; fi
fi)
    oidc:
$oidc_block
  flows:
    error:
      ui_url: ${kratos_ui}
    settings:
      ui_url: ${kratos_settings_ui}
      privileged_session_max_age: 15m
      # Synap Cloud trust (founder decision R1, 2026-10-04): Cloud may SIGN IN
      # by default, RECOVERY is opt-in by the owner. A can_interrupt settings
      # web_hook runs PRE-PERSIST (web_hook.go ExecuteSettingsPrePersistHook);
      # its ctx has the request cookies but not the session, so the body
      # forwards the session cookie and the pod reads authentication_methods
      # (apps/api/src/webhooks/kratos-cloud-trust.ts). A Cloud-only session
      # cannot change a sign-in method unless the owner trusts Cloud for
      # recovery or the account has no pod-held factor yet.
      # Body (decoded): function(ctx) { identity_id, session_cookie: ctx.request_cookies.ory_kratos_session or null }
      after:
        password:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/settings/guard
                method: POST
                body: base64:
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
        passkey:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/settings/guard
                method: POST
                body: base64:
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
        profile:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/settings/guard
                method: POST
                body: base64:
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
        oidc:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/settings/guard
                method: POST
                body: base64:
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
    recovery:
      enabled: true
      use: code
      ui_url: ${kratos_recovery_ui}
      after:
        hooks:
          # A recovered account signs out everywhere else (keeps the new session).
          - hook: revoke_active_sessions
    verification:
      # Off until the pod courier delivers mail (wave 2: CP relay / BYO SMTP).
      enabled: false
      ui_url: ${kratos_ui}
    logout:
      after:
        default_browser_return_url: ${pod_admin_ui}/
    login:
      ui_url: ${kratos_ui}
      lifespan: 10m
      after:
        oidc:
          hooks:
            # Owner set Synap Cloud trust to "off" → refuse "Continue with Synap
            # Cloud" before the session cookie is issued (login/hook.go runs
            # post-login hooks, then UpsertAndIssueCookie).
            # Body (decoded): function(ctx) { identity_id: ctx.identity.id }
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/login/cloud
                method: POST
                body: base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5X2lkOiBjdHguaWRlbnRpdHkuaWQgfQo=
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
    registration:
      lifespan: 10m
      ui_url: ${kratos_ui}
      # NO OPEN SIGN-UP (founder decision 2026-10-04). Kratos v1.3.1 has no
      # per-method registration switch, and flows.registration.enabled=false
      # would ALSO kill the Cloud owner's first oidc sign-in (the oidc login
      # callback creates a registration flow for an unknown subject —
      # strategy_login.go -> NewRegistrationFlow, which checks that flag).
      # So registration stays enabled and a BLOCKING web_hook gates it:
      # can_interrupt=true runs PRE-PERSIST (web_hook.go
      # ExecutePostRegistrationPrePersistHook), so a refusal aborts before any
      # identity exists. The pod refuses every password registration and every
      # Cloud user without pod access (message id 4000901,
      # apps/api/src/webhooks/kratos-registration-gate.ts).
      # Bodies (decoded): function(ctx) { method: "password"|"oidc", identity: ctx.identity }
      after:
        password:
          hooks:
            - hook: web_hook
              config:
                # Use Docker service name for internal communication
                url: http://backend:4000/api/webhooks/kratos/registration/gate
                method: POST
                body: base64://ZnVuY3Rpb24oY3R4KSB7IG1ldGhvZDogInBhc3N3b3JkIiwgaWRlbnRpdHk6IGN0eC5pZGVudGl0eSB9Cg==
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
            - hook: session
        oidc:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/registration/gate
                method: POST
                body: base64://ZnVuY3Rpb24oY3R4KSB7IG1ldGhvZDogIm9pZGMiLCBpZGVudGl0eTogY3R4LmlkZW50aXR5IH0K
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
            # Post-persist (NOT can_interrupt) and BEFORE session: the session
            # hook ends the chain. Seeds the pod owner for a verified CP owner
            # claim; removes any persisted identity that has no pod access.
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/registration/complete
                method: POST
                body: base64://ZnVuY3Rpb24oY3R4KSB7IG1ldGhvZDogIm9pZGMiLCBpZGVudGl0eTogY3R4LmlkZW50aXR5IH0K
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
            - hook: session
log:
  level: info
  format: json
# secrets: provided via environment variables SECRETS_COOKIE and SECRETS_CIPHER in docker-compose.yml
identity:
  default_schema_id: default
  schemas:
    - id: default
      url: file:///etc/config/kratos/identity.schema.json
session:
  # Explicit, not defaulted. Kratos defaults session.lifespan to 24h, and that
  # daily expiry was the ONLY reason the desktop app stored the user's password
  # (to silently re-login each day) — a replayable secret at rest, guarded by a
  # Touch ID prompt that was never actually enforced. 30 days removes the need:
  # a session cookie is scoped and revocable server-side; a password is neither.
  #
  # ABSOLUTE, not sliding — verified against Kratos v1.3.1 source. /sessions/whoami
  # calls RefreshCookie (session/handler.go:266), which only re-issues the COOKIE
  # to match the session (session/manager_http.go:109-131); it never advances
  # ExpiresAt. Extension happens only via the admin endpoint
  # PATCH /admin/sessions/{id}/extend. So users re-login every 30 days regardless
  # of activity. To make it sliding, the pod would have to call that admin
  # endpoint (session.earliest_possible_extend then throttles the DB writes).
  lifespan: 720h
  cookie:
    # Cookie domain: automatically set based on domain
${cookie_domain_line}
    same_site: Lax
    # Note: secure flag is controlled by Kratos based on cookie domain
    # For production domains, Kratos automatically sets secure=true
# The courier's connection URI has ONE source: COURIER_SMTP_CONNECTION_URI
# (docker-compose, from SMTP_CONNECTION_URI). Env overrides this file, so a
# URI here would be dead config — it once pointed at a mail catcher that never
# ran. The backend self-reports the real courier (apps/api/src/courier-status.ts).
courier:
  smtp:
    from_address: noreply@synap.io
EOF
    
    echo -e "${GREEN}✓ Generated kratos.yml for domain: ${domain}${NC}"
}

# Wait until Kratos accepts traffic (first-admin seed, update rollback).
wait_for_kratos_ready() {
    local i=0
    while [ "$i" -lt "${SYNAP_KRATOS_READY_TRIES:-45}" ]; do
        if docker compose exec -T kratos wget --spider -q http://127.0.0.1:4433/health/ready 2>/dev/null; then
            return 0
        fi
        i=$((i + 1))
        sleep "${SYNAP_KRATOS_READY_INTERVAL:-2}"
    done
    return 1
}

# kratos_config_errors <kratos.yml> — one problem per line, nothing = looks valid.
# Used by `synap doctor` and by the update rollback (which falls back to the last
# verified kratos.yml.good when the pre-update file is itself broken).
# Hosts have no YAML parser, so this is a STRUCTURAL check of the shape
# generate_kratos_config renders, not a full parse: every content line is a
# `key:` or a `- item`, no tab indentation, and every OIDC provider has
# issuer_url/client_id/client_secret as plain strings with an https issuer (a
# JSON log line rendered into those fields crash-looped Kratos on 2026-10-14).
# It cannot see a wrong-but-well-shaped value, or a bad indent level.
kratos_config_errors() {
    [ -s "$1" ] || { echo "kratos.yml is missing or empty ($1)"; return 0; }
    awk -v q="'" '
    function ind(s) { match(s, /^ */); return RLENGTH }
    function val(s) { sub(/^ *(- )?[^:]*:[ ]*/, "", s); sub(/[ ]+#.*$/, "", s); return s }
    function unq(x) {
        if (length(x) >= 2 && ((substr(x, 1, 1) == "\"" && substr(x, length(x)) == "\"") || (substr(x, 1, 1) == q && substr(x, length(x)) == q)))
            return substr(x, 2, length(x) - 2)
        return x
    }
    function plain(x,   c) {
        if (x == "" || x ~ /^(~|null|Null|NULL)$/) return 0
        c = substr(x, 1, 1)
        if (c == "{" || c == "[" || c == "|" || c == ">" || c == "&" || c == "*" || c == "!" || c == "%" || c == "@" || c == "`") return 0
        if ((c == "\"" || c == q) && unq(x) == x) return 0   # an unclosed quote
        return 1
    }
    function close_provider(   k) {
        if (!inprov) return
        for (k in need) if (!(k in got)) printf "oidc provider %s: %s is missing\n", pid, k
        for (k in got) if (!plain(got[k])) printf "oidc provider %s: %s is not a plain string\n", pid, k
        if (("issuer_url" in got) && unq(got["issuer_url"]) !~ /^https:\/\/[^ ]+$/) printf "oidc provider %s: issuer_url is not an https URL\n", pid
        for (k in got) delete got[k]
        inprov = 0
    }
    function close_oidc() {
        if (oidc >= 0 && oidc_on && !oidc_prov) print "oidc sign-in is enabled with no provider"
        oidc = -1; oidc_on = 0; oidc_prov = 0
    }
    BEGIN { need["issuer_url"]; need["client_id"]; need["client_secret"]; provs = -1; item = -1; oidc = -1 }
    /^[ \t]*(#|$)/ { next }
    {
        lines++
        if ($0 ~ /^ *\t/) { printf "line %d: tab in the indentation\n", NR; next }
        if ($0 !~ /^ *-( |$)/ && $0 !~ /^ *[A-Za-z0-9_.\/-]+:( |$)/) { printf "line %d: not a YAML key or list item: %.60s\n", NR, $0; next }
        i = ind($0)
        if (provs >= 0 && i <= provs) { close_provider(); provs = -1; item = -1 }
        if (oidc >= 0 && i <= oidc) close_oidc()
        if ($0 ~ /^ *oidc:[ ]*$/) { oidc = i; next }
        if (oidc >= 0 && $0 ~ /^ *enabled:[ ]*true[ ]*$/) oidc_on = 1
        if ($0 ~ /^ *providers:[ ]*$/) { provs = i; if (oidc >= 0) oidc_prov = 1; next }
        if (provs < 0) next
        if ($0 ~ /^ *- / && (item < 0 || i == item)) { close_provider(); item = i; inprov = 1; pid = "?" }
        if (!inprov) next
        k = $0; sub(/^ *(- )?/, "", k)
        if (k !~ /^[a-z_]+:/) next
        sub(/:.*/, "", k)
        if (k in need) got[k] = val($0)
        if (k == "id") pid = unq(val($0))
    }
    END { close_provider(); close_oidc(); if (!lines) print "kratos.yml has no content" }' "$1"
}

# Create first admin via script bundled in backend image (dist/scripts/create-admin-cli.js).
run_preseed_admin_in_container() {
    local email="$1"
    local password="$2"
    local attempt=1
    local max_attempts=6

    if ! wait_for_kratos_ready; then
        echo -e "${YELLOW}⚠️  Kratos did not report ready in time; still attempting admin creation.${NC}"
    fi

    while [ "$attempt" -le "$max_attempts" ]; do
        if docker compose exec -T \
            -e "ADMIN_EMAIL=${email}" \
            -e "ADMIN_PASSWORD=${password}" \
            backend node dist/scripts/create-admin-cli.js; then
            return 0
        fi
        echo -e "${YELLOW}⚠️  Admin seed attempt ${attempt}/${max_attempts} failed, retrying...${NC}"
        attempt=$((attempt + 1))
        sleep 8
    done
    return 1
}

# ============================================================================
# SETUP COMMAND — post-install operator actions (admin creation, etc.)
# ============================================================================

cmd_setup() {
    local sub="${1:-}"
    case "$sub" in
        admin)
            shift
            cmd_setup_admin "$@"
            ;;
        ""|--help|-h)
            cat <<EOF
${BLUE}Synap Setup${NC}

${YELLOW}Subcommands:${NC}
  ${GREEN}admin${NC}        Create or check the first admin account on a running pod

Run 'synap setup <subcommand> --help' for subcommand-specific options.
EOF
            ;;
        *)
            echo -e "${RED}Unknown setup subcommand: ${sub}${NC}"
            echo "Run 'synap setup --help' for available subcommands"
            exit 1
            ;;
    esac
}

# Pod URL for on-host CLI calls. Defaults to the loopback published by the
# eve-managed compose override (127.0.0.1:4000). Operator can override via
# SYNAP_POD_URL when running outside that setup (e.g. dev hosts).
# The backend as seen from the host. An override (e.g. Eve's) can publish it on
# another host port (127.0.0.1:14000), so ask compose for the published port
# instead of assuming 4000 — a wrong guess made every owner probe answer
# "unknown" and PROVISIONING_TOKEN was never retired. Call from the deploy dir.
_synap_pod_url() {
    if [ -n "${SYNAP_POD_URL:-}" ]; then echo "$SYNAP_POD_URL"; return 0; fi
    local hp
    hp=$(docker compose port backend 4000 2>/dev/null | tail -1)
    case "$hp" in
        *:[0-9]*) echo "http://127.0.0.1:${hp##*:}" ;;
        *) echo "http://127.0.0.1:4000" ;;
    esac
}

_synap_bootstrap_token() {
    if [ ! -f .env ]; then
        return 1
    fi
    grep "^ADMIN_BOOTSTRAP_TOKEN=" .env 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || true
}

# PROVISIONING_TOKEN is BOOTSTRAP-ONLY (SECURITY-PLAN-R1 §4 / D9): the pod
# accepts it only while it has no owner and answers 403
# PROVISIONING_TOKEN_RETIRED afterwards, so once the first owner exists the
# secret has no job left. Retire it from deploy/.env, and leave a marker so the
# update backfill below never writes a fresh one. Idempotent; never prints the
# value. Callers run it only where the owner is KNOWN to exist (federated
# bootstrap done, preseed admin created, `setup admin --retire-token` probed).
# A running backend keeps the value in its environment until its next recreate;
# harmless, the pod refuses it.
_BOOTSTRAP_TOKEN_MARKER="state/bootstrap-token.retired"
_bootstrap_token_retire() {
    local had=""
    grep -q "^PROVISIONING_TOKEN=" .env 2>/dev/null && had=1
    SYNAP_ENV_FILE=.env envcfg_write_raw U PROVISIONING_TOKEN || return 1
    mkdir -p state && : > "$_BOOTSTRAP_TOKEN_MARKER" || return 1
    [ -z "$had" ] || echo -e "${GREEN}🔒 PROVISIONING_TOKEN retired from .env (the pod has an owner; it is bootstrap-only).${NC}"
    return 0
}

# Early installs lacked the token; `synap update` backfills it, but never once
# it was retired on purpose.
_bootstrap_token_backfill() {
    [ -f "$_BOOTSTRAP_TOKEN_MARKER" ] && return 0
    if ! grep -q "^PROVISIONING_TOKEN=." .env; then
        SYNAP_ENV_FILE=.env envcfg_write_raw S PROVISIONING_TOKEN "$(openssl rand -hex 32)"
        echo -e "${YELLOW}⚠️  Added missing PROVISIONING_TOKEN to .env${NC}"
    fi
}

# "needed" (no owner yet) | "ready" | "unknown" — the pod's own answer.
_setup_needs_probe() {
    local pod_url token body
    pod_url=$(_synap_pod_url)
    token=$(_synap_bootstrap_token || true)
    local auth_header=()
    if [ -n "$token" ]; then
        auth_header=(-H "Authorization: Bearer ${token}")
    fi
    body=$(curl -fsS --max-time 6 "${auth_header[@]}" "${pod_url}/api/hub/setup/status" 2>/dev/null || echo "")
    if echo "$body" | grep -q '"needsSetup":true'; then echo needed; return 0; fi
    if echo "$body" | grep -q '"needsSetup":false'; then echo ready; return 0; fi
    echo unknown
}

cmd_setup_admin() {
    local deploy_dir
    deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    cd "$deploy_dir"

    local email=""
    local password=""
    local mode=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --email)         email="$2"; shift 2 ;;
            --password)      password="$2"; shift 2 ;;
            --status)        mode="status"; shift ;;
            --magic-link)    mode="magic-link"; shift ;;
            --retire-token)  mode="retire-token"; shift ;;
            --help|-h)
                cat <<EOF
${BLUE}Synap Setup Admin${NC}

${YELLOW}Usage:${NC}
  synap setup admin --email <e> --password <p>     Create admin via container exec (preseed)
  synap setup admin --email <e> --magic-link       Mint a one-hour browser link
  synap setup admin --status                       Probe whether the pod still needs setup
  synap setup admin --retire-token                 Drop the bootstrap-only PROVISIONING_TOKEN from .env once the pod has an owner

${YELLOW}Options:${NC}
  ${GREEN}--email <email>${NC}      Admin email (required for preseed and magic-link modes)
  ${GREEN}--password <secret>${NC}  Admin password (preseed mode — runs container script directly)
  ${GREEN}--magic-link${NC}         Mint a magic-link URL the operator opens in their browser
  ${GREEN}--status${NC}             Print 'needed' or 'ready' and exit (machine-readable)
  ${GREEN}--retire-token${NC}       Remove PROVISIONING_TOKEN from .env (only when --status says 'ready')
EOF
                exit 0
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}"
                exit 1
                ;;
        esac
    done

    # Status probe — used by callers (eve doctor, eve auth provision) to
    # decide whether to prompt for admin setup.
    if [ "$mode" = "status" ]; then
        local state
        state=$(_setup_needs_probe)
        echo "$state"
        [ "$state" = unknown ] && exit 2
        exit 0
    fi

    # Retire the bootstrap token on a pod that already has an owner (existing
    # installs; new ones retire it themselves). Refuses unless the pod says so.
    if [ "$mode" = "retire-token" ]; then
        local state
        state=$(_setup_needs_probe)
        if [ "$state" != ready ]; then
            echo -e "${RED}Not retiring PROVISIONING_TOKEN: the pod reports '${state}' (it needs an owner first — sign in, then re-run).${NC}"
            exit 1
        fi
        _bootstrap_token_retire || { echo -e "${RED}Could not update .env.${NC}"; exit 1; }
        exit 0
    fi

    # Preseed — direct container exec. Uses the existing helper.
    if [ -n "$password" ]; then
        if [ -z "$email" ]; then
            echo -e "${RED}--password requires --email${NC}"
            exit 1
        fi
        if run_preseed_admin_in_container "$email" "$password"; then
            echo -e "${GREEN}✅ First admin created.${NC}"
            _bootstrap_token_retire || true
            exit 0
        else
            echo -e "${RED}❌ Preseed admin creation failed. Check 'docker compose logs backend'.${NC}"
            exit 1
        fi
    fi

    # Magic-link — POST to the pod's /setup/magic-link endpoint, print URL.
    if [ "$mode" = "magic-link" ]; then
        if [ -z "$email" ]; then
            echo -e "${RED}--magic-link requires --email${NC}"
            exit 1
        fi
        local pod_url
        pod_url=$(_synap_pod_url)
        local token
        # The pod authorizes /api/hub/setup/magic-link with PROVISIONING_TOKEN
        # (packages/api/src/routers/hub-protocol/rest/setup.ts) — NOT
        # ADMIN_BOOTSTRAP_TOKEN, and the route lives under /api/hub. Sending
        # either the wrong token or the bare /setup path could never succeed.
        token=$(grep "^PROVISIONING_TOKEN=" .env 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || true)
        if [ -z "$token" ]; then
            echo -e "${RED}No PROVISIONING_TOKEN in .env — magic link cannot be authorized.${NC}"
            exit 1
        fi
        local body
        body=$(curl -fsS -X POST \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer ${token}" \
            -H "Accept: application/json" \
            -d "{\"email\":\"${email}\"}" \
            "${pod_url}/api/hub/setup/magic-link" 2>&1)
        local status=$?
        if [ $status -ne 0 ]; then
            echo -e "${RED}Failed to mint magic link: ${body}${NC}"
            exit 1
        fi
        local url
        url=$(echo "$body" | grep -o '"url":"[^"]*"' | cut -d'"' -f4 || echo "")
        if [ -z "$url" ]; then
            echo -e "${RED}Pod did not return a magic-link URL. Response: ${body}${NC}"
            exit 1
        fi
        echo "$url"
        exit 0
    fi

    # No mode flag and no password — print usage.
    echo -e "${YELLOW}Specify a mode: --password (preseed), --magic-link, or --status.${NC}"
    echo "Run 'synap setup admin --help' for details."
    exit 1
}

# ============================================================================
# INSTALL COMMAND
# ============================================================================

# ─── Canary-gated backend swap (near-zero-downtime, safe rollback) ────────────
# Validates the NEW backend image in a sidecar `backend-canary` container BEFORE
# the live production backend is ever touched. Used by BOTH cmd_install (eve's
# `synap install` path) and cmd_update so there is ONE swap implementation.
#
# Self-gating: if no backend is currently running (fresh install / cold start),
# there is nothing to protect — it just brings backend + realtime up directly,
# preserving the original behavior. The canary path only engages when a live
# backend exists.
#
# Contract / assumptions (caller's responsibility):
#   • cwd is the deploy dir (docker-compose.yml + .env present)
#   • images are already pulled or built
#   • .env's BACKEND_VERSION already points at the NEW version
# It runs backend migrations itself (idempotent) so the canary always validates
# against the migrated schema while the old backend keeps serving.
#
# Relies on the `backend-canary` service (profile: canary, container_name
# synap-backend-canary) and `backend-migrate` defined in docker-compose.yml.
#
# Returns 0 on success; 1 when it failed BEFORE the swap (the live backend was
# never touched and keeps serving); 2 when production was swapped and then
# failed its health check (the caller must roll back).
_swap_backend_canary() {
    local canary_name="synap-backend-canary"
    local health_probe="const r=require('http').get('http://localhost:4000/health',(s)=>{process.exit(s.statusCode===200?0:1)});r.setTimeout(4000,()=>{r.destroy();process.exit(1)});r.on('error',()=>process.exit(1))"

    # Is a production backend already running? (container present)
    local backend_cid
    backend_cid=$(docker compose ps -q backend 2>/dev/null | head -1)

    if [ -z "$backend_cid" ]; then
        # Cold start / fresh install — nothing to protect. Bring up directly;
        # compose pulls in postgres / minio / backend-migrate via depends_on.
        echo -e "${BLUE}  No running backend to protect — starting backend + realtime directly...${NC}"
        docker compose up -d --remove-orphans backend realtime
        return $?
    fi

    echo -e "${BLUE}🐤 Canary-gated swap — validating the new image before touching the live backend...${NC}"

    # Migrations must land while the OLD backend is still serving (expand-contract).
    # The update engine runs them itself first (so it can measure the level and
    # restore on a throw) and sets _UE_MIGRATED=1; install still relies on this.
    if [ "${_UE_MIGRATED:-}" != 1 ]; then
        echo -e "${BLUE}  Running backend migrations (live backend still serving)...${NC}"
        if ! docker compose run --rm backend-migrate; then
            echo -e "${RED}  ✗ Migration failed — live backend untouched. Aborting update.${NC}"
            return 1
        fi
    fi

    # Clean any leftover canary, then start it on the NEW image.
    docker rm -f "$canary_name" >/dev/null 2>&1 || true
    if ! docker compose --profile canary up -d backend-canary; then
        echo -e "${RED}  ✗ Canary failed to start — live backend untouched, still serving.${NC}"
        docker rm -f "$canary_name" >/dev/null 2>&1 || true
        return 1
    fi

    # Health-check the canary from inside its own container (no curl/wget in the
    # alpine image; localhost avoids DNS collision with the prod `backend` alias).
    # Up to 3 minutes (18 × 10s).
    echo -e "${BLUE}  Waiting for canary health (up to 3 min)...${NC}"
    local canary_ok=false i
    for i in $(seq 1 18); do
        sleep "${SYNAP_HEALTH_INTERVAL:-10}"
        if docker exec "$canary_name" node -e "$health_probe" >/dev/null 2>&1; then
            canary_ok=true
            echo -e "${GREEN}  ✓ Canary healthy after ${i}0s — image is good${NC}"
            break
        fi
        echo -e "${BLUE}    canary health attempt ${i}/18...${NC}"
    done

    docker rm -f "$canary_name" >/dev/null 2>&1 || true

    if [ "$canary_ok" != true ]; then
        echo -e "${RED}  ✗ Canary failed health check after 3 min — live backend untouched, still serving.${NC}"
        echo -e "${YELLOW}    The new image is broken; nothing was swapped. Investigate, then re-run.${NC}"
        return 1
    fi

    # Image proven good — swap production (~2-3s gap on a single pod, unavoidable
    # because one container can't hold port 4000 twice).
    echo -e "${BLUE}  Swapping production backend + realtime to the new image (~2-3s)...${NC}"
    docker compose up -d --force-recreate --remove-orphans backend realtime

    # Verify production. Image already validated by the canary → should pass
    # within the first attempt or two. 2 min budget (12 × 10s).
    echo -e "${BLUE}  Verifying production health (up to 2 min)...${NC}"
    local prod_ok=false new_cid
    for i in $(seq 1 12); do
        sleep "${SYNAP_HEALTH_INTERVAL:-10}"
        new_cid=$(docker compose ps -q backend 2>/dev/null | head -1)
        if [ -n "$new_cid" ] && docker exec "$new_cid" node -e "$health_probe" >/dev/null 2>&1; then
            prod_ok=true
            echo -e "${GREEN}  ✓ Production healthy after ${i}0s${NC}"
            break
        fi
        echo -e "${BLUE}    production health attempt ${i}/12...${NC}"
    done

    if [ "$prod_ok" = true ]; then
        return 0
    fi

    # Unexpected: the canary passed but production didn't (env diff / race).
    # Return 2 so the caller knows production WAS touched. Rollback is the
    # update engine's job (previous images + .env; never the data, see
    # _ue_rollback) — the old by-tag rollback here could never work for `:local`.
    echo -e "${RED}  ✗ Production health failed after swap (unexpected — the canary had passed).${NC}"
    return 2
}

# ============================================================================
# POD REGISTRATION — `synap install --register-token` (PODPROV-CONTRACT §3, §4, §6)
# ============================================================================
# A single-use code minted by the Control Plane (`spr_…`) is exchanged, once the
# stack is healthy, at POST {cp}/pods/register. Everything the pod needs comes
# back in that ONE response and is applied HERE, locally, through the pod's own
# doors (the CP pushes nothing to the pod during registration — §6.3):
#
#   1. owner      ownerAssertion → POST /api/federation/bootstrap
#                 (X-Pod-Bootstrap-Token = this pod's PROVISIONING_TOKEN; that
#                 secret never leaves the host). This also approves the CP issuer
#                 the next two doors verify against, so it runs first.
#   2. sign-in    oidc.assertion → POST /api/hub/federation/oidc-config, then
#                 kratos.yml is re-rendered from pod_settings and kratos restarted.
#   3. AI service intelligence {url, apiKey, provisionToken} →
#                 POST /api/provision/register-intelligence (null = not entitled).
#   4. trust      CONTROL_PLANE_URL written to deploy/.env (the explicit opt-in),
#                 backend + realtime recreated to read it.
#
# Every local call runs INSIDE the backend container (`docker exec … node`):
# the backend publishes no host port. Secrets travel as env names (`-e NAME`,
# value inherited — never on a command line) and request bodies on stdin.
#
# Re-runs are safe: the response is kept (0600) in state/registration/ until
# every step applied, so a failed step is retried from it without spending the
# code again; state/registration.json (no secrets) marks a finished registration.
SYNAP_CONTROL_PLANE_DEFAULT="https://api.synap.live"
SYNAP_POD_ZONE="pod.synap.live"
# ACME contact for a registered pod installed without --email (cloud-init has no
# email to pass). Let's Encrypt only needs a syntactically valid address on a
# real domain; --email overrides it.
SYNAP_ACME_EMAIL_DEFAULT="ops@synap.live"

_reg_log()  { echo -e "${BLUE}[register] $*${NC}"; }
_reg_ok()   { echo -e "${GREEN}[register] ✓ $*${NC}"; }
_reg_warn() { echo -e "${YELLOW}[register] ⚠️  $*${NC}" >&2; }
_reg_err()  { echo -e "${RED}[register] ❌ $*${NC}" >&2; }

_reg_sha256_hex() { # <string>
    if command -v sha256sum >/dev/null 2>&1; then printf '%s' "$1" | sha256sum | cut -d' ' -f1
    else printf '%s' "$1" | shasum -a 256 | cut -d' ' -f1; fi
}
# §6.2 — the custom-domain proof. The CP computes the same from the raw code.
_reg_nonce() { _reg_sha256_hex "synap-registration:$1"; }
_reg_valid_name()  { [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$ ]]; }
# The CP mints spr_ + lowercase base32 (≥160 bits); same pattern the CP validates.
_reg_valid_token() { [[ "$1" =~ ^spr_[a-z2-7]{32,80}$ ]]; }
# https only; plain http is accepted for a loopback CP (local dev / tests).
_reg_valid_cp_url() {
    [[ "$1" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]] \
        || [[ "$1" =~ ^http://(127\.0\.0\.1|localhost)(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]]
}
_reg_installer_version() { echo "synap-cli@$(_ue_sha256 "$SYNAP_SELF" | cut -c1-12)"; }
# Public IPv4 from the Hetzner metadata service; empty elsewhere (serverIp is optional).
_reg_server_ip() {
    local url="${SYNAP_METADATA_IP_URL-http://169.254.169.254/hetzner/v1/metadata/public-ipv4}"
    [ -n "$url" ] || return 0
    curl -fsS --max-time 3 "$url" 2>/dev/null | head -1 | grep -E '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || true
}

# POST to THIS pod from inside the backend container.
# <path> <header-name|""> — body on stdin, header value in $SYNAP_REG_AUTH_VALUE.
# Prints "<http-status> <first 500 chars of the body>"; returns 0 only on 2xx.
_REG_POST_JS='let b="";process.stdin.on("data",d=>b+=d).on("end",async()=>{const h={"content-type":"application/json"};if(process.env.SYNAP_REG_HEADER)h[process.env.SYNAP_REG_HEADER]=process.env.SYNAP_REG_AUTH_VALUE||"";try{const r=await fetch(process.env.SYNAP_REG_POD+process.env.SYNAP_REG_PATH,{method:"POST",headers:h,body:b});const t=await r.text();process.stdout.write(r.status+" "+t.replace(/\s+/g," ").slice(0,500));process.exit(r.ok?0:1)}catch(e){process.stdout.write("000 "+e.message);process.exit(1)}})'
_reg_pod_post() {
    local cid
    cid="$(docker compose ps -q backend 2>/dev/null | head -1)"
    [ -n "$cid" ] || { echo "000 no backend container"; return 1; }
    SYNAP_REG_PATH="$1" SYNAP_REG_HEADER="$2" SYNAP_REG_POD="${SYNAP_LOCAL_POD_URL:-http://localhost:4000}" \
        docker exec -i -e SYNAP_REG_PATH -e SYNAP_REG_HEADER -e SYNAP_REG_POD -e SYNAP_REG_AUTH_VALUE \
        "$cid" node -e "$_REG_POST_JS"
}

# The response shape PODPROV-CONTRACT §4 + §6 promises. Prints nothing when valid.
_reg_response_errors() { # <file>
    jq -r '
      def str: type == "string" and length > 0;
      [ (if (.podId|str) then empty else "podId is missing" end),
        (if (.controlPlaneUrl|str) then empty else "controlPlaneUrl is missing" end),
        (if (.issuer|str) then empty else "issuer is missing" end),
        (if (.ownerAssertion|str) then empty else "ownerAssertion is missing" end),
        (if (.catalogUrl|str) then empty else "catalogUrl is missing" end),
        (if has("oidc") | not then "oidc is missing (object or null)"
         elif .oidc == null then empty
         elif (.oidc|type) != "object" or ((.oidc.assertion|str)|not) then "oidc is present without an assertion"
         else empty end),
        (if has("intelligence") | not then "intelligence is missing (object or null)"
         elif .intelligence == null then empty
         elif (.intelligence|type) != "object" or ((.intelligence.url|str)|not) then "intelligence is present without a url"
         elif ((.intelligence.apiKey|str)|not) or ((.intelligence.provisionToken|str)|not) then "intelligence.url is present but apiKey/provisionToken is missing"
         else empty end)
      ] | .[]' "$1" 2>&1
}

# <token> <cp-url> — POST {cp}/pods/register, retrying only what is retryable.
# Leaves the 200 body in state/registration/response.json (0600).
_reg_call_cp() {
    local token="$1" cp="${2%/}" domain pod_url admin_url body resp code attempt tries wait
    domain="$(_ue_env_get DOMAIN)"
    pod_url="$(_ue_env_get PUBLIC_URL)"; pod_url="${pod_url:-https://${domain}}"
    admin_url="$(_ue_env_get POD_ADMIN_URL)"; admin_url="${admin_url:-$(pod_admin_url_for_domain "$domain")}"
    mkdir -p state/registration state/registration-nonce && chmod 700 state/registration
    body="$(umask 077 && mktemp state/registration/request.XXXXXX)" || return 1
    resp="$(umask 077 && mktemp state/registration/reply.XXXXXX)" || { rm -f "$body"; return 1; }
    jq -n --arg token "$token" --arg name "$REG_NAME" --arg podUrl "$pod_url" --arg adminUrl "$admin_url" \
        --arg serverIp "$(_reg_server_ip)" --arg installerVersion "$(_reg_installer_version)" \
        --arg release "$(_ue_env_get SYNAP_RELEASE_ID)" --slurpfile podKey "$SYNAP_POD_KEY_PUB" \
        '{token:$token, name:$name, podUrl:$podUrl, adminUrl:$adminUrl, serverIp:$serverIp,
          installerVersion:$installerVersion, release:$release, podPublicJwk:$podKey[0]}
         | if .serverIp == "" then del(.serverIp) else . end' > "$body"
    # §3/§6.2: the proof the CP may fetch for a custom domain — present only for
    # the duration of the call (Caddy serves state/registration-nonce/nonce.json).
    printf '{"nonce":"%s"}\n' "$(_reg_nonce "$token")" > state/registration-nonce/nonce.json
    chmod 644 state/registration-nonce/nonce.json
    tries="${SYNAP_REGISTER_ATTEMPTS:-5}"; wait="${SYNAP_REGISTER_RETRY_SECONDS:-15}"
    _reg_log "POST ${cp}/pods/register (pod ${pod_url})"
    for attempt in $(seq 1 "$tries"); do
        code="$(curl -sS --max-time 180 -o "$resp" -w '%{http_code}' -H 'Content-Type: application/json' \
            --data-binary @"$body" "${cp}/pods/register" 2>/dev/null)" || code="${code:-000}"
        case "$code" in
            200) break ;;
            000|502|503|504)
                _reg_warn "attempt ${attempt}/${tries}: HTTP ${code} $(head -c 300 "$resp" 2>/dev/null)"
                [ "$attempt" -lt "$tries" ] && sleep "$wait" ;;
            *) break ;;
        esac
    done
    rm -f "$body" state/registration-nonce/nonce.json
    case "$code" in
        200) mv -f "$resp" state/registration/response.json; return 0 ;;
        401) _reg_err "the registration code was refused (bad, expired or already used): $(head -c 300 "$resp")" ;;
        409) _reg_err "this pod's hostname is already held by another pod: $(head -c 300 "$resp")" ;;
        422) _reg_err "the custom-domain proof failed (the CP could not read /.well-known/synap-registration on ${pod_url}): $(head -c 300 "$resp")" ;;
        *)   _reg_err "the Control Plane answered HTTP ${code}: $(head -c 300 "$resp" 2>/dev/null)" ;;
    esac
    rm -f "$resp"
    return 1
}

# A step that succeeded is recorded and never re-run on a resume: the owner
# assertion is single-use on the pod (its jti is consumed), so replaying it
# would fail a resume that only needed a later step.
_reg_step_done() { grep -qx "$1" state/registration/steps 2>/dev/null; }
_reg_step_mark() { echo "$1" >> state/registration/steps; }

# Applies state/registration/response.json; each step is fail-loud.
_reg_apply() {
    local r=state/registration/response.json out
    # 1. owner
    if _reg_step_done owner; then
        _reg_log "owner: already bootstrapped"
    else
        _reg_log "owner: federated bootstrap from the Control Plane assertion"
        out="$(jq -c '{assertion: .ownerAssertion}' "$r" | SYNAP_REG_AUTH_VALUE="$(_ue_env_get PROVISIONING_TOKEN)" \
            _reg_pod_post /api/federation/bootstrap X-Pod-Bootstrap-Token)" \
            || { _reg_err "owner bootstrap failed: ${out}"; return 1; }
        _reg_step_mark owner
        _reg_ok "owner bootstrapped (${out%% *})"
    fi
    # The pod has an owner now: the bootstrap-only token has no job left. Retired
    # BEFORE step 4 so the backend recreate below drops it from its environment.
    _bootstrap_token_retire || _reg_warn "could not retire PROVISIONING_TOKEN from .env — run: synap setup admin --retire-token"
    # 2. federated sign-in (OIDC client)
    if _reg_step_done oidc; then
        _reg_log "OIDC client: already stored"
    elif [ "$(jq -r '.oidc == null' "$r")" = true ]; then
        _reg_warn "the Control Plane returned no OIDC client — Synap sign-in stays off (email/password only)"
    else
        out="$(jq -c '{assertion: .oidc.assertion}' "$r" | SYNAP_REG_AUTH_VALUE="" \
            _reg_pod_post /api/hub/federation/oidc-config "")" \
            || { _reg_err "storing the OIDC client failed: ${out}"; return 1; }
        _reg_step_mark oidc
        _reg_ok "OIDC client stored"
    fi
    # 3. AI service (P6: a pod setting, written through the pod's own door)
    if _reg_step_done intelligence; then
        _reg_log "AI service: already registered"
    elif [ "$(jq -r '.intelligence == null' "$r")" = true ]; then
        _reg_log "AI service: not included with this pod's plan — configure one later in the pod's settings"
    else
        out="$(jq -c '{serviceApiKey: .intelligence.apiKey, serviceUrl: .intelligence.url}' "$r" \
            | SYNAP_REG_AUTH_VALUE="Bearer $(jq -r .intelligence.provisionToken "$r")" \
              _reg_pod_post /api/provision/register-intelligence Authorization)" \
            || { _reg_err "registering the AI service failed: ${out}"; return 1; }
        _reg_step_mark intelligence
        _reg_ok "AI service set to $(jq -r .intelligence.url "$r")"
    fi
    # 4. trust: the explicit CONTROL_PLANE_URL opt-in, then the services that read it
    SYNAP_ENV_FILE=.env envcfg_write_raw S CONTROL_PLANE_URL "$(jq -r .controlPlaneUrl "$r")" || return 1
    # …and pod-agent, the CP's only way back in (backup vault, pushed updates): its
    # trust is the CP issuer from this response + this pod's own public URL, through
    # the one env writer. A value the operator set (--with-pod-agent …) is kept.
    local pa_issuer pa_audience
    pa_issuer="$(jq -r '.issuer // empty' "$r")"
    pa_audience="$(_ue_env_get PUBLIC_URL)"; pa_audience="${pa_audience:-https://$(_ue_env_get DOMAIN)}"
    if _is_canonical_https_url "$pa_issuer" && _is_canonical_https_url "$pa_audience"; then
        [ -n "$(_ue_env_get POD_AGENT_ISSUER_URL)" ] || SYNAP_ENV_FILE=.env envcfg_write_raw S POD_AGENT_ISSUER_URL "$pa_issuer" || return 1
        [ -n "$(_ue_env_get POD_AGENT_AUDIENCE)" ] || SYNAP_ENV_FILE=.env envcfg_write_raw S POD_AGENT_AUDIENCE "$pa_audience" || return 1
        SYNAP_ENV_FILE=.env envcfg_write_raw S SYNAP_WITH_POD_AGENT 1 || return 1
    else
        _reg_warn "pod-agent not enabled: the Control Plane issuer (${pa_issuer:-none}) or the pod URL (${pa_audience}) is not a canonical https URL"
    fi
    if [ "$(jq -r '.oidc == null' "$r")" != true ]; then
        generate_kratos_config "$(_ue_env_get DOMAIN)" pod
    fi
    docker compose up -d --no-deps --force-recreate backend realtime kratos \
        || { _reg_err "could not recreate backend/realtime/kratos with CONTROL_PLANE_URL"; return 1; }
    SYNAP_UPDATE_HEALTH_TRIES="${SYNAP_REGISTER_HEALTH_TRIES:-30}" _ue_backend_healthy \
        || { _reg_err "the backend did not come back healthy after the trust update"; return 1; }
    _reg_ok "trusting Control Plane $(jq -r .controlPlaneUrl "$r")"
    if should_start_pod_agent; then
        docker compose --profile pod-agent up -d pod-agent \
            || { _reg_err "could not start the pod-agent"; return 1; }
        _reg_ok "pod-agent started (the Control Plane can now deliver the backup vault and updates)"
    fi
}

# <token> <cp-url> — the whole registration; idempotent across re-runs.
_reg_register_pod() {
    local token="$1" cp="$2"
    if [ -f state/registration.json ]; then
        _reg_ok "already registered as pod $(jq -r .podId state/registration.json) — nothing to do (a code is single-use)"
        return 0
    fi
    if [ -f state/registration/response.json ]; then
        _reg_log "resuming: the Control Plane already accepted this pod; re-applying its response"
    else
        SYNAP_UPDATE_HEALTH_TRIES="${SYNAP_REGISTER_HEALTH_TRIES:-30}" _ue_backend_healthy || {
            _reg_err "the backend is not healthy — not registering. The code is still unused: fix the pod, then re-run the same command."
            return 1
        }
        # §8: the pod's own public key rides in the registration (the code is
        # not spent if the key cannot be produced).
        _podkey_ensure || { _reg_err "no pod identity key — not registering. The code is still unused."; return 1; }
        _reg_call_cp "$token" "$cp" || return 1
    fi
    local errors
    errors="$(_reg_response_errors state/registration/response.json)"
    if [ -n "$errors" ]; then
        _reg_err "the Control Plane's response does not match PODPROV-CONTRACT §4/§6:"
        printf '   %s\n' "$errors" >&2
        return 1
    fi
    # D3: record the owner-consent line the CP described (never over an owner's file).
    _policy_seed_from_registration state/registration/response.json
    _reg_apply || {
        _reg_err "registration was accepted but not fully applied — re-run the same command to retry from state/registration/response.json"
        return 1
    }
    jq --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg name "$REG_NAME" --arg domain "$(_ue_env_get DOMAIN)" \
        '{podId, controlPlaneUrl, issuer, catalogUrl, intelligenceUrl: (.intelligence.url // null),
          federatedSignIn: (.oidc != null), name: $name, domain: $domain, registeredAt: $at}' \
        state/registration/response.json > state/registration.json
    # §8: the CP holds this pod's key now — sign pod→CP calls with it (R1-b).
    _podkey_record_enrollment "$(jq -r .podId state/registration.json)" "$(jq -r '.issuer // empty' state/registration.json)" "$cp" \
        || _reg_warn "could not write state/pod-identity-enrollment.json — run './synap pod-key enroll' to switch to the pod key"
    rm -f state/registration/response.json state/registration/steps
    _reg_ok "registered as pod $(jq -r .podId state/registration.json)"
}

# ============================================================================
# POD IDENTITY KEY — the pod's OWN ES256 keypair (SECURITY-PLAN-R1 §1, D1/D8;
# PODPROV-CONTRACT §8)
# ============================================================================
# Born here, on the host, once: state/pod-identity/pod-key.pem (PKCS#8 P-256,
# 0600, owned by the backend's uid; dir 0700) by `synap install` (every pod) or
# `synap pod-key ensure|enroll` (pods installed before this; `synap update` does
# not touch it — an update stays a no-op on the same release). A FILE in the deploy dir,
# never a database row — a DB dump must not yield the pod's identity. The
# backend reads it through the deploy dir it already mounts read-only
# (/opt/synap/deploy) and is the ONE signer (packages/api/src/utils/
# pod-identity.ts#signPodJwt). The private half never leaves this host; only
# the public JWK is sent — in POST {cp}/pods/register, or, for a pod that
# never registered, by `synap pod-key enroll`.
#
# Generated in a throwaway container of the backend image, as root, so the
# file can be handed to the backend's uid whether or not this shell is root.
# Idempotent: an existing key is kept, and its public half re-derived.
SYNAP_POD_KEY_DIR="state/pod-identity"
SYNAP_POD_KEY_PUB="state/pod-identity.pub.json"
SYNAP_POD_BACKEND_UID="10001"   # the backend image's `nodejs` user (deploy/Dockerfile)
_PODKEY_JS='const fs=require("fs"),c=require("crypto"),p=require("path");const d=process.env.SYNAP_PODKEY_DIR,f=p.join(d,"pod-key.pem"),uid=Number(process.env.SYNAP_PODKEY_UID||0);fs.mkdirSync(d,{recursive:true,mode:0o700});let pem;try{pem=fs.readFileSync(f,"utf8")}catch(e){if(e.code!=="ENOENT")throw e;pem=c.generateKeyPairSync("ec",{namedCurve:"prime256v1"}).privateKey.export({format:"pem",type:"pkcs8"});fs.writeFileSync(f,pem,{mode:0o600,flag:"wx"})}const k=c.createPrivateKey(pem);if(k.asymmetricKeyType!=="ec"||k.asymmetricKeyDetails.namedCurve!=="prime256v1"){process.stderr.write("pod-key.pem is not an EC P-256 key");process.exit(2)}if(process.getuid&&process.getuid()===0&&uid){fs.chownSync(d,uid,uid);fs.chownSync(f,uid,uid)}fs.chmodSync(d,0o700);fs.chmodSync(f,0o600);const j=c.createPublicKey(k).export({format:"jwk"});process.stdout.write(JSON.stringify({kty:j.kty,crv:j.crv,x:j.x,y:j.y}))'

_podkey_log() { echo -e "${BLUE}[pod-key] $*${NC}"; }
_podkey_ok()  { echo -e "${GREEN}[pod-key] ✓ $*${NC}"; }
_podkey_err() { echo -e "${RED}[pod-key] ❌ $*${NC}" >&2; }

# Ensures the key exists; writes its PUBLIC half to $SYNAP_POD_KEY_PUB (0644).
# Must run in the deploy dir. Returns non-zero (and says why) on failure.
_podkey_ensure() {
    local out tmp
    mkdir -p "$SYNAP_POD_KEY_DIR" 2>/dev/null || true
    out="$(docker compose run --rm --no-deps -T --user 0:0 --entrypoint node \
        -v "$(pwd)/${SYNAP_POD_KEY_DIR}:/pod-identity" \
        -e SYNAP_PODKEY_DIR=/pod-identity -e SYNAP_PODKEY_UID="$SYNAP_POD_BACKEND_UID" \
        backend -e "$_PODKEY_JS" 2>/dev/null)" || { _podkey_err "could not create or read the pod identity key"; return 1; }
    if ! printf '%s' "$out" | jq -e '.kty == "EC" and .crv == "P-256" and (.x|type) == "string" and (.y|type) == "string" and (has("d")|not)' >/dev/null 2>&1; then
        _podkey_err "the pod identity key did not yield a P-256 public key"
        return 1
    fi
    tmp="$(mktemp "${SYNAP_POD_KEY_PUB}.XXXXXX")" || return 1
    printf '%s\n' "$out" | jq -c '{kty, crv, x, y}' > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$SYNAP_POD_KEY_PUB"
}

# RFC 7638 kid of the public half (sha256 over {crv,kty,x,y}, base64url) —
# the CP computes the same. Empty when openssl is missing (the record then
# carries no kid and the backend skips its key-replaced check).
_podkey_kid() {
    command -v openssl >/dev/null 2>&1 || return 0
    jq -jc '{crv, kty, x, y}' "$SYNAP_POD_KEY_PUB" 2>/dev/null \
        | openssl dgst -sha256 -binary | openssl base64 -A | tr '+/' '-_' | tr -d '='
}

# <podId> <issuer|""> <cp-url> — the record that tells the backend the CP knows
# this key (packages/database utils/pod-cp-auth.ts): from then on every pod→CP
# call is signed with it instead of the legacy shared key / relay key. Written
# ONLY after the CP accepted the key (register or enroll). 0644: the backend
# reads it through the read-only deploy mount; it holds no secret.
_podkey_record_enrollment() {
    local tmp kid
    kid="$(_podkey_kid)"
    tmp="$(mktemp state/pod-identity-enrollment.json.XXXXXX)" || return 1
    jq -n --arg podId "$1" --arg issuer "$2" --arg cp "$3" --arg kid "$kid" \
        --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        '{podId: $podId, kid: (if $kid == "" then null else $kid end),
          issuer: (if $issuer == "" then null else $issuer end),
          controlPlaneUrl: $cp, enrolledAt: $at}' > "$tmp" \
        && chmod 644 "$tmp" && mv -f "$tmp" state/pod-identity-enrollment.json
}

# synap pod-key ensure | show | enroll --pod-id <id> --code <spr_…> [--control-plane <url>]
cmd_pod_key() {
    local deploy_dir
    deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in a Synap installation directory${NC}"; exit 1
    fi
    cd "$deploy_dir"
    local action="${1:-show}"; shift 2>/dev/null || true
    case "$action" in
        ensure)
            _podkey_ensure || exit 1
            _podkey_ok "pod identity key ready (public half in ${SYNAP_POD_KEY_PUB})" ;;
        show)
            [ -s "$SYNAP_POD_KEY_PUB" ] || _podkey_ensure || exit 1
            jq . "$SYNAP_POD_KEY_PUB" ;;
        enroll)
            # A pod that never registered (installed by hand): its owner mints a
            # single-use code in the Control Plane (POST /pods/:id/keys/enrollment-code)
            # and runs this ON the pod. Only the public JWK is sent.
            local pod_id="" code="" cp=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --pod-id) pod_id="${2:-}"; shift 2 ;;
                    --code) code="${2:-}"; shift 2 ;;
                    --control-plane) cp="${2:-}"; shift 2 ;;
                    *) _podkey_err "unknown option: $1"; exit 1 ;;
                esac
            done
            cp="${cp:-$(_ue_env_get CONTROL_PLANE_URL)}"; cp="${cp:-$SYNAP_CONTROL_PLANE_DEFAULT}"; cp="${cp%/}"
            [[ "$pod_id" =~ ^[A-Za-z0-9_-]{1,64}$ ]] || { _podkey_err "--pod-id must be the Control Plane pod id"; exit 1; }
            _reg_valid_token "$code" || { _podkey_err "--code must be an enrollment code from the Control Plane (spr_…)"; exit 1; }
            _reg_valid_cp_url "$cp" || { _podkey_err "--control-plane must be an https URL"; exit 1; }
            _podkey_ensure || exit 1
            local resp http
            resp="$(umask 077 && mktemp "${TMPDIR:-/tmp}/synap-enroll.XXXXXX")" || exit 1
            _podkey_log "POST ${cp}/pods/${pod_id}/keys/enroll"
            http="$(jq -c --arg token "$code" '{token: $token, podPublicJwk: .}' "$SYNAP_POD_KEY_PUB" \
                | curl -sS --max-time 60 -o "$resp" -w '%{http_code}' -H 'Content-Type: application/json' \
                    --data-binary @- "${cp}/pods/${pod_id}/keys/enroll" 2>/dev/null)" || http="${http:-000}"
            if [ "$http" != 200 ]; then
                _podkey_err "the Control Plane refused the enrollment (HTTP ${http}): $(jq -r '.code // empty' "$resp" 2>/dev/null) $(jq -r '.error // empty' "$resp" 2>/dev/null | head -c 300)"
                rm -f "$resp"; exit 1
            fi
            _podkey_record_enrollment "$(jq -r .podId "$resp")" "$(jq -r '.issuer // empty' "$resp")" "$cp" \
                || { _podkey_err "enrolled, but the enrollment record could not be written"; rm -f "$resp"; exit 1; }
            rm -f "$resp"
            _podkey_ok "enrolled as pod $(jq -r .podId state/pod-identity-enrollment.json) (key $(jq -r .kid state/pod-identity-enrollment.json))" ;;
        *)
            echo "Usage: synap pod-key ensure | show | enroll --pod-id <id> --code <spr_…> [--control-plane <url>]"
            exit 1 ;;
    esac
}

# ============================================================================
# POD-AGENT POLICY — the owner's consent line for Control Plane commands
# (SECURITY-PLAN-R1 §2, decision D3; reader: deploy/pod-agent/policy.js)
# ============================================================================
# state/pod-agent-policy.json  {"mode": "managed"|"self-hosted", "archiveRecipients": ["age1…"]}
# No file = self-hosted refusals (archive, restore-archive, configure), so a
# managed pod needs `"mode":"managed"`. Registration writes the file ONCE, from
# the Control Plane's `deploymentMode`, and never over an existing file (an
# owner's edit wins). Everything after that is the owner's: `synap policy …`.
# Written atomically (0644; owned by whoever runs this — root on a cloud-init
# install). The backend only sees it through the read-only deploy mount, and
# `configure` can only write .env keys, so the CP can never write it.
SYNAP_POLICY_FILE="state/pod-agent-policy.json"
# Same pattern as deploy/pod-agent/policy.js — a recipient the pod-agent would
# reject must never be written (the whole file would then fail closed).
SYNAP_AGE_RECIPIENT_RE='^age1[0-9a-z]{20,200}$'

_policy_log()  { echo -e "${BLUE}[policy] $*${NC}"; }
_policy_ok()   { echo -e "${GREEN}[policy] ✓ $*${NC}"; }
_policy_warn() { echo -e "${YELLOW}[policy] ⚠️  $*${NC}" >&2; }
_policy_err()  { echo -e "${RED}[policy] ❌ $*${NC}" >&2; }

# <json> — atomic replace of the policy file.
_policy_write() {
    local tmp
    mkdir -p state 2>/dev/null || true
    tmp="$(mktemp "${SYNAP_POLICY_FILE}.XXXXXX")" || return 1
    printf '%s\n' "$1" | jq '.' > "$tmp" && chmod 644 "$tmp" && mv -f "$tmp" "$SYNAP_POLICY_FILE" || { rm -f "$tmp"; return 1; }
}

# Prints the current policy object (the default when there is no file); fails
# loudly on a file the pod-agent could not use — never edit around a typo.
_policy_current() {
    if [ ! -e "$SYNAP_POLICY_FILE" ] && [ ! -L "$SYNAP_POLICY_FILE" ]; then
        echo '{"mode":"self-hosted","archiveRecipients":[]}'; return 0
    fi
    if ! jq -e 'type == "object" and ((.archiveRecipients // []) | type == "array")' "$SYNAP_POLICY_FILE" >/dev/null 2>&1; then
        _policy_err "${SYNAP_POLICY_FILE} is not a valid policy file — fix or remove it first (the pod-agent treats it as self-hosted until then)"
        return 1
    fi
    jq -c '.' "$SYNAP_POLICY_FILE"
}

# <response.json> — the registration's deploymentMode → a first policy file. Only
# ever creates: an existing file (or a CP too old to say) is left alone.
_policy_seed_from_registration() {
    local mode
    if [ -e "$SYNAP_POLICY_FILE" ] || [ -L "$SYNAP_POLICY_FILE" ]; then
        _policy_log "${SYNAP_POLICY_FILE} already exists — kept as the owner left it"
        return 0
    fi
    mode="$(jq -r '.deploymentMode // empty' "$1" 2>/dev/null)"
    case "$mode" in
        managed|self-hosted) ;;
        "") _policy_warn "the Control Plane did not say whether this pod is managed — no policy file written (self-hosted refusals apply; a managed pod needs: ./synap policy set-mode managed)"; return 0 ;;
        *)  _policy_warn "unknown deploymentMode from the Control Plane — no policy file written"; return 0 ;;
    esac
    _policy_write "$(jq -cn --arg mode "$mode" '{mode: $mode, archiveRecipients: []}')" \
        && _policy_ok "wrote ${SYNAP_POLICY_FILE} (mode ${mode})" \
        || _policy_warn "could not write ${SYNAP_POLICY_FILE} — set it with: ./synap policy set-mode ${mode}"
}

# synap policy show | set-mode <managed|self-hosted> | add-recipient <age1…> | remove-recipient <age1…>
cmd_policy() {
    local deploy_dir
    deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in a Synap installation directory${NC}"; exit 1
    fi
    cd "$deploy_dir"
    local action="${1:-show}"; shift 2>/dev/null || true
    local cur
    case "$action" in
        show)
            cur="$(_policy_current)" || exit 1
            if [ -e "$SYNAP_POLICY_FILE" ]; then echo "file: ${deploy_dir}/${SYNAP_POLICY_FILE}"
            else echo "file: (none — ${deploy_dir}/${SYNAP_POLICY_FILE} is absent, so the default applies)"; fi
            echo "$cur" | jq -r '"mode: \(.mode // "(missing)")",
                "refuse: \(if has("refuse") then (.refuse | join(", ")) else (if .mode == "managed" then "(nothing)" else "archive, restore-archive, configure" end) + " (mode default)" end)",
                "archiveRecipients: \((.archiveRecipients // []) | if length == 0 then "(none)" else join(", ") end)"' ;;
        set-mode)
            local mode="${1:-}"
            case "$mode" in managed|self-hosted) ;; *) _policy_err "usage: synap policy set-mode <managed|self-hosted>"; exit 1 ;; esac
            cur="$(_policy_current)" || exit 1
            _policy_write "$(echo "$cur" | jq -c --arg m "$mode" '.mode = $m')" || { _policy_err "could not write ${SYNAP_POLICY_FILE}"; exit 1; }
            _policy_ok "mode = ${mode}"
            [ "$mode" = managed ] && _policy_log "the Control Plane may now order archive, restore-archive and configure on this pod" ;;
        add-recipient|remove-recipient)
            local r="${1:-}"
            [[ "$r" =~ $SYNAP_AGE_RECIPIENT_RE ]] || { _policy_err "usage: synap policy ${action} <age1…>  (an age public key: age1 + lowercase letters and digits)"; exit 1; }
            cur="$(_policy_current)" || exit 1
            if [ "$action" = add-recipient ]; then
                _policy_write "$(echo "$cur" | jq -c --arg r "$r" '.archiveRecipients = ((.archiveRecipients // []) | if index($r) then . else . + [$r] end)')" \
                    || { _policy_err "could not write ${SYNAP_POLICY_FILE}"; exit 1; }
                _policy_ok "archive recipient added"
            else
                _policy_write "$(echo "$cur" | jq -c --arg r "$r" '.archiveRecipients = ((.archiveRecipients // []) | map(select(. != $r)))')" \
                    || { _policy_err "could not write ${SYNAP_POLICY_FILE}"; exit 1; }
                _policy_ok "archive recipient removed (if it was listed)"
            fi ;;
        *)
            echo "Usage: synap policy show | set-mode <managed|self-hosted> | add-recipient <age1…> | remove-recipient <age1…>"
            exit 1 ;;
    esac
}

cmd_install() {
    local FROM_IMAGE=""
    local FROM_SOURCE=""
    local INSTALL_RELEASE=""
    local INSTALL_DIR=""
    local DOMAIN=""
    local EMAIL=""
    local ADMIN_EMAIL=""
    local ADMIN_PASSWORD=""
    local ADMIN_PASSWORD_FROM_ARG=false
    local ADMIN_PASSWORD_GENERATED=""
    local ADMIN_SEED_OK=""
    local ADMIN_BOOTSTRAP_MODE=""
    local ADMIN_BOOTSTRAP_TOKEN=""
    local INTELLIGENCE_URL=""
    local INTELLIGENCE_KEY=""
    local REPO_URL="https://github.com/synap-core/backend.git"
    local INTERACTIVE=true
    local WITH_RSSHUB=false
    local TUNNEL_PROVIDER=""
    local TUNNEL_TOKEN_ARG=""
    local TUNNEL_TOKEN_FILE=""
    local REGISTER_TOKEN=""
    local CONTROL_PLANE=""
    local POD_NAME=""
    local INSTALL_EDGE=""
    local WITH_POD_AGENT=""
    local POD_AGENT_ISSUER=""
    local POD_AGENT_AUDIENCE_ARG=""
    local SMTP_URI_ARG=""

    # Auto-detect if we're in a git repo
    local IN_GIT_REPO=false
    if is_git_repo; then
        IN_GIT_REPO=true
    fi
    # Archive/tarball extract (e.g. codeload) has no .git but is still a valid backend root when cwd is SYNAP_REPO_ROOT
    local BACKEND_TREE_IN_CWD=false
    if [ -f "$(pwd)/deploy/docker-compose.yml" ]; then
        BACKEND_TREE_IN_CWD=true
    fi

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in

  synap pod-key <action>         This pod's own identity key: ensure | show | enroll --pod-id <id> --code <spr_…>
  synap policy <action>          What the Control Plane may order on this pod: show | set-mode <managed|self-hosted> | add-recipient <age1…> | remove-recipient <age1…>
  synap clean [type]             Clean this pod's Docker leftovers (interactive if no type; never volumes or other stacks')
  synap heal                     Restart this pod's unhealthy containers (budget 3 / 30 min; never postgres)
  synap units <install|status|remove>  systemd timers: heal (2 min), update requests; auto-update opt-in
  synap shell [service] [shell]   Open shell in container (default: backend, sh)
  synap exec <service> <cmd>     Execute command in container
  synap users <sub>              Manage pod users (list, add-admin, reset-password, delete)
  synap profiles <sub> [name]  Enable/disable optional compose profiles (rsshub, monitoring)
  synap tunnel <sub>             Enable/disable Cloudflare or Pangolin tunnels (alternative to direct DNS)
  synap reset [--full [--delete-data]]  Wipe data (backup first, type the domain to confirm)

${YELLOW}Examples:${NC}
  # Install (auto-detects: clone if not in repo, use image by default)
  synap install --domain example.com --email me@example.com

  # Install in git repo (auto-detects: uses repo, builds from source by default)
  synap install --domain localhost

  # Force image even in git repo
  synap install --from-image --domain example.com --email me@example.com

  # Update (default: SYNAP_UPDATE_CHANNEL from deploy/.env, else stable)
  synap update
  synap update --release fast          # every green main commit
  synap update --release v1.2.3        # a specific release
  synap update --from-source           # build this checkout as synap-dev/*:<sha>

  # Management
  synap health
  synap connectivity
  synap logs                    # Interactive service selection
  synap logs backend            # View backend logs
  synap logs backend --tail 100 # Last 100 lines
  synap logs backend --filter error # Filter by "error"
  synap errors                  # Find errors in all services
  synap errors backend 200      # Find errors in backend (last 200 lines)
  synap diagnose                # Run full diagnostics
  synap restart                 # Interactive service selection
  synap restart backend         # Restart backend
  synap rebuild backend         # Rebuild and restart backend
  synap rebuild --no-cache     # Rebuild without cache
  synap clean                   # Interactive cleanup
  synap clean all               # Clean all unused resources
  synap shell backend           # Open shell in backend
  synap exec backend node --version # Execute command in backend
  synap config list
  synap config set PUBLIC_URL=https://pod.example.com POD_AGENT_AUDIENCE=https://pod.example.com
  synap config validate && synap apply
  synap doctor --json
  synap users list
  synap users reset-password relay@example.com    # hidden prompt; --password-stdin for scripts
  synap profiles enable rsshub     # RSSHub + browserless (optional stack)
  synap profiles disable rsshub    # Stop the RSSHub stack
  synap tunnel enable cloudflare --token <TOKEN>   # Expose via Cloudflare Tunnel
  synap tunnel status                              # Show active tunnel(s)
  synap tunnel disable                             # Stop all tunnels
  synap reset                      # Reset workspace/application data only
  synap reset --full               # Recreate the stack (volumes kept) + fresh install option
  synap reset --full --delete-data # Also remove this pod's volumes (backup taken first)

${YELLOW}For detailed help:${NC}
  synap install --help
  synap update --help

EOF
}


cmd_backup() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    # ONE backup door (deploy/pgdata-safety.sh): EVERY database — synap AND the
    # kratos/hydra identity stores, without which restored users cannot log in —
    # each dump read back before it is kept. The old path dumped `synap` only.
    local label=${1:-manual}
    local dir
    dir="$(SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" pgdata_backup "$label")" || {
        echo -e "${RED}❌ Backup failed${NC}"
        exit 1
    }
    # The .env holds the secrets the restored data was encrypted/signed with.
    (umask 077 && cp .env "$dir/env.backup")
    echo -e "${GREEN}✅ Backup created: ${dir}${NC}"
    echo -e "${YELLOW}   Contains secrets (env.backup) — copy it OFF this host (restic/PBS/scp).${NC}"
}

cmd_restore() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local backup_file=$1
    if [ -z "$backup_file" ]; then
        echo -e "${RED}Error: Backup file required${NC}"
        echo "Usage: synap restore <backups/postgres/<dir>> | <legacy-backup.tar.gz>"
        exit 1
    fi
    
    # A directory is a `synap backup` / postgres-backup dump set (<db>.dump each).
    if [ -d "$backup_file" ]; then
        echo -e "${YELLOW}⚠️  WARNING: This replaces every database with the contents of ${backup_file}${NC}"
        read -p "Continue? (yes/no): " CONFIRM
        [ "$CONFIRM" = "yes" ] || { echo "Restore cancelled"; exit 0; }
        SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" pgdata_restore "$backup_file" || exit 1
        docker compose up -d --remove-orphans
        echo -e "${GREEN}✅ Restore complete!${NC}"
        return 0
    fi

    if [ ! -f "$backup_file" ]; then
        echo -e "${RED}Error: Backup file not found: $backup_file${NC}"
        exit 1
    fi
    
    echo -e "${YELLOW}⚠️  WARNING: This will overwrite current data!${NC}"
    read -p "Continue? (yes/no): " CONFIRM
    if [ "$CONFIRM" != "yes" ]; then
        echo "Restore cancelled"
        exit 0
    fi
    
    local temp_dir=$(mktemp -d)
    tar -xzf "$backup_file" -C "$temp_dir"
    
    docker compose stop backend
    cat "$temp_dir"/*-database.sql | docker compose exec -T postgres psql -U synap synap
    cp "$temp_dir"/*.env .env
    rm -rf "$temp_dir"
    
    docker compose up -d --remove-orphans
    
    echo -e "${GREEN}✅ Restore complete!${NC}"
}

cmd_config() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local action=${1:-list}
    
    case "$action" in
        list)
            if [ -f .env ]; then
                echo -e "${BLUE}📝 Current Configuration:${NC}"
                grep -v "^#" .env | grep -v "^$" | while IFS='=' read -r k v; do
                    if [[ "$k" == *"SECRET"* ]] || [[ "$k" == *"KEY"* ]] || [[ "$k" == *"PASSWORD"* ]]; then
                        echo "$k=********"
                    else
                        echo "$k=$v"
                    fi
                done
            fi
            ;;
        edit)
            ${EDITOR:-nano} .env
            ;;
        get)
            local key=$2
            if [ -z "$key" ]; then
                echo "Usage: synap config get <key>"
                exit 1
            fi
            grep "^${key}=" .env | cut -d'=' -f2-
            ;;
        set)
            local key=$2
            local value=$3
            if [ -z "$key" ] || [ -z "$value" ]; then
                echo "Usage: synap config set <key> <value>"
                exit 1
            fi
            if grep -q "^${key}=" .env; then
                sed -i.bak "s|^${key}=.*|${key}=${value}|" .env
            else
                echo "${key}=${value}" >> .env
            fi
            echo -e "${GREEN}✓ Updated ${key}${NC}"
            ;;
        *)
            echo "Usage: synap config [list|edit|get|set]"
            ;;
    esac
}

cmd_rebuild() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then

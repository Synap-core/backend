${YELLOW}Installation:${NC}
  synap install [options]        Install Synap

${YELLOW}Management:${NC}
  synap health                   Check system health
  synap ps                       List all services and their status
  synap logs [service] [options] View logs (interactive if no service)
  synap errors [service] [lines] Search for errors in logs
  synap diagnose                 Run comprehensive diagnostics
  synap update [options]         Update to latest or specific version
  synap restart [service]        Restart services (interactive if no service)
  synap rebuild [service]        Rebuild services (interactive if no service)
  synap start [service]          Start services (all or specific)
  synap stop [service]           Stop services (interactive if no service)
  synap backup [name]            Create backup
  synap restore <file>            Restore from backup
  synap config [action]          Manage configuration
  synap clean [type]             Clean Docker resources (interactive if no type)
  synap shell [service] [shell]   Open shell in container (default: backend, sh)
  synap exec <service> <cmd>     Execute command in container
  synap services <sub> [type]    Manage external agent services (OpenClaw, ZeroClaw, etc.)
  synap reset                    Reset all workspace data (keeps Kratos identities)

${YELLOW}Examples:${NC}
  # Install (auto-detects: clone if not in repo, use image by default)
  synap install --domain example.com --email me@example.com

  # Install in git repo (auto-detects: uses repo, builds from source by default)
  synap install --domain localhost

  # Force image even in git repo
  synap install --from-image --domain example.com --email me@example.com

  # Update (auto-detects: builds if in git repo, pulls image otherwise)

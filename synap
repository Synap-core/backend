#!/bin/bash
# Synap - Unified CLI for installation and management
# Replaces: install.sh, install-automated.sh, synap-cli

set -e

# Pin the docker compose project name deterministically. Compose otherwise
# falls back to the cwd basename, which on a git checkout is "deploy" — and
# silently switching project name spawns a parallel orphan stack: NEW empty
# data volumes are created and the running container loses sight of the
# operator's existing data (kratos identities, synap users, postgres rows).
#
# This is the ROOT CAUSE of the May-2026 wipe report: existing installs
# created their data under project "deploy" (volume `deploy_postgres_data`),
# then a later run hard-pinned project to "synap-backend" → compose created
# `synap-backend_postgres_data` empty, postgres mounted on it, kratos-migrate
# ran every migration from scratch on the empty schema. The original data
# was still in `deploy_postgres_data` but orphaned.
#
# Pick the project name that owns the actual data volume. Preference order:
#   1. shell env override (operator knows what they're doing)
#   2. .env override (operator pinned it)
#   3. existing data volume — if `deploy_postgres_data` exists and a
#      synap-backend one does NOT, USE "deploy" so postgres mounts the
#      already-populated volume on next compose up.
#   4. fall back to "synap-backend" (the current convention for fresh installs).
_resolve_compose_project_name() {
    if [ -n "${COMPOSE_PROJECT_NAME:-}" ]; then
        echo "$COMPOSE_PROJECT_NAME"
        return
    fi
    if [ -f .env ] && grep -q "^COMPOSE_PROJECT_NAME=" .env 2>/dev/null; then
        grep "^COMPOSE_PROJECT_NAME=" .env | head -1 | cut -d'=' -f2- | tr -d '"' | tr -d "'"
        return
    fi
    # Probe Docker for existing data volumes — only when docker is available.
    if command -v docker >/dev/null 2>&1; then
        local has_deploy
        has_deploy=$(docker volume ls --format '{{.Name}}' 2>/dev/null | grep -E '^deploy_postgres_data$' || true)
        local has_synap
        has_synap=$(docker volume ls --format '{{.Name}}' 2>/dev/null | grep -E '^synap-backend_postgres_data$' || true)
        if [ -n "$has_deploy" ] && [ -z "$has_synap" ]; then
            echo "deploy"
            return
        fi
    fi
    echo "synap-backend"
}
export COMPOSE_PROJECT_NAME="$(_resolve_compose_project_name)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

# Detect if we're in a git repository
is_git_repo() {
    git rev-parse --git-dir > /dev/null 2>&1
}

# Get repo root (if in git repo)
get_repo_root() {
    if is_git_repo; then
        git rev-parse --show-toplevel 2>/dev/null || pwd
    else
        echo ""
    fi
}

# Get deploy directory (explicit env wins — enables tooling like Eve to point here without cd)
get_deploy_dir() {
    if [ -n "${SYNAP_DEPLOY_DIR:-}" ] && [ -d "${SYNAP_DEPLOY_DIR}" ] && [ -f "${SYNAP_DEPLOY_DIR}/docker-compose.yml" ]; then
        echo "${SYNAP_DEPLOY_DIR}"
        return
    fi
    local repo_root=$(get_repo_root)
    if [ -n "$repo_root" ] && [ -d "$repo_root/deploy" ]; then
        echo "$repo_root/deploy"
    elif [ -f "docker-compose.yml" ]; then
        echo "$(pwd)"
    else
        echo ""
    fi
}

# Used by destructive / confirm flows when automation must not block (e.g. Eve -y)
synap_assume_yes() {
    [ "${SYNAP_ASSUME_YES:-}" = "1" ] || [ "${SYNAP_YES:-}" = "1" ] || [ "${SYNAP_NON_INTERACTIVE:-}" = "1" ]
}

# Remove known stale artifacts from older installers/flows.
# Safe-by-default: only removes known files/containers that should never hold source-of-truth data.
cleanup_stale_synap_state() {
    local deploy_dir="$1"
    if [ -z "$deploy_dir" ] || [ ! -d "$deploy_dir" ]; then
        return 0
    fi

    echo -e "${BLUE}🧹 Cleaning known stale install artifacts...${NC}"

    # Legacy install.sh artifacts that can override backend-migrate behavior.
    rm -f "$deploy_dir/patch_migration.js"

    if [ -f "$deploy_dir/docker-compose.override.yml" ] && grep -q "patch_migration.js" "$deploy_dir/docker-compose.override.yml" 2>/dev/null; then
        rm -f "$deploy_dir/docker-compose.override.yml"
        echo -e "${YELLOW}  Removed legacy docker-compose.override.yml (patch_migration hook)${NC}"
    fi

    # Legacy Eve fallback container (removed path): can create confusing health/readiness state.
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q '^eve-brain-synap$'; then
        docker rm -f eve-brain-synap >/dev/null 2>&1 || true
        echo -e "${YELLOW}  Removed legacy container: eve-brain-synap${NC}"
    fi
}

# ============================================================================
# HELPER: Update env value
# ============================================================================

update_env_value() {
    local key=$1
    local value=$2
    if [ -z "$value" ]; then
        return 0  # Skip if value is empty
    fi
    if grep -q "^${key}=" .env; then
        sed -i.bak "s|^${key}=.*|${key}=${value}|" .env
    else
        echo "${key}=${value}" >> .env
    fi
}

# ============================================================================
# HELPER: Generate secrets and create .env
# ============================================================================

generate_and_create_env() {
    local domain=$1
    local email=$2
    local from_source=$3
    local openai_key=$4
    local anthropic_key=$5
    local google_key=$6
    local admin_email=$7
    local intelligence_url=$8
    local intelligence_key=$9
    local admin_bootstrap_mode=${10}
    local admin_bootstrap_token=${11}
    
    # Generate secrets
    echo -e "${BLUE}🔐 Generating secrets...${NC}"
    
    # Use openssl hex output to avoid any base64 line-wrap issues (no newlines ever)
    local POSTGRES_PASSWORD=$(openssl rand -hex 24)
    local JWT_SECRET=$(openssl rand -hex 48)
    local KRATOS_COOKIE=$(openssl rand -hex 24)
    local KRATOS_CIPHER=$(openssl rand -hex 16)
    local KRATOS_WEBHOOK=$(openssl rand -hex 24)
    local MINIO_ACCESS_KEY=$(openssl rand -hex 12)
    local MINIO_SECRET_KEY=$(openssl rand -hex 24)
    local TYPESENSE_KEY=$(openssl rand -hex 24)
    local TYPESENSE_ADMIN_KEY=$(openssl rand -hex 24)
    local HYDRA_SECRETS_SYSTEM=$(openssl rand -hex 24)
    local SYNAP_SERVICE_ENCRYPTION_KEY=$(openssl rand -hex 32)
    # PROVISIONING_TOKEN authorizes agent-key minting via POST /v1/agents/provision.
    # Backend reads it from compose env; .env.example documents it as required.
    local PROVISIONING_TOKEN=$(openssl rand -hex 32)
    
    local backend_version="latest"
    if [ "$from_source" = "true" ]; then
        backend_version="local"
    fi
    
    cat > .env <<EOF
# Synap Backend Configuration
# Generated: $(date)

GITHUB_REPOSITORY=synap-core/backend
BACKEND_VERSION=${backend_version}
COMPOSE_PROJECT_NAME=synap-backend

DOMAIN=${domain}
LETSENCRYPT_EMAIL=${email:-noreply@localhost}

# PUBLIC_URL: How intelligence hub calls back to this backend
# This MUST be the public-facing URL (not internal Docker network)
PUBLIC_URL=https://${domain}

# Intelligence Service
INTELLIGENCE_HUB_URL=${intelligence_url}
INTELLIGENCE_HUB_API_KEY=${intelligence_key}

# AI Provider API Keys
OPENAI_API_KEY=${openai_key}
ANTHROPIC_API_KEY=${anthropic_key}
GOOGLE_AI_API_KEY=${google_key}

# Embeddings are deterministic by default (no provider key required)
EMBEDDING_PROVIDER=deterministic

# Admin Configuration
ADMIN_EMAIL=${admin_email}
ADMIN_BOOTSTRAP_MODE=${admin_bootstrap_mode}
ADMIN_BOOTSTRAP_TOKEN=${admin_bootstrap_token}

# Auto-generated Secrets
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
JWT_SECRET=${JWT_SECRET}
KRATOS_SECRETS_COOKIE=${KRATOS_COOKIE}
KRATOS_SECRETS_CIPHER=${KRATOS_CIPHER}
KRATOS_WEBHOOK_SECRET=${KRATOS_WEBHOOK}
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
TYPESENSE_API_KEY=${TYPESENSE_KEY}
TYPESENSE_ADMIN_API_KEY=${TYPESENSE_ADMIN_KEY}
ORY_HYDRA_SECRETS_SYSTEM=${HYDRA_SECRETS_SYSTEM}
SYNAP_SERVICE_ENCRYPTION_KEY=${SYNAP_SERVICE_ENCRYPTION_KEY}
PROVISIONING_TOKEN=${PROVISIONING_TOKEN}

# Allowed CORS origins (comma-separated frontend URLs)
# Add your Electron app origin or web client URL here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
EOF
    
    chmod 600 .env
}

# Generate kratos.yml with actual domain values
# IMPORTANT: This function ALWAYS overwrites kratos.yml - never use a static file
# The file is generated fresh on every install/update to ensure webhook secret and domain are correct
generate_kratos_config() {
    local domain=$1
    local kratos_dir="../kratos"
    local deploy_dir="deploy"
    
    if [ ! -d "$kratos_dir" ]; then
        echo -e "${YELLOW}⚠️  Kratos directory not found, skipping config generation${NC}"
        return
    fi
    
    # Read webhook secret from .env file (if it exists)
    # This function is called from deploy/ directory, so .env is in current directory
    local webhook_secret=""
    local env_file=""
    
    # Find .env file - check current directory first (deploy/), then parent (repo root)
    if [ -f ".env" ] && [ -r ".env" ]; then
        # Called from deploy/ directory
        env_file=".env"
    elif [ -f "../deploy/.env" ] && [ -r "../deploy/.env" ]; then
        # Called from repo root
        env_file="../deploy/.env"
    elif [ -f "deploy/.env" ] && [ -r "deploy/.env" ]; then
        # Alternative path
        env_file="deploy/.env"
    fi
    
    if [ -n "$env_file" ]; then
        # Use cat and grep to avoid permission issues with direct grep
        webhook_secret=$(cat "$env_file" 2>/dev/null | grep "^KRATOS_WEBHOOK_SECRET=" | cut -d'=' -f2- | tr -d ' ' | tr -d '"' || echo "")
    fi
    
    if [ -z "$webhook_secret" ] || [ "$webhook_secret" = "" ]; then
        echo -e "${YELLOW}⚠️  KRATOS_WEBHOOK_SECRET not found in .env, generating new secret...${NC}"
        # Generate a random secret if not found
        webhook_secret=$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | base64 | tr -d '\n' || echo "CHANGE_ME")
        echo -e "${BLUE}ℹ️  Generated webhook secret: ${webhook_secret:0:10}...${NC}"
        # Try to write it back to .env if we found the file
        if [ -n "$env_file" ] && [ -w "$env_file" ]; then
            if grep -q "^KRATOS_WEBHOOK_SECRET=" "$env_file" 2>/dev/null; then
                # Update existing
                sed -i.bak "s|^KRATOS_WEBHOOK_SECRET=.*|KRATOS_WEBHOOK_SECRET=${webhook_secret}|" "$env_file" 2>/dev/null && rm -f "${env_file}.bak" || true
            else
                # Add new
                echo "KRATOS_WEBHOOK_SECRET=${webhook_secret}" >> "$env_file" 2>/dev/null || true
            fi
        fi
    fi
    
    # Backup existing kratos.yml if it exists (for recovery)
    if [ -f "$kratos_dir/kratos.yml" ]; then
        cp "$kratos_dir/kratos.yml" "$kratos_dir/kratos.yml.backup" 2>/dev/null || true
    fi
    
    # Determine if domain is localhost (dev) or production
    local is_localhost=false
    if [ "$domain" = "localhost" ]; then
        is_localhost=true
    fi

    # Browser-visible UI for Kratos flows. The legacy admin-ui SPA was retired
    # 2026-05; pod-admin (Next.js, served at pod-admin.<bare-root>) now hosts
    # all flow renderers natively at /login. Kratos still hits ui_url for
    # browser-initiated flows (error pages, /self-service/*/browser
    # redirects) — pointing it at pod-admin/login lets pod-admin re-init the
    # flow via Kratos public API and render the form locally.
    local pod_admin_ui=""
    local kratos_ui=""
    local bare_root="$domain"
    if [ "$is_localhost" = true ]; then
        pod_admin_ui="http://localhost:4040"
    else
        # Strip the `pod.` FQDN prefix to recover the bare root domain. Eve's
        # toPodFqdn() always passes `pod.<root>`; for hand-rolled installs
        # that bypass eve, $domain may already be the bare root, in which
        # case the prefix strip is a no-op.
        bare_root="${domain#pod.}"
        pod_admin_ui="https://pod-admin.${bare_root}"
    fi
    kratos_ui="${pod_admin_ui}/login"

    # Kratos public API base URL — localhost in dev, domain URL in production
    local kratos_public_base_url=""
    if [ "$is_localhost" = true ]; then
        kratos_public_base_url="http://localhost:4433"
    else
        kratos_public_base_url="https://${domain}/.ory/kratos/public/"
    fi

    # Generate CORS origins
    local cors_origins="        - http://localhost:3000
        - http://localhost:5173
        - http://localhost:3001
        - http://localhost:4000
        - http://localhost:4040"

    if [ "$is_localhost" = false ]; then
        cors_origins="$cors_origins
        - https://${domain}
        - https://pod-admin.${bare_root}
        - https://*.synap.live"
    fi

    # Generate allowed return URLs
    local return_urls="    - http://localhost:3000
    - http://localhost:3000/*
    - http://localhost:4000
    - http://localhost:4000/*
    - http://localhost:4040
    - http://localhost:4040/*"

    if [ "$is_localhost" = false ]; then
        return_urls="$return_urls
    - https://${domain}
    - https://${domain}/*
    - https://pod-admin.${bare_root}
    - https://pod-admin.${bare_root}/*"
    fi

    # Cookie domain and secure settings — scoped to the bare root so the
    # session cookie set at pod.<root> is also valid at pod-admin.<root>.
    local cookie_domain="localhost"
    local cookie_secure="false"
    if [ "$is_localhost" = false ]; then
        cookie_domain="$bare_root"
        cookie_secure="true"
    fi
    
    # Always overwrite kratos.yml (never use a static file - always generate fresh)
    # This ensures webhook secret and domain are always correct
    cat > "$kratos_dir/kratos.yml" << EOF
version: v1.3.1
# DSN should match docker-compose environment variable
# Uses postgres service name, kratos database
dsn: postgres://synap:\${POSTGRES_PASSWORD}@postgres:5432/kratos?sslmode=disable
serve:
  public:
    base_url: ${kratos_public_base_url}
    cors:
      enabled: true
      # CORS origins - automatically generated from domain
      allowed_origins:
$cors_origins
      allowed_methods:
        - POST
        - GET
        - PUT
        - PATCH
        - DELETE
        - OPTIONS
      allowed_headers:
        - Authorization
        - Cookie
        - Content-Type
        - X-Requested-With
      exposed_headers:
        - Content-Type
        - Set-Cookie
      allow_credentials: true
  admin:
    base_url: http://localhost:4434
selfservice:
  default_browser_return_url: ${pod_admin_ui}/
  allowed_return_urls:
$return_urls
  methods:
    password:
      enabled: true
      config: {}
    oidc:
      enabled: false
  flows:
    error:
      ui_url: ${kratos_ui}
    settings:
      ui_url: ${kratos_ui}
      privileged_session_max_age: 15m
    recovery:
      enabled: true
      ui_url: ${kratos_ui}
    verification:
      enabled: false # Disabled: mailslurper service not running
      ui_url: ${kratos_ui}
    logout:
      after:
        default_browser_return_url: ${pod_admin_ui}/
    login:
      ui_url: ${kratos_ui}
      lifespan: 10m
    registration:
      lifespan: 10m
      ui_url: ${kratos_ui}
      after:
        password:
          hooks:
            - hook: session
            - hook: web_hook
              config:
                # Use Docker service name for internal communication
                # backend:4000 is accessible from within the Docker network
                url: http://backend:4000/webhooks/kratos
                method: POST
                body: base64://ZnVuY3Rpb24oY3R4KSB7CiAgdHlwZTogImlkZW50aXR5LmNyZWF0ZWQiLAogIGlkZW50aXR5OiB7CiAgICBpZDogY3R4LmlkZW50aXR5LmlkLAogICAgdHJhaXRzOiBjdHguaWRlbnRpdHkudHJhaXRzCiAgfQp9
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: false
        oidc:
          hooks:
            - hook: session
log:
  level: info
  format: json
# secrets: provided via environment variables SECRETS_COOKIE and SECRETS_CIPHER in docker-compose.yml
identity:
  default_schema_id: default
  schemas:
    - id: default
      url: file:///etc/config/kratos/identity.schema.json
session:
  cookie:
    # Cookie domain: automatically set based on domain
    domain: ${cookie_domain}
    same_site: Lax
    # Note: secure flag is controlled by Kratos based on cookie domain
    # For production domains, Kratos automatically sets secure=true
courier:
  smtp:
    connection_uri: smtps://test:test@mailslurper:1025/?skip_ssl_verify=true
    from_address: noreply@synap.io
EOF
    
    echo -e "${GREEN}✓ Generated kratos.yml for domain: ${domain}${NC}"
}

# Wait until Kratos accepts traffic (used before first-admin seed).
wait_for_kratos_ready() {
    local i=0
    while [ "$i" -lt 45 ]; do
        if docker compose exec -T kratos wget --spider -q http://127.0.0.1:4433/health/ready 2>/dev/null; then
            return 0
        fi
        i=$((i + 1))
        sleep 2
    done
    return 1
}

# Create first admin via script bundled in backend image (dist/scripts/create-admin-cli.js).
run_preseed_admin_in_container() {
    local email="$1"
    local password="$2"
    local attempt=1
    local max_attempts=6

    if ! wait_for_kratos_ready; then
        echo -e "${YELLOW}⚠️  Kratos did not report ready in time; still attempting admin creation.${NC}"
    fi

    while [ "$attempt" -le "$max_attempts" ]; do
        if docker compose exec -T \
            -e "ADMIN_EMAIL=${email}" \
            -e "ADMIN_PASSWORD=${password}" \
            backend node dist/scripts/create-admin-cli.js; then
            return 0
        fi
        echo -e "${YELLOW}⚠️  Admin seed attempt ${attempt}/${max_attempts} failed, retrying...${NC}"
        attempt=$((attempt + 1))
        sleep 8
    done
    return 1
}

# ============================================================================
# SETUP COMMAND — post-install operator actions (admin creation, etc.)
# ============================================================================

cmd_setup() {
    local sub="${1:-}"
    case "$sub" in
        admin)
            shift
            cmd_setup_admin "$@"
            ;;
        ""|--help|-h)
            cat <<EOF
${BLUE}Synap Setup${NC}

${YELLOW}Subcommands:${NC}
  ${GREEN}admin${NC}        Create or check the first admin account on a running pod

Run 'synap setup <subcommand> --help' for subcommand-specific options.
EOF
            ;;
        *)
            echo -e "${RED}Unknown setup subcommand: ${sub}${NC}"
            echo "Run 'synap setup --help' for available subcommands"
            exit 1
            ;;
    esac
}

# Pod URL for on-host CLI calls. Defaults to the loopback published by the
# eve-managed compose override (127.0.0.1:4000). Operator can override via
# SYNAP_POD_URL when running outside that setup (e.g. dev hosts).
_synap_pod_url() {
    echo "${SYNAP_POD_URL:-http://127.0.0.1:4000}"
}

_synap_bootstrap_token() {
    if [ ! -f .env ]; then
        return 1
    fi
    grep "^ADMIN_BOOTSTRAP_TOKEN=" .env 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || true
}

cmd_setup_admin() {
    local deploy_dir
    deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    cd "$deploy_dir"

    local email=""
    local password=""
    local mode=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --email)         email="$2"; shift 2 ;;
            --password)      password="$2"; shift 2 ;;
            --status)        mode="status"; shift ;;
            --magic-link)    mode="magic-link"; shift ;;
            --help|-h)
                cat <<EOF
${BLUE}Synap Setup Admin${NC}

${YELLOW}Usage:${NC}
  synap setup admin --email <e> --password <p>     Create admin via container exec (preseed)
  synap setup admin --email <e> --magic-link       Mint a one-hour browser link
  synap setup admin --status                       Probe whether the pod still needs setup

${YELLOW}Options:${NC}
  ${GREEN}--email <email>${NC}      Admin email (required for preseed and magic-link modes)
  ${GREEN}--password <secret>${NC}  Admin password (preseed mode — runs container script directly)
  ${GREEN}--magic-link${NC}         Mint a magic-link URL the operator opens in their browser
  ${GREEN}--status${NC}             Print 'needed' or 'ready' and exit (machine-readable)
EOF
                exit 0
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}"
                exit 1
                ;;
        esac
    done

    # Status probe — used by callers (eve doctor, eve auth provision) to
    # decide whether to prompt for admin setup.
    if [ "$mode" = "status" ]; then
        local pod_url
        pod_url=$(_synap_pod_url)
        local token
        token=$(_synap_bootstrap_token || true)
        local auth_header=()
        if [ -n "$token" ]; then
            auth_header=(-H "Authorization: Bearer ${token}")
        fi
        local body
        body=$(curl -fsS --max-time 6 "${auth_header[@]}" "${pod_url}/api/hub/setup/status" 2>/dev/null || echo "")
        if echo "$body" | grep -q '"needsSetup":true'; then
            echo "needed"
            exit 0
        fi
        if echo "$body" | grep -q '"needsSetup":false'; then
            echo "ready"
            exit 0
        fi
        echo "unknown"
        exit 2
    fi

    # Preseed — direct container exec. Uses the existing helper.
    if [ -n "$password" ]; then
        if [ -z "$email" ]; then
            echo -e "${RED}--password requires --email${NC}"
            exit 1
        fi
        if run_preseed_admin_in_container "$email" "$password"; then
            echo -e "${GREEN}✅ First admin created.${NC}"
            exit 0
        else
            echo -e "${RED}❌ Preseed admin creation failed. Check 'docker compose logs backend'.${NC}"
            exit 1
        fi
    fi

    # Magic-link — POST to the pod's /setup/magic-link endpoint, print URL.
    if [ "$mode" = "magic-link" ]; then
        if [ -z "$email" ]; then
            echo -e "${RED}--magic-link requires --email${NC}"
            exit 1
        fi
        local pod_url
        pod_url=$(_synap_pod_url)
        local token
        token=$(_synap_bootstrap_token || true)
        if [ -z "$token" ]; then
            echo -e "${RED}No ADMIN_BOOTSTRAP_TOKEN in .env — magic link cannot be authorized.${NC}"
            exit 1
        fi
        local body
        body=$(curl -fsS -X POST \
            -H "Content-Type: application/json" \
            -H "Authorization: Bearer ${token}" \
            -H "Accept: application/json" \
            -d "{\"email\":\"${email}\"}" \
            "${pod_url}/setup/magic-link" 2>&1)
        local status=$?
        if [ $status -ne 0 ]; then
            echo -e "${RED}Failed to mint magic link: ${body}${NC}"
            exit 1
        fi
        local url
        url=$(echo "$body" | grep -o '"url":"[^"]*"' | cut -d'"' -f4 || echo "")
        if [ -z "$url" ]; then
            echo -e "${RED}Pod did not return a magic-link URL. Response: ${body}${NC}"
            exit 1
        fi
        echo "$url"
        exit 0
    fi

    # No mode flag and no password — print usage.
    echo -e "${YELLOW}Specify a mode: --password (preseed), --magic-link, or --status.${NC}"
    echo "Run 'synap setup admin --help' for details."
    exit 1
}

# ============================================================================
# INSTALL COMMAND
# ============================================================================

cmd_install() {
    local FROM_IMAGE=""
    local FROM_SOURCE=""
    local INSTALL_DIR=""
    local DOMAIN=""
    local EMAIL=""
    local ADMIN_EMAIL=""
    local ADMIN_PASSWORD=""
    local ADMIN_PASSWORD_FROM_ARG=false
    local ADMIN_PASSWORD_GENERATED=""
    local ADMIN_SEED_OK=""
    local ADMIN_BOOTSTRAP_MODE=""
    local ADMIN_BOOTSTRAP_TOKEN=""
    local INTELLIGENCE_URL=""
    local INTELLIGENCE_KEY=""
    local REPO_URL="https://github.com/synap-core/backend.git"
    local INTERACTIVE=true
    local WITH_OPENCLAW=false
    local WITH_RSSHUB=false
    local TUNNEL_PROVIDER=""
    local TUNNEL_TOKEN_ARG=""
    local TUNNEL_TOKEN_FILE=""

    # Auto-detect if we're in a git repo
    local IN_GIT_REPO=false
    if is_git_repo; then
        IN_GIT_REPO=true
    fi
    # Archive/tarball extract (e.g. codeload) has no .git but is still a valid backend root when cwd is SYNAP_REPO_ROOT
    local BACKEND_TREE_IN_CWD=false
    if [ -f "$(pwd)/deploy/docker-compose.yml" ]; then
        BACKEND_TREE_IN_CWD=true
    fi

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --from-image)
                FROM_IMAGE=true
                shift
                ;;
            --from-source|--build)
                FROM_SOURCE=true
                shift
                ;;
            --dir|--directory)
                INSTALL_DIR="$2"
                shift 2
                ;;
            --domain)
                DOMAIN="$2"
                shift 2
                ;;
            --email)
                EMAIL="$2"
                shift 2
                ;;
            --admin-email)
                ADMIN_EMAIL="$2"
                shift 2
                ;;
            --admin-password)
                ADMIN_PASSWORD="$2"
                ADMIN_PASSWORD_FROM_ARG=true
                shift 2
                ;;
            --admin-bootstrap-mode)
                ADMIN_BOOTSTRAP_MODE="$2"
                shift 2
                ;;
            --admin-bootstrap-token)
                ADMIN_BOOTSTRAP_TOKEN="$2"
                shift 2
                ;;
            --intelligence-url)
                INTELLIGENCE_URL="$2"
                shift 2
                ;;
            --intelligence-key)
                INTELLIGENCE_KEY="$2"
                shift 2
                ;;
            --repo-url)
                REPO_URL="$2"
                shift 2
                ;;
            --non-interactive|--automated)
                INTERACTIVE=false
                shift
                ;;
            --with-openclaw)
                WITH_OPENCLAW=true
                shift
                ;;
            --with-rsshub)
                WITH_RSSHUB=true
                shift
                ;;
            --tunnel)
                TUNNEL_PROVIDER="$2"
                shift 2
                ;;
            --tunnel-token)
                TUNNEL_TOKEN_ARG="$2"
                shift 2
                ;;
            --tunnel-token-file)
                TUNNEL_TOKEN_FILE="$2"
                shift 2
                ;;
            --help|-h)
                cat << EOF
${BLUE}Synap Install${NC}

${YELLOW}Usage:${NC}
  synap install [options]

${YELLOW}Auto-Detection:${NC}
  - If in git repository: Uses existing repo, defaults to --from-source
  - If not in git repository: Clones repo, defaults to --from-image
  - Default clone location: Current directory + "synap-backend"

${YELLOW}Options:${NC}
  ${GREEN}--from-image${NC}        Use Docker image (default when cloning)
  ${GREEN}--from-source${NC}        Build from source code (default when in git repo)
  ${GREEN}--dir <path>${NC}         Installation directory (default: ./synap-backend when cloning)
  ${GREEN}--domain <domain>${NC}    Domain name (required)
  ${GREEN}--email <email>${NC}     Email for SSL certificates (required for production)
  ${GREEN}--repo-url <url>${NC}    Repository URL (default: synap-core/backend)
  ${GREEN}--non-interactive${NC}   Automated mode (no prompts)
  ${GREEN}--admin-email <email>${NC}       Admin email (required for preseed)
  ${GREEN}--admin-password <secret>${NC} First admin password (required for non-interactive preseed)
  ${GREEN}--admin-bootstrap-mode <preseed|token>${NC}  First admin bootstrap strategy
  ${GREEN}--admin-bootstrap-token <token>${NC}         One-time token (when mode=token)
  
  ${GREEN}--intelligence-url <url>${NC} URL of Intelligence Service (e.g. http://localhost:3001)
  ${GREEN}--intelligence-key <key>${NC} Hub Protocol API Key for Intelligence Service
  ${GREEN}--with-openclaw${NC}        Provision OpenClaw agent automatically after install
  ${GREEN}--with-rsshub${NC}          Start RSSHub + browserless (compose profile rsshub)
  ${GREEN}--tunnel <provider>${NC}    Enable tunnel after install (cloudflare | pangolin)
  ${GREEN}--tunnel-token <TOKEN>${NC}        Tunnel token (pairs with --tunnel)
  ${GREEN}--tunnel-token-file <PATH>${NC}   Read tunnel token from file (safer than --tunnel-token)

${YELLOW}Examples:${NC}
  # In git repo: build from source (default)
  synap install --domain localhost

  # Not in git repo: clone and use image (default)
  synap install --domain example.com --email me@example.com

  # With Intelligence Service config
  synap install --domain localhost --intelligence-url http://localhost:3001 --intelligence-key my-secret-key

  # Provision OpenClaw during install
  synap install --domain example.com --with-openclaw

  # Enable RSS aggregation (RSSHub + browserless)
  synap install --domain localhost --with-rsshub

  # Expose via Cloudflare Tunnel (bring your own token)
  synap install --domain example.com --tunnel cloudflare --tunnel-token <TOKEN>
  synap install --domain example.com --tunnel cloudflare --tunnel-token-file /path/to/token

${YELLOW}After install:${NC}
  This script installs the pod only. Agent connections (OpenClaw, Raycast,
  other MCP clients) are handled from your laptop with @synap-core/cli:
    npm install -g @synap-core/cli
    npx @synap-core/cli init --pod-url https://<your-pod>

  ./synap itself stays on this server for ops (health, logs, backups, updates).

EOF
                exit 0
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}"
                echo "Run 'synap install --help' for usage"
                exit 1
                ;;
        esac
    done
    
    # Determine if we need to clone (no .git and no existing deploy/ tree in cwd → clone under pwd/synap-backend)
    local NEEDS_CLONE=false
    if [ "$IN_GIT_REPO" = true ]; then
        echo -e "${GREEN}✓ Detected git repository, using existing repo${NC}"
    elif [ "$BACKEND_TREE_IN_CWD" = true ]; then
        echo -e "${GREEN}✓ Synap backend tree present (deploy/), no .git — using current directory (no nested clone)${NC}"
    else
        NEEDS_CLONE=true
        echo -e "${BLUE}ℹ️  Not in git repository, will clone${NC}"
    fi

    # Determine installation directory
    if [ -z "$INSTALL_DIR" ]; then
        if [ "$NEEDS_CLONE" = true ]; then
            # Default to current directory + "synap-backend"
            INSTALL_DIR="$(pwd)/synap-backend"

            # Propose to change if interactive
            if [ "$INTERACTIVE" = true ]; then
                echo -e "${BLUE}📁 Installation directory: ${INSTALL_DIR}${NC}"
                read -p "Change installation directory? (y/N): " CHANGE_DIR
                if [ "$CHANGE_DIR" = "y" ] || [ "$CHANGE_DIR" = "Y" ]; then
                    read -p "Enter installation directory: " INSTALL_DIR
                    INSTALL_DIR=${INSTALL_DIR:-$(pwd)/synap-backend}
                fi
            fi
        else
            # Use repo root as install directory
            if [ "$IN_GIT_REPO" = true ]; then
                INSTALL_DIR=$(get_repo_root)
            elif [ "$BACKEND_TREE_IN_CWD" = true ]; then
                INSTALL_DIR=$(pwd)
            else
                INSTALL_DIR=""
            fi
            if [ -z "$INSTALL_DIR" ]; then
                echo -e "${RED}Error: Could not determine repository root${NC}"
                exit 1
            fi
        fi
    fi
    
    # Determine deployment method (smart defaults)
    if [ -z "$FROM_IMAGE" ] && [ -z "$FROM_SOURCE" ]; then
        if [ "$NEEDS_CLONE" = true ]; then
            # When cloning: default to image
            FROM_IMAGE=true
            echo -e "${BLUE}ℹ️  Defaulting to --from-image (use --from-source to build)${NC}"
        else
            # When in git repo: default to source
            FROM_SOURCE=true
            echo -e "${BLUE}ℹ️  Defaulting to --from-source (use --from-image to use pre-built image)${NC}"
        fi
    fi
    
    # Check for existing .env file in deploy directory to load defaults
    # We need to do this before prompts, but after we know the install directory
    local deploy_env_path=""
    if [ -n "$INSTALL_DIR" ]; then
        deploy_env_path="$INSTALL_DIR/deploy/.env"
    fi
    
    # Load existing .env values as defaults (if .env exists)
    local DEFAULT_DOMAIN=""
    local DEFAULT_EMAIL=""
    local DEFAULT_ADMIN_EMAIL=""
    local DEFAULT_ADMIN_BOOTSTRAP_MODE=""
    local DEFAULT_INTEL_URL=""
    local DEFAULT_INTEL_KEY=""
    
    if [ -n "$deploy_env_path" ] && [ -f "$deploy_env_path" ]; then
        DEFAULT_DOMAIN=$(grep "^DOMAIN=" "$deploy_env_path" 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "")
        DEFAULT_EMAIL=$(grep "^LETSENCRYPT_EMAIL=" "$deploy_env_path" 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "")
        DEFAULT_ADMIN_EMAIL=$(grep "^ADMIN_EMAIL=" "$deploy_env_path" 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "")
        DEFAULT_ADMIN_BOOTSTRAP_MODE=$(grep "^ADMIN_BOOTSTRAP_MODE=" "$deploy_env_path" 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "")
        DEFAULT_INTEL_URL=$(grep "^INTELLIGENCE_HUB_URL=" "$deploy_env_path" 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "")
        DEFAULT_INTEL_KEY=$(grep "^INTELLIGENCE_HUB_API_KEY=" "$deploy_env_path" 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "")
    fi
    
    # Interactive prompts (if not automated)
    if [ "$INTERACTIVE" = true ]; then
        if [ -z "$DOMAIN" ]; then
            local prompt="Enter domain (or 'localhost' for testing)"
            if [ -n "$DEFAULT_DOMAIN" ]; then
                prompt="$prompt [${DEFAULT_DOMAIN}]: "
            else
                prompt="$prompt: "
            fi
            read -p "$prompt" DOMAIN
            DOMAIN=${DOMAIN:-${DEFAULT_DOMAIN:-localhost}}
        fi
        
        if [ "$DOMAIN" != "localhost" ] && [ -z "$EMAIL" ]; then
            local prompt="Enter email for SSL certificates"
            if [ -n "$DEFAULT_EMAIL" ]; then
                prompt="$prompt [${DEFAULT_EMAIL}]: "
            else
                prompt="$prompt: "
            fi
            read -p "$prompt" EMAIL
            EMAIL=${EMAIL:-$DEFAULT_EMAIL}
        fi
        
        # First-admin bootstrap strategy (self-hosted)
        echo ""
        echo -e "${BLUE}👤 Admin Bootstrap${NC}"
        if [ -z "$ADMIN_BOOTSTRAP_MODE" ]; then
            local mode_default=${DEFAULT_ADMIN_BOOTSTRAP_MODE:-preseed}
            echo "  1) Pre-seed first admin via CLI/script (recommended for operators)"
            echo "  2) One-time bootstrap token (guided UI at /admin/bootstrap)"
            echo ""
            read -p "Choice [1/2] (${mode_default}): " ADMIN_BOOTSTRAP_CHOICE
            if [ "$ADMIN_BOOTSTRAP_CHOICE" = "2" ] || [ "$mode_default" = "token" -a -z "$ADMIN_BOOTSTRAP_CHOICE" ]; then
                ADMIN_BOOTSTRAP_MODE="token"
            else
                ADMIN_BOOTSTRAP_MODE="preseed"
            fi
        fi

        if [ "$ADMIN_BOOTSTRAP_MODE" = "preseed" ]; then
            if [ -z "$ADMIN_EMAIL" ]; then
                local prompt="Enter admin email (used for pre-seeding/admin scripts)"
                if [ -n "$DEFAULT_ADMIN_EMAIL" ]; then
                    prompt="$prompt [${DEFAULT_ADMIN_EMAIL}]: "
                else
                    prompt="$prompt: "
                fi
                read -p "$prompt" ADMIN_EMAIL
                ADMIN_EMAIL=${ADMIN_EMAIL:-$DEFAULT_ADMIN_EMAIL}
            fi

            # Prompt for first-admin password immediately in interactive preseed mode
            # unless it was explicitly provided with --admin-password.
            if [ "$INTERACTIVE" = true ] && [ "$ADMIN_PASSWORD_FROM_ARG" != true ]; then
                echo ""
                echo -e "${BLUE}🔑 First admin password${NC}"
                echo "Creates the Kratos account for ${ADMIN_EMAIL}. Not stored in .env."
                echo "Leave both blank to auto-generate a strong password (shown once after install)."
                local pw1=""
                local pw2=""
                while true; do
                    read -s -p "Password: " pw1
                    echo ""
                    read -s -p "Confirm:  " pw2
                    echo ""
                    if [ -z "$pw1" ] && [ -z "$pw2" ]; then
                        ADMIN_PASSWORD=$(openssl rand -hex 16)
                        ADMIN_PASSWORD_GENERATED=1
                        break
                    fi
                    if [ "$pw1" = "$pw2" ]; then
                        ADMIN_PASSWORD="$pw1"
                        break
                    fi
                    echo -e "${RED}Passwords do not match. Try again (or leave both empty to auto-generate).${NC}"
                done
                unset pw1 pw2 2>/dev/null || true
            fi
        else
            ADMIN_EMAIL=""
            if [ -z "$ADMIN_BOOTSTRAP_TOKEN" ]; then
                ADMIN_BOOTSTRAP_TOKEN=$(openssl rand -hex 24)
            fi
        fi
        
        # Intelligence Service Configuration (optional)
        echo ""
        echo -e "${BLUE}🧠 Intelligence Service Configuration${NC}"
        echo "The Intelligence Service powers AI features (chat, search, analysis)."
        echo ""
        echo "  1) Use Synap hosted Intelligence Service (app.synap.live)"
        echo "  2) Use my own self-hosted Intelligence Service"
        echo "  3) Skip for now (AI features will be disabled)"
        echo ""

        if [ -z "$INTELLIGENCE_URL" ]; then
            read -p "Choice [1/2/3]: " INTEL_CHOICE
            INTEL_CHOICE=${INTEL_CHOICE:-3}

            case "$INTEL_CHOICE" in
                1)
                    INTELLIGENCE_URL="https://intelligence.synap.live"
                    echo -e "${YELLOW}  Using Synap hosted service. Enter your API key from app.synap.live/settings/developer${NC}"
                    read -p "  API Key (or press Enter to skip): " INTELLIGENCE_KEY
                    INTELLIGENCE_KEY=${INTELLIGENCE_KEY:-$DEFAULT_INTEL_KEY}
                    ;;
                2)
                    # Try to detect local IP as a suggestion
                    local LOCAL_IP=""
                    if command -v hostname &> /dev/null; then
                        LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
                    fi
                    local SUGGESTION=${DEFAULT_INTEL_URL:-"http://${LOCAL_IP:-localhost}:3001"}
                    read -p "  Intelligence Service URL [${SUGGESTION}]: " INTELLIGENCE_URL
                    INTELLIGENCE_URL=${INTELLIGENCE_URL:-$SUGGESTION}

                    if [ -z "$INTELLIGENCE_KEY" ]; then
                        local key_prompt="  API Key (from hub installation)"
                        if [ -n "$DEFAULT_INTEL_KEY" ]; then
                            key_prompt="$key_prompt [${DEFAULT_INTEL_KEY:0:5}...]: "
                        else
                            key_prompt="$key_prompt: "
                        fi
                        read -p "$key_prompt" INTELLIGENCE_KEY
                        INTELLIGENCE_KEY=${INTELLIGENCE_KEY:-$DEFAULT_INTEL_KEY}
                    fi
                    ;;
                *)
                    echo -e "${YELLOW}  Skipping — AI features will be disabled until you configure an Intelligence Service${NC}"
                    INTELLIGENCE_URL=""
                    INTELLIGENCE_KEY=""
                    ;;
            esac
        fi
        
        echo ""
        echo -e "${BLUE}🤖 Intelligence Service${NC}"
        echo "Provider API keys (OpenAI/Anthropic/Google) are not prompted here."
        echo "Configure AI routing through Intelligence Service now or later."
    fi

    # Normalize bootstrap mode defaults in non-interactive runs
    if [ -z "$ADMIN_BOOTSTRAP_MODE" ]; then
        if [ -n "$ADMIN_BOOTSTRAP_TOKEN" ]; then
            ADMIN_BOOTSTRAP_MODE="token"
        else
            ADMIN_BOOTSTRAP_MODE=${DEFAULT_ADMIN_BOOTSTRAP_MODE:-preseed}
        fi
    fi

    if [ "$ADMIN_BOOTSTRAP_MODE" != "preseed" ] && [ "$ADMIN_BOOTSTRAP_MODE" != "token" ]; then
        echo -e "${RED}Error: --admin-bootstrap-mode must be 'preseed' or 'token'${NC}"
        exit 1
    fi

    if [ "$ADMIN_BOOTSTRAP_MODE" = "token" ] && [ -z "$ADMIN_BOOTSTRAP_TOKEN" ]; then
        ADMIN_BOOTSTRAP_TOKEN=$(openssl rand -hex 24)
    fi

    if [ "$ADMIN_BOOTSTRAP_MODE" = "preseed" ]; then
        if [ -z "$ADMIN_EMAIL" ]; then
            echo -e "${RED}Error: admin email is required for preseed (use --admin-email or interactive install).${NC}"
            exit 1
        fi
        if [ "$INTERACTIVE" != true ] && [ -z "$ADMIN_PASSWORD" ]; then
            echo -e "${RED}Error: non-interactive preseed requires --admin-password or ADMIN_PASSWORD in the environment.${NC}"
            exit 1
        fi
    fi

    # Validate required parameters
    if [ -z "$DOMAIN" ]; then
        echo -e "${RED}Error: --domain is required${NC}"
        exit 1
    fi
    
    if [ "$DOMAIN" != "localhost" ] && [ -z "$EMAIL" ]; then
        echo -e "${RED}Error: --email is required for production domains${NC}"
        exit 1
    fi
    
    # Create/use installation directory if cloning
    if [ "$NEEDS_CLONE" = true ]; then
        echo -e "${BLUE}📁 Installation directory: ${INSTALL_DIR}${NC}"

        # If directory exists, handle idempotently
        if [ -d "$INSTALL_DIR" ]; then
            # Reuse if it already looks like a valid backend checkout
            if [ -f "$INSTALL_DIR/deploy/docker-compose.yml" ]; then
                echo -e "${GREEN}✓ Existing Synap backend directory detected — reusing${NC}"
                NEEDS_CLONE=false
            else
                # Check whether directory is empty
                if [ -z "$(ls -A "$INSTALL_DIR" 2>/dev/null)" ]; then
                    echo -e "${BLUE}ℹ️  Existing directory is empty — cloning into it${NC}"
                else
                    echo -e "${YELLOW}⚠️  Directory exists and is not empty: ${INSTALL_DIR}${NC}"
                    if [ "$INTERACTIVE" = true ]; then
                        echo "  1) Reset directory and clone fresh (destructive)"
                        echo "  2) Choose a different install directory"
                        echo "  3) Cancel"
                        read -p "Choice [1/2/3] (3): " DIR_CHOICE
                        DIR_CHOICE=${DIR_CHOICE:-3}
                        case "$DIR_CHOICE" in
                            1)
                                echo -e "${BLUE}🧹 Resetting installation directory...${NC}"
                                if ! rm -rf "$INSTALL_DIR" 2>/dev/null; then
                                    echo -e "${RED}❌ Could not remove ${INSTALL_DIR}${NC}"
                                    echo "Try one of:"
                                    echo "  sudo rm -rf \"$INSTALL_DIR\""
                                    echo "  or choose a different --dir"
                                    exit 1
                                fi
                                ;;
                            2)
                                read -p "Enter new installation directory: " NEW_INSTALL_DIR
                                if [ -z "$NEW_INSTALL_DIR" ]; then
                                    echo -e "${RED}No directory entered. Installation cancelled.${NC}"
                                    exit 1
                                fi
                                INSTALL_DIR="$NEW_INSTALL_DIR"
                                ;;
                            *)
                                echo "Installation cancelled"
                                exit 0
                                ;;
                        esac
                    else
                        echo -e "${RED}Error: target directory exists and is not empty: ${INSTALL_DIR}${NC}"
                        echo "Use --dir to choose another directory, or remove it first."
                        exit 1
                    fi
                fi
            fi
        fi

        if [ "$NEEDS_CLONE" = true ]; then
            # Ensure parent exists; clone creates INSTALL_DIR itself.
            mkdir -p "$(dirname "$INSTALL_DIR")"
            echo -e "${BLUE}⬇️  Cloning repository...${NC}"
            git clone "$REPO_URL" "$INSTALL_DIR"
        fi

        cd "$INSTALL_DIR"
    else
        # Use existing repo
        echo -e "${GREEN}✓ Using existing repository${NC}"
        cd "$INSTALL_DIR"
    fi
    
    # Enter deploy directory
    if [ ! -d "deploy" ]; then
        echo -e "${RED}Error: 'deploy' directory not found${NC}"
        exit 1
    fi
    
    cd deploy

    cleanup_stale_synap_state "$(pwd)"
    
    # If we loaded defaults earlier and they were used, we're done with prompts
    # Otherwise, if .env exists now, show a message
    if [ -f .env ] && [ "$INTERACTIVE" = true ] && [ -n "$DEFAULT_DOMAIN" ]; then
        echo -e "${BLUE}ℹ️  Using existing .env file values${NC}"
    fi
    
    # Handle .env file (preserve existing or create new)
    if [ -f .env ]; then
        echo -e "${YELLOW}⚠️  .env file already exists${NC}"
        if [ "$INTERACTIVE" = true ]; then
            read -p "Overwrite .env? (y/N): " OVERWRITE
            if [ "$OVERWRITE" != "y" ] && [ "$OVERWRITE" != "Y" ]; then
                echo -e "${BLUE}ℹ️  Using existing .env file, updating values...${NC}"
                # Just update domain/email/keys if needed
                update_env_value "DOMAIN" "$DOMAIN"
                update_env_value "LETSENCRYPT_EMAIL" "$EMAIL"
                update_env_value "ADMIN_EMAIL" "$ADMIN_EMAIL"
                update_env_value "ADMIN_BOOTSTRAP_MODE" "$ADMIN_BOOTSTRAP_MODE"
                update_env_value "ADMIN_BOOTSTRAP_TOKEN" "$ADMIN_BOOTSTRAP_TOKEN"
                update_env_value "INTELLIGENCE_HUB_URL" "$INTELLIGENCE_URL"
                update_env_value "INTELLIGENCE_HUB_API_KEY" "$INTELLIGENCE_KEY"
                update_env_value "EMBEDDING_PROVIDER" "deterministic"
                # Update backend version based on method
                local backend_version="latest"
                if [ "$FROM_SOURCE" = true ]; then
                    backend_version="local"
                fi
                update_env_value "BACKEND_VERSION" "$backend_version"
                rm -f .env.bak
            else
                # Overwrite .env
                echo -e "${BLUE}📝 Creating new configuration...${NC}"
                generate_and_create_env "$DOMAIN" "$EMAIL" "$FROM_SOURCE" "" "" "" "$ADMIN_EMAIL" "$INTELLIGENCE_URL" "$INTELLIGENCE_KEY" "$ADMIN_BOOTSTRAP_MODE" "$ADMIN_BOOTSTRAP_TOKEN"
            fi
        else
            # Non-interactive: preserve existing
            echo -e "${BLUE}ℹ️  Preserving existing .env file${NC}"
            # Just update values if provided
            update_env_value "DOMAIN" "$DOMAIN"
            update_env_value "LETSENCRYPT_EMAIL" "$EMAIL"
            update_env_value "ADMIN_EMAIL" "$ADMIN_EMAIL"
            update_env_value "ADMIN_BOOTSTRAP_MODE" "$ADMIN_BOOTSTRAP_MODE"
            update_env_value "ADMIN_BOOTSTRAP_TOKEN" "$ADMIN_BOOTSTRAP_TOKEN"
            update_env_value "INTELLIGENCE_HUB_URL" "$INTELLIGENCE_URL"
            update_env_value "INTELLIGENCE_HUB_API_KEY" "$INTELLIGENCE_KEY"
            update_env_value "EMBEDDING_PROVIDER" "deterministic"
            local backend_version="latest"
            if [ "$FROM_SOURCE" = true ]; then
                backend_version="local"
            fi
            update_env_value "BACKEND_VERSION" "$backend_version"
            rm -f .env.bak
        fi
    else
        # No .env file, create new
        echo -e "${BLUE}📝 Creating configuration...${NC}"
        generate_and_create_env "$DOMAIN" "$EMAIL" "$FROM_SOURCE" "" "" "" "$ADMIN_EMAIL" "$INTELLIGENCE_URL" "$INTELLIGENCE_KEY" "$ADMIN_BOOTSTRAP_MODE" "$ADMIN_BOOTSTRAP_TOKEN"
    fi
    
    # Generate kratos.yml with actual domain values
    echo -e "${BLUE}📝 Generating Kratos configuration...${NC}"
    generate_kratos_config "$DOMAIN"
    
    # Build/pull images FIRST (migrations need the image to exist)
    echo -e "${BLUE}🔨 Preparing backend images...${NC}"
    if [ "$FROM_SOURCE" = true ]; then
        echo -e "${BLUE}  Building backend...${NC}"
        docker compose build backend
        echo -e "${BLUE}  Building realtime...${NC}"
        docker compose build realtime
        echo -e "${BLUE}  Building pod-admin...${NC}"
        docker compose build pod-admin
        
        # Verify realtime build succeeded (check for server.js)
        # The main Dockerfile deploys realtime to /app/realtime/dist/server.js
        echo -e "${BLUE}  Verifying realtime build...${NC}"
        if docker compose run --rm realtime test -f /app/realtime/dist/server.js 2>/dev/null; then
            echo -e "${GREEN}  ✓ Realtime build verified${NC}"
        else
            echo -e "${YELLOW}  ⚠️  Realtime verification failed, rebuilding with --no-cache...${NC}"
            docker compose build --no-cache realtime
            if docker compose run --rm realtime test -f /app/realtime/dist/server.js 2>/dev/null; then
                echo -e "${GREEN}  ✓ Realtime rebuild successful${NC}"
            else
                echo -e "${RED}  ✗ Realtime build failed. Check logs with: docker compose logs realtime${NC}"
                exit 1
            fi
        fi
    else
        echo -e "${BLUE}  Pulling backend...${NC}"
        docker compose pull backend --ignore-pull-failures || {
            echo -e "${YELLOW}⚠️  Pull failed, building from source...${NC}"
            docker compose build backend
        }
        echo -e "${BLUE}  Pulling realtime...${NC}"
        docker compose pull realtime --ignore-pull-failures || {
            echo -e "${YELLOW}⚠️  Pull failed, building from source...${NC}"
            docker compose build realtime
        }
        echo -e "${BLUE}  Pulling pod-admin...${NC}"
        docker compose pull pod-admin --ignore-pull-failures || {
            echo -e "${YELLOW}⚠️  Pull failed, building from source...${NC}"
            docker compose build pod-admin
        }
    fi
    

    
    # Start services
    #
    # Caddy is the synap stack's built-in edge proxy. When the operator runs
    # behind their own edge (eve's Traefik on port 80, an external nginx,
    # cloudflared, etc.) Caddy can't bind 80/443 and aborts the install.
    # SYNAP_SKIP_EDGE=1 brings up everything-but-caddy. Compose's depends_on
    # graph still pulls in postgres / redis / minio / typesense / migrations
    # via the listed leaf services (backend, realtime, pod-admin, etc.).
    # Mirror cmd_update's behavior so install + update have one rule.
    #
    # Pod-agent is profile-gated (compose profile: pod-agent) and only included
    # when the operator opts in via `SYNAP_WITH_POD_AGENT=1`. CP-managed pods
    # need it; eve installs and standalone self-hosters do not.
    local pod_agent_args=()
    local profile_args=()
    if [ "${SYNAP_WITH_POD_AGENT:-}" = "1" ]; then
        pod_agent_args=(pod-agent)
        profile_args=(--profile pod-agent)
    fi

    echo -e "${BLUE}🚀 Starting Synap...${NC}"
    if [ "${SYNAP_SKIP_EDGE:-}" = "1" ]; then
        echo -e "${BLUE}  (SYNAP_SKIP_EDGE=1: skipping Caddy — external edge proxy assumed)${NC}"
        docker compose "${profile_args[@]}" up -d --remove-orphans \
            postgres redis minio typesense \
            backend realtime "${pod_agent_args[@]}" pod-admin hydra kratos
    else
        docker compose "${profile_args[@]}" up -d --remove-orphans
    fi

    # Reapply auth schema. On a brand-new volume this is a no-op (compose's
    # depends_on already ran kratos-migrate / hydra-migrate to completion).
    # On a rerun against an existing project this is the SAFETY NET — see
    # cmd_update for the full rationale (compose's `service_completed_successfully`
    # short-circuit + any volume drift = empty kratos DB + 500s on auth).
    docker compose run --rm kratos-migrate >/dev/null 2>&1 || true
    docker compose run --rm hydra-migrate >/dev/null 2>&1 || true

    if [ "$ADMIN_BOOTSTRAP_MODE" = "preseed" ]; then
        echo ""
        echo -e "${BLUE}👤 Creating first admin (Kratos + database)...${NC}"
        ADMIN_SEED_OK=false
        if run_preseed_admin_in_container "$ADMIN_EMAIL" "$ADMIN_PASSWORD"; then
            ADMIN_SEED_OK=true
            echo -e "${GREEN}✅ First admin created.${NC}"
            if [ "$ADMIN_PASSWORD_GENERATED" = "1" ]; then
                echo -e "${YELLOW}Auto-generated admin password (save securely): ${NC}${ADMIN_PASSWORD}"
            fi
        else
            echo -e "${RED}❌ Automatic admin creation failed.${NC}"
            echo "After fixing services, run from this directory (deploy/):"
            echo "  docker compose exec -T -e ADMIN_EMAIL='${ADMIN_EMAIL}' -e ADMIN_PASSWORD='<password>' backend node dist/scripts/create-admin-cli.js"
            echo "Or from repo root with .env loaded: pnpm tsx scripts/create-admin-cli.ts"
        fi
        unset ADMIN_PASSWORD
    fi

    # Provision agent services requested at install time
    # OpenClaw provisioning needs at least one workspace row (workspace_members for the agent).
    # Token bootstrap creates the first workspace only AFTER /admin/bootstrap — so defer here.
    if [ "$WITH_OPENCLAW" = "true" ]; then
        echo ""
        if [ "$ADMIN_BOOTSTRAP_MODE" = "token" ]; then
            echo -e "${YELLOW}🤖 OpenClaw: deferred (token bootstrap has no workspace yet).${NC}"
            echo "  After you finish admin bootstrap and can sign in, run from this directory:"
            echo "    ./synap services add openclaw"
            echo "  Optional: check public reachability first:"
            echo "    ./synap connectivity"
        else
            echo -e "${BLUE}🤖 Provisioning OpenClaw agent...${NC}"
            cmd_services add "openclaw" || {
                echo -e "${YELLOW}⚠️  OpenClaw provisioning failed. Run 'synap services add openclaw' manually after startup.${NC}"
            }
        fi
    fi

    if [ "$WITH_RSSHUB" = "true" ]; then
        echo ""
        echo -e "${BLUE}📡 Starting RSSHub profile (rsshub + browserless)...${NC}"
        docker compose --profile rsshub up -d rsshub browserless || {
            echo -e "${YELLOW}⚠️  RSSHub profile failed. Run 'synap profiles enable rsshub' after fixing compose.${NC}"
        }
    fi

    # Tunnel activation — self-hosted operator brings their own token.
    local TUNNEL_ENABLED=""
    if [ -n "$TUNNEL_PROVIDER" ]; then
        echo ""
        case "$TUNNEL_PROVIDER" in
            cloudflare|pangolin) ;;
            *)
                echo -e "${YELLOW}⚠️  Unknown --tunnel provider '${TUNNEL_PROVIDER}' — skipping. Known: cloudflare, pangolin${NC}"
                TUNNEL_PROVIDER=""
                ;;
        esac
    fi
    if [ -n "$TUNNEL_PROVIDER" ]; then
        if _tunnel_read_token "$TUNNEL_TOKEN_ARG" "$TUNNEL_TOKEN_FILE"; then
            echo -e "${BLUE}🌐 Enabling ${TUNNEL_PROVIDER} tunnel...${NC}"
            if _tunnel_enable_provider "$TUNNEL_PROVIDER" "$TUNNEL_TOKEN_VALUE"; then
                TUNNEL_ENABLED="$TUNNEL_PROVIDER"
            else
                echo -e "${YELLOW}⚠️  Tunnel activation failed. Run 'synap tunnel enable ${TUNNEL_PROVIDER} --token <TOKEN>' manually.${NC}"
            fi
        else
            echo -e "${YELLOW}⚠️  --tunnel ${TUNNEL_PROVIDER} specified but no valid token provided. Run 'synap tunnel enable ${TUNNEL_PROVIDER} --token <TOKEN>' later.${NC}"
        fi
    fi

    echo -e "${GREEN}✅ Installation complete!${NC}"
    echo ""
    echo "Management commands:"
    echo "  ./synap health    # Check status"
    echo "  ./synap logs      # View logs"
    echo "  ./synap update    # Update to latest"
    echo ""
    echo "First admin setup:"
    if [ "$ADMIN_BOOTSTRAP_MODE" = "token" ]; then
        local ui_base="https://${DOMAIN}"
        if [ "$DOMAIN" = "localhost" ]; then
            ui_base="http://localhost:4000"
        fi
        echo "  1) Open: ${ui_base}/admin/bootstrap"
        echo "  2) Use token: ${ADMIN_BOOTSTRAP_TOKEN}"
        echo "  3) Continue to registration and set your password"
    else
        if [ "${ADMIN_SEED_OK:-}" = "true" ]; then
            echo "  Pre-seed finished. Sign in at /admin with ${ADMIN_EMAIL}"
        else
            echo "  Pre-seed manually:"
            echo "    docker compose exec -T -e ADMIN_EMAIL='<email>' -e ADMIN_PASSWORD='<password>' backend node dist/scripts/create-admin-cli.js"
            echo "  Or from repo: ADMIN_EMAIL=... ADMIN_PASSWORD=... pnpm tsx scripts/create-admin-cli.ts"
            echo "  Then open /admin"
        fi
    fi
    if [ "$WITH_OPENCLAW" = "true" ]; then
        if [ "$ADMIN_BOOTSTRAP_MODE" = "token" ]; then
            echo "  ./synap services add openclaw   # After bootstrap (OpenClaw was deferred)"
            echo "  ./synap connectivity              # If your public domain does not load"
        else
            echo "  ./synap services status openclaw  # Check OpenClaw status"
        fi
    fi
    if [ "$WITH_RSSHUB" = "true" ]; then
        echo "  ./synap profiles status rsshub   # RSSHub + browserless"
    fi

    # ──────────────────────────────────────────────────────────────────────
    # Final handoff: pod is running here. Agent connections happen elsewhere.
    # Keep laptop-side work (MCP clients, skill install, provider wiring)
    # out of the bash script — point users at @synap-core/cli explicitly.
    # ──────────────────────────────────────────────────────────────────────
    local PUBLIC_URL_HINT
    if [ "$DOMAIN" = "localhost" ]; then
        PUBLIC_URL_HINT="http://localhost:4000"
    else
        PUBLIC_URL_HINT="https://${DOMAIN}"
    fi

    echo ""
    echo "════════════════════════════════════════════════════════════════"
    echo -e "${GREEN}✅ Synap pod is running at: ${PUBLIC_URL_HINT}${NC}"
    echo "════════════════════════════════════════════════════════════════"
    echo ""
    echo "Next steps — run these on YOUR LAPTOP (not on this server):"
    echo ""
    echo "  1. Install the user CLI:"
    echo "     npm install -g @synap-core/cli"
    echo ""
    echo "  2. Connect your workspace and any AI agents (OpenClaw, Raycast, MCP clients):"
    echo "     npx @synap-core/cli init --pod-url ${PUBLIC_URL_HINT}"
    echo ""
    echo "  3. Optional — install OpenClaw on this server (self-hosted):"
    echo "     ./synap services add openclaw"
    echo ""
    echo "For ops (health, logs, backups, updates) — keep using ./synap on this server."
    echo "════════════════════════════════════════════════════════════════"

    if [ "$WITH_OPENCLAW" = "true" ]; then
        echo ""
        echo -e "${BLUE}🤖 OpenClaw is running on this server.${NC}"
        echo "   To connect OpenClaw on your laptop:"
        echo "     npx @synap-core/cli oc connect --pod-url ${PUBLIC_URL_HINT}"
        echo ""
    fi

    if [ -n "$TUNNEL_ENABLED" ]; then
        echo ""
        case "$TUNNEL_ENABLED" in
            cloudflare)
                echo -e "${BLUE}🌐 Your pod is reachable via the Cloudflare Tunnel you configured.${NC}"
                echo "   Finish setup in the Cloudflare dashboard: route the tunnel's public"
                echo "   hostname to http://backend:4000 (or whichever service you want to expose)."
                ;;
            pangolin)
                echo -e "${BLUE}🌐 Pangolin tunnel container started.${NC}"
                echo "   Confirm the compose profile points at your real newt image (the shipped"
                echo "   profile is a placeholder) and verify connectivity in Pangolin's dashboard."
                ;;
        esac
        echo "   Check status anytime: ./synap tunnel status"
        echo ""
    fi
}



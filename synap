                # accepted so an older caller (Eve's `--synap-repo` install)
                # does not abort the install; it does nothing.
                echo -e "${YELLOW}--with-openclaw is retired and ignored: Synap no longer bundles an agent. Connect any agent from your laptop (npx @synap-core/cli init).${NC}"
                shift

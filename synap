_resolve_compose_project_name "$(get_deploy_dir)"
if [ -n "$_SYNAP_PROJECT_CONFLICT" ]; then
    case "${1:-help}" in
        help|--help|-h|doctor) ;;
        *)
            echo -e "${RED}❌ Refusing to guess the compose project: these projects each own a postgres container for $(get_deploy_dir):${NC}" >&2
            echo -e "     ${_SYNAP_PROJECT_CONFLICT}" >&2
            echo -e "${YELLOW}   Running against the wrong one would start (or migrate) an empty database next to your data.${NC}" >&2
            echo -e "   Inspect each before changing anything:  docker compose -p <project> ps ;  docker compose -p <project> exec postgres psql -U synap -d synap -c 'select count(*) from users'" >&2
            echo -e "   Then pin the real one in $(get_deploy_dir)/.env:  COMPOSE_PROJECT_NAME=<project>" >&2
            echo -e "   Nothing was changed." >&2
            exit 2
            ;;
    esac
fi
export COMPOSE_PROJECT_NAME

# Pod-mutating commands serialise on <deploy_dir>/state/update.lock.
case "${1:-help}" in
    install|update|rebuild|reset|restore|apply)
        if ! synap_update_lock "$(get_deploy_dir)" "synap $1"; then
            # An unattended run must still consume its request (no .path loop).
            case " $* " in *" --unattended "*) [ "$1" = update ] && ( cd "$(get_deploy_dir)" && _ue_unattended_busy ) ;; esac
            exit 1
        fi
        ;;
    config)
        case "${2:-}" in
            set|unset|edit|apply) synap_update_lock "$(get_deploy_dir)" "synap config $2" || exit 1 ;;
        esac
        ;;
esac


#!/bin/bash
# Synap - Unified CLI for installation and management
# Replaces: install.sh, install-automated.sh, synap-cli

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

# Detect if we're in a git repository
is_git_repo() {
    git rev-parse --git-dir > /dev/null 2>&1
}

# Get repo root (if in git repo)
get_repo_root() {
    if is_git_repo; then
        git rev-parse --show-toplevel 2>/dev/null || pwd
    else
        echo ""
    fi
}

# Get deploy directory
get_deploy_dir() {
    local repo_root=$(get_repo_root)
    if [ -n "$repo_root" ] && [ -d "$repo_root/deploy" ]; then
        echo "$repo_root/deploy"
    elif [ -f "docker-compose.yml" ]; then
        echo "$(pwd)"
    else
        echo ""
    fi
}

# ============================================================================
# INSTALL COMMAND
# ============================================================================

cmd_install() {
    local CLONE_REPO=""  # Empty = auto-detect
    local FROM_IMAGE=""
    local FROM_SOURCE=""
    local INSTALL_DIR=""
    local DOMAIN=""
    local EMAIL=""
    local REPO_URL="https://github.com/synap-core/backend.git"
    local INTERACTIVE=true
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --clone)
                CLONE_REPO=true
                shift
                ;;
            --no-clone|--use-repo)
                CLONE_REPO=false
                shift
                ;;
            --from-image)
                FROM_IMAGE=true
                shift
                ;;
            --from-source|--build)
                FROM_SOURCE=true
                shift
                ;;
            --dir|--directory)
                INSTALL_DIR="$2"
                shift 2
                ;;
            --domain)
                DOMAIN="$2"
                shift 2
                ;;
            --email)
                EMAIL="$2"
                shift 2
                ;;
            --repo-url)
                REPO_URL="$2"
                shift 2
                ;;
            --non-interactive|--automated)
                INTERACTIVE=false
                shift
                ;;
            --help|-h)
                cat << EOF
${BLUE}Synap Install${NC}

${YELLOW}Usage:${NC}
  synap install [options]

${YELLOW}Options:${NC}
  ${GREEN}--clone${NC}              Clone repository (default if not in repo)
  ${GREEN}--no-clone${NC}           Use existing repository (skip cloning)
  ${GREEN}--from-image <tag>${NC}   Use Docker image (default: latest)
  ${GREEN}--from-source${NC}        Build from source code
  ${GREEN}--dir <path>${NC}         Installation directory (default: /opt/synap-backend)
  ${GREEN}--domain <domain>${NC}    Domain name (required for production)
  ${GREEN}--email <email>${NC}     Email for SSL certificates (required for production)
  ${GREEN}--repo-url <url>${NC}    Repository URL (default: synap-core/backend)
  ${GREEN}--non-interactive${NC}   Automated mode (no prompts)

${YELLOW}Examples:${NC}
  # Clone and install from image (production)
  synap install --clone --from-image latest --domain example.com --email me@example.com

  # Use existing repo and build from source (development)
  synap install --no-clone --from-source --domain localhost

  # Automated installation
  synap install --clone --from-image latest --domain example.com --email me@example.com --non-interactive

EOF
                exit 0
                ;;
            *)
                echo -e "${RED}Unknown option: $1${NC}"
                echo "Run 'synap install --help' for usage"
                exit 1
                ;;
        esac
    done
    
    # Auto-detect if we should clone (if not explicitly set)
    if [ -z "$CLONE_REPO" ]; then
        if is_git_repo; then
            CLONE_REPO=false
            echo -e "${GREEN}✓ Detected git repository, using existing repo${NC}"
        else
            CLONE_REPO=true
            echo -e "${BLUE}ℹ️  Not in git repository, will clone${NC}"
        fi
    fi
    
    # Determine installation directory
    if [ -z "$INSTALL_DIR" ]; then
        if [ "$CLONE_REPO" = false ]; then
            # Use repo root as install directory
            INSTALL_DIR=$(get_repo_root)
            if [ -z "$INSTALL_DIR" ]; then
                INSTALL_DIR="/opt/synap-backend"
            fi
        else
            INSTALL_DIR="/opt/synap-backend"
        fi
    fi
    
    # Determine deployment method
    if [ -z "$FROM_IMAGE" ] && [ -z "$FROM_SOURCE" ]; then
        # Default to image if nothing specified
        FROM_IMAGE=true
    fi
    
    # Interactive prompts (if not automated)
    if [ "$INTERACTIVE" = true ]; then
        if [ -z "$DOMAIN" ]; then
            read -p "Enter domain (or 'localhost' for testing): " DOMAIN
            DOMAIN=${DOMAIN:-localhost}
        fi
        
        if [ "$DOMAIN" != "localhost" ] && [ -z "$EMAIL" ]; then
            read -p "Enter email for SSL certificates: " EMAIL
        fi
    fi
    
    # Validate required parameters
    if [ -z "$DOMAIN" ]; then
        echo -e "${RED}Error: --domain is required${NC}"
        exit 1
    fi
    
    if [ "$DOMAIN" != "localhost" ] && [ -z "$EMAIL" ]; then
        echo -e "${RED}Error: --email is required for production domains${NC}"
        exit 1
    fi
    
    # Create installation directory if cloning
    if [ "$CLONE_REPO" = true ]; then
        echo -e "${BLUE}📁 Creating installation directory: ${INSTALL_DIR}${NC}"
        mkdir -p "$INSTALL_DIR"
        cd "$INSTALL_DIR"
        
        # Clone repository
        echo -e "${BLUE}⬇️  Cloning repository...${NC}"
        git clone "$REPO_URL" .
    else
        # Use existing repo
        echo -e "${GREEN}✓ Using existing repository${NC}"
        INSTALL_DIR=$(get_repo_root)
        cd "$INSTALL_DIR"
    fi
    
    # Enter deploy directory
    if [ ! -d "deploy" ]; then
        echo -e "${RED}Error: 'deploy' directory not found${NC}"
        exit 1
    fi
    
    cd deploy
    
    # Generate secrets
    echo -e "${BLUE}🔐 Generating secrets...${NC}"
    
    # Generate secure secrets
    POSTGRES_PASSWORD=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    JWT_SECRET=$(openssl rand -base64 64 | tr -d "=+/" | cut -c1-64)
    KRATOS_COOKIE=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    KRATOS_CIPHER=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    KRATOS_WEBHOOK=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    MINIO_SECRET_KEY=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    TYPESENSE_KEY=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    TYPESENSE_ADMIN_KEY=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    INNGEST_EVENT_KEY=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    INNGEST_SIGNING_KEY=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    HYDRA_SECRETS_SYSTEM=$(openssl rand -base64 32 | tr -d "=+/" | cut -c1-32)
    
    # Create .env file
    echo -e "${BLUE}📝 Creating configuration...${NC}"
    
    local backend_version="latest"
    if [ "$FROM_SOURCE" = true ]; then
        backend_version="local"
    fi
    
    cat > .env <<EOF
# Synap Backend Configuration
# Generated: $(date)

GITHUB_REPOSITORY=synap-core/backend
BACKEND_VERSION=${backend_version}
COMPOSE_PROJECT_NAME=synap-backend

DOMAIN=${DOMAIN}
LETSENCRYPT_EMAIL=${EMAIL:-noreply@localhost}

POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
JWT_SECRET=${JWT_SECRET}
KRATOS_SECRETS_COOKIE=${KRATOS_COOKIE}
KRATOS_SECRETS_CIPHER=${KRATOS_CIPHER}
KRATOS_WEBHOOK_SECRET=${KRATOS_WEBHOOK}
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
TYPESENSE_API_KEY=${TYPESENSE_KEY}
TYPESENSE_ADMIN_API_KEY=${TYPESENSE_ADMIN_KEY}
INNGEST_EVENT_KEY=${INNGEST_EVENT_KEY}
INNGEST_SIGNING_KEY=${INNGEST_SIGNING_KEY}
ORY_HYDRA_SECRETS_SYSTEM=${HYDRA_SECRETS_SYSTEM}
EOF
    
    chmod 600 .env
    
    # Start services
    echo -e "${BLUE}🚀 Starting Synap...${NC}"
    if [ "$FROM_SOURCE" = true ]; then
        docker compose build backend
    else
        docker compose pull backend --ignore-pull-failures || true
    fi
    
    docker compose up -d
    
    echo -e "${GREEN}✅ Installation complete!${NC}"
    echo ""
    echo "Management commands:"
    echo "  ./synap health    # Check status"
    echo "  ./synap logs      # View logs"
    echo "  ./synap update    # Update to latest"
}


# ============================================================================
# MANAGEMENT COMMANDS (from synap-cli)
# ============================================================================

cmd_health() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    echo -e "${BLUE}🏥 Synap Health Check${NC}"
    echo ""
    
    if ! docker compose ps | grep -q "Up"; then
        echo -e "${RED}❌ No services running${NC}"
        exit 1
    fi
    
    check_service() {
        local service=$1
        local name=$2
        if docker compose ps "$service" | grep -q "Up"; then
            echo -e "${GREEN}✅ ${name}${NC}"
        else
            echo -e "${RED}❌ ${name}${NC}"
        fi
    }
    
    check_service "backend" "Backend API"
    check_service "postgres" "Database"
    check_service "redis" "Redis"
    check_service "minio" "Storage"
    check_service "typesense" "Search"
    check_service "kratos" "Authentication"
    check_service "hydra" "OAuth2"
    check_service "caddy" "Reverse Proxy"
    
    echo ""
    echo -e "${GREEN}✅ System healthy${NC}"
}

cmd_logs() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-}
    if [ -z "$service" ]; then
        docker compose logs -f
    else
        docker compose logs -f "$service"
    fi
}

cmd_update() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local version="latest"
    local force_build=false
    local local_build=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --build|-b)
                force_build=true
                shift
                ;;
            --local|-l)
                local_build=true
                force_build=true
                shift
                ;;
            --version|-v)
                version="$2"
                shift 2
                ;;
            *)
                if [[ "$1" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]] || [ "$1" = "latest" ]; then
                    version="$1"
                fi
                shift
                ;;
        esac
    done
    
    echo -e "${BLUE}🔄 Updating Synap...${NC}"
    
    if [ "$force_build" = true ]; then
        echo -e "${BLUE}🔨 Building from source...${NC}"
        docker compose build backend
    else
        echo -e "${BLUE}📥 Pulling image...${NC}"
        docker compose pull backend || {
            echo -e "${YELLOW}⚠️  Pull failed, building from source...${NC}"
            docker compose build backend
        }
    fi
    
    # Update .env
    if [ -f .env ]; then
        if grep -q "^BACKEND_VERSION=" .env; then
            sed -i.bak "s|^BACKEND_VERSION=.*|BACKEND_VERSION=${version}|" .env
        else
            echo "BACKEND_VERSION=${version}" >> .env
        fi
    fi
    
    # Run migrations
    echo -e "${BLUE}🔄 Running migrations...${NC}"
    docker compose run --rm backend-migrate || true
    
    # Restart services
    echo -e "${BLUE}🔄 Restarting services...${NC}"
    docker compose up -d backend
    
    echo -e "${GREEN}✅ Update complete!${NC}"
}

cmd_restart() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-}
    if [ -z "$service" ]; then
        docker compose restart
    else
        docker compose restart "$service"
    fi
}

cmd_start() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    docker compose up -d
}

cmd_stop() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    docker compose stop
}

cmd_backup() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local backup_name=${1:-"backup-$(date +%Y%m%d-%H%M%S)"}
    local backup_dir="./backups"
    
    mkdir -p "$backup_dir"
    
    echo -e "${BLUE}💾 Creating backup: ${backup_name}${NC}"
    
    # Backup database
    docker compose exec -T postgres pg_dump -U synap synap > "$backup_dir/${backup_name}-database.sql"
    
    # Backup .env
    cp .env "$backup_dir/${backup_name}.env"
    
    # Create tarball
    tar -czf "$backup_dir/${backup_name}.tar.gz" \
        -C "$backup_dir" \
        "${backup_name}-database.sql" \
        "${backup_name}.env"
    
    rm "$backup_dir/${backup_name}-database.sql" "$backup_dir/${backup_name}.env"
    
    echo -e "${GREEN}✅ Backup created: ${backup_dir}/${backup_name}.tar.gz${NC}"
}

cmd_restore() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local backup_file=$1
    if [ -z "$backup_file" ]; then
        echo -e "${RED}Error: Backup file required${NC}"
        echo "Usage: synap restore <backup-file.tar.gz>"
        exit 1
    fi
    
    if [ ! -f "$backup_file" ]; then
        echo -e "${RED}Error: Backup file not found: $backup_file${NC}"
        exit 1
    fi
    
    echo -e "${YELLOW}⚠️  WARNING: This will overwrite current data!${NC}"
    read -p "Continue? (yes/no): " CONFIRM
    if [ "$CONFIRM" != "yes" ]; then
        echo "Restore cancelled"
        exit 0
    fi
    
    local temp_dir=$(mktemp -d)
    tar -xzf "$backup_file" -C "$temp_dir"
    
    docker compose stop backend
    cat "$temp_dir"/*-database.sql | docker compose exec -T postgres psql -U synap synap
    cp "$temp_dir"/*.env .env
    rm -rf "$temp_dir"
    
    docker compose up -d
    
    echo -e "${GREEN}✅ Restore complete!${NC}"
}

cmd_config() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local action=${1:-list}
    
    case "$action" in
        list)
            if [ -f .env ]; then
                echo -e "${BLUE}📝 Current Configuration:${NC}"
                grep -v "^#" .env | grep -v "^$" | while IFS='=' read -r k v; do
                    if [[ "$k" == *"SECRET"* ]] || [[ "$k" == *"KEY"* ]] || [[ "$k" == *"PASSWORD"* ]]; then
                        echo "$k=********"
                    else
                        echo "$k=$v"
                    fi
                done
            fi
            ;;
        edit)
            ${EDITOR:-nano} .env
            ;;
        get)
            local key=$2
            if [ -z "$key" ]; then
                echo "Usage: synap config get <key>"
                exit 1
            fi
            grep "^${key}=" .env | cut -d'=' -f2-
            ;;
        set)
            local key=$2
            local value=$3
            if [ -z "$key" ] || [ -z "$value" ]; then
                echo "Usage: synap config set <key> <value>"
                exit 1
            fi
            if grep -q "^${key}=" .env; then
                sed -i.bak "s|^${key}=.*|${key}=${value}|" .env
            else
                echo "${key}=${value}" >> .env
            fi
            echo -e "${GREEN}✓ Updated ${key}${NC}"
            ;;
        *)
            echo "Usage: synap config [list|edit|get|set]"
            ;;
    esac
}

cmd_help() {
    cat << EOF
${BLUE}Synap - Unified CLI${NC}

${YELLOW}Installation:${NC}
  synap install [options]        Install Synap

${YELLOW}Management:${NC}
  synap health                   Check system health
  synap logs [service]           View logs
  synap update [options]         Update to latest or specific version
  synap restart [service]        Restart services
  synap start                    Start all services
  synap stop                     Stop all services
  synap backup [name]            Create backup
  synap restore <file>            Restore from backup
  synap config [action]          Manage configuration

${YELLOW}Examples:${NC}
  # Install (clone repo, use image)
  synap install --clone --from-image latest --domain example.com --email me@example.com

  # Install (use existing repo, build from source)
  synap install --no-clone --from-source --domain localhost

  # Update
  synap update
  synap update --build
  synap update v1.2.3

  # Management
  synap health
  synap logs backend
  synap config list

${YELLOW}For detailed help:${NC}
  synap install --help
  synap update --help

EOF
}

# ============================================================================
# MAIN COMMAND ROUTER
# ============================================================================

case "${1:-help}" in
    install)
        shift
        cmd_install "$@"
        ;;
    health)
        cmd_health
        ;;
    logs)
        cmd_logs "${2:-}"
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    restart)
        cmd_restart "${2:-}"
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    backup)
        cmd_backup "${2:-}"
        ;;
    restore)
        cmd_restore "${2:-}"
        ;;
    config)
        shift
        cmd_config "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo ""
        cmd_help
        exit 1
        ;;
esac

        echo ""
        local i=1
        for svc in "${services[@]}"; do
            echo -e "  ${GREEN}[$i]${NC} $svc"
            ((i++))
        done
        echo ""
        echo -e "  ${BLUE}[a]${NC} All services"
        echo -e "  ${BLUE}[q]${NC} Quit"
        echo ""
        read -p "Select service (number/a/q): " choice
        
        case "$choice" in
            [0-9]*)
                local idx=$((choice - 1))
                if [ $idx -ge 0 ] && [ $idx -lt ${#services[@]} ]; then
                    service="${services[$idx]}"
                else
                    echo -e "${RED}Invalid selection${NC}"
                    exit 1
                fi
                ;;
            a|A)
                service=""
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    fi
    
    local build_cmd="docker compose build"
    if [ "$no_cache" = true ]; then
        build_cmd="$build_cmd --no-cache"
    fi
    
    if [ -z "$service" ]; then
        echo -e "${BLUE}🔨 Rebuilding all services...${NC}"
        eval "$build_cmd"
        echo -e "${BLUE}🔄 Restarting services...${NC}"
        docker compose up -d
    else
        echo -e "${BLUE}🔨 Rebuilding $service...${NC}"
        eval "$build_cmd $service"
        echo -e "${BLUE}🔄 Restarting $service...${NC}"
        docker compose up -d "$service"
    fi
    
    echo -e "${GREEN}✅ Rebuild complete!${NC}"
}

cmd_errors() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-}
    local tail_lines=${2:-100}
    
    echo -e "${BLUE}🔍 Searching for errors in logs...${NC}"
    echo ""
    
    if [ -z "$service" ]; then
        # Search all services
        local services=($(docker compose ps --services 2>/dev/null))
        for svc in "${services[@]}"; do
            local status=$(docker compose ps "$svc" --format json 2>/dev/null | grep -o '"State":"[^"]*"' | cut -d'"' -f4 || echo "unknown")
            if [ "$status" = "running" ]; then
                echo -e "${YELLOW}━━━ $svc ━━━${NC}"
                docker compose logs --tail="$tail_lines" "$svc" 2>&1 | grep -i "error\|fatal\|panic\|exception\|failed" | head -20 || echo "  No errors found"
                echo ""
            fi
        done
    else
        echo -e "${YELLOW}━━━ $service ━━━${NC}"
        docker compose logs --tail="$tail_lines" "$service" 2>&1 | grep -i "error\|fatal\|panic\|exception\|failed" | head -50 || echo "  No errors found"
    fi
}

cmd_diagnose() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    echo -e "${BLUE}🔍 Synap Diagnostics${NC}"
    echo ""
    
    # Check Docker
    echo -e "${BLUE}1. Docker Status${NC}"
    if command -v docker &> /dev/null; then
        echo -e "${GREEN}✓ Docker installed${NC}"
        docker --version
    else
        echo -e "${RED}❌ Docker not found${NC}"
    fi
    echo ""
    
    # Check services
    echo -e "${BLUE}2. Services Status${NC}"
    docker compose ps
    echo ""
    
    # Check for errors
    echo -e "${BLUE}3. Recent Errors${NC}"
    cmd_errors "" 50
    echo ""
    
    # Check disk space
    echo -e "${BLUE}4. Disk Space${NC}"
    df -h . | tail -1
    echo ""
    
    # Check Docker resources
    echo -e "${BLUE}5. Docker Resources${NC}"
    docker system df
    echo ""
    
    # Check health endpoints
    echo -e "${BLUE}6. Health Checks${NC}"
    if docker compose ps backend | grep -q "Up"; then
        if curl -sf http://localhost:4000/health > /dev/null 2>&1; then
            echo -e "${GREEN}✓ Backend health endpoint responding${NC}"
        else
            echo -e "${RED}❌ Backend health endpoint not responding${NC}"
        fi
    fi
    echo ""
}

cmd_clean() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local what=${1:-}
    
    if [ -z "$what" ]; then
        echo -e "${BLUE}🧹 Clean Docker Resources${NC}"
        echo ""
        echo "  ${GREEN}[1]${NC} Remove stopped containers"
        echo "  ${GREEN}[2]${NC} Remove unused images"
        echo "  ${GREEN}[3]${NC} Remove unused volumes"
        echo "  ${GREEN}[4]${NC} Remove unused networks"
        echo "  ${GREEN}[5]${NC} Prune everything (containers, images, volumes, networks)"
        echo "  ${GREEN}[6]${NC} Remove build cache"
        echo "  ${GREEN}[q]${NC} Quit"
        echo ""
        read -p "Select option (number/q): " choice
        
        case "$choice" in
            1)
                docker container prune -f
                ;;
            2)
                docker image prune -f
                ;;
            3)
                docker volume prune -f
                ;;
            4)
                docker network prune -f
                ;;
            5)
                echo -e "${YELLOW}⚠️  This will remove all unused Docker resources${NC}"
                read -p "Continue? (y/N): " CONFIRM
                if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
                    docker system prune -a -f --volumes
                fi
                ;;
            6)
                docker builder prune -f
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    else
        case "$what" in
            containers)
                docker container prune -f
                ;;
            images)
                docker image prune -f
                ;;
            volumes)
                docker volume prune -f
                ;;
            networks)
                docker network prune -f
                ;;
            all)
                echo -e "${YELLOW}⚠️  This will remove all unused Docker resources${NC}"
                read -p "Continue? (y/N): " CONFIRM
                if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
                    docker system prune -a -f --volumes
                fi
                ;;
            cache)
                docker builder prune -f
                ;;
            *)
                echo "Usage: synap clean [containers|images|volumes|networks|all|cache]"
                exit 1
                ;;
        esac
    fi
    
    echo -e "${GREEN}✅ Cleanup complete!${NC}"
}

cmd_shell() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local service=${1:-backend}
    local shell=${2:-sh}
    
    echo -e "${BLUE}🐚 Opening shell in $service (using $shell)...${NC}"
    docker compose exec "$service" "$shell"
}

cmd_exec() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    local service=$1
    shift

    if [ -z "$service" ] || [ $# -eq 0 ]; then
        echo "Usage: synap exec <service> <command> [args...]"
        echo "Example: synap exec backend node --version"
        exit 1
    fi

    docker compose exec "$service" "$@"

# ============================================================================
# TUNNEL COMMAND
# Self-hosted operators expose their pod via Cloudflare Tunnel or Pangolin.
# This is the "bring your own token" path — the operator pastes a token and
# we wire it into .env + activate the matching compose profile.
# CP-managed tunnels follow a different flow (pod-agent /configure).
# ============================================================================

# Resolve a tunnel provider's env var name. Keep this the single source of truth.
_tunnel_env_var_for() {
    case "$1" in
        cloudflare) echo "CLOUDFLARED_TUNNEL_TOKEN" ;;
        pangolin)   echo "PANGOLIN_NEWT_TOKEN" ;;
        *)          echo "" ;;
    esac
}

_tunnel_profile_for() {
    case "$1" in
        cloudflare) echo "cloudflare-tunnel" ;;
        pangolin)   echo "pangolin-tunnel" ;;
        *)          echo "" ;;
    esac
}

_tunnel_service_for() {
    case "$1" in
        cloudflare) echo "cloudflared" ;;
        pangolin)   echo "pangolin-tunnel" ;;
        *)          echo "" ;;
    esac
}

# Read a token from --token or --token-file, with basic sanity checks.
# Sets the global TUNNEL_TOKEN_VALUE on success, empties it on failure.
_tunnel_read_token() {
    local token_arg="$1"
    local token_file="$2"
    TUNNEL_TOKEN_VALUE=""

    if [ -n "$token_arg" ] && [ -n "$token_file" ]; then
        echo -e "${RED}Error: pass either --token or --token-file, not both${NC}"
        return 1
    fi
    if [ -n "$token_file" ]; then
        if [ ! -f "$token_file" ]; then
            echo -e "${RED}Error: token file not found: ${token_file}${NC}"
            return 1
        fi
        # Strip leading/trailing whitespace + any stray newline
        TUNNEL_TOKEN_VALUE=$(tr -d '\r\n' < "$token_file" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    else
        TUNNEL_TOKEN_VALUE="$token_arg"
    fi
    if [ -z "$TUNNEL_TOKEN_VALUE" ]; then
        echo -e "${RED}Error: tunnel token is empty${NC}"
        return 1
    fi
    return 0
}

# Comment out a key in .env (preserve for easy re-enable); idempotent.
_comment_env_value() {
    local key="$1"
    local reason="${2:-disabled}"
    if [ ! -f ".env" ]; then
        return 0
    fi
    if grep -q "^${key}=" .env; then
        sed -i.bak "s|^${key}=\(.*\)$|# ${key}=\1  # ${reason} on $(date -u +%Y-%m-%d)|" .env
    fi
}

# Remove a key entirely from .env; idempotent.
_remove_env_value() {
    local key="$1"
    if [ ! -f ".env" ]; then
        return 0
    fi
    # Remove both active and already-commented variants, and our disabled marker.
    sed -i.bak "/^${key}=/d" .env
    sed -i.bak "/^# ${key}=.*disabled on /d" .env
}

# Internal helper: wire up a tunnel provider (write token, start compose profile,
# tail logs, print handoff). Shared by `tunnel enable` and install --tunnel.
_tunnel_enable_provider() {
    local provider="$1"
    local token="$2"

    local env_var
    env_var=$(_tunnel_env_var_for "$provider")
    local profile
    profile=$(_tunnel_profile_for "$provider")
    local service
    service=$(_tunnel_service_for "$provider")

    if [ -z "$env_var" ] || [ -z "$profile" ] || [ -z "$service" ]; then
        echo -e "${RED}Error: unknown tunnel provider: ${provider}${NC}"
        echo "Known providers: cloudflare, pangolin"
        return 1
    fi

    # .env must exist (install writes it); if missing, the pod isn't set up.
    if [ ! -f ".env" ]; then
        echo -e "${RED}Error: .env not found in ${PWD}. Run 'synap install' first.${NC}"
        return 1
    fi

    # Compose file must exist.
    if [ ! -f "docker-compose.yml" ]; then
        echo -e "${RED}Error: docker-compose.yml not found in ${PWD}${NC}"
        return 1
    fi

    # Pod must be running — tunnel alone without a backend is pointless.
    if ! docker compose ps --services --filter "status=running" 2>/dev/null | grep -q '^backend$'; then
        echo -e "${RED}Error: backend service is not running.${NC}"
        echo "  Start it first: ${GREEN}./synap start${NC}"
        return 1
    fi

    echo -e "${BLUE}🔐 Writing ${env_var} to .env...${NC}"
    update_env_value "$env_var" "$token"

    echo -e "${BLUE}🚀 Starting ${provider} tunnel (compose profile: ${profile})...${NC}"
    if ! docker compose --profile "$profile" up -d "$service"; then
        echo -e "${RED}Error: failed to start ${service}${NC}"
        return 1
    fi

    # Give cloudflared/newt a few seconds to register before tailing logs.
    echo -e "${BLUE}⏳ Waiting for tunnel to connect (5s)...${NC}"
    sleep 5
    echo ""
    echo -e "${YELLOW}Recent ${service} logs:${NC}"
    docker compose logs --tail 20 "$service" 2>/dev/null || true
    echo ""

    case "$provider" in
        cloudflare)
            echo -e "${GREEN}✅ Cloudflare tunnel active.${NC}"
            echo ""
            echo "Next: in your Cloudflare dashboard, configure the tunnel's public hostname"
            echo "to route traffic to http://backend:4000 (or the service you want to expose)."
            echo ""
            echo "Check status anytime: ./synap tunnel status"
            ;;
        pangolin)
            echo -e "${GREEN}✅ Pangolin tunnel container started.${NC}"
            echo ""
            echo -e "${YELLOW}Note:${NC} the pangolin-tunnel compose profile is a placeholder in this"
            echo "repo. Replace the image/command in docker-compose.yml with your actual"
            echo "newt runtime before relying on it for exposure. Env var: ${env_var}."
            echo ""
            echo "Check status anytime: ./synap tunnel status"
            ;;
    esac
    return 0
}

cmd_tunnel() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory (set SYNAP_DEPLOY_DIR or run from repo/deploy)${NC}"
        exit 1
    fi
    cd "$deploy_dir"

    local action="${1:-help}"
    shift || true

    case "$action" in
        enable)
            # Allow `synap tunnel enable --help` without forcing a provider.
            case "${1:-}" in
                --help|-h|"")
                    if [ -z "${1:-}" ]; then
                        echo -e "${RED}Usage: synap tunnel enable <cloudflare|pangolin> --token <TOKEN>${NC}"
                        echo "   or: synap tunnel enable <cloudflare|pangolin> --token-file <PATH>"
                        echo "Run 'synap tunnel enable --help' for details"
                        exit 1
                    fi
                    cat << EOF
${BLUE}synap tunnel enable${NC} — wire a tunnel provider into this pod

${YELLOW}Usage:${NC}
  synap tunnel enable cloudflare --token <TOKEN>
  synap tunnel enable cloudflare --token-file <PATH>
  synap tunnel enable pangolin   --token <TOKEN>
  synap tunnel enable pangolin   --token-file <PATH>

${YELLOW}What it does:${NC}
  1. Writes the provider's token to deploy/.env
  2. Starts the matching docker compose profile
  3. Tails the tunnel container logs so you can see the handshake
  4. Prints next-step guidance (dashboard config)

${YELLOW}Env vars written:${NC}
  cloudflare → CLOUDFLARED_TUNNEL_TOKEN
  pangolin   → PANGOLIN_NEWT_TOKEN

${YELLOW}Tip:${NC} prefer --token-file for long tokens — avoids shell history leaks.
EOF
                    exit 0
                    ;;
            esac

            local provider="$1"
            shift

            local token_arg=""
            local token_file=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --token)      token_arg="$2"; shift 2 ;;
                    --token-file) token_file="$2"; shift 2 ;;
                    --help|-h)
                        cat << EOF
${BLUE}synap tunnel enable${NC} — wire a tunnel provider into this pod

${YELLOW}Usage:${NC}
  synap tunnel enable cloudflare --token <TOKEN>
  synap tunnel enable cloudflare --token-file <PATH>
  synap tunnel enable pangolin   --token <TOKEN>
  synap tunnel enable pangolin   --token-file <PATH>

${YELLOW}What it does:${NC}
  1. Writes the provider's token to deploy/.env
  2. Starts the matching docker compose profile
  3. Tails the tunnel container logs so you can see the handshake
  4. Prints next-step guidance (dashboard config)

${YELLOW}Env vars written:${NC}
  cloudflare → CLOUDFLARED_TUNNEL_TOKEN
  pangolin   → PANGOLIN_NEWT_TOKEN

${YELLOW}Tip:${NC} prefer --token-file for long tokens — avoids shell history leaks.
EOF
                        exit 0
                        ;;
                    *)
                        echo -e "${RED}Unknown option: $1${NC}"
                        echo "Run 'synap tunnel enable --help'"
                        exit 1
                        ;;
                esac
            done

            if ! _tunnel_read_token "$token_arg" "$token_file"; then
                exit 1
            fi

            case "$provider" in
                cloudflare|pangolin) ;;
                *)
                    echo -e "${RED}Unknown tunnel provider: ${provider}${NC}"
                    echo "Known providers: cloudflare, pangolin"
                    exit 1
                    ;;
            esac

            _tunnel_enable_provider "$provider" "$TUNNEL_TOKEN_VALUE" || exit 1
            ;;

        disable)
            local provider=""
            local clear_token=false
            while [ $# -gt 0 ]; do
                case "$1" in
                    --provider)    provider="$2"; shift 2 ;;
                    --clear-token) clear_token=true; shift ;;
                    --help|-h)
                        cat << EOF
${BLUE}synap tunnel disable${NC} — stop tunnel containers

${YELLOW}Usage:${NC}
  synap tunnel disable                       Disable all tunnels
  synap tunnel disable --provider cloudflare Disable just Cloudflare
  synap tunnel disable --provider pangolin   Disable just Pangolin

${YELLOW}Options:${NC}
  --clear-token    Remove the token from .env (default: comment it out so re-enable
                   is one command)
EOF
                        exit 0
                        ;;
                    *)
                        echo -e "${RED}Unknown option: $1${NC}"
                        echo "Run 'synap tunnel disable --help'"
                        exit 1
                        ;;
                esac
            done

            if [ ! -f "docker-compose.yml" ]; then
                echo -e "${RED}Error: docker-compose.yml not found in ${PWD}${NC}"
                exit 1
            fi

            local providers_to_disable=""
            if [ -z "$provider" ]; then
                providers_to_disable="cloudflare pangolin"
            else
                case "$provider" in
                    cloudflare|pangolin) providers_to_disable="$provider" ;;
                    *)
                        echo -e "${RED}Unknown provider: ${provider}${NC}"
                        echo "Known: cloudflare, pangolin"
                        exit 1
                        ;;
                esac
            fi

            for p in $providers_to_disable; do
                local svc env_var
                svc=$(_tunnel_service_for "$p")
                env_var=$(_tunnel_env_var_for "$p")
                echo -e "${BLUE}🛑 Stopping ${p} tunnel (${svc})...${NC}"
                docker compose stop "$svc" 2>/dev/null || true
                docker compose rm -f "$svc" 2>/dev/null || true
                if [ "$clear_token" = "true" ]; then
                    _remove_env_value "$env_var"
                    echo -e "${YELLOW}  Removed ${env_var} from .env${NC}"
                else
                    _comment_env_value "$env_var" "disabled"
                fi
            done

            echo ""
            echo -e "${GREEN}✅ Tunnel disabled.${NC}"
            echo "Re-enable anytime: ${GREEN}./synap tunnel enable <cloudflare|pangolin> --token <TOKEN>${NC}"
            ;;

        status)
            if [ ! -f "docker-compose.yml" ]; then
                echo -e "${RED}Error: docker-compose.yml not found in ${PWD}${NC}"
                exit 1
            fi

            local running
            running=$(docker compose ps --services --filter "status=running" 2>/dev/null || true)

            local any_active=false
            for p in cloudflare pangolin; do
                local svc
                svc=$(_tunnel_service_for "$p")
                if echo "$running" | grep -q "^${svc}$"; then
                    any_active=true
                    echo -e "${GREEN}✅ ${p} tunnel active (${svc})${NC}"
                    echo -e "${YELLOW}  Recent logs:${NC}"
                    docker compose logs --tail 5 "$svc" 2>/dev/null || true
                    echo ""
                fi
            done

            if [ "$any_active" = "false" ]; then
                echo "No tunnel active. Your pod is exposed via direct DNS (or not exposed — check \`./synap health\`)."
            fi
            ;;

        help|--help|-h|"")
            cat << EOF
${BLUE}Synap Tunnel${NC} — Expose your pod via Cloudflare or Pangolin

${YELLOW}Usage:${NC}
  synap tunnel enable <provider> --token <TOKEN>         Enable a tunnel
  synap tunnel enable <provider> --token-file <PATH>     Enable from a file
  synap tunnel disable [--provider <p>] [--clear-token]  Stop tunnel(s)
  synap tunnel status                                    Show active tunnel(s)

${YELLOW}Providers:${NC}
  cloudflare   Cloudflare Tunnel (uses CLOUDFLARED_TUNNEL_TOKEN)
  pangolin     Pangolin/newt tunnel (uses PANGOLIN_NEWT_TOKEN)

${YELLOW}Examples:${NC}
  synap tunnel enable cloudflare --token eyJhIjoiX...
  synap tunnel enable cloudflare --token-file ~/secrets/cf-tunnel.token
  synap tunnel status
  synap tunnel disable --provider cloudflare
  synap tunnel disable --clear-token

${YELLOW}Note:${NC} this is the ${GREEN}self-hosted${NC} path — you bring your own token from the
provider's dashboard. CP-managed tunnels follow a different flow.

${YELLOW}At install time:${NC}
  synap install --domain example.com --tunnel cloudflare --tunnel-token <TOKEN>
  synap install --domain example.com --tunnel cloudflare --tunnel-token-file <PATH>
EOF
            ;;

        *)
            echo -e "${RED}Unknown tunnel action: ${action}${NC}"
            echo "Run 'synap tunnel help'"
            exit 1
            ;;
    esac
}

# ============================================================================
# SERVICES COMMAND
# Manages external agent service provisioning (OpenClaw, ZeroClaw, etc.)
# ============================================================================

cmd_services() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    local subcommand="${1:-help}"
    shift || true

    # Resolve workspace context for all subcommands that need it
    local workspace_id=""
    local admin_email=""
    if [ -f ".env" ]; then
        workspace_id=$(grep "^WORKSPACE_ID=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' || true)
        admin_email=$(grep "^ADMIN_EMAIL=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' || true)
    fi

    case "$subcommand" in
        list)
            echo -e "${BLUE}🤖 Listing provisioned agent services...${NC}"
            docker compose exec -T backend \
                sh -c "ACTION=list node dist/scripts/provision-agent.js" 2>/dev/null || {
                    echo -e "${YELLOW}Tip: ensure the backend container is running (synap start)${NC}"
                }
            ;;

        add)
            local service_type="${1:-}"
            if [ -z "$service_type" ]; then
                echo -e "${RED}Usage: synap services add <type>${NC}"
                echo "Known types: openclaw, zeroclaw"
                exit 1
            fi

            echo -e "${BLUE}🤖 Provisioning ${service_type} agent...${NC}"
            docker compose exec -T backend \
                sh -c "SERVICE_TYPE=${service_type} WORKSPACE_ID=${workspace_id} ADMIN_EMAIL=${admin_email} node dist/scripts/provision-agent.js"
            ;;

        remove)
            local assume_yes=false
            while [ $# -gt 0 ]; do
                case "$1" in
                    --yes|-y) assume_yes=true; shift ;;
                    *) break ;;
                esac
            done
            local service_type="${1:-}"
            if [ -z "$service_type" ]; then
                echo -e "${RED}Usage: synap services remove [--yes|-y] <type>${NC}"
                exit 1
            fi

            echo -e "${YELLOW}⚠️  This will revoke all API keys and delete the ${service_type} agent user.${NC}"
            if [ "$assume_yes" != "true" ] && ! synap_assume_yes; then
                read -p "Continue? (y/N): " confirm
                if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
                    echo "Cancelled."
                    exit 0
                fi
            fi

            echo -e "${BLUE}🗑️  Deprovisioning ${service_type} agent...${NC}"
            docker compose exec -T backend \
                sh -c "SERVICE_TYPE=${service_type} WORKSPACE_ID=${workspace_id} ADMIN_EMAIL=${admin_email} ACTION=remove node dist/scripts/provision-agent.js"
            ;;

        status)
            local service_type="${1:-}"
            if [ -z "$service_type" ]; then
                echo -e "${RED}Usage: synap services status <type>${NC}"
                exit 1
            fi

            echo -e "${BLUE}🔍 Checking ${service_type} status...${NC}"
            docker compose exec -T backend \
                sh -c "SERVICE_TYPE=${service_type} WORKSPACE_ID=${workspace_id} ADMIN_EMAIL=${admin_email} ACTION=status node dist/scripts/provision-agent.js"
            ;;

        rotate)
            local assume_yes=false
            while [ $# -gt 0 ]; do
                case "$1" in
                    --yes|-y) assume_yes=true; shift ;;
                    *) break ;;
                esac
            done
            local service_type="${1:-}"
            if [ -z "$service_type" ]; then
                echo -e "${RED}Usage: synap services rotate [--yes|-y] <type>${NC}"
                exit 1
            fi

            echo -e "${YELLOW}⚠️  This will revoke the existing API key and issue a new one.${NC}"
            if [ "$assume_yes" != "true" ] && ! synap_assume_yes; then
                read -p "Continue? (y/N): " confirm
                if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
                    echo "Cancelled."
                    exit 0
                fi
            fi

            echo -e "${BLUE}🔑 Rotating ${service_type} API key...${NC}"
            docker compose exec -T backend \
                sh -c "SERVICE_TYPE=${service_type} WORKSPACE_ID=${workspace_id} ADMIN_EMAIL=${admin_email} ACTION=rotate node dist/scripts/provision-agent.js"
            ;;

        help|--help|-h|"")
            cat << EOF
${BLUE}Synap Services${NC} — Manage external agent service provisioning

${YELLOW}Note:${NC} ${GREEN}synap services add openclaw${NC} needs at least one workspace in Postgres.
If you used ${GREEN}ADMIN_BOOTSTRAP_MODE=token${NC}, finish ${GREEN}/admin/bootstrap${NC} first (install defers OpenClaw in that mode).

${YELLOW}Usage:${NC}
  synap services list              List all provisioned agent users
  synap services add <type>        Provision a new agent service
  synap services remove [--yes|-y] <type>   Deprovision (revoke keys + delete agent user)
  synap services status <type>     Check provisioned + registered status
  synap services rotate [--yes|-y] <type>   Rotate the Hub Protocol API key

  Non-interactive confirm: ${GREEN}SYNAP_ASSUME_YES=1${NC} or ${GREEN}--yes${NC} / ${GREEN}-y${NC} before <type>

${YELLOW}Known service types:${NC}
  openclaw    World-interface agent (shell, browser, filesystem, messaging)
  zeroclaw    LLM inference agent

${YELLOW}Examples:${NC}
  synap services add openclaw
  synap services status openclaw
  synap services rotate openclaw
  synap services remove openclaw
EOF
            ;;

        *)
            echo -e "${RED}Unknown services subcommand: $subcommand${NC}"
            echo "Run 'synap services help' for usage"
            exit 1
            ;;
    esac
}

cmd_users() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    cd "$deploy_dir"

    local subcommand="${1:-help}"
    shift || true

    case "$subcommand" in
        list)
            local limit="${1:-200}"
            echo -e "${BLUE}👥 Listing users (limit=${limit})...${NC}"
            docker compose exec -T backend \
                sh -c "ACTION=list LIMIT='${limit}' node dist/scripts/user-admin-cli.js"
            ;;

        add-admin)
            local email="${1:-}"
            local password="${2:-}"
            local name="${3:-}"
            local create_workspace="true"
            local arg4="${4:-}"
            if [ "$name" = "--no-workspace" ]; then
                create_workspace="false"
                name=""
            elif [ "$arg4" = "--no-workspace" ]; then
                create_workspace="false"
            fi
            if [ -z "$email" ] || [ -z "$password" ]; then
                echo -e "${RED}Usage: synap users add-admin <email> <password> [name] [--no-workspace]${NC}"
                exit 1
            fi
            echo -e "${BLUE}👤 Creating admin user ${email}...${NC}"
            docker compose exec -T backend \
                sh -c "ACTION=add-admin CREATE_WORKSPACE='${create_workspace}' ADMIN_EMAIL='${email}' ADMIN_PASSWORD='${password}' ADMIN_NAME='${name}' node dist/scripts/user-admin-cli.js"
            ;;

        reset-password|passwd)
            local email="${1:-}"
            local password="${2:-}"
            if [ -z "$email" ] || [ -z "$password" ]; then
                echo -e "${RED}Usage: synap users reset-password <email> <new-password>${NC}"
                exit 1
            fi
            echo -e "${BLUE}🔐 Resetting password for ${email}...${NC}"
            docker compose exec -T backend \
                sh -c "ACTION=reset-password USER_EMAIL='${email}' USER_PASSWORD='${password}' node dist/scripts/user-admin-cli.js"
            ;;

        delete)
            local email="${1:-}"
            local assume_yes="false"
            if [ "$email" = "--yes" ] || [ "$email" = "-y" ]; then
                assume_yes="true"
                email="${2:-}"
            fi
            if [ -z "$email" ]; then
                echo -e "${RED}Usage: synap users delete [--yes|-y] <email>${NC}"
                exit 1
            fi
            if [ "$assume_yes" != "true" ] && ! synap_assume_yes; then
                echo -e "${YELLOW}⚠️  This deletes the user identity for ${email}.${NC}"
                read -p "Continue? (y/N): " confirm
                if [ "$confirm" != "y" ] && [ "$confirm" != "Y" ]; then
                    echo "Cancelled."
                    exit 0
                fi
            fi
            echo -e "${BLUE}🗑️  Deleting user ${email}...${NC}"
            docker compose exec -T backend \
                sh -c "ACTION=delete USER_EMAIL='${email}' node dist/scripts/user-admin-cli.js"
            ;;

        help|--help|-h|"")
            cat << EOF
${BLUE}Synap Users${NC} — Manage pod users and passwords

${YELLOW}Usage:${NC}
  synap users list [limit]
  synap users add-admin <email> <password> [name] [--no-workspace]
  synap users reset-password <email> <new-password>
  synap users delete [--yes|-y] <email>

${YELLOW}Examples:${NC}
  synap users list
  synap users add-admin admin@example.com 'StrongPassw0rd!'
  synap users add-admin admin@example.com 'StrongPassw0rd!' --no-workspace
  synap users reset-password relay@example.com 'NewStrongPassw0rd!'
  synap users delete --yes relay@example.com
EOF
            ;;

        *)
            echo -e "${RED}Unknown users subcommand: $subcommand${NC}"
            echo "Run 'synap users help' for usage"
            exit 1
            ;;
    esac
}

cmd_reset() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    local mode="data"
    local assume_yes="false"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full|-f)
                mode="full"
                ;;
            --yes|-y)
                assume_yes="true"
                ;;
            --help|-h)
                echo "Usage: synap reset [--full|-f] [--yes|-y]"
                echo "  default: wipe workspace/application data only (keeps infra)"
                echo "  --full : wipe stack state + stale docker resources and optionally rerun install"
                return 0
                ;;
            *)
                echo -e "${RED}Unknown option for reset: $1${NC}"
                echo "Usage: synap reset [--full|-f] [--yes|-y]"
                return 1
                ;;
        esac
        shift
    done

    if [ "$mode" = "full" ]; then
        echo -e "${RED}⚠️  WARNING: FULL RESET will destroy this installation state.${NC}"
        echo ""
        echo "What will be deleted:"
        echo "  - All application data (Postgres + MinIO bucket)"
        echo "  - All project containers, networks, and compose volumes"
        echo "  - Stale Docker resources (system prune --volumes)"
        echo ""
        echo "What will be kept:"
        echo "  - deploy/.env (unless you manually remove it)"
        echo "  - Repository files"
        echo ""
        if [ "$assume_yes" != "true" ] && ! synap_assume_yes; then
            read -p "Type 'recreate' to confirm full reset: " confirm
            if [ "$confirm" != "recreate" ]; then
                echo "Cancelled."
                exit 0
            fi
        fi

        echo ""
        echo -e "${BLUE}🧨 Full cleanup in progress...${NC}"
        echo "  Stopping and removing compose resources..."
        docker compose down --volumes --remove-orphans 2>/dev/null || true

        echo "  Pruning stale Docker resources..."
        docker system prune -a -f --volumes 2>/dev/null || true

        echo ""
        echo -e "${GREEN}✅ Full cleanup complete.${NC}"
        echo ""
        if [ "$assume_yes" = "true" ] || synap_assume_yes; then
            echo -e "${BLUE}🚀 Re-running install in non-interactive mode...${NC}"
            cmd_install --non-interactive
            return $?
        fi

        read -p "Run fresh install now? (y/N): " rerun
        if [ "$rerun" = "y" ] || [ "$rerun" = "Y" ]; then
            cmd_install
            return $?
        fi
        echo "Run 'synap install' when ready."
        return 0
    fi

    echo -e "${RED}⚠️  WARNING: This will permanently delete all workspace data!${NC}"
    echo ""
    echo "What will be deleted:"
    echo "  - All workspaces, users, and workspace members"
    echo "  - All documents, channels, messages, entities, relations"
    echo "  - All API keys, agent users, intelligence services"
    echo "  - All MinIO stored files (documents, attachments)"
    echo ""
    echo "What will be KEPT:"
    echo "  - Kratos identities (login accounts remain intact)"
    echo "  - Database schema and migrations"
    echo "  - Configuration (.env)"
    echo ""
    if [ "$assume_yes" != "true" ] && ! synap_assume_yes; then
        read -p "Type 'yes' to confirm data reset: " confirm
        if [ "$confirm" != "yes" ]; then
            echo "Cancelled."
            exit 0
        fi
    fi

    echo ""
    echo -e "${BLUE}🗑️  Resetting workspace data...${NC}"

    # 1. Truncate all workspace data from PostgreSQL
    echo "  Clearing PostgreSQL workspace data..."
    docker compose exec -T postgres psql -U synap -d synap -c "
        TRUNCATE TABLE
            workspace_members, users, workspaces,
            api_keys, events,
            documents, document_versions, document_sessions,
            channels, channel_context_items, messages, message_links,
            entities, entity_relationships, entity_tags, entity_enrichments,
            entity_property_index, entity_templates, entity_vectors,
            knowledge_facts,
            profiles, profile_properties, profile_relations, profile_workspace_access,
            proposals, reasoning_traces,
            relations, relation_defs, property_defs,
            resource_shares, roles, skills, tags, views,
            inbox_items, user_entity_state, user_preferences,
            agents, ai_suggestions, command_runs,
            intelligence_commands, intelligence_services,
            background_tasks, admin_invitations,
            webhook_deliveries, webhook_subscriptions, workspace_invites,
            provisioning_tokens,
            secrets, secret_tags, secret_shares, secret_vault_keys, secret_audit_log
        CASCADE;
        DELETE FROM system_settings WHERE key = 'event_processor_watermark';
        SELECT 'PostgreSQL cleared' as status;
    " 2>&1 | grep -v "^$" | sed 's/^/    /'

    # 2. Clear MinIO bucket
    echo "  Clearing MinIO storage..."
    local minio_key=$(grep "^MINIO_ACCESS_KEY=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "minioadmin")
    local minio_secret=$(grep "^MINIO_SECRET_KEY=" .env 2>/dev/null | cut -d'=' -f2- | tr -d '"' || echo "minioadmin")
    docker compose exec -T minio sh -c "
        mc alias set local http://localhost:9000 ${minio_key} ${minio_secret} 2>/dev/null
        mc rm --recursive --force local/synap-storage/ 2>/dev/null || true
        echo 'MinIO cleared'
    " 2>&1 | grep -v "^$" | sed 's/^/    /'

    # 3. Restart backend to re-initialize
    echo "  Restarting backend..."
    docker start synap-backend-backend-1 2>/dev/null || docker compose restart backend 2>/dev/null || true
    sleep 3

    echo ""
    echo -e "${GREEN}✅ Data reset complete!${NC}"
    echo ""
    echo "Next steps:"
    echo "  1. Log in via the UI — a new workspace will be created automatically"
    echo "  2. Run 'synap services add <type>' to reprovision agent services"
}

cmd_help() {
    cat << EOF
${BLUE}Synap - Unified CLI${NC}

${YELLOW}Installation:${NC}
  synap install [options]        Install Synap

${YELLOW}Management:${NC}
  synap health                   Canonical local health check (docker + services)
  synap connectivity             DNS + /health probe for DOMAIN / PUBLIC_URL (domain debugging)
  synap ps                       List all services and their status (status is an alias)
  synap logs [service] [options] View logs (interactive if no service)
  synap errors [service] [lines] Search for errors in logs
  synap diagnose                 Run comprehensive diagnostics
  synap update [options]         Update to latest or specific version
  synap restart [service]        Restart services (interactive if no service)
  synap rebuild [service]        Rebuild services (interactive if no service)
  synap start [service]          Start services (all or specific)
  synap stop [service]           Stop services (interactive if no service)
  synap backup [name]            Create backup
  synap restore <file>            Restore from backup
  synap config [action]          Manage configuration
  synap clean [type]             Clean Docker resources (interactive if no type)
  synap shell [service] [shell]   Open shell in container (default: backend, sh)
  synap exec <service> <cmd>     Execute command in container
  synap services <sub> [type]    Manage external agent services (OpenClaw, ZeroClaw, etc.)
  synap users <sub>              Manage pod users (list, add-admin, reset-password, delete)
  synap profiles <sub> [name]  Enable/disable optional compose profiles (rsshub, openclaw, monitoring)
  synap tunnel <sub>             Enable/disable Cloudflare or Pangolin tunnels (alternative to direct DNS)
  synap reset [--full]           Reset workspace data or full cleanup + recreate

${YELLOW}Examples:${NC}
  # Install (auto-detects: clone if not in repo, use image by default)
  synap install --domain example.com --email me@example.com

  # Install in git repo (auto-detects: uses repo, builds from source by default)
  synap install --domain localhost

  # Force image even in git repo
  synap install --from-image --domain example.com --email me@example.com

  # Update (auto-detects: builds if in git repo, pulls image otherwise)
  synap update
  synap update --from-image
  synap update --from-source
  synap update v1.2.3

  # Management
  synap health
  synap connectivity
  synap logs                    # Interactive service selection
  synap logs backend            # View backend logs
  synap logs backend --tail 100 # Last 100 lines
  synap logs backend --filter error # Filter by "error"
  synap errors                  # Find errors in all services
  synap errors backend 200      # Find errors in backend (last 200 lines)
  synap diagnose                # Run full diagnostics
  synap restart                 # Interactive service selection
  synap restart backend         # Restart backend
  synap rebuild backend         # Rebuild and restart backend
  synap rebuild --no-cache     # Rebuild without cache
  synap clean                   # Interactive cleanup
  synap clean all               # Clean all unused resources
  synap shell backend           # Open shell in backend
  synap exec backend node --version # Execute command in backend
  synap config list
  synap services add openclaw   # Provision OpenClaw agent
  synap services status openclaw # Check OpenClaw status
  synap services rotate openclaw # Rotate OpenClaw API key
  synap services remove openclaw # Remove OpenClaw agent
  synap users list
  synap users reset-password relay@example.com 'NewStrongPassw0rd!'
  synap profiles enable rsshub     # RSSHub + browserless (optional stack)
  synap profiles disable openclaw  # Stop OpenClaw container
  synap tunnel enable cloudflare --token <TOKEN>   # Expose via Cloudflare Tunnel
  synap tunnel status                              # Show active tunnel(s)
  synap tunnel disable                             # Stop all tunnels
  synap reset                      # Reset workspace/application data only
  synap reset --full               # Full cleanup (docker stale data) + fresh install option

${YELLOW}For detailed help:${NC}
  synap install --help
  synap update --help

EOF
}


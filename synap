cmd_clean() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi
    
    cd "$deploy_dir"
    
    local what=${1:-}

    # `clean` NEVER touches volumes. The 2026-10-02 pod wipe was an update
    # episode followed by a volume-pruning `system prune`; a stopped stack's
    # postgres/minio/kratos volumes count as "unused" to Docker. The one
    # explicit wipe door is `synap reset --full --delete-data` (backup first,
    # typed domain, this project's volumes only).
    _clean_refuse_volumes() {
        echo -e "${RED}synap clean never removes Docker volumes — they hold the pod's database and files.${NC}"
        echo "To deliberately wipe THIS pod's data: synap reset --full --delete-data (takes a verified backup first)."
        exit 1
    }
    
    if [ -z "$what" ]; then
        echo -e "${BLUE}🧹 Clean Docker Resources${NC} (volumes are never removed)"
        echo ""
        echo "  ${GREEN}[1]${NC} Remove stopped containers"
        echo "  ${GREEN}[2]${NC} Remove unused images"
        echo "  ${GREEN}[3]${NC} Remove unused networks"
        echo "  ${GREEN}[4]${NC} Prune containers, images and networks (keeps volumes)"
        echo "  ${GREEN}[5]${NC} Remove build cache"
        echo "  ${GREEN}[q]${NC} Quit"
        echo ""
        read -p "Select option (number/q): " choice
        
        case "$choice" in
            1)
                docker container prune -f
                ;;
            2)
                docker image prune -f
                ;;
            3)
                docker network prune -f
                ;;
            4)
                echo -e "${YELLOW}⚠️  This will remove all unused containers, images and networks (volumes are kept)${NC}"
                read -p "Continue? (y/N): " CONFIRM
                if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
                    docker system prune -a -f
                fi
                ;;
            5)
                docker builder prune -f
                ;;
            q|Q)
                exit 0
                ;;
            *)
                echo -e "${RED}Invalid selection${NC}"
                exit 1
                ;;
        esac
    else
        case "$what" in
            containers)
                docker container prune -f
                ;;
            images)
                docker image prune -f
                ;;
            volumes)
                _clean_refuse_volumes
                ;;
            networks)
                docker network prune -f
                ;;
            all)
                echo -e "${YELLOW}⚠️  This will remove all unused containers, images and networks (volumes are kept)${NC}"
                read -p "Continue? (y/N): " CONFIRM
                if [ "$CONFIRM" = "y" ] || [ "$CONFIRM" = "Y" ]; then
                    docker system prune -a -f
                fi
                ;;
            cache)
                docker builder prune -f
                ;;
            *)
                echo "Usage: synap clean [containers|images|networks|all|cache]"
                exit 1
                ;;
        esac
    fi
    
    echo -e "${GREEN}✅ Cleanup complete!${NC}"
}


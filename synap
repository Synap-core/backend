                TUNNEL_PROVIDER="$2"
                shift 2
                ;;
            --tunnel-token)
                TUNNEL_TOKEN_ARG="$2"
                shift 2
                ;;
            --tunnel-token-file)
                TUNNEL_TOKEN_FILE="$2"
                shift 2
                ;;
            --register-token)
                REGISTER_TOKEN="${2:-}"
                shift 2
                ;;
            --control-plane)
                CONTROL_PLANE="${2:-}"
                shift 2
                ;;
            --name)
                POD_NAME="${2:-}"
                shift 2
                ;;
            --edge)
                INSTALL_EDGE="${2:-}"
                shift 2
                ;;
            --with-pod-agent)
                WITH_POD_AGENT=1
                shift
                ;;
            --pod-agent-issuer-url)
                POD_AGENT_ISSUER="${2:-}"

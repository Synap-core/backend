#!/bin/bash
# Synap - Unified CLI for installation and management
# Replaces: install.sh, install-automated.sh, synap-cli

set -e

# Pin the docker compose project name deterministically. Compose otherwise
# falls back to the cwd basename, which on a git checkout is "deploy" — and
# silently switching project name spawns a parallel orphan stack: NEW empty
# data volumes are created and the running container loses sight of the
# operator's existing data (kratos identities, synap users, postgres rows).
#
# This is the ROOT CAUSE of the May-2026 wipe report: existing installs
# created their data under project "deploy" (volume `deploy_postgres_data`),
# then a later run hard-pinned project to "synap-backend" → compose created
# `synap-backend_postgres_data` empty, postgres mounted on it, kratos-migrate
# ran every migration from scratch on the empty schema. The original data
# was still in `deploy_postgres_data` but orphaned.
#
# Resolution order (sets COMPOSE_PROJECT_NAME; called just before the command
# router at the bottom of this file, once get_deploy_dir is defined):
#   1. shell env override (operator / eve delegate knows what it's doing)
#   2. <deploy_dir>/.env COMPOSE_PROJECT_NAME (the PIN — install/update write it
#      when missing, so after one run the name is never guessed again)
#   3. the compose projects that own a postgres container for THIS deploy dir
#      (label com.docker.compose.project.working_dir). Exactly one → use it.
#      TWO OR MORE → REFUSE: picking one silently is how a stray `deploy` stack
#      shadows the real one (update-door plan 2026-10-04, team pod).
#   4. legacy data volume sniff (no containers at all): `deploy_postgres_data`
#      without a synap-backend one → "deploy"
#   5. "synap-backend" (the convention for fresh installs).
_SYNAP_PROJECT_CONFLICT=""
_compose_projects_owning_postgres() {
    local dir="$1" phys proj wd
    [ -n "$dir" ] || return 0
    command -v docker >/dev/null 2>&1 || return 0
    phys="$(cd "$dir" 2>/dev/null && pwd -P)"
    command docker ps -a --filter label=com.docker.compose.service=postgres \
        --format '{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null |
    while IFS='|' read -r proj wd; do
        [ -n "$proj" ] || continue
        if [ "$wd" = "$dir" ] || [ "$wd" = "$phys" ]; then echo "$proj"; fi
    done | sort -u
}
_resolve_compose_project_name() {
    local deploy_dir="$1" pinned owners count
    _SYNAP_PROJECT_CONFLICT=""
    if [ -n "${COMPOSE_PROJECT_NAME:-}" ]; then
        return 0
    fi
    if [ -n "$deploy_dir" ] && [ -f "$deploy_dir/.env" ]; then
        pinned="$(grep "^COMPOSE_PROJECT_NAME=" "$deploy_dir/.env" 2>/dev/null | head -1 | cut -d'=' -f2- | tr -d '"' | tr -d "'")"
    fi
    owners="$(_compose_projects_owning_postgres "$deploy_dir")"
    count=$(printf '%s' "$owners" | grep -c . || true)
    if [ -n "$pinned" ]; then
        COMPOSE_PROJECT_NAME="$pinned"
        if [ "$count" -ge 2 ]; then
            echo "⚠️  ${count} compose projects own a postgres container for ${deploy_dir}: $(echo $owners). Using the pinned COMPOSE_PROJECT_NAME=${pinned} from .env — inspect the others before removing anything." >&2
        fi
        return 0
    fi
    if [ "$count" -ge 2 ]; then
        _SYNAP_PROJECT_CONFLICT="$(echo $owners)"
        return 0
    fi
    if [ "$count" -eq 1 ]; then
        COMPOSE_PROJECT_NAME="$owners"
        return 0
    fi
    if command -v docker >/dev/null 2>&1; then
        local vols
        vols=$(command docker volume ls --format '{{.Name}}' 2>/dev/null || true)
        if printf '%s\n' "$vols" | grep -qx 'deploy_postgres_data' \
            && ! printf '%s\n' "$vols" | grep -qx 'synap-backend_postgres_data'; then
            COMPOSE_PROJECT_NAME="deploy"
            return 0
        fi
    fi
    COMPOSE_PROJECT_NAME="synap-backend"
}

# Write the resolved name into .env when it is not pinned yet, so the next run
# (and every other door that reads .env) uses it instead of guessing again.
_pin_compose_project_name() {
    local env_file="${1:-.env}"
    [ -f "$env_file" ] && [ -n "${COMPOSE_PROJECT_NAME:-}" ] || return 0
    grep -q "^COMPOSE_PROJECT_NAME=" "$env_file" && return 0
    [ -n "$(tail -c1 "$env_file")" ] && echo >> "$env_file"
    echo "COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}" >> "$env_file"
    echo -e "${BLUE}ℹ️  Pinned COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME} in ${env_file}${NC}"
}

# ─── Shared Ory database bootstrap ────────────────────────────────────────────
# Sourced once so every command (install, update, and the alternate
# update-pod.sh) uses ONE fail-closed, non-destructive bootstrap. Resolved
# relative to this script's own location so it works from the repo root,
# from deploy/, or when invoked as `bash synap` from anywhere.
_ory_bootstrap_script="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/deploy/ensure-ory-databases.sh"
if [ -f "$_ory_bootstrap_script" ]; then
    # shellcheck source=/dev/null
    source "$_ory_bootstrap_script"
else
    echo -e "${RED}❌ Ory database bootstrap not found at ${_ory_bootstrap_script}${NC}"
    exit 1
fi
unset _ory_bootstrap_script

# ─── Postgres data-placement guard (deploy/pgdata-safety.sh) ──────────────────
# 2026-10-02: the pod's database lived in the postgres container's writable
# layer (volume mounted at the wrong path) and one recreate wiped it. Before ANY
# `docker compose up|run|create` in this process — from any command or helper,
# present or future — the guard moves a legacy in-layer cluster onto its volume
# and marks the pod initialized. Intercepting `docker` itself (rather than
# listing the commands that recreate containers) means a new call site is
# covered by existing, not by someone remembering to add it.
_pgdata_safety_script="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/deploy/pgdata-safety.sh"
if [ -f "$_pgdata_safety_script" ]; then
    # shellcheck source=/dev/null
    source "$_pgdata_safety_script"
else
    echo -e "${RED}❌ Postgres data-placement guard not found at ${_pgdata_safety_script}${NC}"
    exit 1
fi
unset _pgdata_safety_script

# ─── Update lock (deploy/update-lock.sh) ──────────────────────────────────────
# install/update/rebuild/reset/restore take <deploy_dir>/state/update.lock in
# the router below, so eve, pod-agent's update-pod.sh and an operator can never
# run two of them against one pod at the same time.
_update_lock_script="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/deploy/update-lock.sh"
if [ -f "$_update_lock_script" ]; then
    # shellcheck source=/dev/null
    source "$_update_lock_script"
else
    echo -e "${RED}❌ Update lock helper not found at ${_update_lock_script}${NC}"
    exit 1
fi
unset _update_lock_script

_PGDATA_GUARD_DONE=0
_run_pgdata_guard() {
    _PGDATA_GUARD_DONE=1
    local deploy_dir
    deploy_dir="$(get_deploy_dir)"
    [ -z "$deploy_dir" ] && return 0
    SYNAP_DEPLOY_DIR="$deploy_dir" COMPOSE_CMD="command docker compose" pgdata_guard || {
        echo -e "${RED}❌ Postgres data-placement guard failed — aborting before anything recreates postgres.${NC}"
        echo -e "${YELLOW}   Nothing was deleted. See the [pgdata] lines above; backups live in ${deploy_dir}/backups/postgres.${NC}"
        exit 1
    }
}

docker() {
    if [ "${1:-}" = compose ] && [ "$_PGDATA_GUARD_DONE" = 0 ]; then
        local arg
        for arg in "$@"; do
            case "$arg" in
                up|run|create) _run_pgdata_guard; break ;;
            esac
        done
    fi
    command docker "$@"
}

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ─── Read-only Compose preflight check ────────────────────────────────────────
# Verifies the Compose project and Postgres service are resolvable BEFORE any
# database provisioning. Purely diagnostic — never starts, stops, or recreates
# anything, never switches stacks. If the expected Postgres service/container
# cannot be resolved, aborts so the operator sees why rather than silently
# creating another stack (which would orphan the real data volume).
_preflight_compose_check() {
    local deploy_dir="${1:-.}"

    # Canonicalize: callers pass either the repo root (…/synap-backend) or the
    # deploy dir itself (…/synap-backend/deploy). Resolve to the deploy dir so
    # the compose-file path below is correct from either entry point. Without
    # this, running the CLI from inside deploy/ looked for
    # deploy/deploy/docker-compose.yml and aborted a working update.
    if [ -f "$deploy_dir/docker-compose.yml" ] && [ ! -f "$deploy_dir/deploy/docker-compose.yml" ]; then
        # $deploy_dir IS the deploy dir
        :
    elif [ -f "$deploy_dir/deploy/docker-compose.yml" ]; then
        deploy_dir="$deploy_dir/deploy"
    elif [ -d "$deploy_dir/deploy" ]; then
        deploy_dir="$deploy_dir/deploy"
    fi

    echo -e "${BLUE}🔍 Preflight: resolving Compose project and Postgres service...${NC}"

    # 1. Log the resolved Compose project name (already pinned at script top).
    local project_name="${COMPOSE_PROJECT_NAME:-}"
    if [ -z "$project_name" ]; then
        project_name="$(_resolve_compose_project_name)"
    fi
    echo -e "${BLUE}  Compose project: ${project_name}${NC}"

    # 2. Verify the compose file exists and defines a postgres service.
    local compose_file="$deploy_dir/docker-compose.yml"
    if [ ! -f "$compose_file" ]; then
        echo -e "${RED}❌ Compose file not found at ${compose_file}${NC}"
        return 1
    fi

    if ! grep -qE "^\s+postgres:" "$compose_file"; then
        echo -e "${RED}❌ Postgres service not defined in ${compose_file}${NC}"
        return 1
    fi
    echo -e "${BLUE}  Postgres service: defined in ${compose_file}${NC}"

    # 3. If a postgres container is already running, log its container ID and
    #    the mounted postgres_data volume so the operator can confirm the
    #    update will operate on the expected data volume.
    local postgres_container
    postgres_container="$(cd "$deploy_dir" && docker compose ps -q postgres 2>/dev/null | head -1)"
    if [ -n "$postgres_container" ]; then
        echo -e "${BLUE}  Postgres container: ${postgres_container}${NC}"

        local volume
        volume="$(docker inspect --format '{{ range .Mounts }}{{ if eq .Destination "/var/lib/postgresql/data" }}{{ .Name }}{{ end }}{{ end }}' "$postgres_container" 2>/dev/null)"
        if [ -n "$volume" ]; then
            echo -e "${BLUE}  Mounted postgres_data volume: ${volume}${NC}"
        else
            echo -e "${YELLOW}  ⚠️  Could not resolve postgres_data volume mount on ${postgres_container}${NC}"
        fi
    else
        echo -e "${YELLOW}  Postgres container: not running (bootstrap will start it)${NC}"
    fi

    echo -e "${GREEN}  ✓ Preflight check passed${NC}"
    return 0
}

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================

# Detect if we're in a git repository
is_git_repo() {
    git rev-parse --git-dir > /dev/null 2>&1
}

# Get repo root (if in git repo)
get_repo_root() {
    if is_git_repo; then
        git rev-parse --show-toplevel 2>/dev/null || pwd
    else
        echo ""
    fi
}

# Get deploy directory (explicit env wins — enables tooling like Eve to point here without cd)
get_deploy_dir() {
    if [ -n "${SYNAP_DEPLOY_DIR:-}" ] && [ -d "${SYNAP_DEPLOY_DIR}" ] && [ -f "${SYNAP_DEPLOY_DIR}/docker-compose.yml" ]; then
        echo "${SYNAP_DEPLOY_DIR}"
        return
    fi
    local repo_root=$(get_repo_root)
    if [ -n "$repo_root" ] && [ -d "$repo_root/deploy" ]; then
        echo "$repo_root/deploy"
    elif [ -f "docker-compose.yml" ]; then
        echo "$(pwd)"
    else
        echo ""
    fi
}

# ─── Deploy-integrity: sync the checkout before a from-source build ───────────
# ROOT CAUSE (2026-07 stale-deploy investigation): `docker compose build` reads
# whatever is on disk in the repo root — it never git-pulls first. An operator
# (or an automation like eve) running `synap update`/`synap install` in a repo
# that is behind origin (or has drifted local commits) silently bakes a stale
# checkout into the `:local` image, with no signal anywhere that it happened.
#
# This brings the checkout to origin's tip BEFORE any `docker compose build`,
# and exports GIT_SHA so the image is stamped with the commit that was
# actually built (see deploy/Dockerfile ARG GIT_SHA / docker-compose.yml
# build.args.GIT_SHA / apps/api/src/index.ts buildStamp). Called from the
# repo root (get_repo_root), not the deploy dir.
#
# Destructive: `git reset --hard` discards uncommitted local changes. That is
# the correct behavior for the pod's deploy checkout (it must exactly match
# what was pushed — that's the whole point of this gate), but would be wrong
# on a developer's working tree, so it's opt-out via SYNAP_SKIP_GIT_SYNC=1
# for local/dev iteration where an uncommitted checkout is intentional.
sync_git_before_build() {
    if ! is_git_repo; then
        return 0
    fi
    local repo_root
    repo_root=$(get_repo_root)
    if [ -z "$repo_root" ]; then
        return 0
    fi

    if [ "${SYNAP_SKIP_GIT_SYNC:-}" = "1" ]; then
        echo -e "${YELLOW}⚠️  SYNAP_SKIP_GIT_SYNC=1 — building from the checkout as-is (not synced to origin). Do not use this on a deploy pod.${NC}"
    else
        (
            cd "$repo_root" || exit 1
            local branch
            branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
            [ "$branch" = "HEAD" ] && branch="main"  # detached HEAD fallback
            echo -e "${BLUE}🔄 Syncing checkout to origin/${branch} before build (git fetch + reset --hard)...${NC}"
            if ! git fetch origin "$branch" 2>&1; then
                echo -e "${RED}✗ git fetch origin ${branch} failed — refusing to build against a checkout we couldn't verify is current.${NC}"
                exit 1
            fi
            if ! git reset --hard "origin/${branch}" 2>&1; then
                echo -e "${RED}✗ git reset --hard origin/${branch} failed.${NC}"
                exit 1
            fi
        ) || exit 1
    fi

    # Export GIT_SHA regardless of sync/skip so the image is always stamped
    # with whatever HEAD actually is at build time (accurate even when the
    # sync was skipped).
    export GIT_SHA
    GIT_SHA=$(cd "$repo_root" && git rev-parse HEAD 2>/dev/null || echo "")
}

# Used by destructive / confirm flows when automation must not block (e.g. Eve -y)
synap_assume_yes() {
    [ "${SYNAP_ASSUME_YES:-}" = "1" ] || [ "${SYNAP_YES:-}" = "1" ] || [ "${SYNAP_NON_INTERACTIVE:-}" = "1" ]
}

# Remove known stale artifacts from older installers/flows.
# Safe-by-default: only removes known files/containers that should never hold source-of-truth data.
cleanup_stale_synap_state() {
    local deploy_dir="$1"
    if [ -z "$deploy_dir" ] || [ ! -d "$deploy_dir" ]; then
        return 0
    fi

    echo -e "${BLUE}🧹 Cleaning known stale install artifacts...${NC}"

    # Legacy install.sh artifacts that can override backend-migrate behavior.
    rm -f "$deploy_dir/patch_migration.js"

    if [ -f "$deploy_dir/docker-compose.override.yml" ] && grep -q "patch_migration.js" "$deploy_dir/docker-compose.override.yml" 2>/dev/null; then
        rm -f "$deploy_dir/docker-compose.override.yml"
        echo -e "${YELLOW}  Removed legacy docker-compose.override.yml (patch_migration hook)${NC}"
    fi

    # Legacy Eve fallback container (removed path): can create confusing health/readiness state.
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q '^eve-brain-synap$'; then
        docker rm -f eve-brain-synap >/dev/null 2>&1 || true
        echo -e "${YELLOW}  Removed legacy container: eve-brain-synap${NC}"
    fi
}

# ============================================================================
# HELPER: Update env value
# ============================================================================

update_env_value() {
    local key=$1
    local value=$2
    if [ -z "$value" ]; then
        return 0  # Skip if value is empty
    fi
    if grep -q "^${key}=" .env; then
        sed -i.bak "s|^${key}=.*|${key}=${value}|" .env
    else
        echo "${key}=${value}" >> .env
    fi
}

pod_admin_domain_for_domain() {
    local domain="$1"
    if [ "$domain" = "localhost" ]; then
        printf '%s' "pod-admin.localhost"
        return
    fi
    if [[ "$domain" == *.* ]]; then
        printf '%s-admin.%s' "${domain%%.*}" "${domain#*.}"
        return
    fi
    printf 'pod-admin.%s' "$domain"
}

pod_admin_url_for_domain() {
    local domain="$1"
    if [ "$domain" = "localhost" ]; then
        printf '%s' "http://localhost:4040"
        return
    fi
    printf 'https://%s' "$(pod_admin_domain_for_domain "$domain")"
}

shared_cookie_domain() {
    local api_host="$1"
    local admin_host="$2"
    local -a api_labels admin_labels
    local common=""
    local ai bi

    IFS='.' read -r -a api_labels <<< "$api_host"
    IFS='.' read -r -a admin_labels <<< "$admin_host"
    ai=$((${#api_labels[@]} - 1))
    bi=$((${#admin_labels[@]} - 1))
    while [ "$ai" -ge 0 ] && [ "$bi" -ge 0 ] && [ "${api_labels[$ai]}" = "${admin_labels[$bi]}" ]; do
        common="${api_labels[$ai]}${common:+.$common}"
        ai=$((ai - 1))
        bi=$((bi - 1))
    done

    # A domain cookie must be scoped to a registrable-style parent, not a TLD.
    if [[ "$common" == *.* ]]; then
        printf '%s' "$common"
    fi
}

backfill_federation_public_urls() {
    local domain="$1"
    local configured_public_url
    local configured_pod_admin_domain
    local configured_pod_admin_url
    local pod_admin_authority

    configured_public_url=$(grep "^PUBLIC_URL=" .env 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || true)
    if [ -z "$configured_public_url" ]; then
        update_env_value "PUBLIC_URL" "https://${domain}"
        echo -e "${BLUE}ℹ️  Backfilled PUBLIC_URL for secure federation${NC}"
    elif [ "$domain" != "localhost" ] && [[ "$configured_public_url" == http://* ]]; then
        update_env_value "PUBLIC_URL" "https://${configured_public_url#http://}"
        echo -e "${BLUE}ℹ️  Upgraded PUBLIC_URL to HTTPS for secure Pod Admin federation${NC}"
    fi

    configured_pod_admin_domain=$(grep "^POD_ADMIN_DOMAIN=" .env 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || true)
    configured_pod_admin_url=$(grep "^POD_ADMIN_URL=" .env 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || true)

    # Older deployments may have received only one endpoint setting during a
    # partial rollout. Complete the pair from that explicit value, rather than
    # replacing it with the conventional host and splitting Caddy from Kratos.
    if [ -z "$configured_pod_admin_domain" ] && [ -n "$configured_pod_admin_url" ]; then
        pod_admin_authority="${configured_pod_admin_url#https://}"
        configured_pod_admin_domain="${pod_admin_authority%%/*}"
        update_env_value "POD_ADMIN_DOMAIN" "$configured_pod_admin_domain"
        echo -e "${BLUE}ℹ️  Backfilled POD_ADMIN_DOMAIN from the configured Pod Admin URL${NC}"
    elif [ -z "$configured_pod_admin_url" ] && [ -n "$configured_pod_admin_domain" ]; then
        configured_pod_admin_url="https://${configured_pod_admin_domain}"
        update_env_value "POD_ADMIN_URL" "$configured_pod_admin_url"
        echo -e "${BLUE}ℹ️  Backfilled POD_ADMIN_URL from the configured Pod Admin domain${NC}"
    elif [ -z "$configured_pod_admin_domain" ] && [ -z "$configured_pod_admin_url" ]; then
        update_env_value "POD_ADMIN_DOMAIN" "$(pod_admin_domain_for_domain "$domain")"
        update_env_value "POD_ADMIN_URL" "$(pod_admin_url_for_domain "$domain")"
        echo -e "${BLUE}ℹ️  Backfilled Pod Admin handoff endpoints${NC}"
    fi

    # Self-heal SYNAP_BASE_DOMAIN — the first-party CORS base that makes sibling
    # surfaces (pod-admin.<root>) first-party to the pod (pod.<root>). It is set
    # once at install and nothing else rewrites it, so a domain move leaves it
    # stale and pod-admin's Kratos login is CORS-blocked. Re-derive it from the
    # CURRENT domain + pod-admin domain on every reconcile so it can never drift.
    # (Belt for the backend, which now also derives this from PUBLIC_URL at
    # runtime; keeping the env value correct keeps older images working too.)
    if [ "$domain" != "localhost" ]; then
        local effective_pod_admin_domain
        effective_pod_admin_domain="${configured_pod_admin_domain:-$(pod_admin_domain_for_domain "$domain")}"
        local derived_base
        derived_base="$(shared_cookie_domain "$domain" "$effective_pod_admin_domain")"
        if [ -n "$derived_base" ]; then
            local configured_base
            configured_base=$(grep "^SYNAP_BASE_DOMAIN=" .env 2>/dev/null | cut -d'=' -f2- | tr -d ' ' || true)
            if [ "$configured_base" != "$derived_base" ]; then
                update_env_value "SYNAP_BASE_DOMAIN" "$derived_base"
                echo -e "${BLUE}ℹ️  Set SYNAP_BASE_DOMAIN=${derived_base} (first-party CORS base)${NC}"
            fi
        fi
    fi
}

# Pod-agent has the Docker socket, so only start its profile after the Pod
# owner configured a generic issuer and this Pod's exact audience. The legacy
# CONTROL_PLANE_URL setting is intentionally not considered here.
_pod_agent_setting() {
    local key="$1"
    local shell_value="${!key:-}"
    if [ -n "$shell_value" ]; then
        printf '%s' "$shell_value"
        return
    fi
    if [ -f .env ]; then
        grep -E "^${key}=" .env 2>/dev/null | head -n 1 | cut -d= -f2-
    fi
}

_is_canonical_https_url() {
    local value="$1"
    local authority="${value#https://}"
    [[ "$value" == https://* && -n "$authority" && "$authority" != */ && "$value" != *"?"* && "$value" != *"#"* && "$authority" != *"@"* && ! "$value" =~ [[:space:]] ]]
}

should_start_pod_agent() {
    local enabled issuer audience
    enabled="$(_pod_agent_setting SYNAP_WITH_POD_AGENT)"
    issuer="$(_pod_agent_setting POD_AGENT_ISSUER_URL)"
    audience="$(_pod_agent_setting POD_AGENT_AUDIENCE)"

    if [ "$enabled" != "1" ] && [ -z "$issuer" ] && [ -z "$audience" ]; then
        return 1
    fi
    if [ -z "$issuer" ] || [ -z "$audience" ]; then
        echo -e "${RED}✗ Pod-agent requires POD_AGENT_ISSUER_URL and POD_AGENT_AUDIENCE.${NC}" >&2
        return 2
    fi
    if ! _is_canonical_https_url "$issuer" || ! _is_canonical_https_url "$audience"; then
        echo -e "${RED}✗ Pod-agent issuer and audience must be canonical HTTPS URLs without credentials, query, fragment, or trailing slash.${NC}" >&2
        return 2
    fi
    return 0
}

# ============================================================================
# HELPER: Generate secrets and create .env
# ============================================================================

generate_and_create_env() {
    local domain=$1
    local email=$2
    # $3 (from_source) is unused: images are pinned by the release block
    local openai_key=$4
    local anthropic_key=$5
    local google_key=$6
    local admin_email=$7
    local intelligence_url=$8
    local intelligence_key=$9
    local admin_bootstrap_mode=${10}
    local admin_bootstrap_token=${11}
    local pod_admin_domain
    local pod_admin_url
    pod_admin_domain="$(pod_admin_domain_for_domain "$domain")"
    pod_admin_url="$(pod_admin_url_for_domain "$domain")"
    
    # Generate secrets
    echo -e "${BLUE}🔐 Generating secrets...${NC}"
    
    # Use openssl hex output to avoid any base64 line-wrap issues (no newlines ever)
    local POSTGRES_PASSWORD=$(openssl rand -hex 24)
    local JWT_SECRET=$(openssl rand -hex 48)
    local KRATOS_COOKIE=$(openssl rand -hex 24)
    local KRATOS_CIPHER=$(openssl rand -hex 16)
    local KRATOS_WEBHOOK=$(openssl rand -hex 24)
    local MINIO_ACCESS_KEY=$(openssl rand -hex 12)
    local MINIO_SECRET_KEY=$(openssl rand -hex 24)
    local TYPESENSE_KEY=$(openssl rand -hex 24)
    local TYPESENSE_ADMIN_KEY=$(openssl rand -hex 24)
    local HYDRA_SECRETS_SYSTEM=$(openssl rand -hex 24)
    local SYNAP_SERVICE_ENCRYPTION_KEY=$(openssl rand -hex 32)
    # PROVISIONING_TOKEN authorizes agent-key minting via POST /v1/agents/provision.
    # Backend reads it from compose env; .env.example documents it as required.
    local PROVISIONING_TOKEN=$(openssl rand -hex 32)
    
    # Placeholder until the image step pins the release block (SYNAP_IMAGE_*,
    # BACKEND_VERSION=<release id>) — never `latest`.
    local backend_version="unreleased"
    
    cat > .env <<EOF
# Synap Backend Configuration
# Generated: $(date)

GITHUB_REPOSITORY=synap-core/backend
BACKEND_VERSION=${backend_version}
COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME:-synap-backend}

DOMAIN=${domain}
LETSENCRYPT_EMAIL=${email:-noreply@localhost}

# PUBLIC_URL: How intelligence hub calls back to this backend
# This MUST be the public-facing URL (not internal Docker network)
PUBLIC_URL=https://${domain}

# Public Pod Admin console. Keep this explicit: the API and operator console
# may use different origins on self-hosted deployments.
POD_ADMIN_DOMAIN=${pod_admin_domain}
POD_ADMIN_URL=${pod_admin_url}

# Intelligence Service
INTELLIGENCE_HUB_URL=${intelligence_url}
INTELLIGENCE_HUB_API_KEY=${intelligence_key}

# AI Provider API Keys
OPENAI_API_KEY=${openai_key}
ANTHROPIC_API_KEY=${anthropic_key}
GOOGLE_AI_API_KEY=${google_key}

# Embeddings are deterministic by default (no provider key required)
EMBEDDING_PROVIDER=deterministic

# Admin Configuration
ADMIN_EMAIL=${admin_email}
ADMIN_BOOTSTRAP_MODE=${admin_bootstrap_mode}
ADMIN_BOOTSTRAP_TOKEN=${admin_bootstrap_token}

# Auto-generated Secrets
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
JWT_SECRET=${JWT_SECRET}
KRATOS_SECRETS_COOKIE=${KRATOS_COOKIE}
KRATOS_SECRETS_CIPHER=${KRATOS_CIPHER}
KRATOS_WEBHOOK_SECRET=${KRATOS_WEBHOOK}
MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
TYPESENSE_API_KEY=${TYPESENSE_KEY}
TYPESENSE_ADMIN_API_KEY=${TYPESENSE_ADMIN_KEY}
ORY_HYDRA_SECRETS_SYSTEM=${HYDRA_SECRETS_SYSTEM}
SYNAP_SERVICE_ENCRYPTION_KEY=${SYNAP_SERVICE_ENCRYPTION_KEY}
PROVISIONING_TOKEN=${PROVISIONING_TOKEN}

# Allowed CORS origins (comma-separated frontend URLs)
# Add your Electron app origin or web client URL here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
EOF
    
    chmod 600 .env
}

# Generate kratos.yml with actual domain values
# IMPORTANT: This function ALWAYS overwrites kratos.yml - never use a static file
# The file is generated fresh on every install/update to ensure webhook secret and domain are correct
generate_kratos_config() {
    local domain=$1
    local kratos_dir="../kratos"
    local deploy_dir="deploy"
    
    if [ ! -d "$kratos_dir" ]; then
        echo -e "${YELLOW}⚠️  Kratos directory not found, skipping config generation${NC}"
        return
    fi
    
    # Read webhook secret from .env file (if it exists)
    # This function is called from deploy/ directory, so .env is in current directory
    local webhook_secret=""
    local env_file=""
    
    # Find .env file - check current directory first (deploy/), then parent (repo root)
    if [ -f ".env" ] && [ -r ".env" ]; then
        # Called from deploy/ directory
        env_file=".env"
    elif [ -f "../deploy/.env" ] && [ -r "../deploy/.env" ]; then
        # Called from repo root
        env_file="../deploy/.env"
    elif [ -f "deploy/.env" ] && [ -r "deploy/.env" ]; then
        # Alternative path
        env_file="deploy/.env"
    fi
    
    if [ -n "$env_file" ]; then
        # Use cat and grep to avoid permission issues with direct grep
        webhook_secret=$(cat "$env_file" 2>/dev/null | grep "^KRATOS_WEBHOOK_SECRET=" | cut -d'=' -f2- | tr -d ' ' | tr -d '"' || echo "")
    fi

    # CP OIDC federation — per-pod, auto-provisioned via CP→pod PUSH. When this pod
    # is connected to a Control Plane (CONTROL_PLANE_URL set), we ask the CP to
    # (re)provision this pod's OWN OIDC client: the CP mints it and PUSHES it to the
    # pod over the authenticated Hub channel (the pod persists it in pod_settings).
    # We then read the pushed client from the pod's OWN database — there is no
    # pod→CP secret and no manual env var (a pod holds no credential it can present
    # to the CP; the authenticated direction is CP→pod). When NOT CP-connected
    # (self-hosted / agnostic), disabled via `synap federation disable`, or on ANY
    # failure, the oidc method stays disabled — byte-identical to the prior config,
    # so this can never break Kratos boot. provider_id is fixed at "cp": Kratos
    # builds its callback as .../oidc/callback/<provider_id>, which must match the
    # redirect the CP registered (see ensurePodOidcClient / derivePodOidcRedirectUri).
    local oidc_client_secret=""
    local oidc_issuer=""
    local oidc_client_id=""
    local oidc_label="Synap Cloud"
    local oidc_provider_id="cp"
    if [ -n "$env_file" ]; then
        local _cp_url _pub_url _v _disabled
        _cp_url=$(grep "^CONTROL_PLANE_URL=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || echo "")
        _pub_url=$(grep "^PUBLIC_URL=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || echo "")
        [ -z "$_pub_url" ] && _pub_url="https://${domain}"
        _v=$(grep "^SYNAP_POD_OIDC_LABEL=" "$env_file" 2>/dev/null | cut -d'=' -f2- | sed 's/^ *//; s/ *$//' | tr -d '"' || echo ""); [ -n "$_v" ] && oidc_label="$_v"
        # Explicit off-switch (`synap federation disable`) — keeps CP trust intact
        # while forcing password-only sign-in.
        _disabled=$(grep "^SYNAP_POD_FEDERATION_DISABLED=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || echo "")
        if [ -n "$_cp_url" ] && [ "$_disabled" != "1" ]; then
            # 1. Trigger the CP to mint + push this pod's OIDC client over the Hub
            #    channel. Returns { delivered: true } once the pod has persisted it.
            #    No secret is returned here — it travels CP→pod (authenticated) only.
            local _resp _delivered
            _resp=$(curl -fsS --max-time 20 -X POST \
                -H "Content-Type: application/json" \
                -d "{\"podUrl\":\"${_pub_url}\"}" \
                "${_cp_url%/}/pods/oidc/provision" 2>/dev/null || echo "")
            _delivered=$(printf '%s' "$_resp" | grep -oE '"delivered"[[:space:]]*:[[:space:]]*true' | head -1)
            if [ -n "$_delivered" ]; then
                # 2. Read the pushed client from the pod's OWN Postgres (pod-local,
                #    plaintext read for the Kratos config — same trust as kratos.yml).
                local _row
                _row=$(docker compose exec -T postgres psql -U synap -d synap -tAF '|' -c \
                    "SELECT settings->'federationOidcClient'->>'clientId', settings->'federationOidcClient'->>'clientSecret', settings->'federationOidcClient'->>'issuer' FROM pod_settings WHERE settings ? 'federationOidcClient' LIMIT 1" 2>/dev/null | head -1 || echo "")
                oidc_client_id=$(printf '%s' "$_row" | cut -d'|' -f1)
                oidc_client_secret=$(printf '%s' "$_row" | cut -d'|' -f2)
                oidc_issuer=$(printf '%s' "$_row" | cut -d'|' -f3)
                if [ -n "$oidc_client_secret" ] && [ -n "$oidc_client_id" ] && [ -n "$oidc_issuer" ]; then
                    echo -e "${BLUE}ℹ️  Per-pod OIDC client provisioned by Control Plane (${oidc_client_id})${NC}"
                else
                    oidc_client_secret=""
                    echo -e "${YELLOW}⚠️  OIDC client delivered but not readable from pod_settings — federated sign-in stays disabled${NC}"
                fi
            elif [ -n "$_resp" ]; then
                echo -e "${YELLOW}⚠️  CP could not deliver the OIDC client (${_resp}) — federated sign-in stays disabled${NC}"
            else
                echo -e "${YELLOW}⚠️  Could not reach CP /pods/oidc/provision — federated sign-in stays disabled this deploy${NC}"
            fi
        fi
    fi

    if [ -z "$webhook_secret" ] || [ "$webhook_secret" = "" ]; then
        echo -e "${YELLOW}⚠️  KRATOS_WEBHOOK_SECRET not found in .env, generating new secret...${NC}"
        # Generate a random secret if not found
        webhook_secret=$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | base64 | tr -d '\n' || echo "CHANGE_ME")
        echo -e "${BLUE}ℹ️  Generated webhook secret: ${webhook_secret:0:10}...${NC}"
        # Try to write it back to .env if we found the file
        if [ -n "$env_file" ] && [ -w "$env_file" ]; then
            if grep -q "^KRATOS_WEBHOOK_SECRET=" "$env_file" 2>/dev/null; then
                # Update existing
                sed -i.bak "s|^KRATOS_WEBHOOK_SECRET=.*|KRATOS_WEBHOOK_SECRET=${webhook_secret}|" "$env_file" 2>/dev/null && rm -f "${env_file}.bak" || true
            else
                # Add new
                echo "KRATOS_WEBHOOK_SECRET=${webhook_secret}" >> "$env_file" 2>/dev/null || true
            fi
        fi
    fi
    
    # Backup existing kratos.yml if it exists (for recovery)
    if [ -f "$kratos_dir/kratos.yml" ]; then
        cp "$kratos_dir/kratos.yml" "$kratos_dir/kratos.yml.backup" 2>/dev/null || true
    fi
    
    # Determine if domain is localhost (dev) or production
    local is_localhost=false
    if [ "$domain" = "localhost" ]; then
        is_localhost=true
    fi

    # Browser-visible UI for Kratos flows. The legacy admin-ui SPA was retired
    # 2026-05; Pod Admin now hosts
    # all flow renderers natively at /login. Kratos still hits ui_url for
    # browser-initiated flows (error pages, /self-service/*/browser
    # redirects) — pointing it at pod-admin/login lets pod-admin re-init the
    # flow via Kratos public API and render the form locally.
    local pod_admin_ui=""
    local kratos_ui=""
    local bare_root="$domain"
    local pod_admin_domain=""
    local configured_pod_admin_domain=""
    local configured_pod_admin_url=""
    local pod_admin_origin=""
    if [ "$is_localhost" = true ]; then
        pod_admin_ui="http://localhost:4040"
        pod_admin_origin="$pod_admin_ui"
    else
        if [ -n "$env_file" ]; then
            configured_pod_admin_domain=$(grep "^POD_ADMIN_DOMAIN=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || true)
            configured_pod_admin_url=$(grep "^POD_ADMIN_URL=" "$env_file" 2>/dev/null | cut -d'=' -f2- | tr -d ' "' || true)
        fi
        pod_admin_domain="${configured_pod_admin_domain:-$(pod_admin_domain_for_domain "$domain")}"
        pod_admin_ui="${configured_pod_admin_url:-https://${pod_admin_domain}}"
        pod_admin_ui="${pod_admin_ui%/}"
        local admin_remainder="${pod_admin_ui#*://}"
        local admin_host="${admin_remainder%%/*}"
        local admin_scheme="${pod_admin_ui%%://*}"
        if [ "$pod_admin_ui" != "https://${pod_admin_domain}" ] || ! [[ "$pod_admin_domain" =~ ^[A-Za-z0-9.-]+$ ]] || [ "$admin_host" != "$pod_admin_domain" ]; then
            echo -e "${RED}❌ POD_ADMIN_URL must be the HTTPS origin for POD_ADMIN_DOMAIN, without a path.${NC}" >&2
            return 1
        fi
        pod_admin_origin="${admin_scheme}://${admin_host}"
        bare_root="$(shared_cookie_domain "$domain" "$pod_admin_domain")"
        if [ -z "$bare_root" ]; then
            echo -e "${RED}❌ POD_ADMIN_DOMAIN must share a parent domain with DOMAIN so Kratos can keep the owner session.${NC}" >&2
            return 1
        fi
    fi
    kratos_ui="${pod_admin_ui}/login"
    # Recovery and settings have their own pod-admin renderers (account
    # recovery P0/P1): /recovery renders the Kratos recovery flow plus the
    # "use a recovery code" door; /settings/security is where a recovered
    # (privileged) session lands to set a new password.
    local kratos_recovery_ui="${pod_admin_ui}/recovery"
    local kratos_settings_ui="${pod_admin_ui}/settings/security"

    # Kratos public API base URL — localhost in dev, domain URL in production
    local kratos_public_base_url=""
    if [ "$is_localhost" = true ]; then
        kratos_public_base_url="http://localhost:4433"
    else
        kratos_public_base_url="https://${domain}/.ory/kratos/public/"
    fi

    # Generate CORS origins
    local cors_origins="        - http://localhost:3000
        - http://localhost:5173
        - http://localhost:3001
        - http://localhost:4000
        - http://localhost:4040"

    if [ "$is_localhost" = false ]; then
        cors_origins="$cors_origins
        - https://${domain}
        - ${pod_admin_origin}
        - https://*.synap.live"
    fi

    # Generate allowed return URLs. The relay-app (Expo/React Native) completes
    # federated "Continue with Synap Cloud" sign-in via WebBrowser.openAuthSession
    # → the ephemeral browser returns to a DEEP LINK, so its custom scheme must be
    # an allowed Kratos return_to (app-level, present in every env — relay's
    # app.json declares both the `synap` and `relay` schemes).
    local return_urls="    - http://localhost:3000
    - http://localhost:3000/*
    - http://localhost:4000
    - http://localhost:4000/*
    - http://localhost:4040
    - http://localhost:4040/*
    - synap://auth/callback
    - relay://auth/callback"

    if [ "$is_localhost" = false ]; then
        return_urls="$return_urls
    - https://${domain}
    - https://${domain}/*
    - ${pod_admin_origin}
    - ${pod_admin_origin}/*
    - https://*.synap.live
    - https://*.synap.live/*"
    fi

    # OIDC method block — federate to the Control Plane ONLY when a per-pod client
    # was fetched above; otherwise `enabled: false` (unchanged, cannot break
    # boot). The mapper (oidc.cp.jsonnet) maps email+name onto the pod identity.
    local oidc_block="      enabled: false"
    if [ -n "$oidc_client_secret" ]; then
        oidc_block="      enabled: true
      config:
        providers:
          - id: ${oidc_provider_id}
            provider: generic
            label: ${oidc_label}
            issuer_url: ${oidc_issuer}
            client_id: ${oidc_client_id}
            client_secret: ${oidc_client_secret}
            scope:
              - openid
              - email
              - profile
            mapper_url: file:///etc/config/kratos/oidc.cp.jsonnet"
    fi

    # Cookie domain and secure settings — scoped to the bare root so the
    # session cookie set at pod.<root> is also valid at pod-admin.<root>.
    local cookie_domain="localhost"
    local cookie_secure="false"
    if [ "$is_localhost" = false ]; then
        cookie_domain="$bare_root"
        cookie_secure="true"
    fi
    
    # Always overwrite kratos.yml (never use a static file - always generate fresh)
    # This ensures webhook secret and domain are always correct
    cat > "$kratos_dir/kratos.yml" << EOF
version: v1.3.1
# DSN should match docker-compose environment variable
# Uses postgres service name, kratos database
dsn: postgres://synap:\${POSTGRES_PASSWORD}@postgres:5432/kratos?sslmode=disable
serve:
  public:
    base_url: ${kratos_public_base_url}
    cors:
      enabled: true
      # CORS origins - automatically generated from domain
      allowed_origins:
$cors_origins
      allowed_methods:
        - POST
        - GET
        - PUT
        - PATCH
        - DELETE
        - OPTIONS
      allowed_headers:
        - Authorization
        - Cookie
        - Content-Type
        - X-Requested-With
      exposed_headers:
        - Content-Type
        - Set-Cookie
      allow_credentials: true
  admin:
    base_url: http://localhost:4434
selfservice:
  default_browser_return_url: ${pod_admin_ui}/
  allowed_return_urls:
$return_urls
  methods:
    password:
      enabled: true
      config: {}
    passkey:
      # Pod Admin does NOT run the WebAuthn ceremony yet: its login hides the
      # passkey trigger (no navigator.credentials code there). The ceremony
      # exists in synap-app/packages/core/auth-ui/src/webauthn.ts but is mounted
      # only in synap-app/apps/studio. Kept enabled so passkeys already
      # registered stay valid. Requires the passkey credentials block in
      # identity.schema.json — without it the strategy silently does nothing.
      enabled: true
      config:
        rp:
          display_name: "Synap"
          id: ${bare_root}
          origins:
$(if [ "$is_localhost" = true ]; then
echo "            - http://localhost:3000"
echo "            - http://localhost:4040"
else
echo "            - https://${domain}"
echo "            - ${pod_admin_origin}"
fi)
    oidc:
$oidc_block
  flows:
    error:
      ui_url: ${kratos_ui}
    settings:
      ui_url: ${kratos_settings_ui}
      privileged_session_max_age: 15m
      # Synap Cloud trust (founder decision R1, 2026-10-04): Cloud may SIGN IN
      # by default, RECOVERY is opt-in by the owner. A can_interrupt settings
      # web_hook runs PRE-PERSIST (web_hook.go ExecuteSettingsPrePersistHook);
      # its ctx has the request cookies but not the session, so the body
      # forwards the session cookie and the pod reads authentication_methods
      # (apps/api/src/webhooks/kratos-cloud-trust.ts). A Cloud-only session
      # cannot change a sign-in method unless the owner trusts Cloud for
      # recovery or the account has no pod-held factor yet.
      # Body (decoded): function(ctx) { identity_id, session_cookie: ctx.request_cookies.ory_kratos_session or null }
      after:
        password:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/settings/guard
                method: POST
                body: base64:
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
        passkey:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/settings/guard
                method: POST
                body: base64:
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
        profile:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/settings/guard
                method: POST
                body: base64:
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
        oidc:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/settings/guard
                method: POST
                body: base64:
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
    recovery:
      enabled: true
      use: code
      ui_url: ${kratos_recovery_ui}
      after:
        hooks:
          # A recovered account signs out everywhere else (keeps the new session).
          - hook: revoke_active_sessions
    verification:
      # Off until the pod courier delivers mail (wave 2: CP relay / BYO SMTP).
      enabled: false
      ui_url: ${kratos_ui}
    logout:
      after:
        default_browser_return_url: ${pod_admin_ui}/
    login:
      ui_url: ${kratos_ui}
      lifespan: 10m
      after:
        oidc:
          hooks:
            # Owner set Synap Cloud trust to "off" → refuse "Continue with Synap
            # Cloud" before the session cookie is issued (login/hook.go runs
            # post-login hooks, then UpsertAndIssueCookie).
            # Body (decoded): function(ctx) { identity_id: ctx.identity.id }
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/login/cloud
                method: POST
                body: base64://ZnVuY3Rpb24oY3R4KSB7IGlkZW50aXR5X2lkOiBjdHguaWRlbnRpdHkuaWQgfQo=
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
    registration:
      lifespan: 10m
      ui_url: ${kratos_ui}
      # NO OPEN SIGN-UP (founder decision 2026-10-04). Kratos v1.3.1 has no
      # per-method registration switch, and flows.registration.enabled=false
      # would ALSO kill the Cloud owner's first oidc sign-in (the oidc login
      # callback creates a registration flow for an unknown subject —
      # strategy_login.go -> NewRegistrationFlow, which checks that flag).
      # So registration stays enabled and a BLOCKING web_hook gates it:
      # can_interrupt=true runs PRE-PERSIST (web_hook.go
      # ExecutePostRegistrationPrePersistHook), so a refusal aborts before any
      # identity exists. The pod refuses every password registration and every
      # Cloud user without pod access (message id 4000901,
      # apps/api/src/webhooks/kratos-registration-gate.ts).
      # Bodies (decoded): function(ctx) { method: "password"|"oidc", identity: ctx.identity }
      after:
        password:
          hooks:
            - hook: web_hook
              config:
                # Use Docker service name for internal communication
                url: http://backend:4000/api/webhooks/kratos/registration/gate
                method: POST
                body: base64://ZnVuY3Rpb24oY3R4KSB7IG1ldGhvZDogInBhc3N3b3JkIiwgaWRlbnRpdHk6IGN0eC5pZGVudGl0eSB9Cg==
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
            - hook: session
        oidc:
          hooks:
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/registration/gate
                method: POST
                body: base64://ZnVuY3Rpb24oY3R4KSB7IG1ldGhvZDogIm9pZGMiLCBpZGVudGl0eTogY3R4LmlkZW50aXR5IH0K
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
                can_interrupt: true
            # Post-persist (NOT can_interrupt) and BEFORE session: the session
            # hook ends the chain. Seeds the pod owner for a verified CP owner
            # claim; removes any persisted identity that has no pod access.
            - hook: web_hook
              config:
                url: http://backend:4000/api/webhooks/kratos/registration/complete
                method: POST
                body: base64://ZnVuY3Rpb24oY3R4KSB7IG1ldGhvZDogIm9pZGMiLCBpZGVudGl0eTogY3R4LmlkZW50aXR5IH0K
                headers:
                  Content-Type: application/json
                  X-Webhook-Secret: ${webhook_secret}
            - hook: session
log:
  level: info
  format: json
# secrets: provided via environment variables SECRETS_COOKIE and SECRETS_CIPHER in docker-compose.yml
identity:
  default_schema_id: default
  schemas:
    - id: default
      url: file:///etc/config/kratos/identity.schema.json
session:
  # Explicit, not defaulted. Kratos defaults session.lifespan to 24h, and that
  # daily expiry was the ONLY reason the desktop app stored the user's password
  # (to silently re-login each day) — a replayable secret at rest, guarded by a
  # Touch ID prompt that was never actually enforced. 30 days removes the need:
  # a session cookie is scoped and revocable server-side; a password is neither.
  #
  # ABSOLUTE, not sliding — verified against Kratos v1.3.1 source. /sessions/whoami
  # calls RefreshCookie (session/handler.go:266), which only re-issues the COOKIE
  # to match the session (session/manager_http.go:109-131); it never advances
  # ExpiresAt. Extension happens only via the admin endpoint
  # PATCH /admin/sessions/{id}/extend. So users re-login every 30 days regardless
  # of activity. To make it sliding, the pod would have to call that admin
  # endpoint (session.earliest_possible_extend then throttles the DB writes).
  lifespan: 720h
  cookie:
    # Cookie domain: automatically set based on domain
    domain: ${cookie_domain}
    same_site: Lax
    # Note: secure flag is controlled by Kratos based on cookie domain
    # For production domains, Kratos automatically sets secure=true
# The courier's connection URI has ONE source: COURIER_SMTP_CONNECTION_URI
# (docker-compose, from SMTP_CONNECTION_URI). Env overrides this file, so a
# URI here would be dead config — it once pointed at a mail catcher that never
# ran. The backend self-reports the real courier (apps/api/src/courier-status.ts).
courier:
  smtp:
    from_address: noreply@synap.io
EOF
    
    echo -e "${GREEN}✓ Generated kratos.yml for domain: ${domain}${NC}"
}

# Wait until Kratos accepts traffic (used before first-admin seed).
wait_for_kratos_ready() {
    local i=0
    while [ "$i" -lt 45 ]; do
        if docker compose exec -T kratos wget --spider -q http://127.0.0.1:4433/health/ready 2>/dev/null; then
            return 0
        fi
        i=$((i + 1))
        sleep 2
    done
    return 1
}

# Create first admin via script bundled in backend image (dist/scripts/create-admin-cli.js).
run_preseed_admin_in_container() {
    local email="$1"
    local password="$2"
    local attempt=1
    local max_attempts=6

    if ! wait_for_kratos_ready; then
        echo -e "${YELLOW}⚠️  Kratos did not report ready in time; still attempting admin creation.${NC}"
    fi

    while [ "$attempt" -le "$max_attempts" ]; do
        if docker compose exec -T \
            -e "ADMIN_EMAIL=${email}" \
            -e "ADMIN_PASSWORD=${password}" \
            backend node dist/scripts/create-admin-cli.js; then
            return 0
        fi
        echo -e "${YELLOW}⚠️  Admin seed attempt ${attempt}/${max_attempts} failed, retrying...${NC}"
        attempt=$((attempt + 1))
        sleep 8
    done
    return 1
}


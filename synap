cmd_start() {
    local deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in Synap installation directory${NC}"
        exit 1
    fi

    cd "$deploy_dir"

    local service=${1:-}

    # Self-heal Kratos config before bringing up. `generate_kratos_config` is
    # idempotent and fast — it reads $DOMAIN from .env and re-templates
    # kratos.yml with the current CORS list, return URLs and webhook secret.
    # Without this, kratos comes up against whatever kratos.yml was on disk
    # the last time `install` or `update` ran. If $DOMAIN drifted (manual
    # edit, configure-pod.sh, CP update), the running kratos serves stale
    # `allowed_origins` and the browser sees CORS rejections — exactly the
    # failure mode that previously required a full `synap update` to fix.
    # We only regen when bringing up "all" services or kratos specifically,
    # to keep `start backend` / `start redis` cheap.
    if [ -z "$service" ] || [ "$service" = "kratos" ]; then
        local domain="$(grep '^DOMAIN=' .env 2>/dev/null | cut -d= -f2)"
        if [ -n "$domain" ]; then
            echo -e "${BLUE}🔧 Refreshing Kratos config for domain=${domain}…${NC}"
            generate_kratos_config "$domain"
        else
            echo -e "${YELLOW}⚠ DOMAIN not in .env — skipping kratos.yml regeneration${NC}"
        fi
    fi

    if [ -z "$service" ]; then
        echo -e "${BLUE}🚀 Starting all services...${NC}"
        docker compose up -d --remove-orphans
    else
        echo -e "${BLUE}🚀 Starting $service...${NC}"
        docker compose up -d --remove-orphans "$service"
    fi

    echo -e "${GREEN}✅ Services started!${NC}"
}

# ─── Federation / external sign-in enablement ──────────────────────────────────
# Turn on "Continue with Synap Cloud" sign-in through Kratos. There is NO secret
# to paste and NO shared key: the pod's OWN per-pod OIDC client is auto-fetched
# from the Control Plane at deploy over the pod's existing Hub API key (see
# generate_kratos_config). This command just records which CP to federate to and
# hands off to the landing page to link the pod to the owner's account. The pod
# backend stays CP-agnostic — the only CP-specific bit is the provision endpoint.
cmd_federation() {
    local deploy_dir
    deploy_dir=$(get_deploy_dir)
    if [ -z "$deploy_dir" ]; then
        echo -e "${RED}Error: Not in a Synap installation directory${NC}"; exit 1
    fi
    cd "$deploy_dir"

    local action="${1:-status}"; shift 2>/dev/null || true
    local domain; domain="$(grep '^DOMAIN=' .env 2>/dev/null | cut -d= -f2)"

    _fed_apply() {
        echo -e "${BLUE}🔧 Regenerating Kratos config…${NC}"
        generate_kratos_config "$domain"
        echo -e "${BLUE}🔁 Restarting Kratos…${NC}"
        docker compose up -d --force-recreate kratos >/dev/null 2>&1
    }

    case "$action" in
        connect-cloud|enable)
            # Turn ON federated sign-in. NO secret to paste: the per-pod OIDC
            # client is auto-provisioned from the Control Plane at deploy over the
            # pod's existing Hub API key (see generate_kratos_config). We only
            # record which CP to federate to (and clear any disable flag).
            local cp_url=""
            while [ $# -gt 0 ]; do case "$1" in
                --control-plane) cp_url="$2"; shift 2;;
                --label) update_env_value SYNAP_POD_OIDC_LABEL "$2"; shift 2;;
                *) shift;;
            esac; done
            [ -z "$cp_url" ] && cp_url="$(grep '^CONTROL_PLANE_URL=' .env 2>/dev/null | cut -d= -f2- | tr -d ' \"')"
            [ -z "$cp_url" ] && cp_url="https://api.synap.live"
            update_env_value CONTROL_PLANE_URL "$cp_url"   # also auto-trusts the CP at boot (seedControlPlaneIssuer)
            SYNAP_ENV_FILE=.env envcfg_write_raw U SYNAP_POD_FEDERATION_DISABLED
            _fed_apply
            echo -e "${BLUE}🔎 Verifying the Control Plane…${NC}"
            if curl -fsS "${cp_url%/}/.well-known/openid-configuration" >/dev/null 2>&1; then
                echo -e "${GREEN}  ✓ CP OIDC discovery reachable at ${cp_url}${NC}"
            else
                echo -e "${YELLOW}  ⚠ Couldn't reach ${cp_url}/.well-known/openid-configuration — check CONTROL_PLANE_URL.${NC}"
            fi
            echo ""
            echo -e "${GREEN}✅ Federated sign-in is LIVE — the login page now offers \"Continue with Synap Cloud\".${NC}"
            echo -e "  The FIRST time you use it, Kratos links your Cloud identity to your existing"
            echo -e "  pod account: you'll sign in once with your pod password to confirm you own"
            echo -e "  both. After that, \"Continue with Synap Cloud\" signs you in directly."
            echo -e "  (No account-linking URL, no key to manage — the binding is Kratos-native.)"
            ;;
        status)
            local cp lbl disabled
            cp="$(grep '^CONTROL_PLANE_URL=' .env 2>/dev/null | cut -d= -f2- | tr -d ' \"')"
            lbl="$(grep '^SYNAP_POD_OIDC_LABEL=' .env 2>/dev/null | cut -d= -f2-)"
            disabled="$(grep '^SYNAP_POD_FEDERATION_DISABLED=' .env 2>/dev/null | cut -d= -f2- | tr -d ' \"')"
            echo -e "${BLUE}Federation (external sign-in) status${NC}"
            if [ -n "$cp" ] && [ "$disabled" != "1" ]; then
                echo -e "  Configured:    ${GREEN}ENABLED${NC} (per-pod client, CP→pod push)"
                echo -e "  Control Plane: $cp"
                echo -e "  Button:        ${lbl:-Synap Cloud}"
                # Ground truth: does the LIVE Kratos actually offer the oidc method?
                # (Config can be ENABLED yet the CP push may have failed — e.g. the
                # CP wasn't deployed with the endpoint, or the pod backend was down.)
                local _live=""
                _live="$(curl -fsS --max-time 6 "https://${domain}/.ory/kratos/public/self-service/login/api" 2>/dev/null || true)"
                [ -z "$_live" ] && _live="$(curl -fsS --max-time 6 "http://localhost:4433/self-service/login/api" 2>/dev/null || true)"
                if printf '%s' "$_live" | grep -q '"group":"oidc"'; then
                    echo -e "  Kratos:        ${GREEN}LIVE${NC} — the login page offers the provider"
                elif [ -n "$_live" ]; then
                    echo -e "  Kratos:        ${RED}NOT LIVE${NC} — login flow has NO oidc method."
                    echo -e "    → the CP→pod OIDC-client push failed at last deploy."
                    echo -e "      Confirm CP is deployed with /pods/oidc/provision + the pod's"
                    echo -e "      /api/hub/federation/oidc-config, then: ./synap federation connect-cloud"
                else
                    echo -e "  Kratos:        ${YELLOW}unreachable${NC} — couldn't probe the login flow to confirm."
                fi
            else
                echo -e "  External sign-in: ${YELLOW}DISABLED${NC} (Pod password sign-in only)"
                [ -z "$cp" ]  && echo -e "    • CONTROL_PLANE_URL not set"
                [ "$disabled" = "1" ] && echo -e "    • explicitly disabled (synap federation disable)"
                echo -e "  Enable: ${BLUE}synap federation connect-cloud${NC}"
            fi
            ;;
        disable)
            update_env_value SYNAP_POD_FEDERATION_DISABLED "1"
            rm -f .env.bak
            _fed_apply
            echo -e "${GREEN}✅ External sign-in disabled — password sign-in only. (CP trust unchanged.)${NC}"
            ;;
        *)
            echo -e "${RED}Unknown action: $action${NC}"
            echo "  synap federation status | connect-cloud | disable"
            exit 1
            ;;
    esac
}


${YELLOW}For detailed help:${NC}
  synap install --help
  synap update --help

EOF
}

# ============================================================================
# MAIN COMMAND ROUTER
# ============================================================================

case "${1:-help}" in
    install)
        shift
        cmd_install "$@"
        ;;
    health)
        cmd_health
        ;;
    ps|status)
        cmd_ps
        ;;
    logs)
        shift
        cmd_logs "$@"
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    restart)
        cmd_restart "${2:-}"
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    backup)
        cmd_backup "${2:-}"
        ;;
    restore)
        cmd_restore "${2:-}"
        ;;
    config)
        shift
        cmd_config "$@"
        ;;
    rebuild)
        shift
        cmd_rebuild "$@"
        ;;
    errors|error)
        shift
        cmd_errors "$@"
        ;;
    diagnose|diag)
        cmd_diagnose
        ;;
    clean)
        shift
        cmd_clean "$@"
        ;;
    shell)
        shift
        cmd_shell "$@"
        ;;
    exec)
        shift
        cmd_exec "$@"
        ;;
    services)
        shift
        cmd_services "$@"
        ;;
    reset)
        shift
        cmd_reset "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo ""
        cmd_help
        exit 1
        ;;
esac



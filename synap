                FROM_IMAGE=true
                shift
                ;;
            --from-source|--build)
                FROM_SOURCE=true
                shift
                ;;
            --release|-r)
                FROM_IMAGE=true
                INSTALL_RELEASE="${2:-}"
                shift 2
                ;;
            --dir|--directory)
                INSTALL_DIR="$2"
                shift 2
                ;;
            --domain)
                DOMAIN="$2"
                shift 2
                ;;
            --email)
                EMAIL="$2"
                shift 2
                ;;
            --admin-email)
                ADMIN_EMAIL="$2"
                shift 2
                ;;
            --admin-password)
                ADMIN_PASSWORD="$2"
                ADMIN_PASSWORD_FROM_ARG=true
                shift 2
                ;;
            --admin-bootstrap-mode)
                ADMIN_BOOTSTRAP_MODE="$2"
                shift 2
                ;;
            --admin-bootstrap-token)
                ADMIN_BOOTSTRAP_TOKEN="$2"
                shift 2
                ;;
            --intelligence-url)
                INTELLIGENCE_URL="$2"
                shift 2
                ;;
            --intelligence-key)
                INTELLIGENCE_KEY="$2"
                shift 2
                ;;
            --repo-url)
                REPO_URL="$2"
                shift 2
                ;;
            --non-interactive|--automated)

{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "tsconfig.json"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsconfig.json",
        "tsup.config.ts",
        "tsup.config.js",
        "tsup.config.mjs",
        "package.json"
      ],
      "outputs": ["dist/**", ".tsbuildinfo"],
      "outputLogs": "errors-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.ts", "**/*.test.ts", "vitest.config.ts"],
      "outputs": ["coverage/**"]
    }
  }
}
